{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/goal_guard.py",
            "timeout": 3600,
            "statusMessage": "Checking the armed goal..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/goal_guard.py --inject",
            "timeout": 15,
            "statusMessage": "Restating the armed goal..."
          }
        ]
      }
    ]
  }
}
