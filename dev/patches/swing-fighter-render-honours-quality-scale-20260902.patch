+def reject_unsupported_quality_scale(target: str, opts: dict) -> None:
+    """Refuse a quality scale this family's SHEET render cannot honour.
+
+    ⛔ THE BUG THIS REPLACES WAS SILENCE, NOT THE MISSING FEATURE. All four
+    swing-fighter modules opened their `render` with `del opts`, so a caller
+    that passed `quality_scale` — `ambition_sprite2d_renderer publish --target
+    medic --quality-scale 0.25 --dest-root <...>/sprites_0_25x` — got a
+    FULL-RESOLUTION sheet installed into a reduced tier and no indication that
+    anything had been ignored. Four sheets on one machine sat that way for days
+    (67.2 MP where the tier promised ~10.5) and nothing on screen looked wrong,
+    because the art is correct and merely larger than asked for.
+
+    ⚠ THIS DOES NOT IMPLEMENT SCALING, DELIBERATELY. `render_portraits` scales
+    by shrinking its `output_size`, but the sheet path has no equivalent single
+    knob: `frame_size()` is derived from `doc.frame["render_scale"]` while the
+    frames themselves come from `_raw_frame`, so scaling `frame_size` alone
+    would shrink the LAYOUT and not the art — cropping every frame at its new
+    edge. That is the one failure Jon's standing rule forbids, and it would look
+    like a successful render. Making the discard loud is the change that can be
+    made safely without a rasterisation review.
+
+    ⇒ Tiers do not need this path anyway: `generate_visual_quality_variants.py`
+    sends every `module`-kind target to `build_sheet_variant`, which RESIZES the
+    published full sheet from isolated frames and is the road every correctly
+    scaled variant already comes from.
+    """
+    scale = opts.get("quality_scale")
+    if scale is None:
+        return
+    if float(scale) == 1.0:
+        return
+    raise ValueError(
+        f"{target}: this target's sheet render cannot honour quality_scale="
+        f"{scale}; it would publish full-resolution art into a reduced tier. "
+        "Publish tiers with scripts/generate_visual_quality_variants.py, which "
+        "resizes the full sheet, rather than rendering per tier."
+    )
+
+
 class AuthoredSwingFighter:
     """One SVG-rigged fighter, published with its authored effects and volumes."""
 
