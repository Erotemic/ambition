// The lines the Versus mode shows (schema `versus_text`, owned by the mode).
// An edit here is shown at the next start, with no Rust build. A `{word}` is
// a hole the game fills; a line may leave out a hole it fills, and may not
// name one it does not. A key names a line, not its words.
{
    // The score line: each team and its round wins, joined by the separator.
    "hud.rounds": "ROUNDS  {score}   (first to {to_win})",
    "hud.team_score": "{team} {wins}",
    "hud.score_separator": "  -  ",
    // The countdown in two beats: which round, then go.
    "announce.round": "ROUND {number}",
    "announce.fight": "FIGHT",
    // A round ends.
    "announce.ko": "K.O.  {team} wins the round",
    "announce.double_ko": "DOUBLE K.O.  —  the round is a draw",
    // The match ends.
    "announce.match_won": "{winner} WINS THE MATCH",
    // The mode's row of a launcher.
    "launcher.label": "Versus",
    "launcher.description": "Two characters from two providers, fighting",
    "launcher.preparing": "Prepare Versus",
}
