// The words of the host's own surfaces (schema `host_text`, in the host's
// pack `assets/host/pack.ron`, read by `app::host_pack`). An edit
// here is shown at the next start, with no Rust build. A `{word}` is a hole
// the host fills; a line may leave out a hole it fills, and may not name one
// it does not. A key names a line, not its words.
//
// These are the host's words. A game's words are in its own pack (Ambition's
// launcher row is `ambition_content`'s `data/ambition_text.ron`).
{
    // The run-in's first card, before the title: what the game was built
    // with.
    "startup.engine_card": "Powered by Ambition",
    // The cover while the first frame is prepared.
    "loading.title": "AMBITION",
    "loading.subtitle": "TANGENT SPACE SANDBOX",
    "loading.preparing": "Preparing sandbox…",
    "loading.building": "Building the first coherent frame",
    "loading.loading": "Loading the Ambition sandbox",
    // The progress line: the headline above, and the assets settled of all.
    "loading.progress": "{headline}  ·  {settled}/{total}",
    // `{label}` is the asset it waits for.
    "loading.item": "Loading {label}",
    "loading.presentation": "Preparing presentation",
    "loading.ready": "Ready",
    "loading.finalizing": "Finalizing the first complete frame…",
    // `{assets}` is the list of the assets that did not load.
    "loading.asset_failed": "A required asset failed to load",
    "loading.failed_list": "Failed: {assets}",
    "loading.preparation_failed": "Startup preparation failed",
    // The pause menu's pages: their names on the side tabs, and their titles.
    "menu.page.items": "Equipment",
    "menu.page.map": "Map",
    "menu.page.quest": "Quest",
    "menu.page.system": "System",
    "menu.items.title": "EQUIPMENT",
    "menu.map.title": "MAP",
    // The Map page: off the map, and the line naming the building the
    // player is inside while the map shows the region outside it.
    "menu.map.unmapped": "No map of this place.",
    "menu.map.inside": "inside",
    "menu.quest.title": "QUEST",
    "menu.system.title": "SYSTEM",
    // The SYSTEM page's title inside one of its screens.
    "menu.system.screen_title": "SYSTEM • {screen}",
    // The QUEST page: the things the player carries that are not
    // equipment (the key items), under one heading.
    "menu.quest.carried": "CARRIED",
    "menu.quest.carried_none": "You carry nothing for a quest yet.",
    // The items page: what a press does to the focused item, and its state.
    "menu.items.equip": "Equip",
    "menu.items.use": "Use",
    "menu.items.selected": "SELECTED",
    "menu.items.not_owned": "not owned",
    "menu.items.equipped": "equipped",
    "menu.items.activate_to_equip": "Activate to equip",
    "menu.items.activate_to_use": "Activate to use",
    // The SYSTEM page's own rows. Each setting's label and description are the
    // settings' own.
    "menu.system.back": "< Back",
    "menu.system.back_detail": "Return to the SYSTEM list.",
    "menu.system.quality_apply": "Apply quality: {profile}",
    "menu.system.quality_apply_detail": "Confirm the {profile} visual-quality profile. Textures and room visuals reload immediately after this is applied.",
    "menu.system.quality_cancel": "Cancel quality change",
    "menu.system.quality_cancel_detail": "Discard the pending visual-quality profile and keep the current setting.",
    "menu.system.radio_detail": "Play this station now, in place of the room's and the fight's music (the menu stays open to audition).",
    "menu.system.radio_off": "Stop the radio",
    "menu.system.radio_off_detail": "Turn the radio off: the room's and the fight's own music return.",
    "menu.system.locale_detail": "Active interface language.",
    "menu.system.locale_unavailable_detail": "Not available yet (real localization is a later pass).",
    "menu.system.rebind_detail": "Press to rebind, then press the key or button you want.",
    "menu.system.now_playing": "Now playing: {name}",
    "menu.system.now_playing_nothing": "Now playing: nothing",
    // A row that is not found any more; the menu is rebuilt each frame.
    "menu.system.missing_station": "Station",
    "menu.system.missing_locale": "Locale",
    "menu.system.missing_rebind": "Rebind",
    "menu.system.missing_label": "System",
    "menu.system.missing_detail": "System options.",
}
