// The colours of the host's pause menu pages (schema `menu_look`, read by
// `menu::model`). An edit is shown at the next start, with no Rust build.
// Each colour is (red, green, blue, alpha), from 0 to 1. The items grid
// keeps the menu model's own colours.
(
    // Behind the System page and a page with no content yet.
    page: (0.03, 0.04, 0.10, 0.96),
    // The detail panel of the Items and System pages.
    panel: (0.035, 0.046, 0.105, 0.96),
    // A page's title and a panel's header: gold.
    heading: (1.0, 0.84, 0.38, 1.0),
    // The lines under a header.
    body: (0.88, 0.94, 1.0, 0.96),
    // The line of a page that has no content yet: a little dimmer.
    placeholder_body: (0.85, 0.92, 1.0, 0.9),
    // The 3D cube's own colours.
    cube: (
        // A control under the cursor: gold.
        selected: (0.98, 0.76, 0.26, 0.96),
        // A control the menu marks important (the equipped item): green.
        important: (0.13, 0.34, 0.28, 0.96),
        // An item cell, an action button, and any other control.
        item: (0.055, 0.074, 0.155, 0.96),
        action: (0.09, 0.12, 0.26, 0.96),
        control: (0.055, 0.070, 0.145, 0.96),
        // A control that cannot be used.
        disabled: (0.040, 0.045, 0.075, 0.72),
        // A scroll bar: a dim track, so the bright thumb reads as the handle.
        scrollbar_track: (0.10, 0.09, 0.04, 0.55),
        scrollbar_thumb: (0.98, 0.82, 0.36, 0.95),
        // The frame around each face.
        edge_frame: (0.80, 0.92, 1.0, 0.62),
        // The tint of an item's icon that cannot be used, and of one under
        // the cursor.
        icon_disabled: (0.55, 0.58, 0.66, 0.55),
        icon_selected: (1.0, 0.95, 0.78, 1.0),
    ),
)
