// The host's own content pack (`app::host_pack::HOST_PACK`): the facts of
// the host's own surfaces, which no game owns. A game's facts are in its own
// pack; the versus stage's are `assets/pack.ron`.
(
    id: "ambition_app_host",
    version: "0.1.0",
    // Every identity this pack mints is `host:<schema>/<name>`.
    namespace: "host",
    requires: [],
    sources: [
        // The words of the run-in's engine card, the start cover and the
        // pause menu's own rows.
        (path: "data/host_text.ron", schema: "host_text", version: 1),
        // The title screen's look: the drifting scene and the menu's window;
        // and how long the run-in's engine card holds before it.
        (path: "data/title_look.ron", schema: "title_look", version: 1),
        // The colours of the start cover.
        (path: "data/cover_look.ron", schema: "cover_look", version: 1),
        // The colours of the pause menu's pages.
        (path: "data/menu_look.ron", schema: "menu_look", version: 1),
    ],
)
