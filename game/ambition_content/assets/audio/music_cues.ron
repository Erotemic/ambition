// Ambition's adaptive music: the cues that ship, and the encounters and rooms
// that bind to them. Schema `music_cue_catalog` (owned by `ambition_audio`); the content
// compiler checks every reference and requires each section's audio file.
//
// The audio is rendered by tools/ambition_music_renderer
// (scores/active/first_goblin_tune_v2.music.yaml). Each section is one
// mastered `full` mix, so the renderer owns loudness: keep gains near unity.
// If a section needs +10 dB here, fix the score or the generator and render
// again. Large runtime boosts make the noise floor and the section boundaries
// audible.
(
    cues: [
        (
            id: "first_goblin_tune_v2",
            asset_root: "audio/music/generated/first_goblin_tune_v2",
            bpm: 132.0,
            beats_per_bar: 4.0,
            // Stacked layers sum hotter than the one-channel room tracks, so
            // keep this conservative.
            relative_volume: 1.0,
            sections: [
                (id: "intro", duration_beats: 16.0, looped: false, sources: [(layer_id: "full", path: "adaptive/intro/intro.full.ogg")]),
                (id: "wave1", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave1/wave1.full.ogg")]),
                (id: "wave2", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave2/wave2.full.ogg")]),
                (id: "wave3", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave3/wave3.full.ogg")]),
                (id: "recap_loop", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/recap_loop/recap_loop.full.ogg")]),
                (id: "outro", duration_beats: 16.0, looped: false, sources: [(layer_id: "full", path: "adaptive/outro/outro.full.ogg")]),
            ],
            // One mastered layer. Add per-stem layers again only when the
            // renderer masters per-stem outputs and each stem is audible.
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "intro", section_id: "intro", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave1", section_id: "wave1", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave2", section_id: "wave2", gains: [(layer_id: "full", gain: 1.0)]),
                // With one full mix per section this state is the same as
                // wave2. It stays so that the binding's
                // `wave2_reinforced_state` names a state.
                (id: "wave2_brute", section_id: "wave2", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave3", section_id: "wave3", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "cleared_bridge", section_id: "recap_loop", gains: [(layer_id: "full", gain: 0.85)]),
                (id: "outro", section_id: "outro", gains: [(layer_id: "full", gain: 1.0)]),
            ],
            outro_state: Some("outro"),
            post_clear_bridge_state: Some("cleared_bridge"),
        ),
        (
            // The primeval trail. ONE loop, the whole song (verse, chorus and
            // the two solo sections), in six layers; a state is a set of layer
            // gains. So a walk from room to room, and the start of the T-rex
            // fight, change only gains: nothing starts again and nothing is
            // cut (Jon, 2026-10-12: "The user should never hear a
            // discontinuity in the music. New instruments should layer onto
            // the loop making each section progressively rock harder"). Each
            // level of intensity is the whole song. The soundtrack version,
            // with its intro, its outro and a master chain, is the track
            // `dinosaur_liberators`.
            //
            // The audio is the playback layers of
            // scores/active/dinosaur_liberators_adaptive.music.yaml: sums of
            // stems before the master chain. Measure with the renderer's
            // dev/measure_playback_layers.py before you change a gain.
            id: "dinosaur_liberators_adaptive",
            asset_root: "audio/music/generated/dinosaur_liberators_adaptive",
            bpm: 110.0,
            beats_per_bar: 4.0,
            // The fight state peaks 0.3 dB under full scale at a volume of
            // one (measured); this leaves it 1.2 dB.
            relative_volume: 0.9,
            sections: [
                // Plays one time, to its end, when the cue starts.
                (id: "intro", duration_beats: 32.0, looped: false, sources: [
                    (layer_id: "bed", path: "playback/intro/intro.bed.ogg"),
                    (layer_id: "tune", path: "playback/intro/intro.tune.ogg"),
                ]),
                (id: "song", duration_beats: 256.0, looped: true, sources: [
                    (layer_id: "bed", path: "playback/song/song.bed.ogg"),
                    (layer_id: "tune", path: "playback/song/song.tune.ogg"),
                    (layer_id: "drums", path: "playback/song/song.drums.ogg"),
                    (layer_id: "crunch", path: "playback/song/song.crunch.ogg"),
                    (layer_id: "horn", path: "playback/song/song.horn.ogg"),
                    (layer_id: "second", path: "playback/song/song.second.ogg"),
                ]),
            ],
            // In the order the level adds them.
            layers: [
                // Arpeggio guitar, bass, organ and piano.
                (id: "bed", slot: 0),
                // The melody of each part of the song: the lead and the slide
                // guitar in the verse and the chorus, the first solo guitar in
                // the solo sections.
                (id: "tune", slot: 1),
                (id: "drums", slot: 2),
                // The heavy rhythm guitar.
                (id: "crunch", slot: 3),
                (id: "horn", slot: 4),
                // The second solo guitar: it plays in the last quarter of the loop.
                (id: "second", slot: 5),
            ],
            // Each state is the state before it and one layer more. The level
            // of each over the loop, measured at these gains: soft -23.7 dB,
            // rolling +1.8, driving +1.1, charging +0.4, blazing +0.2, fight
            // +0.6. At a gain of one the heavy guitar adds 0.5 dB and the
            // horns 0.2: the gains over one are what make them a step.
            states: [
                (id: "intro", section_id: "intro", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "soft", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "rolling", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0)]),
                (id: "driving", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5)]),
                (id: "charging", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5), (layer_id: "horn", gain: 1.8)]),
                (id: "blazing", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5), (layer_id: "horn", gain: 1.8), (layer_id: "second", gain: 1.6)]),
                // Every layer, and each louder: the top of the song.
                (id: "fight", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.12), (layer_id: "crunch", gain: 1.7), (layer_id: "horn", gain: 2.0), (layer_id: "second", gain: 1.8)]),
            ],
        ),
        (
            // The town of the Math dimension: the peaceful relative of the
            // GNU-ton boss music, standing_on_shoulders. ONE loop of 48 bars
            // in five layers; a state is a set of layer gains, so a walk from
            // the gate square to the terraces changes only gains. The
            // terraces state is a subset of the gate square state.
            //
            // The audio is the playback layers of
            // scores/active/shoulders_at_rest.music.yaml: sums of stems before
            // the master chain. Measured over the loop at these gains:
            // terraces -28.2 dB RMS, peak -11.4 dBFS; gate square -27.6 dB,
            // peak -9.0 dBFS. The lofi room tracks are -27.0 and -29.4 dB.
            id: "shoulders_at_rest",
            asset_root: "audio/music/generated/shoulders_at_rest",
            bpm: 88.0,
            beats_per_bar: 4.0,
            relative_volume: 1.0,
            sections: [
                (id: "town", duration_beats: 192.0, looped: true, sources: [
                    (layer_id: "bed", path: "playback/town/town.bed.ogg"),
                    (layer_id: "tune", path: "playback/town/town.tune.ogg"),
                    (layer_id: "harp", path: "playback/town/town.harp.ogg"),
                    (layer_id: "groove", path: "playback/town/town.groove.ogg"),
                    (layer_id: "comp", path: "playback/town/town.comp.ogg"),
                ]),
            ],
            layers: [
                // Double bass, electric piano, strings.
                (id: "bed", slot: 0),
                // The tune: piano and clarinet.
                (id: "tune", slot: 1),
                (id: "harp", slot: 2),
                // A soft swung drum groove and a quiet hi-hat.
                (id: "groove", slot: 3),
                // An acoustic guitar on the off-beats.
                (id: "comp", slot: 4),
            ],
            states: [
                (id: "terraces", section_id: "town", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "harp", gain: 1.0)]),
                (id: "gate_square", section_id: "town", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "harp", gain: 1.0), (layer_id: "groove", gain: 1.0), (layer_id: "comp", gain: 1.0)]),
            ],
        ),
        (
            // Wolfenstein's fight (scores/active/galvanic_march.music.yaml): a
            // stiff brass march that detunes into a howling theremin theme,
            // the howl being the march tune slowed and glided; both at once
            // when he is enraged. His phases choose the section
            // (`boss_bindings`). Awaken and unleash do not loop: each plays
            // to its end, then the phase's own loop starts.
            id: "galvanic_march",
            asset_root: "audio/music/generated/galvanic_march",
            bpm: 116.0,
            beats_per_bar: 4.0,
            relative_volume: 1.0,
            sections: [
                (id: "awaken", duration_beats: 16.0, looped: false, sources: [
                    (layer_id: "bed", path: "playback/awaken/awaken.bed.ogg"),
                    (layer_id: "drums", path: "playback/awaken/awaken.drums.ogg"),
                    (layer_id: "tune", path: "playback/awaken/awaken.tune.ogg"),
                ]),
                (id: "march", duration_beats: 64.0, looped: true, sources: [
                    (layer_id: "bed", path: "playback/march/march.bed.ogg"),
                    (layer_id: "drums", path: "playback/march/march.drums.ogg"),
                    (layer_id: "tune", path: "playback/march/march.tune.ogg"),
                ]),
                (id: "unleash", duration_beats: 8.0, looped: false, sources: [
                    (layer_id: "bed", path: "playback/unleash/unleash.bed.ogg"),
                    (layer_id: "drums", path: "playback/unleash/unleash.drums.ogg"),
                    (layer_id: "tune", path: "playback/unleash/unleash.tune.ogg"),
                ]),
                (id: "howl", duration_beats: 64.0, looped: true, sources: [
                    (layer_id: "bed", path: "playback/howl/howl.bed.ogg"),
                    (layer_id: "drums", path: "playback/howl/howl.drums.ogg"),
                    (layer_id: "tune", path: "playback/howl/howl.tune.ogg"),
                ]),
                (id: "storm", duration_beats: 64.0, looped: true, sources: [
                    (layer_id: "bed", path: "playback/storm/storm.bed.ogg"),
                    (layer_id: "drums", path: "playback/storm/storm.drums.ogg"),
                    (layer_id: "tune", path: "playback/storm/storm.tune.ogg"),
                ]),
            ],
            layers: [
                // Strings, organ, choir, tuba and timpani.
                (id: "bed", slot: 0),
                (id: "drums", slot: 1),
                // The brass march and the theremin howl.
                (id: "tune", slot: 2),
            ],
            states: [
                (id: "awaken", section_id: "awaken", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "march", section_id: "march", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "unleash", section_id: "unleash", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "howl", section_id: "howl", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "storm", section_id: "storm", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
            ],
        ),
        (
            // The Evil dimension (Castle Godwin): The Tritone Decree
            // (scores/active/tritone_decree.music.yaml), heavy metal in E
            // Locrian. Its intro (bells, chant, the riff on floor toms) plays
            // one time when the cue starts in the forest by the gate; then the
            // song loops, its turnaround climbing back into the riff. The
            // forest and the castle's halls share the cue, so walking between
            // them does not start it again. The layers are pre-master sums:
            // the song measures -17.7 dB RMS, peak -0.4 dBFS at a gain of one,
            // so the cue plays at 0.8.
            id: "tritone_decree",
            asset_root: "audio/music/generated/tritone_decree",
            bpm: 140.0,
            beats_per_bar: 4.0,
            relative_volume: 0.8,
            sections: [
                (id: "intro", duration_beats: 32.0, looped: false, sources: [
                    (layer_id: "band", path: "playback/intro/intro.band.ogg"),
                    (layer_id: "orchestra", path: "playback/intro/intro.orchestra.ogg"),
                    (layer_id: "lead", path: "playback/intro/intro.lead.ogg"),
                ]),
                (id: "song", duration_beats: 256.0, looped: true, sources: [
                    (layer_id: "band", path: "playback/song/song.band.ogg"),
                    (layer_id: "orchestra", path: "playback/song/song.orchestra.ogg"),
                    (layer_id: "lead", path: "playback/song/song.lead.ogg"),
                ]),
            ],
            layers: [
                // Rhythm guitars, bass, drums.
                (id: "band", slot: 0),
                // Strings, choir, bells, timpani.
                (id: "orchestra", slot: 1),
                // The lead guitar and its harmony.
                (id: "lead", slot: 2),
            ],
            states: [
                (id: "intro", section_id: "intro", gains: [(layer_id: "band", gain: 1.0), (layer_id: "orchestra", gain: 1.0), (layer_id: "lead", gain: 1.0)]),
                (id: "decree", section_id: "song", gains: [(layer_id: "band", gain: 1.0), (layer_id: "orchestra", gain: 1.0), (layer_id: "lead", gain: 1.0)]),
            ],
        ),
    ],
    encounter_bindings: [
        (
            // The sandbox goblin lab.
            encounter_id: "goblin_encounter",
            cue_id: "first_goblin_tune_v2",
            starting_state: "intro",
            wave_states: ["wave1", "wave2", "wave3"],
            wave2_reinforced_state: Some("wave2_brute"),
            cleared_state: "outro",
        ),
    ],
    // A room's adaptive music, in place of its `music_track`. The six rooms of
    // the primeval trail share one cue, and EACH has a binding: a room of the
    // trail with none plays its `music_track` from the top, which cuts the
    // song (the rookery and the ridge had none from 2026-10-11 to 10-12). Each
    // room deeper in adds a layer, and the T-rex fight is every layer. The
    // intro plays one time, to its end, when the cue starts at the trailhead;
    // a player who is in the next room before it ends hears it end, and then
    // the loop at that room's state.
    room_bindings: [
        (room_id: "primeval_trailhead", cue_id: "dinosaur_liberators_adaptive", state: "soft", entry_state: Some("intro")),
        (room_id: "primeval_run", cue_id: "dinosaur_liberators_adaptive", state: "rolling"),
        (room_id: "primeval_rookery", cue_id: "dinosaur_liberators_adaptive", state: "driving"),
        (room_id: "primeval_ridge", cue_id: "dinosaur_liberators_adaptive", state: "charging"),
        (room_id: "primeval_canopy", cue_id: "dinosaur_liberators_adaptive", state: "blazing"),
        (room_id: "primeval_tyrant_hall", cue_id: "dinosaur_liberators_adaptive", state: "blazing", fight_state: Some("fight")),
        // The Evil dimension: the forest by the gate and the castle's halls
        // (not the throne room, which is Wolfenstein's).
        (room_id: "evil_gate_forest", cue_id: "tritone_decree", state: "decree", entry_state: Some("intro")),
        (room_id: "castle_godwin_gatehouse", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_barracks", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_tower", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_great_hall", cue_id: "tritone_decree", state: "decree"),
    ],
    // A boss's phases choose the state of its cue, for every placement of
    // the archetype (the story's fight and the Hall of Bosses' copy).
    boss_bindings: [
        (
            boss_id: "wolfenstein_boss",
            cue_id: "galvanic_march",
            phase_states: [
                (phase: "Intro", state: "awaken"),
                (phase: "Phase1", state: "march"),
                (phase: "Transition", state: "unleash"),
                (phase: "Phase2", state: "howl"),
                (phase: "Stagger", state: "howl"),
                (phase: "Enrage", state: "storm"),
            ],
        ),
        // The Inugami: silence while it rises out of his body (his death
        // stopped the march), then the theremin howls the tune; the storm at
        // its end.
        (
            boss_id: "wolfenstein_inugami",
            cue_id: "galvanic_march",
            phase_states: [
                (phase: "Phase1", state: "howl"),
                (phase: "Transition", state: "unleash"),
                (phase: "Phase2", state: "howl"),
                (phase: "Stagger", state: "howl"),
                (phase: "Enrage", state: "storm"),
            ],
        ),
    ],
    // The town of the Math dimension by the time of day: four pieces of one
    // family (the Euclid Street motif). The gate hall under the street
    // follows the day too; it keeps its lamps (`ambition_content::day_cycle`).
    // `shoulders_at_rest` stays authored for another place.
    room_phase_tracks: [
        (room_id: "math_gate_hall", phase: "morning", track: "math_town_morning"),
        (room_id: "math_gate_hall", phase: "day", track: "math_town_day"),
        (room_id: "math_gate_hall", phase: "evening", track: "math_town_evening"),
        (room_id: "math_gate_hall", phase: "night", track: "math_town_night"),
        (room_id: "math_town_street", phase: "morning", track: "math_town_morning"),
        (room_id: "math_town_street", phase: "day", track: "math_town_day"),
        (room_id: "math_town_street", phase: "evening", track: "math_town_evening"),
        (room_id: "math_town_street", phase: "night", track: "math_town_night"),
    ],
)
