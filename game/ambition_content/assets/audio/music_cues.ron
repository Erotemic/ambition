// Ambition's adaptive music: the cues that ship, and the encounters and rooms
// that bind to them. Schema `music_cue_catalog` (owned by `ambition_audio`); the content
// compiler checks every reference and requires each section's audio file.
//
// The audio is rendered by tools/ambition_music_renderer
// (scores/active/first_goblin_tune_v2.music.yaml). Each section is one
// mastered `full` mix, so the renderer owns loudness: keep gains near unity.
// If a section needs +10 dB here, fix the score or the generator and render
// again. Large runtime boosts make the noise floor and the section boundaries
// audible.
(
    cues: [
        (
            id: "first_goblin_tune_v2",
            media: Inline(
                asset_root: "audio/music/generated/first_goblin_tune_v2",
                bpm: 132.0,
                beats_per_bar: 4.0,
                // Stacked layers sum hotter than the one-channel room tracks, so
                // keep this conservative.
                sections: [
                    (id: "intro", duration_beats: 16.0, looped: false, sources: [(layer_id: "full", path: "adaptive/intro/intro.full.ogg")]),
                    (id: "wave1", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave1/wave1.full.ogg")]),
                    (id: "wave2", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave2/wave2.full.ogg")]),
                    (id: "wave3", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/wave3/wave3.full.ogg")]),
                    (id: "recap_loop", duration_beats: 32.0, looped: true, sources: [(layer_id: "full", path: "adaptive/recap_loop/recap_loop.full.ogg")]),
                    (id: "outro", duration_beats: 16.0, looped: false, sources: [(layer_id: "full", path: "adaptive/outro/outro.full.ogg")]),
                ],
                // One mastered layer. Add per-stem layers again only when the
                // renderer masters per-stem outputs and each stem is audible.
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "intro", section_id: "intro", next_state: Some("wave1"), gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave1", section_id: "wave1", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave2", section_id: "wave2", gains: [(layer_id: "full", gain: 1.0)]),
                // With one full mix per section this state is the same as
                // wave2. It stays so that the binding's
                // `wave2_reinforced_state` names a state.
                (id: "wave2_brute", section_id: "wave2", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wave3", section_id: "wave3", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "cleared_bridge", section_id: "recap_loop", gains: [(layer_id: "full", gain: 0.85)]),
                (id: "outro", section_id: "outro", gains: [(layer_id: "full", gain: 1.0)]),
            ],
            outro_state: Some("outro"),
            post_clear_bridge_state: Some("cleared_bridge"),
        ),
        (
            // The Frontier dimension (scores/active/leaden_saddle.music.yaml,
            // `docs/planning/game/leadensaddle.md`): Dry Dock, the spaceport
            // town in the Leaden Saddle, on one motif, the saddle. The rooms
            // choose the section (`room_bindings`).
            id: "leaden_saddle",
            media: Inline(
                asset_root: "audio/music/generated/leaden_saddle",
                bpm: 96.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "dry_dock", duration_beats: 128.0, looped: true, sources: [(layer_id: "full", path: "playback/dry_dock/dry_dock.full.ogg")]),
                    (id: "wet_whistle", duration_beats: 96.0, looped: true, sources: [(layer_id: "full", path: "playback/wet_whistle/wet_whistle.full.ogg")]),
                    (id: "refinery_shift", duration_beats: 96.0, looped: true, sources: [(layer_id: "full", path: "playback/refinery_shift/refinery_shift.full.ogg")]),
                    (id: "mesa_top", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/mesa_top/mesa_top.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "dry_dock", section_id: "dry_dock", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "wet_whistle", section_id: "wet_whistle", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "refinery_shift", section_id: "refinery_shift", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "mesa_top", section_id: "mesa_top", gains: [(layer_id: "full", gain: 1.0)]),
            ],
        ),
        (
            // Marshal Gallus's fight (scores/active/marshal_gallus_showdown.music.yaml):
            // the crow motif on a lone trumpet for the standoff, the duel on a
            // galloping snare, high noon a semitone up, and his fall slowed
            // into the town's saddle motif. His phases choose the section
            // (`boss_bindings`); the standoff and the sundown play one time.
            id: "marshal_gallus_showdown",
            media: Inline(
                asset_root: "audio/music/generated/marshal_gallus_showdown",
                bpm: 132.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "standoff", duration_beats: 32.0, looped: false, sources: [(layer_id: "full", path: "playback/standoff/standoff.full.ogg")]),
                    (id: "duel", duration_beats: 128.0, looped: true, sources: [(layer_id: "full", path: "playback/duel/duel.full.ogg")]),
                    (id: "high_noon", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/high_noon/high_noon.full.ogg")]),
                    (id: "sundown", duration_beats: 40.0, looped: false, sources: [(layer_id: "full", path: "playback/sundown/sundown.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "standoff", section_id: "standoff", next_state: Some("duel"), gains: [(layer_id: "full", gain: 1.0)]),
                (id: "duel", section_id: "duel", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "high_noon", section_id: "high_noon", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "sundown", section_id: "sundown", gains: [(layer_id: "full", gain: 1.0)]),
            ],
            outro_state: Some("sundown"),
        ),
        (
            // The Frontier's first slice (scores/active/halfway_siding.music.yaml,
            // `techno-western-frontier-first-slice.md`): Halfway Siding, its
            // station and street, its inn and trestle, and Sprocket Row, on
            // one motif, the detour.
            id: "halfway_siding",
            media: Inline(
                asset_root: "audio/music/generated/halfway_siding",
                bpm: 88.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "platform", duration_beats: 96.0, looped: true, sources: [(layer_id: "full", path: "playback/platform/platform.full.ogg")]),
                    (id: "lie_down", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/lie_down/lie_down.full.ogg")]),
                    (id: "trestle", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/trestle/trestle.full.ogg")]),
                    (id: "sprocket", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/sprocket/sprocket.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "platform", section_id: "platform", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "lie_down", section_id: "lie_down", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "trestle", section_id: "trestle", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "sprocket", section_id: "sprocket", gains: [(layer_id: "full", gain: 1.0)]),
            ],
        ),
        (
            // Clinker Flats, the smelter town down the line
            // (scores/active/clinker_flats.music.yaml): the yard and the works,
            // and the Row on the way to the railhead.
            id: "clinker_flats",
            media: Inline(
                asset_root: "audio/music/generated/clinker_flats",
                bpm: 76.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "works", duration_beats: 96.0, looped: true, sources: [(layer_id: "full", path: "playback/works/works.full.ogg")]),
                    (id: "row", duration_beats: 64.0, looped: true, sources: [(layer_id: "full", path: "playback/row/row.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "works", section_id: "works", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "row", section_id: "row", gains: [(layer_id: "full", gain: 1.0)]),
            ],
        ),
        (
            // The train robbery (scores/active/the_rustler.music.yaml): the
            // Number 9 freight at speed, and the outlaw engine at its head.
            id: "the_rustler",
            media: Inline(
                asset_root: "audio/music/generated/the_rustler",
                bpm: 152.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "boxcars", duration_beats: 128.0, looped: true, sources: [(layer_id: "full", path: "playback/boxcars/boxcars.full.ogg")]),
                    (id: "rustler", duration_beats: 96.0, looped: true, sources: [(layer_id: "full", path: "playback/rustler/rustler.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "boxcars", section_id: "boxcars", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "rustler", section_id: "rustler", gains: [(layer_id: "full", gain: 1.0)]),
            ],
        ),
        (
            // Level 1 (Hobford): Hobford Goblins
            // (scores/active/hobford_goblins.music.yaml), every section on
            // the first goblin tune's motif. The valley rooms hold `lurking`
            // (a fiddle tune with the motif under it, in place of "A possible
            // morning") and the woods `shadowed` (the motif slowed over a
            // drone); the workshop raid plays `break_in` one time at the
            // knock, then `raid`, the brute's wave `brute`, and `aftermath`
            // (a lament on a cello) when it is won. One mastered `full` file
            // per section, slices of one composition master: the valley
            // measures -27.1 dB RMS, the brute -17.9 dB, peak -3.3 dBFS.
            id: "hobford_goblins",
            media: Published(
                description: "content://ambition_shared/audio/music/generated/hobford_goblins/hobford_goblins.adaptive_manifest.json",
                products: MasteredFull,
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "lurking", section_id: "lurking", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "shadowed", section_id: "shadowed", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "break_in", section_id: "break_in", next_state: Some("raid"), gains: [(layer_id: "full", gain: 1.0)]),
                (id: "raid", section_id: "raid", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "brute", section_id: "brute", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "aftermath", section_id: "aftermath", gains: [(layer_id: "full", gain: 1.0)]),
            ],
            outro_state: Some("aftermath"),
        ),
        (
            // The primeval trail. ONE loop, the whole song (verse, chorus and
            // the two solo sections), in six layers; a state is a set of layer
            // gains. So a walk from room to room, and the start of the T-rex
            // fight, change only gains: nothing starts again and nothing is
            // cut (Jon, 2026-10-12: "The user should never hear a
            // discontinuity in the music. New instruments should layer onto
            // the loop making each section progressively rock harder"). Each
            // level of intensity is the whole song. The soundtrack version,
            // with its intro, its outro and a master chain, is the track
            // `dinosaur_liberators`.
            //
            // The audio is the playback layers of
            // scores/active/dinosaur_liberators_adaptive.music.yaml: sums of
            // stems before the master chain. Measure with the renderer's
            // dev/measure_playback_layers.py before you change a gain.
            id: "dinosaur_liberators_adaptive",
            media: Published(
                description: "content://ambition_shared/audio/music/generated/dinosaur_liberators_adaptive/dinosaur_liberators_adaptive.adaptive_manifest.json",
                products: GroupedLayers,
            ),
            relative_volume: 0.9,
            layers: [
                // Arpeggio guitar, bass, organ and piano.
                (id: "bed", slot: 0),
                // The melody of each part of the song: the lead and the slide
                // guitar in the verse and the chorus, the first solo guitar in
                // the solo sections.
                (id: "tune", slot: 1),
                (id: "drums", slot: 2),
                // The heavy rhythm guitar.
                (id: "crunch", slot: 3),
                (id: "horn", slot: 4),
                // The second solo guitar: it plays in the last quarter of the loop.
                (id: "second", slot: 5),
            ],
            // Each state is the state before it and one layer more. The level
            // of each over the loop, measured at these gains: soft -23.7 dB,
            // rolling +1.8, driving +1.1, charging +0.4, blazing +0.2, fight
            // +0.6. At a gain of one the heavy guitar adds 0.5 dB and the
            // horns 0.2: the gains over one are what make them a step.
            states: [
                (id: "intro", section_id: "intro", next_state: Some("soft"), gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "soft", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "rolling", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0)]),
                (id: "driving", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5)]),
                (id: "charging", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5), (layer_id: "horn", gain: 1.8)]),
                (id: "blazing", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "crunch", gain: 1.5), (layer_id: "horn", gain: 1.8), (layer_id: "second", gain: 1.6)]),
                // Every layer, and each louder: the top of the song.
                (id: "fight", section_id: "song", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "drums", gain: 1.12), (layer_id: "crunch", gain: 1.7), (layer_id: "horn", gain: 2.0), (layer_id: "second", gain: 1.8)]),
            ],
        ),
        (
            // The town of the Math dimension: the peaceful relative of the
            // GNU-ton boss music, standing_on_shoulders. ONE loop of 48 bars
            // in five layers; a state is a set of layer gains, so a walk from
            // the gate square to the terraces changes only gains. The
            // terraces state is a subset of the gate square state.
            //
            // The audio is the playback layers of
            // scores/active/shoulders_at_rest.music.yaml: sums of stems before
            // the master chain. Measured over the loop at these gains:
            // terraces -28.2 dB RMS, peak -11.4 dBFS; gate square -27.6 dB,
            // peak -9.0 dBFS. The lofi room tracks are -27.0 and -29.4 dB.
            id: "shoulders_at_rest",
            media: Inline(
                asset_root: "audio/music/generated/shoulders_at_rest",
                bpm: 88.0,
                beats_per_bar: 4.0,
                sections: [
                    (id: "town", duration_beats: 192.0, looped: true, sources: [
                        (layer_id: "bed", path: "playback/town/town.bed.ogg"),
                        (layer_id: "tune", path: "playback/town/town.tune.ogg"),
                        (layer_id: "harp", path: "playback/town/town.harp.ogg"),
                        (layer_id: "groove", path: "playback/town/town.groove.ogg"),
                        (layer_id: "comp", path: "playback/town/town.comp.ogg"),
                    ]),
                ],
            ),
            relative_volume: 1.0,
            layers: [
                // Double bass, electric piano, strings.
                (id: "bed", slot: 0),
                // The tune: piano and clarinet.
                (id: "tune", slot: 1),
                (id: "harp", slot: 2),
                // A soft swung drum groove and a quiet hi-hat.
                (id: "groove", slot: 3),
                // An acoustic guitar on the off-beats.
                (id: "comp", slot: 4),
            ],
            states: [
                (id: "terraces", section_id: "town", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "harp", gain: 1.0)]),
                (id: "gate_square", section_id: "town", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "tune", gain: 1.0), (layer_id: "harp", gain: 1.0), (layer_id: "groove", gain: 1.0), (layer_id: "comp", gain: 1.0)]),
            ],
        ),
        (
            // Wolfenstein's fight (scores/active/galvanic_march.music.yaml): a
            // stiff brass march that detunes into a howling theremin theme,
            // the howl being the march tune slowed and glided; both at once
            // when he is enraged. His phases choose the section
            // (`boss_bindings`). Awaken and unleash do not loop: each plays
            // to its end, then the phase's own loop starts.
            id: "galvanic_march",
            media: Published(
                description: "content://ambition_shared/audio/music/generated/galvanic_march/galvanic_march.adaptive_manifest.json",
                products: GroupedLayers,
            ),
            relative_volume: 1.0,
            layers: [
                // Strings, organ, choir, tuba and timpani.
                (id: "bed", slot: 0),
                (id: "drums", slot: 1),
                // The brass march and the theremin howl.
                (id: "tune", slot: 2),
            ],
            states: [
                (id: "awaken", section_id: "awaken", next_state: Some("march"), gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "march", section_id: "march", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "unleash", section_id: "unleash", next_state: Some("march"), gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "howl", section_id: "howl", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
                (id: "storm", section_id: "storm", gains: [(layer_id: "bed", gain: 1.0), (layer_id: "drums", gain: 1.0), (layer_id: "tune", gain: 1.0)]),
            ],
        ),
        (
            // GNU-ton's fight: Standing on Shoulders v2
            // (scores/active/standing_on_shoulders_v2_adaptive.music.yaml, made
            // from the radio's standing_on_shoulders_v2 by
            // dev/derive_standing_on_shoulders_v2.py --adaptive). Its intro (the
            // royal call, the proclamation, the giant takes the stage) plays one
            // time. Then the body of the song loops, note for note the radio's:
            // its B7 turnaround leads back into Hands of GNU, and the renderer
            // carries the ring of the loop's end onto its head. Every phase plays
            // the loop, so a phase change starts nothing again (Jon, 2026-10-24).
            // The outro (the final royal impacts, one last slam, its ring) plays
            // when he falls. One mastered `full` layer per section, so the
            // renderer owns loudness, as for the radio's version.
            id: "standing_on_shoulders_v2_adaptive",
            media: Inline(
                asset_root: "audio/music/generated/standing_on_shoulders_v2_adaptive",
                bpm: 88.0,
                beats_per_bar: 4.0,
                sections: [
                    // The intro's file runs on past its 24 beats with its ring,
                    // which sounds as the director fades it out under the loop.
                    (id: "intro", duration_beats: 24.0, looped: false, sources: [(layer_id: "full", path: "playback/intro/intro.full.ogg")]),
                    (id: "fight", duration_beats: 292.0, looped: true, sources: [(layer_id: "full", path: "playback/fight/fight.full.ogg")]),
                    (id: "outro", duration_beats: 20.0, looped: false, sources: [(layer_id: "full", path: "playback/outro/outro.full.ogg")]),
                ],
            ),
            relative_volume: 1.0,
            layers: [(id: "full", slot: 0)],
            states: [
                (id: "intro", section_id: "intro", next_state: Some("fight"), gains: [(layer_id: "full", gain: 1.0)]),
                (id: "fight", section_id: "fight", gains: [(layer_id: "full", gain: 1.0)]),
                (id: "outro", section_id: "outro", gains: [(layer_id: "full", gain: 1.0)]),
            ],
            outro_state: Some("outro"),
        ),
        (
            // The Evil dimension (Castle Godwin): The Tritone Decree
            // (scores/active/tritone_decree.music.yaml), heavy metal in E
            // Locrian. Its intro (bells, chant, the riff on floor toms) plays
            // one time when the cue starts in the forest by the gate; then the
            // song loops, its turnaround climbing back into the riff. The
            // forest and the castle's halls share the cue, so walking between
            // them does not start it again. The layers are pre-master sums:
            // the song measures -17.7 dB RMS, peak -0.4 dBFS at a gain of one,
            // so the cue plays at 0.8.
            id: "tritone_decree",
            media: Published(
                description: "content://ambition_shared/audio/music/generated/tritone_decree/tritone_decree.adaptive_manifest.json",
                products: GroupedLayers,
            ),
            relative_volume: 0.8,
            layers: [
                // Rhythm guitars, bass, drums.
                (id: "band", slot: 0),
                // Strings, choir, bells, timpani.
                (id: "orchestra", slot: 1),
                // The lead guitar and its harmony.
                (id: "lead", slot: 2),
            ],
            states: [
                (id: "intro", section_id: "intro", next_state: Some("decree"), gains: [(layer_id: "band", gain: 1.0), (layer_id: "orchestra", gain: 1.0), (layer_id: "lead", gain: 1.0)]),
                (id: "decree", section_id: "song", gains: [(layer_id: "band", gain: 1.0), (layer_id: "orchestra", gain: 1.0), (layer_id: "lead", gain: 1.0)]),
            ],
        ),
    ],
    encounter_bindings: [
        (
            // Level 1's workshop raid: the knock, the three raiders, the
            // brute's wave, and the lament when it is won.
            encounter_id: "intro_workshop_raid",
            cue_id: "hobford_goblins",
            starting_state: "break_in",
            wave_states: ["raid", "brute"],
            cleared_state: "aftermath",
        ),
        (
            // The sandbox goblin lab.
            encounter_id: "goblin_encounter",
            cue_id: "first_goblin_tune_v2",
            starting_state: "intro",
            wave_states: ["wave1", "wave2", "wave3"],
            wave2_reinforced_state: Some("wave2_brute"),
            cleared_state: "outro",
        ),
    ],
    // Rooms that request the continuous Dinosaur song share one cue and loop.
    // A side room can request another track. State changes add layers without
    // restarting the loop. The intro plays once at the trailhead and completes
    // even when the listener enters the next room before it ends.
    room_bindings: [
        // Level 1's valley: the open rooms by day, and the woods, the gate
        // clearing and the fell in the motif's shadow.
        // The Frontier: the town, the saloon, the refinery and the corral,
        // the mesa top.
        (room_id: "frontier_landing_pad", cue_id: "leaden_saddle", state: "dry_dock"),
        (room_id: "frontier_main_street", cue_id: "leaden_saddle", state: "dry_dock"),
        (room_id: "frontier_livery", cue_id: "leaden_saddle", state: "dry_dock"),
        (room_id: "frontier_wet_whistle", cue_id: "leaden_saddle", state: "wet_whistle"),
        (room_id: "frontier_refinery", cue_id: "leaden_saddle", state: "refinery_shift"),
        (room_id: "frontier_ore_corral", cue_id: "leaden_saddle", state: "refinery_shift"),
        (room_id: "hall_marshal_gallus_corral", cue_id: "leaden_saddle", state: "refinery_shift"),
        (room_id: "frontier_saddle_lookout", cue_id: "leaden_saddle", state: "mesa_top"),
        // The first slice: Halfway Siding, the Number 9 freight, Clinker Flats.
        (room_id: "frontier_siding_station", cue_id: "halfway_siding", state: "platform"),
        (room_id: "frontier_siding_street", cue_id: "halfway_siding", state: "platform"),
        (room_id: "frontier_sprocket_row", cue_id: "halfway_siding", state: "sprocket"),
        (room_id: "frontier_lie_down_inn", cue_id: "halfway_siding", state: "lie_down"),
        (room_id: "frontier_siding_trestle", cue_id: "halfway_siding", state: "trestle"),
        (room_id: "frontier_freight_tail", cue_id: "the_rustler", state: "boxcars"),
        (room_id: "frontier_freight_cars", cue_id: "the_rustler", state: "boxcars"),
        (room_id: "frontier_rustler_head", cue_id: "the_rustler", state: "rustler"),
        (room_id: "frontier_clinker_yard", cue_id: "clinker_flats", state: "works"),
        (room_id: "frontier_clinker_works", cue_id: "clinker_flats", state: "works"),
        (room_id: "frontier_clinker_row", cue_id: "clinker_flats", state: "row"),
        (room_id: "frontier_clinker_railhead", cue_id: "clinker_flats", state: "row"),
        (room_id: "intro_hobford_lane", cue_id: "hobford_goblins", state: "lurking"),
        (room_id: "intro_high_meadow", cue_id: "hobford_goblins", state: "lurking"),
        (room_id: "intro_millstream", cue_id: "hobford_goblins", state: "lurking"),
        (room_id: "intro_woods", cue_id: "hobford_goblins", state: "shadowed"),
        (room_id: "intro_gate_clearing", cue_id: "hobford_goblins", state: "shadowed"),
        (room_id: "intro_fell", cue_id: "hobford_goblins", state: "shadowed"),
        (room_id: "primeval_trailhead", cue_id: "dinosaur_liberators_adaptive", state: "soft", entry_state: Some("intro")),
        (room_id: "primeval_run", cue_id: "dinosaur_liberators_adaptive", state: "rolling"),
        (room_id: "primeval_treetops", cue_id: "dinosaur_liberators_adaptive", state: "rolling"),
        (room_id: "primeval_rookery", cue_id: "dinosaur_liberators_adaptive", state: "driving"),
        (room_id: "primeval_ridge", cue_id: "dinosaur_liberators_adaptive", state: "charging"),
        (room_id: "primeval_canopy", cue_id: "dinosaur_liberators_adaptive", state: "blazing"),
        (room_id: "primeval_tar_pits", cue_id: "dinosaur_liberators_adaptive", state: "blazing"),
        (room_id: "primeval_tyrant_hall", cue_id: "dinosaur_liberators_adaptive", state: "blazing", fight_state: Some("fight")),
        // The Evil dimension: the forest by the gate and the castle's halls
        // (not the throne room, which is Wolfenstein's).
        (room_id: "evil_gate_forest", cue_id: "tritone_decree", state: "decree", entry_state: Some("intro")),
        (room_id: "castle_godwin_gatehouse", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_barracks", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_tower", cue_id: "tritone_decree", state: "decree"),
        (room_id: "castle_godwin_great_hall", cue_id: "tritone_decree", state: "decree"),
    ],
    // A boss's phases choose the state of its cue, for every placement of
    // the archetype (the story's fight and the Hall of Bosses' copy).
    boss_bindings: [
        (
            // Marshal Gallus: the standoff as he walks out, the duel for his
            // first two phases, high noon when he is enraged, the sundown
            // when he falls.
            boss_id: "marshal_gallus",
            cue_id: "marshal_gallus_showdown",
            phase_states: [
                (phase: "Intro", state: "standoff"),
                (phase: "Phase1", state: "duel"),
                (phase: "Transition", state: "duel"),
                (phase: "Phase2", state: "duel"),
                (phase: "Stagger", state: "duel"),
                (phase: "Enrage", state: "high_noon"),
                (phase: "Death", state: "sundown"),
            ],
        ),
        (
            // The bossofthegame (the final boss): his own anthem is wanted
            // (`docs/planning/game/final-boss.md`). Until it is rendered he
            // plays the cue of standing on the shoulders of giants.
            boss_id: "bossofthegame",
            cue_id: "standing_on_shoulders_v2_adaptive",
            phase_states: [
                (phase: "Intro", state: "intro"),
                (phase: "Phase1", state: "fight"),
                (phase: "Transition", state: "fight"),
                (phase: "Phase2", state: "fight"),
                (phase: "Stagger", state: "fight"),
                (phase: "Enrage", state: "fight"),
                (phase: "Death", state: "outro"),
            ],
        ),
        (
            // GNU-ton: the loop through every phase of the fight, and the
            // outro when he falls (it plays one time: a fallen boss's outro
            // only ends a cue that is playing).
            boss_id: "gnu_ton_rider",
            cue_id: "standing_on_shoulders_v2_adaptive",
            phase_states: [
                (phase: "Intro", state: "intro"),
                (phase: "Phase1", state: "fight"),
                (phase: "Transition", state: "fight"),
                (phase: "Phase2", state: "fight"),
                (phase: "Stagger", state: "fight"),
                (phase: "Enrage", state: "fight"),
                (phase: "Death", state: "outro"),
            ],
        ),
        (
            // The Supreme Leader: the regime's own song until a cue of his
            // own is written; its intro under his address.
            boss_id: "supreme_leader",
            cue_id: "tritone_decree",
            phase_states: [
                (phase: "Intro", state: "intro"),
                (phase: "Phase1", state: "decree"),
                (phase: "Transition", state: "decree"),
                (phase: "Phase2", state: "decree"),
                (phase: "Stagger", state: "decree"),
                (phase: "Enrage", state: "decree"),
            ],
        ),
        (
            boss_id: "wolfenstein_boss",
            cue_id: "galvanic_march",
            phase_states: [
                (phase: "Intro", state: "awaken"),
                (phase: "Phase1", state: "march"),
                (phase: "Transition", state: "unleash"),
                // ⛔ Not `howl` or `storm`: those states are a theremin's howl
                // and a storm with no tune under them (Jon, 2026-10-21: "howl
                // and storm are just sfx not music"). The fight plays the
                // march, its music, after the unleash too.
                (phase: "Phase2", state: "march"),
                (phase: "Stagger", state: "march"),
                (phase: "Enrage", state: "march"),
            ],
        ),
    ],
    // The town of the Math dimension by the time of day: four pieces of one
    // family (the Euclid Street motif). The gate hall under the street
    // follows the day too; it keeps its lamps (`ambition_content::day_cycle`).
    // `shoulders_at_rest` stays authored for another place.
    room_phase_tracks: [
        (room_id: "math_gate_hall", phase: "morning", track: "math_town_morning"),
        (room_id: "math_gate_hall", phase: "day", track: "math_town_day"),
        (room_id: "math_gate_hall", phase: "evening", track: "math_town_evening"),
        (room_id: "math_gate_hall", phase: "night", track: "math_town_night"),
        (room_id: "math_town_street", phase: "morning", track: "math_town_morning"),
        (room_id: "math_town_street", phase: "day", track: "math_town_day"),
        (room_id: "math_town_street", phase: "evening", track: "math_town_evening"),
        (room_id: "math_town_street", phase: "night", track: "math_town_night"),
        (room_id: "math_cafe", phase: "morning", track: "math_town_morning"),
        (room_id: "math_cafe", phase: "day", track: "math_town_day"),
        (room_id: "math_cafe", phase: "evening", track: "math_town_evening"),
        (room_id: "math_cafe", phase: "night", track: "math_town_night"),
        (room_id: "math_surveyors_office", phase: "morning", track: "math_town_morning"),
        (room_id: "math_surveyors_office", phase: "day", track: "math_town_day"),
        (room_id: "math_surveyors_office", phase: "evening", track: "math_town_evening"),
        (room_id: "math_surveyors_office", phase: "night", track: "math_town_night"),
        (room_id: "math_observatory", phase: "morning", track: "math_town_morning"),
        (room_id: "math_observatory", phase: "day", track: "math_town_day"),
        (room_id: "math_observatory", phase: "evening", track: "math_town_evening"),
        (room_id: "math_observatory", phase: "night", track: "math_town_night"),
    ],
)
