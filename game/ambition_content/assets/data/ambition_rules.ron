// Ambition's own tuning (schema `ambition_rules`, owned by
// `ambition_content_schemas`). An edit here is played at the next start, and
// after a content reload, with no Rust build.
(
    // An active boss says an idle line between strikes, so it reads as a
    // present character when nobody attacks it: one each 7 s, plus or minus
    // at most 3 s, so two bosses do not speak together.
    boss_idle_bark: (
        base_seconds: 7.0,
        jitter_seconds: 3.0,
    ),
    // The duel on the giant's back: the scholar fights with the moves of the
    // fighter `npc_gnu_ton`. A table move has a platform fighter's damage and
    // launch (percent, and a launch that grows with it); a boss's strike is a
    // few hearts and a fixed launch (1.25).
    gnu_ton_duel: (
        // The table's damage at and over which a move is a heavy one here.
        heavy_damage: 12,
        light: (hearts: 1, launch: 1.0),
        heavy: (hearts: 2, launch: 1.7),
        // The table is of a fighter as tall as the player. On the giant he is
        // drawn larger (his body is about twice the player's height), so a
        // move's reach is larger by this. A move that is not over his head
        // (a middle under `overhead`; up is negative) is put DOWN, at the
        // height of a player beside him (`at_the_player`, from the middle of
        // his body), and is at least `least_half_height` tall. Generous on
        // purpose for a first cut.
        reach: 1.3,
        overhead: -30.0,
        at_the_player: 24.0,
        least_half_height: 30.0,
        // A move over his head is drawn higher and taller on the giant: its
        // middle's height times `overhead_rise`, its half height times
        // `overhead_grow`.
        overhead_rise: 1.6,
        overhead_grow: 1.5,
        // A move that calls the fist of his giant out of a portal is a blow
        // of his book here (the giant under him has its own punch): this box
        // about his body, in the fighter's units, before `reach`.
        book: (offset: (42.0, -4.0), half_extents: (30.0, 24.0)),
    ),
    // What an African swallow does with a coconut: it fetches one at rest,
    // carries it over what it hunts, and lets it go there.
    african_swallow: (
        // It goes for a coconut at rest no farther from it than this (px).
        fetch_reach: 900.0,
        // How fast it flies to a coconut, and how fast with one: it is a five
        // ounce bird (px/s; its own speed is 290).
        fetch_speed: 250.0,
        laden_speed: 185.0,
        // It carries the coconut this far over its target (px).
        carry_over: 150.0,
        // It lets go within this of the place over its target, side to side,
        // and no lower over it than `let_go_over` (px). A coconut that falls
        // that far arrives faster than the speed it hurts at
        // (`a_coconut_let_go_arrives_faster_than_it_hurts_at`).
        let_go_within: 18.0,
        let_go_over: 90.0,
        // It aims where its target will be after this long (s): about the
        // fall.
        lead_seconds: 0.35,
    ),
    // The thrown items that hurt the body they strike, by held-item id, and
    // bounce off it. An item with no row lands and hurts nobody (the javelin
    // and the axe). A tilt throw ahead leaves the hand at about 480 px/s and a
    // smash throw at about 820; a fall of a body's height arrives at about
    // 370. `rebound` is the fraction of its speed an item keeps, reversed,
    // when it strikes; `rebound_cap` is the most of `min_speed` the rebound
    // may be, so the item leaves under its bar and the blow is spent.
    thrown_impacts: {
        "coconut": (min_speed: 240.0, damage: 2, rebound: 0.3, rebound_cap: 0.8),
    },
    // The character a player starts as, a row of `character_catalog.ron`:
    // the current robot. Which row the game starts on is its choice, so it is
    // stated here and not on the row.
    starting_character: "player_robot_v3",
    // The Noether attunement in the Noether Chamber: it completes when each
    // signal came in. The chamber's four kernel switches send them (their
    // `on_activate` lines in sandbox.ldtk): flip the gravity through every
    // face and every symmetry is visited.
    symmetry_attunement: (
        signals: ["gravity_down", "gravity_left", "gravity_up", "gravity_right"],
        banner: "NOETHER ATTUNEMENT — every symmetry conserved",
        banner_seconds: 4.0,
    ),
    // A quest's payout: its banner (each quest's words, in quests.ron) stays
    // this long, in seconds. Shorter than the attunement's: a payout is read
    // at a glance, and the items it gives are in the inventory.
    quest_payout: (
        banner_seconds: 3.0,
    ),
    // The portal gun a player drops lies this far ahead of it, in the way
    // it faces (px), with a pickup box of this half size (px). It cannot be
    // taken again for `arm_seconds`, so the press that dropped it does not
    // take it back.
    portal_gun_drop: (
        ahead_px: 44.0,
        half_extent_px: 20.0,
        arm_seconds: 0.35,
    ),
    // The trap over the Smirking Behemoth. What hangs from the rope, in the
    // order the room's replays take them (a session starts on the first):
    // each is a prop sheet and a name, which the banner says and the
    // dialogue asks for (`cut_rope_heavy_object_is("anvil")`).
    cut_rope_trap: (
        heavy_objects: [
            (prop: "cut_rope_anvil", name: "anvil"),
            (prop: "cut_rope_piano", name: "piano"),
        ],
        // When it lands on him; `{object}` is the name of what fell.
        flattened_banner: "Smirking Behemoth was flattened by a {object}",
        banner_seconds: 2.8,
        // Seconds between two sparks on the rope while it waits to be cut.
        rope_spark_seconds: 0.22,
        // How the trap looks. A speed is px per second; a colour is (red,
        // green, blue, alpha), each 0 to 1.
        effects: (
            // The shards when the rope is cut.
            cut: (count: 14, speed: 160.0, color: (0.90, 0.82, 0.58, 0.78)),
            // The sparks on the rope while it waits: the effect rows they play
            // in turn, their size, the band across the rope (px), how far above
            // its centre (the least and the most, px), and how far toward the
            // boss (a share of his distance from the rope, up to a reach, px).
            rope_sparks: (
                effects: ["starburst", "classic_burst", "burst_round", "shockwave", "smoke_burst"],
                scale: 0.48,
                across_px: 44.0,
                above_px: (16.0, 74.0),
                pull_share: 0.18,
                pull_reach_px: 80.0,
            ),
            // When it lands on him: the explosion's size, the fireworks (how
            // many, the area they go off in, px, and for how long, seconds),
            // and the sparks.
            landing: (
                explosion_scale: 1.25,
                fireworks: (count: 18, spread: (420.0, 280.0), seconds: 2.75),
                sparks: (count: 28, speed: 260.0, color: (0.84, 0.95, 1.0, 0.86)),
            ),
        ),
    ),
    // Ambition's day: 24 minutes of play (an hour of the day a minute), and a
    // session begins at 8 in the morning. Each phase begins at its hour and
    // lasts until the next one begins. The music of a room by the time of day
    // is in `music_cues.ron` (`room_phase_tracks`).
    day: (
        length_seconds: 1440.0,
        morning_at: 5.0,
        day_at: 10.0,
        evening_at: 17.0,
        night_at: 21.0,
        start_hour: 8.0,
        // The veil over a sunlit room by the hour, (r, g, b, a) in sRGB: clear
        // from 10 to 16, gold at 7:30, violet at dawn and dusk, deep blue at
        // night. The veil is blended in linear light, which darkens much less
        // than its alpha reads in sRGB: 0.86 takes a white wall to about a
        // third of its brightness (measured in a capture at 22:00).
        daylight: [
            (0.0, (0.05, 0.08, 0.26, 0.86)),
            (4.5, (0.05, 0.08, 0.26, 0.86)),
            (6.0, (0.32, 0.26, 0.52, 0.55)),
            (7.5, (1.0, 0.72, 0.42, 0.20)),
            (10.0, (1.0, 1.0, 1.0, 0.0)),
            (16.0, (1.0, 1.0, 1.0, 0.0)),
            (18.0, (1.0, 0.48, 0.12, 0.32)),
            (19.5, (0.45, 0.20, 0.42, 0.58)),
            (21.0, (0.06, 0.09, 0.28, 0.82)),
        ],
    ),
    // The NPC that comes out of the Smirking Behemoth when it dies. Its
    // lines are `smirking_behemoth_victory_npc` in
    // `dialogue/sandbox/kernel.yarn`, which writes the speaker's name again.
    cut_rope_victory: (
        name: "The Rope Appreciator",
        dialogue: "smirking_behemoth_victory_npc",
        width: 28.0,
        height: 48.0,
    ),
    // The spectator duel in the basement: the PCA against the player's
    // previous build. The arena room stages it, and `<<duel>>` stages it
    // beside the player.
    duel: (
        room: "duel_arena",
        arena_offset_x: 360.0,
        beside_player_x: 220.0,
        fighters: [
            (id: "duel_pca", character: "perfect_cellular_automaton", brain: "cellular_automaton_fighter",
             offset: (-75.0, 0.0), half_size: (14.0, 23.0), grudge_against: "duel_robot"),
            (id: "duel_robot", character: "player_robot_v2", brain: "player_robot",
             offset: (75.0, 0.0), half_size: (14.0, 23.0), grudge_against: "duel_pca"),
        ],
    ),
)
