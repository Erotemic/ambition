// Ambition's own tuning (schema `ambition_rules`, owned by
// `ambition_content_schemas`). An edit here is played at the next start, and
// after a content reload, with no Rust build.
(
    // An active boss says an idle line between strikes, so it reads as a
    // present character when nobody attacks it: one each 7 s, plus or minus
    // at most 3 s, so two bosses do not speak together.
    boss_idle_bark: (
        base_seconds: 7.0,
        jitter_seconds: 3.0,
    ),
    // The duel on the giant's back: the scholar fights with the moves of the
    // fighter `npc_gnu_ton`. A table move has a platform fighter's damage and
    // launch (percent, and a launch that grows with it); a boss's strike is a
    // few hearts and a fixed launch (1.25).
    gnu_ton_duel: (
        // The table's damage at and over which a move is a heavy one here.
        heavy_damage: 12,
        light: (hearts: 1, launch: 1.0),
        heavy: (hearts: 2, launch: 1.7),
        // The table is of a fighter as tall as the player. On the giant he is
        // drawn larger (his body is about twice the player's height), so a
        // move's reach is larger by this. A move that is not over his head
        // (a middle under `overhead`; up is negative) is put DOWN, at the
        // height of a player beside him (`at_the_player`, from the middle of
        // his body), and is at least `least_half_height` tall. Generous on
        // purpose for a first cut.
        reach: 1.3,
        overhead: -30.0,
        at_the_player: 24.0,
        least_half_height: 30.0,
    ),
    // What an African swallow does with a coconut: it fetches one at rest,
    // carries it over what it hunts, and lets it go there.
    african_swallow: (
        // It goes for a coconut at rest no farther from it than this (px).
        fetch_reach: 900.0,
        // How fast it flies to a coconut, and how fast with one: it is a five
        // ounce bird (px/s; its own speed is 290).
        fetch_speed: 250.0,
        laden_speed: 185.0,
        // It carries the coconut this far over its target (px).
        carry_over: 150.0,
        // It lets go within this of the place over its target, side to side,
        // and no lower over it than `let_go_over` (px). A coconut that falls
        // that far arrives faster than the speed it hurts at
        // (`a_coconut_let_go_arrives_faster_than_it_hurts_at`).
        let_go_within: 18.0,
        let_go_over: 90.0,
        // It aims where its target will be after this long (s): about the
        // fall.
        lead_seconds: 0.35,
    ),
    // The thrown items that hurt the body they strike, by held-item id, and
    // bounce off it. An item with no row lands and hurts nobody (the javelin
    // and the axe). A tilt throw ahead leaves the hand at about 480 px/s and a
    // smash throw at about 820; a fall of a body's height arrives at about
    // 370.
    thrown_impacts: {
        "coconut": (min_speed: 240.0, damage: 2),
    },
)
