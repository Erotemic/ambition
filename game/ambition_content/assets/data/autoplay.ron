{
    "ambition": (
        fight_at_stops: false, repeat: true, equip: None,
        stops: [
            (room: "hall_of_characters", way: Walk, cross: true),
            (room: "primeval_trailhead", way: Walk, cross: false),
            (room: "primeval_tyrant_hall", way: Fly, cross: true),
            (room: "central_hub_complex", way: Fly, cross: false),
        ],
    ),
    "castle_godwin": (
        fight_at_stops: true, repeat: false, equip: Some("fireball"),
        stops: [
            (room: "evil_gate_forest", way: Fly, cross: false),
            (room: "castle_godwin_gatehouse", way: Fly, cross: false),
            (room: "castle_godwin_barracks", way: Fly, cross: false),
            (room: "castle_godwin_tower", way: Fly, cross: false),
            (room: "castle_godwin_great_hall", way: Fly, cross: true),
            (room: "castle_godwin_throne", way: Fly, cross: true),
        ],
    ),
    // The Wolfenstein fight end to end, for a developer (Jon, 2026-11-19):
    // Wolfenstein, his head risen as the Inugami, its chase to the final
    // hall, Kagero's spell, its finish and death. `examples/inugami_e2e.rs`
    // runs it headless and reports where the sequence stalls;
    // `AMBITION_AUTOPLAY=wolfenstein` plays it in the window.
    "wolfenstein": (
        fight_at_stops: true, repeat: false, equip: Some("fireball"),
        assist: (endless_health: true, boss_advance: 0.2),
        stops: [
            (room: "castle_godwin_throne", way: Fly, cross: false),
        ],
    ),
    "portal_profile": (
        fight_at_stops: false, repeat: true, equip: None,
        stops: [
            (room: "portal_lab", way: Fly, cross: true),
            (room: "hall_of_characters", way: Fly, cross: true),
            (room: "central_hub_complex", way: Fly, cross: false),
        ],
    ),
}
