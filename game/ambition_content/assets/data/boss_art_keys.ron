// Ambition's boss art keys: which file draws each boss sheet, and which sheet
// rows each special move and each geometry strike claims. Read by `ambition_content::bosses` and by the
// boss crate's test catalog, so the two cannot disagree.
(
    sprite_filenames: {
        "gradient_sentinel": "boss_spritesheet.png",
        "mockingbird": "mockingbird_boss_v2_spritesheet.png",
        "smirking_behemoth_boss": "smirking_behemoth_boss_spritesheet.png",
        "giant_gnu": "gnu_ton_boss/giant_gnu_spritesheet.png",
        "gnu_ton_rider": "gnu_ton_boss/gnu_ton_rider_spritesheet.png",
        "flying_spaghetti_monster_boss": "flying_spaghetti_monster_boss_spritesheet.png",
        "trex_boss": "trex_enemy_spritesheet.png",
    },
    special_animation_rows: {
        "overfit_volley": ["spike_halo", "eye_beam"],
        "eye_beam": ["eye_beam", "spike_halo"],
        "minima_trap": ["spike_halo"],
        "saddle_point": ["spike_halo"],
        "gradient_cascade": ["spike_halo"],
        "mode_collapse_converge": ["spike_halo"],
        "gradient_nova": ["spike_halo"],
        "overflow_flood": ["spike_halo"],
        // GNU-ton's lectures. Every `Special` draws the scholar's spike-halo row
        // (arms raised: he is conducting), so that is the row each names.
        // `apple_rain` deliberately claims nothing (see
        // `apple_rain_claims_no_animation_rows_which_is_why_the_fold_is_blocked`).
        "demonstrate": ["spike_halo"],
        "demonstrate_pair": ["spike_halo"],
        "pendulum": ["spike_halo"],
        "cradle": ["spike_halo"],
        "orbit": ["spike_halo"],
        "fluxions": ["spike_halo"],
        "fluxions_pair": ["spike_halo"],
        "buck": ["spike_halo"],
        "stomp": ["spike_halo"],
        // The Flying Spaghetti Monster's moves, each on the sheet row its
        // conductor pins, so the god's hurt hull is the pose it is drawn in.
        "noodle_lash": ["side_sweep"],
        "meatball_volley": ["floor_slam"],
        "noodly_pulse": ["pulse"],
        "noodly_dive": ["dive"],
        "noodly_grasp": ["grasp"],
        // The T-rex's conducted moves: his module draws them, row by row.
        "trex_bite": ["bite"],
        "trex_double_bite": ["bite"],
        "trex_tail_whip": ["tail_swipe"],
        "trex_charge": ["roar"],
        "trex_snap_up": ["snap_up"],
        "trex_stomp": ["stomp"],
        "trex_roar": ["roar"],
        "trex_leap": ["leap"],
        "trex_jaw_grab": ["grab_reach"],
        "trex_call": ["roar"],
        "lesser_appendages": ["summon"],
        // The Mockingbird's air chase: its module draws each move's row.
        "mockingbird_missile": ["missile"],
        "mockingbird_salvo": ["missile"],
        "mockingbird_fireballs": ["slash"],
        "mockingbird_fire_fan": ["slash"],
        "mockingbird_snap": ["chomp"],
        "mockingbird_dive": ["dive"],
        "mockingbird_double_dive": ["dive"],
        "mockingbird_strafe": ["thrust"],
        "mockingbird_lightsabers": ["slash"],
    },
    // The sheet rows each geometry strike claims. The first row is the
    // canonical runtime key; the others are row-name aliases, so a
    // regenerated manifest and a review image can stay row-oriented. A strike
    // with no entry (`wing_sweep`, `dive_lane`, `broadside`) keeps its static
    // boxes.
    strike_animation_rows: {
        "floor_slam": ["floor_slam", "mouth_open"],
        "side_sweep": ["side_sweep"],
        "full_body_pulse": ["spike_halo", "eye_beam"],
        "hazard_column": ["dash_echo", "eye_beam"],
        // GNU-ton's strikes use gameplay keys of their own, so one visual row
        // can expose several boxes (`hand_slam` and the shockwave). The visual
        // row name is the alias: without it GNU-ton would fall back to rest
        // boxes when the generator names the row `head_down`.
        "hand_slam": ["gnu_hand_slam", "hand_slam"],
        "converging_shockwave": ["gnu_shockwave", "hand_slam"],
        "hand_sweep": ["gnu_hand_sweep", "hand_sweep"],
        "head_descent": ["gnu_head_descent", "head_down"],
    },
    // The generic animation row each geometry strike plays while it
    // telegraphs and while it is active. `None` is a strike that plays no row.
    // A strike with no entry (`full_body_pulse`, `head_descent`) plays the
    // spike-halo row, as each special does.
    strike_animations: {
        "floor_slam": Some(FloorSlam),
        "hand_slam": Some(FloorSlam),
        "converging_shockwave": Some(FloorSlam),
        "side_sweep": Some(SideSweep),
        "hand_sweep": Some(SideSweep),
        "broadside": Some(SideSweep),
        "hazard_column": Some(DashEcho),
        "dive_lane": Some(DashEcho),
        "wing_sweep": None,
    },
    // The sheet row the damageable box of a move is sampled from, when it is
    // not the first row the move claims. GNU-ton's strikes claim a gameplay
    // key first (`gnu_shockwave`), but his head and body box follows the row
    // that is drawn, so the authored frames of that row are the source of the
    // box. `apple_rain` claims no row and reads the head row for its box.
    hurtbox_sample_rows: {
        "hand_slam": "hand_slam",
        "converging_shockwave": "hand_slam",
        "hand_sweep": "hand_sweep",
        "head_descent": "head_down",
        "apple_rain": "head_down",
    },
)
