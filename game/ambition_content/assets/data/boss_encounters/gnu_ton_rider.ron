// Boss encounter spec — GNU-ton, the scholar who rides the giant gnu.
//
// The scholar is the boss; the `giant_gnu` mount he rides is scenery you can
// stand on and cannot hurt (the conductor holds it untouchable), so there is no
// on-foot phase and no `mount_died` trigger. The phases are his lectures:
// Phase 1 "Lectures on Motion", Phase 2 "Principia", Enrage "The System of the
// World" — see the `gnu_ton_rider` row in `boss_profiles.ron`.
(
    id: "gnu_ton_rider",
    name: "GNU-ton",
    max_hp: 42,
    phase1_to_transition_hp: 0.65,
    phase2_to_enrage_hp: 0.28,
    intro_seconds: 2.8,
    transition_seconds: 2.0,
    death_seconds: 3.0,
    music_intro: "standing_on_shoulders",
    music_phase1: "standing_on_shoulders",
    music_phase2: "standing_on_shoulders",
    music_enrage: "standing_on_shoulders",
)
