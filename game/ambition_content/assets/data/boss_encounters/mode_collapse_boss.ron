// Boss encounter spec — Mode Collapse (a floating summoner boss: a training
// failure that keeps generating the same output, flooding the arena with
// identical lesser copies).
//
// Behaviour (movement + attack schedule) lives in `assets/data/boss_profiles.ron`.
//
// Music: `crooked_ascent_boss` in every phase, wherever this boss is fought. It
// is a temporary fallback: the wanted track is a bespoke degenerating loop
// (Q148, docs/planning/game/bosses.md). A room can override it for the fights in that room with its LDtk level field
// `fight_music_track` (see docs/recipes/room-music.md).
(
    id: "mode_collapse_boss",
    name: "Mode Collapse",
    max_hp: 34,
    phase1_to_transition_hp: 0.6,
    phase2_to_enrage_hp: 0.25,
    intro_seconds: 2.6,
    transition_seconds: 2.0,
    death_seconds: 2.6,
    music_intro: "crooked_ascent_boss",
    music_phase1: "crooked_ascent_boss",
    music_phase2: "crooked_ascent_boss",
    music_enrage: "crooked_ascent_boss",
)
