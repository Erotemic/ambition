// Boss encounter spec — Wolfenstein, the boss of Castle Godwin in the Evil
// dimension: Frankenstein's monster with the head of a mad wolf, and the
// armband of the regime.
//
// Behaviour lives in `assets/data/boss_profiles.ron` (a pattern of the
// generic strikes: the claw sweep, the hammer slam, the howl).
//
// Music: his own adaptive cue, `galvanic_march`, bound to his phases in
// `assets/audio/music_cues.ron` (`boss_bindings`). No simple track per phase.
(
    id: "wolfenstein_boss",
    name: "Wolfenstein",
    // More health for a longer fight (Jon, 2026-10-18), in three acts: the
    // leash (phase 1), the unleashed wolf (phase 2), and from a third of his
    // health the serum (the enrage phase: he injects it and grows).
    max_hp: 110,
    phase1_to_transition_hp: 0.66,
    phase2_to_enrage_hp: 0.33,
    // The intro: dead on his throne, the coils wake him, he stands
    // (`ambition_content_modules::wolfenstein`, `INTRO_*`).
    intro_seconds: 4.6,
    transition_seconds: 1.8,
    music_intro: "",
    music_phase1: "",
    music_phase2: "",
    music_enrage: "",
)
