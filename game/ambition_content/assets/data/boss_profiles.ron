    // T-rex — a bipedal, GROUNDED, melee-centric boss (Jon canon: "a boss to
    // flex the player/boss unification with a bipedal character like the trex").
    // Deliberately the opposite of the aerial Flying Spaghetti Monster: it stays
    // on the floor and charges the player (macro Approach), then stomps / bites /
    // tail-sweeps (melee profiles FloorSlam / FullBodyPulse / SideSweep — all
    // contact-AABB, no projectiles), stressing the grounded shared-kinematic path.
    "trex_boss": (
        id: "trex_boss",
        reward_ability: Some("grapple"),
        signature_gauntlet: Some("shockwave"),
        combat_size: Some((140.0, 112.0)),
        movement: AnchorSway(
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 170.0,
        ),
        movement_phase2: Some(AnchorSway(
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 205.0,
        )),
        movement_enrage: Some(AnchorSway(
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 250.0,
        )),
        strike_speed_scale: 0.15,
        macro_tuning: (
            // Grounded charger: Approach runs at the player until it's in bite
            // range or blocked by a wall; Engage holds and stomps/bites.
            too_close_distance: 0.0,
            too_far_distance: 0.0,
            engage_distance: 0.0,
            approach_duration_s: 6.0,
            retreat_duration_s: 0.0,
            engage_max_duration_s: 0.0,
            front_wall_standoff: 56.0,
            idle_attack_chance_per_second: 0.6,
            hold_position_while_engaged: true,
            approach_speed_scale: 1.1,
            retreat_speed_scale: 1.0,
            retreat_distance: 0.0,
            suppress_attacks_while_moving: true,
        ),
        attacks: [
            Strike("floor_slam"),
            Strike("full_body_pulse"),
            Strike("side_sweep"),
            Special("seismic_stomp"),
        ],
        attack_cooldown: 1.0,
        attack_windup: 0.5,
        attack_active: 0.34,
        attack_damage: 2,
        body_damage: 2,
        attack_pattern: Scripted(
            intro: (steps: [
                Telegraph(profile: Strike("floor_slam"), duration: 1.3),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 1.0),
            ]),
            phase1: (steps: [
                // Stomp.
                Telegraph(profile: Strike("floor_slam"), duration: 1.1),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 1.3),
                // Bite.
                Telegraph(profile: Strike("full_body_pulse"), duration: 0.9),
                Strike(profile: Strike("full_body_pulse"), duration: 0.4),
                Rest(duration: 1.2),
                // Tail sweep.
                Telegraph(profile: Strike("side_sweep"), duration: 0.9),
                Strike(profile: Strike("side_sweep"), duration: 0.45),
                Rest(duration: 1.6),
            ]),
            transition: (steps: [Rest(duration: 2.2)]),
