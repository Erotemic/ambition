// Authored boss behavior profiles. Shape: `{ "<id>": BossBehaviorProfile }`.
// Bosses without a row use the generic fallback.
// `Cycle` rotates through `attacks` with flat durations; `Scripted` uses per-phase
// Telegraph/Strike/Rest timelines.
// `Strike("key")` selects body-mounted geometry; `Special("key")` dispatches a
// content-owned technique with no body geometry.
{
    // Clockwork Warden / Gradient Sentinel: scripted multi-phase profile.
    "clockwork_warden": (
        id: "clockwork_warden",
        sprite_target: Some("boss"),
        reward_ability: Some("markrecall"),
        // Combat size follows the visible body bbox rather than the full sprite frame.
        combat_size: Some((54.0, 56.0)),
        movement: AnchorSway(
            x_radius: 130.0,
            y_bob: 18.0,
            x_frequency: 0.72,
            y_frequency: 1.10,
            chase_scale: 0.18,
            chase_limit: 70.0,
            speed: 220.0,
        ),
        // Phase 2 swaps to a wide AirSwoop — boss reads as breaking
        // its anchor and flying across the arena.
        movement_phase2: Some(AirSwoop(
            x_radius: 360.0,
            y_radius: 110.0,
            x_frequency: 0.95,
            y_frequency: 0.72,
            chase_scale: 0.35,
            chase_limit: 220.0,
            speed: 320.0,
        )),
        // Enrage commits visually to chasing.
        movement_enrage: Some(AirSwoop(
            x_radius: 380.0,
            y_radius: 140.0,
            x_frequency: 1.35,
            y_frequency: 0.95,
            chase_scale: 0.55,
            chase_limit: 280.0,
            speed: 420.0,
        )),
        // Hold roughly steady while a special strike is live —
        // World-anchored hitboxes shouldn't drift mid-strike.
        strike_speed_scale: 0.20,
        macro_tuning: (
            too_close_distance: 110.0,
            too_far_distance: 480.0,
            engage_distance: 220.0,
            approach_duration_s: 3.2,
            retreat_duration_s: 2.4,
            engage_max_duration_s: 9.0,
            approach_speed_scale: 1.50,
            retreat_speed_scale: 0.80,
            retreat_distance: 280.0,
        ),
        // Scripted timing ignores `attacks`; the list remains the profile's diagnostic vocabulary.
        attacks: [
            Strike("floor_slam"),
            Strike("side_sweep"),
            Strike("full_body_pulse"),
            Strike("hazard_column"),
            Special("overfit_volley"),
            Special("minima_trap"),
            Special("saddle_point"),
            Special("gradient_cascade"),
        ],
        attack_cooldown: 1.35,
        attack_windup: 0.52,
        attack_active: 0.32,
        attack_damage: 2,
        body_damage: 1,
        attack_pattern: Scripted(
            // Single show-of-force beat to anchor the tone.
            intro: (steps: [
                Telegraph(profile: Strike("floor_slam"), duration: 1.4),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 1.2),
            ]),
            phase1: (steps: [
                // Beat 1: FloorSlam — familiar ground-pound.
                Telegraph(profile: Strike("floor_slam"), duration: 1.2),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 1.4),
                // Beat 2: HazardColumn — vertical hazard column.
                Telegraph(profile: Strike("hazard_column"), duration: 1.4),
                Strike(profile: Strike("hazard_column"), duration: 1.0),
                Rest(duration: 1.0),
                // Beat 3: MemorizedVolley — markers track player.
                Telegraph(profile: Special("overfit_volley"), duration: 1.4),
                Strike(profile: Special("overfit_volley"), duration: 0.30),
                Rest(duration: 1.5),
                // Beat 4: SideSweep — classic two-arm sweep.
                Telegraph(profile: Strike("side_sweep"), duration: 0.9),
                Strike(profile: Strike("side_sweep"), duration: 0.4),
                // Long breather closes the loop.
                Rest(duration: 2.0),
            ]),
            // Pure 3 s rest so the music swap has space.
            transition: (steps: [Rest(duration: 3.0)]),
            phase2: (steps: [
                // Beat 1: PitTrap — pit + puppy_slug spawn.
                Telegraph(profile: Special("minima_trap"), duration: 1.0),
                Strike(profile: Special("minima_trap"), duration: 0.6),
                Rest(duration: 1.4),
                // Beat 2: RotatingCross — rotating cross hazard.
                Telegraph(profile: Special("saddle_point"), duration: 1.4),
                Strike(profile: Special("saddle_point"), duration: 4.8),
                Rest(duration: 1.2),
                // Beat 3: MinionCascade — 2 slop minions (npc_ai_slop).
                Telegraph(profile: Special("gradient_cascade"), duration: 1.2),
                Strike(profile: Special("gradient_cascade"), duration: 0.4),
                Rest(duration: 2.4),
                // Beat 4: MemorizedVolley returns, faster.
                Telegraph(profile: Special("overfit_volley"), duration: 1.2),
                Strike(profile: Special("overfit_volley"), duration: 0.30),
                Rest(duration: 1.4),
                // Beat 5: FullBodyPulse — close-range pulse.
                Telegraph(profile: Strike("full_body_pulse"), duration: 1.1),
                Strike(profile: Strike("full_body_pulse"), duration: 0.5),
                Rest(duration: 1.0),
            ]),
            enrage: (steps: [
                // Tight PitTrap → MemorizedVolley combo.
                Telegraph(profile: Special("minima_trap"), duration: 0.7),
                Strike(profile: Special("minima_trap"), duration: 0.5),
                Telegraph(profile: Special("overfit_volley"), duration: 0.7),
                Strike(profile: Special("overfit_volley"), duration: 0.3),
                Rest(duration: 0.6),
                // Faster RotatingCross — shorter total exposure.
                Telegraph(profile: Special("saddle_point"), duration: 1.0),
                Strike(profile: Special("saddle_point"), duration: 3.0),
                // HazardColumn closer for the final punish.
                Telegraph(profile: Strike("hazard_column"), duration: 0.7),
                Strike(profile: Strike("hazard_column"), duration: 0.8),
                Rest(duration: 1.2),
            ]),
        ),
    ),
    // ============================================================
    // Mockingbird — airborne ship/bird-like boss. Cycle pattern,
    // no per-phase movement variants. Underdeveloped today; the
    // intent is a duel-style boss whose three attacks (WingSweep /
    // DiveLane / Broadside) chain via the flat cycle rhythm.
    // ============================================================
    "mockingbird": (
        id: "mockingbird",
        sprite_target: Some("mockingbird_boss"),
        signature_gauntlet: Some("volley"),
        combat_size: Some((500.0, 185.0)),
        movement: AirSwoop(
            x_radius: 250.0,
            y_radius: 62.0,
            x_frequency: 0.56,
            y_frequency: 1.35,
            chase_scale: 0.08,
            chase_limit: 95.0,
            speed: 320.0,
        ),
        movement_phase2: None,
        movement_enrage: None,
        strike_speed_scale: 1.0,
        // Macro tuning disabled — Mockingbird stays in Engage,
        // attacks via flat Cycle rhythm. All zeros / 1.0s.
        macro_tuning: (
            too_close_distance: 0.0,
            too_far_distance: 0.0,
            engage_distance: 0.0,
            approach_duration_s: 0.0,
            retreat_duration_s: 0.0,
            engage_max_duration_s: 0.0,
            approach_speed_scale: 1.0,
            retreat_speed_scale: 1.0,
            retreat_distance: 0.0,
        ),
        attacks: [
            Strike("wing_sweep"),
            Strike("dive_lane"),
            Strike("broadside"),
            // The mimic copies one shot across a cone aimed at you.
            Special("echo_fan"),
        ],
        attack_cooldown: 1.05,
        attack_windup: 0.44,
        attack_active: 0.28,
        attack_damage: 2,
        body_damage: 1,
        attack_pattern: Cycle,
        reward: DropChest(
            pickup: Custom("pirate_hoard"),
            offset: (0.0, 24.0),
            size: (56.0, 56.0),
        ),
    ),
    // ============================================================
    // GNU-ton RIDER — "Principia". The scholar is the boss (BossConfig +
    // encounter HP); he rides the `giant_gnu` MOUNT and CONDUCTS its two fists.
    // Every move is a `Special`: the brain decides WHAT he does, and
    // `ambition_content::bosses::gnu_ton::conductor` performs it with the fists
    // (see `choreography.rs` for the shapes). Each move is one of his laws,
    // demonstrated on the player, and each contains its own refutation:
    //   * demonstrate(_pair) — a fist hovers over you, tracks, locks, falls.
    //     A fist in the floor can be struck, and the blow lands on him.
    //   * pendulum — a fist on a string, released from high on one side, sweeping
    //     the floor where you stood. Double jump it, twice.
    //   * fluxions(_pair) — his signature: he DRAWS the curve in the air, then a
    //     fist traces it. It dips to the floor where you stood; stand where it
    //     is high.
    //   * cradle — Newton's cradle: the fists trade one impulse, clack by clack.
    //   * orbit — the fists orbit him like planets. Slip between them.
    //   * buck / stomp — the gnu's own answers: a buck throws whoever stands on
    //     its back (the way to reach him); a stomp sends a shock along the floor.
    //   * apple_rain — and after it, a golden apple finds his head: the long
    //     Rest that follows is him knocked off the gnu and dazed on the floor
    //     (the conductor performs it), the fight's big punish window.
    // Each key has ONE telegraph and ONE strike length, wherever it appears.
    "gnu_ton_rider": (
        bark_anchor: (dx_px: 0.0, dy_half_h: -1.0, dy_px: -18.0),
        id: "gnu_ton_rider",
        sprite_target: Some("gnu_ton_rider"),
        reward_ability: Some("fireball"),
        signature_gauntlet: Some("meteor"),
        // The scholar's own body: his sheet's authored body box at the sheet's
        // scale (39x52 px at 1.75).
        combat_size: Some((68.0, 91.0)),
        // ADR 0020: this boss RIDES a "giant"-class mount. `spawn_boss` attaches
        // the CanPilot tag from this list.
        pilotable_mount_classes: ["giant"],
        // Possess the scholar and your verbs conduct his fists.
        possessed_verbs: [
            ("attack", "demonstrate"),
            ("attack_down", "stomp"),
            ("attack_up", "pendulum"),
            ("special", "apple_rain"),
        ],
        movement: StationaryGiant(
            sway_amplitude: 0.0,
            sway_frequency: 0.0,
            speed: 0.0,
        ),
        movement_phase2: None,
        movement_enrage: None,
        strike_speed_scale: 1.0,
        self_dodge: None,
        macro_tuning: (
            too_close_distance: 0.0,
            too_far_distance: 0.0,
            engage_distance: 0.0,
            approach_duration_s: 0.0,
            retreat_duration_s: 0.0,
            engage_max_duration_s: 0.0,
            approach_speed_scale: 1.0,
            retreat_speed_scale: 1.0,
            retreat_distance: 0.0,
        ),
        attacks: [
            Special("demonstrate"),
            Special("demonstrate_pair"),
            Special("pendulum"),
            Special("fluxions"),
            Special("fluxions_pair"),
            Special("cradle"),
            Special("orbit"),
            Special("buck"),
            Special("stomp"),
            Special("apple_rain"),
        ],
        attack_cooldown: 0.0,
        attack_windup: 0.0,
        attack_active: 0.0,
        attack_damage: 2,
        // The scholar deals no contact damage: his fists are the threat.
        body_damage: 0,
        attack_pattern: Scripted(
            intro: (steps: [
                Rest(duration: 1.0),
                Telegraph(profile: Special("demonstrate"), duration: 1.0,
                    telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("demonstrate"), duration: 1.5),
                Rest(duration: 1.0),
            ]),
            // Phase 1 — "Lectures on Motion": one fist at a time.
            phase1: (steps: [
                Telegraph(profile: Special("demonstrate"), duration: 1.0,
                    telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("demonstrate"), duration: 1.5),
                Rest(duration: 0.8),
                Telegraph(profile: Special("pendulum"), duration: 0.9,
                    telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("pendulum"), duration: 2.4),
                Rest(duration: 0.8),
                Telegraph(profile: Special("demonstrate"), duration: 1.0,
                    telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("demonstrate"), duration: 1.5),
                Rest(duration: 0.8),
                Select(table: [
                    (weight: 1.0, when: Some(PlayerNear), steps: [
                        Telegraph(profile: Special("buck"), duration: 0.7,
                            telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("buck"), duration: 0.5),
                        Rest(duration: 0.8),
                    ]),
                    (weight: 1.0, when: Some(PlayerFar), steps: [
                        Telegraph(profile: Special("stomp"), duration: 0.8,
                            telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("stomp"), duration: 0.5),
                        Rest(duration: 0.8),
                    ]),
                ]),
                Telegraph(profile: Special("apple_rain"), duration: 1.0,
                    telegraph: Some((pose: Some("rest"), cue: Some("boss.gnu_ton.snort")))),
                Strike(profile: Special("apple_rain"), duration: 3.0),
                // Eureka: the golden apple, the tumble, the daze, the climb.
                Rest(duration: 3.5),
            ]),
            transition: (steps: [Rest(duration: 3.0)]),
            // Phase 2 — "Principia": both hands, and the curve he draws.
            phase2: (steps: [
                Telegraph(profile: Special("fluxions"), duration: 1.5,
                    telegraph: Some((pose: Some("spike_halo"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("fluxions"), duration: 1.4),
                Rest(duration: 0.8),
                Telegraph(profile: Special("demonstrate_pair"), duration: 1.0,
                    telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.stomp")))),
                Strike(profile: Special("demonstrate_pair"), duration: 2.0),
                Rest(duration: 0.8),
                Select(table: [
                    (weight: 1.0, when: Some(PlayerNear), steps: [
                        Telegraph(profile: Special("buck"), duration: 0.7,
                            telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("buck"), duration: 0.5),
                        Rest(duration: 0.6),
                    ]),
                    (weight: 1.0, when: Some(PlayerFar), steps: [
                        Telegraph(profile: Special("stomp"), duration: 0.8,
                            telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("stomp"), duration: 0.5),
                        Rest(duration: 0.6),
                    ]),
                ]),
                Telegraph(profile: Special("cradle"), duration: 1.0,
                    telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.stomp")))),
                Strike(profile: Special("cradle"), duration: 3.3),
                Rest(duration: 0.8),
                Telegraph(profile: Special("pendulum"), duration: 0.9,
                    telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.charge")))),
                Strike(profile: Special("pendulum"), duration: 2.4),
                Rest(duration: 0.6),
                Telegraph(profile: Special("apple_rain"), duration: 1.0,
                    telegraph: Some((pose: Some("rest"), cue: Some("boss.gnu_ton.snort")))),
                Strike(profile: Special("apple_rain"), duration: 3.0),
                Rest(duration: 3.5),
            ]),
            // Enrage — "The System of the World": the planets, and everything
            // at once.
            enrage: (steps: [
                Telegraph(profile: Special("orbit"), duration: 0.8,
                    telegraph: Some((pose: Some("spike_halo"), cue: Some("boss.gnu_ton.snort")))),
                Strike(profile: Special("orbit"), duration: 4.5),
                Rest(duration: 0.6),
                Telegraph(profile: Special("fluxions_pair"), duration: 1.5,
                    telegraph: Some((pose: Some("spike_halo"), cue: Some("boss.gnu_ton.stomp")))),
                Strike(profile: Special("fluxions_pair"), duration: 1.6),
                Rest(duration: 0.6),
                Select(table: [
                    (weight: 1.0, when: Some(PlayerNear), steps: [
                        Telegraph(profile: Special("buck"), duration: 0.7,
                            telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("buck"), duration: 0.5),
                        Rest(duration: 0.5),
                    ]),
                    (weight: 1.0, when: Some(PlayerFar), steps: [
                        Telegraph(profile: Special("stomp"), duration: 0.8,
                            telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.snort")))),
                        Strike(profile: Special("stomp"), duration: 0.5),
                        Rest(duration: 0.5),
                    ]),
                ]),
                Telegraph(profile: Special("demonstrate_pair"), duration: 1.0,
                    telegraph: Some((pose: Some("floor_slam"), cue: Some("boss.gnu_ton.stomp")))),
                Strike(profile: Special("demonstrate_pair"), duration: 2.0),
                Rest(duration: 0.6),
                Telegraph(profile: Special("cradle"), duration: 1.0,
                    telegraph: Some((pose: Some("side_sweep"), cue: Some("boss.gnu_ton.stomp")))),
                Strike(profile: Special("cradle"), duration: 3.3),
                Rest(duration: 0.6),
                Telegraph(profile: Special("apple_rain"), duration: 1.0,
                    telegraph: Some((pose: Some("rest"), cue: Some("boss.gnu_ton.snort")))),
                Strike(profile: Special("apple_rain"), duration: 3.0),
                Rest(duration: 3.5),
            ]),
        ),
        reward: DropChest(
            pickup: Custom("gnu_scroll"),
            offset: (0.0, 30.0),
            size: (52.0, 52.0),
        ),
    ),
    // ============================================================
    // Smirking Behemoth — "You Have To Cut The Rope" parody boss.
    //
    // The player cannot attrition this boss down. Player damage is
    // ignored in the cut-rope arena; the intended clear condition is
    // cutting the LDtk-authored rope above the boss so the anvil prop
    // drops onto its head.
    // ============================================================
    "smirking_behemoth_boss": (
        id: "smirking_behemoth_boss",
        signature_gauntlet: Some("beam"),
        // Environmental puzzle boss: ordinary slashes/projectiles never
        // damage it; the only kill condition is the LDtk-authored
        // rope/anvil trap (see ambition_content::bosses::cut_rope).
        environmental_kill_only: true,
        // Matches the generated Smirking Behemoth monolith body metrics:
        // x=0, y=22, w=208, h=266.  The bottom sits exactly on the sprite
        // frame floor so contact blocks morph-ball tunneling under the boss
        // without extending below the visible body into the room floor.
        combat_size: Some((208.0, 266.0)),
        movement: AnchorSway(
            // Smirking Behemoth's movement should be macro-driven:
            // Approach closes distance to the player, Engage holds
            // position and maybe fires the eye beam. Zeroing the sway
            // prevents the old spawn-anchor drift from looking like a
            // retreat after the boss has run in.
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 135.0,
        ),
        movement_phase2: Some(AnchorSway(
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 150.0,
        )),
        movement_enrage: Some(AnchorSway(
            x_radius: 0.0,
            y_bob: 0.0,
            x_frequency: 0.0,
            y_frequency: 0.0,
            chase_scale: 0.0,
            chase_limit: 0.0,
            speed: 165.0,
        )),
        strike_speed_scale: 0.20,
        macro_tuning: (
            // Contact boss: never retreat from the player just because
            // they are close. Approach moves toward the player until it
            // is either in body-contact range or blocked by a front wall;
            // Engage then holds position and probabilistically starts an
            // eye-beam after the minimum Rest beat.
            too_close_distance: 0.0,
            too_far_distance: 0.0,
            engage_distance: 0.0,
            approach_duration_s: 8.0,
            retreat_duration_s: 0.0,
            engage_max_duration_s: 0.0,
            front_wall_standoff: 48.0,
            idle_attack_chance_per_second: 0.55,
            hold_position_while_engaged: true,
            approach_speed_scale: 1.05,
            retreat_speed_scale: 1.0,
            retreat_distance: 0.0,
            suppress_attacks_while_moving: true,
        ),
        attacks: [
            Special("eye_beam"),
        ],
        attack_cooldown: 0.0,
        attack_windup: 0.0,
        attack_active: 0.0,
        attack_damage: 1,
        body_damage: 1,
        projectile_origin_offset: (0.0, -88.0),
        attack_pattern: Scripted(
            intro: (steps: [Rest(duration: 1.0)]),
            phase1: (steps: [
                Rest(duration: 1.4),
                Telegraph(profile: Special("eye_beam"), duration: 0.75),
                Strike(profile: Special("eye_beam"), duration: 0.25),
            ]),
            transition: (steps: [Rest(duration: 1.0)]),
            phase2: (steps: [
                Rest(duration: 1.2),
                Telegraph(profile: Special("eye_beam"), duration: 0.65),
                Strike(profile: Special("eye_beam"), duration: 0.25),
            ]),
            enrage: (steps: [
                Rest(duration: 0.95),
                Telegraph(profile: Special("eye_beam"), duration: 0.55),
                Strike(profile: Special("eye_beam"), duration: 0.22),
            ]),
        ),
    ),
    // Flying Spaghetti Monster — a false-god boss (canon: Jon). A floaty,
    // noodly-appendage monster. Composed ENTIRELY of reusable attack profiles
    // (no new hardcoded attack types): MemorizedVolley = meatball volley that
    // tracks the player, RotatingCross = rotating noodle cross, MinionCascade =
    // spawns lesser appendages (minions), FullBodyPulse / SideSweep = His Noodly
    // touch + appendage sweep. Sprite/animation fidelity + the Will-Smith finish
    // are follow-ups; this is the playable fight.
    "flying_spaghetti_monster_boss": (
        id: "flying_spaghetti_monster_boss",
        reward_ability: Some("blink"),
        combat_size: Some((168.0, 150.0)),
        movement: AirSwoop(
            x_radius: 190.0,
            y_radius: 70.0,
            x_frequency: 0.62,
            y_frequency: 1.15,
            chase_scale: 0.12,
            chase_limit: 110.0,
            speed: 240.0,
        ),
        movement_phase2: Some(AirSwoop(
            x_radius: 230.0,
            y_radius: 90.0,
            x_frequency: 0.9,
            y_frequency: 1.0,
            chase_scale: 0.26,
            chase_limit: 170.0,
            speed: 300.0,
        )),
        movement_enrage: Some(AirSwoop(
            x_radius: 260.0,
            y_radius: 110.0,
            x_frequency: 1.15,
            y_frequency: 1.1,
            chase_scale: 0.44,
            chase_limit: 230.0,
            speed: 360.0,
        )),
        strike_speed_scale: 0.30,
        macro_tuning: (
            too_close_distance: 0.0,
            too_far_distance: 0.0,
            engage_distance: 0.0,
            approach_duration_s: 0.0,
            retreat_duration_s: 0.0,
            engage_max_duration_s: 0.0,
            approach_speed_scale: 1.0,
            retreat_speed_scale: 1.0,
            retreat_distance: 0.0,
        ),
        attacks: [
            Special("overfit_volley"),
            Special("saddle_point"),
            Special("gradient_cascade"),
            Strike("full_body_pulse"),
            Strike("side_sweep"),
        ],
        attack_cooldown: 1.1,
        attack_windup: 0.5,
        attack_active: 0.32,
        attack_damage: 2,
        body_damage: 1,
        projectile_origin_offset: (0.0, -40.0),
        attack_pattern: Scripted(
            intro: (steps: [
                Telegraph(profile: Strike("full_body_pulse"), duration: 1.2),
                Strike(profile: Strike("full_body_pulse"), duration: 0.4),
                Rest(duration: 1.0),
            ]),
            phase1: (steps: [
                // Meatball volley tracks the player.
                Telegraph(profile: Special("overfit_volley"), duration: 1.3),
                Strike(profile: Special("overfit_volley"), duration: 0.32),
                Rest(duration: 1.3),
                // Appendage sweep.
