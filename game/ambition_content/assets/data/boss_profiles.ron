                Telegraph(profile: Strike("floor_slam"), duration: 0.9),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 0.9),
                // Seismic stomp — a floor shockwave rolls out both ways; jump it.
                Telegraph(profile: Special("seismic_stomp"), duration: 1.0),
                Strike(profile: Special("seismic_stomp"), duration: 0.4),
                Rest(duration: 1.1),
                Telegraph(profile: Strike("full_body_pulse"), duration: 0.8),
                Strike(profile: Strike("full_body_pulse"), duration: 0.4),
                Rest(duration: 0.8),
                Telegraph(profile: Strike("side_sweep"), duration: 0.8),
                Strike(profile: Strike("side_sweep"), duration: 0.45),
                Rest(duration: 1.2),
