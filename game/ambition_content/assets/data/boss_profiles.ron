                Strike(profile: Strike("full_body_pulse"), duration: 0.4),
                Telegraph(profile: Strike("floor_slam"), duration: 0.6),
                Strike(profile: Strike("floor_slam"), duration: 0.4),
                Rest(duration: 0.5),
                Telegraph(profile: Strike("side_sweep"), duration: 0.6),
                Strike(profile: Strike("side_sweep"), duration: 0.4),
                Rest(duration: 0.7),
            ]),
        ),
        reward: DropChest(
