// Boss SPRITESHEET layouts — content-authored sheet specs (C6).
//
// Top-level shape: `{ "<boss_key>": BossSheetSpec }`, parsed into a
// `BossCatalogFragment` for focused validation and assembled with the provider's
// other boss data into the App-local `BossCatalog`. This file is the only
// layout for these sheets. A boss whose key is absent here wears the provider's
// fallback sheet (`gradient_sentinel`).
//
// To re-author a boss's sheet layout, edit its row here. No Rust change.
// `boss_key` is the lowercased boss behavior id the renderer dispatches on.
// Rows are in PNG order. A row the sheet does not ship falls back to `Rest`
// through `BossSheetSpec::resolve_anim`.
{
    // idle->Rest, drift->DashEcho, noodle_whip->SideSweep,
    // meatball_volley->FloorSlam, eye_beam->SpikeHalo, hurt->Hit, death->Death.
    // The sheet also ships `pulse`, `dive`, `grasp` and `summon` AFTER these seven; the
    // fight's conductor pins them by name, so they need no `BossAnim`.
    //
    // It floats, so `body_centered`, and the generator puts the BELL'S CENTRE
    // at the frame's centre: the noodles hang into the lower half and the
    // lash reaches right, and the body, position and collision box coincide.
    // `collision_scale` sizes the frame so one sheet pixel is ~1.04 world
    // units: the 182 px bell draws ~190 wide, the width of `combat_size`.
    "flying_spaghetti_monster_boss": (
        label_width: 100,
        frame_width: 748,
        frame_height: 696,
        rows: [
            (Rest, (
                frame_count: 6,
                duration_secs: 0.132,
            )),
            (DashEcho, (
                frame_count: 8,
                duration_secs: 0.098,
            )),
            (SideSweep, (
                frame_count: 7,
                duration_secs: 0.086,
            )),
            (FloorSlam, (
                frame_count: 7,
                duration_secs: 0.088,
            )),
            (SpikeHalo, (
                frame_count: 7,
                duration_secs: 0.09,
            )),
            (Hit, (
                frame_count: 4,
                duration_secs: 0.096,
            )),
            (Death, (
                frame_count: 8,
                duration_secs: 0.112,
            )),
        ],
        collision_scale: 3.81,
        feet_anchor_y: 0.0,
        frame_sample_inset: 1,
        body_centered: true,
        authored_faces_left: false,
        // Its marinara: a reveal map per cell, drawn over it up to its damage
        // (`presentation::fsm_sauce`). Clean at full health, a splatter at the end.
        layers: ["sauce"],
    ),
    // ADR 0020 mount/rider split (G1): the giant GNU MOUNT, without the
    // scholar (840x680; the six rows a boss sheet reads by index, then
    // `buck` and `stomp` by name).
    "giant_gnu": (
        label_width: 0,
        frame_width: 840,
        frame_height: 680,
        rows: [
            (Rest, (
                frame_count: 10,
                duration_secs: 0.11,
            )),
            (FloorSlam, (
                frame_count: 10,
                duration_secs: 0.072,
            )),
            (SideSweep, (
                frame_count: 10,
                duration_secs: 0.065,
            )),
            (SpikeHalo, (
                frame_count: 9,
                duration_secs: 0.09,
            )),
            (Hit, (
                frame_count: 6,
                duration_secs: 0.08,
            )),
            (Death, (
                frame_count: 10,
                duration_secs: 0.105,
            )),
        ],
        collision_scale: 4.5,
        feet_anchor_y: 0.0034722222,
        frame_sample_inset: 1,
        body_centered: true,
        authored_faces_left: false,
    ),
    // GNU-ton, the scholar who rides the giant: the sheet `gnu_ton_scholar_boss`
    // (the rigged scholar; 248x262 frames). The frame is drawn 96 px of basis
    // (the arena's 54x96 BossSpawn) x 1.687 = 162 world units tall, so his
    // authored body (102x178 px) is 63x110: the size he had. His collision is
    // his authored body. Centred on his body: he sits in a saddle, not on a
    // floor.
    //
    // The fixed slots draw his closest rows (FloorSlam: point, SideSweep:
    // conduct, SpikeHalo: invoke). The conductor pins the named rows past them
    // (brace, tumble, dazed, climb) by name, and the duel pins the rows of his
    // fighter's moves (jab, attack_side, attack_up, attack_down,
    // smash_forward).
    "gnu_ton_rider": (
        label_width: 0,
        frame_width: 248,
        frame_height: 262,
        rows: [
            (Rest, (
                frame_count: 10,
                duration_secs: 0.11,
            )),
            (FloorSlam, (
                frame_count: 8,
                duration_secs: 0.07,
            )),
            (SideSweep, (
                frame_count: 10,
                duration_secs: 0.08,
            )),
            (SpikeHalo, (
                frame_count: 8,
                duration_secs: 0.08,
            )),
            (Hit, (
                frame_count: 6,
                duration_secs: 0.08,
