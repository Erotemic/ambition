// Boss SPRITESHEET layouts — content-authored sheet specs (C6).
//
// Top-level shape: `{ "<boss_key>": BossSheetSpec }`, parsed into a
// `BossCatalogFragment` for focused validation and assembled with the provider's
// other boss data into the App-local `BossCatalog`. This file is the only
// layout for these sheets. A boss whose key is absent here wears the provider's
// fallback sheet (`gradient_sentinel`).
//
// To re-author a boss's sheet layout, edit its row here. No Rust change.
// `boss_key` is the lowercased boss behavior id the renderer dispatches on.
// Rows are in PNG order. A row the sheet does not ship falls back to `Rest`
// through `BossSheetSpec::resolve_anim`.
{
    // idle->Rest, drift->DashEcho, noodle_whip->SideSweep,
    // meatball_volley->FloorSlam, eye_beam->SpikeHalo, hurt->Hit, death->Death.
    // It floats, so `body_centered`.
    "flying_spaghetti_monster_boss": (
        label_width: 100,
        frame_width: 393,
        frame_height: 344,
        rows: [
            (Rest, (
                frame_count: 6,
                duration_secs: 0.132,
            )),
            (DashEcho, (
                frame_count: 8,
                duration_secs: 0.098,
            )),
            (SideSweep, (
                frame_count: 7,
                duration_secs: 0.09,
            )),
            (FloorSlam, (
                frame_count: 7,
                duration_secs: 0.09,
            )),
            (SpikeHalo, (
                frame_count: 7,
                duration_secs: 0.09,
            )),
            (Hit, (
                frame_count: 4,
                duration_secs: 0.09,
            )),
            (Death, (
                frame_count: 8,
                duration_secs: 0.108,
            )),
        ],
        collision_scale: 1.8,
        feet_anchor_y: 0.0,
        frame_sample_inset: 1,
        body_centered: true,
        authored_faces_left: false,
    ),
    // ADR 0020 mount/rider split (G1): the giant GNU MOUNT, without the
    // scholar (768x576, 6 rows, collision_scale 4.5). The collision anchor is
    // the shoulder ridge where the rider sits.
    "giant_gnu": (
        label_width: 0,
        frame_width: 768,
        frame_height: 576,
        rows: [
            (Rest, (
                frame_count: 10,
                duration_secs: 0.11,
            )),
            (FloorSlam, (
                frame_count: 10,
                duration_secs: 0.072,
            )),
            (SideSweep, (
                frame_count: 10,
                duration_secs: 0.065,
            )),
            (SpikeHalo, (
                frame_count: 9,
                duration_secs: 0.09,
            )),
            (Hit, (
                frame_count: 6,
                duration_secs: 0.08,
            )),
            (Death, (
                frame_count: 10,
                duration_secs: 0.105,
            )),
        ],
        collision_scale: 4.5,
        feet_anchor_y: 0.0034722222,
        frame_sample_inset: 1,
        body_centered: true,
        authored_faces_left: false,
    ),
    // GNU-ton, the scholar who rides the giant: his own 96x96 sheet, cropped
    // around him. Drawn at 1.75 world units per pixel (96 px of basis height —
    // the arena's 54x96 BossSpawn — times 1.75), so his collision is his
    // authored body (39x52 px → 68x91) and he reads as a person on a giant, not
    // a speck. Centred on his body: he sits in a saddle, not on a floor.
    "gnu_ton_rider": (
        label_width: 0,
        frame_width: 96,
        frame_height: 96,
        rows: [
            (Rest, (
                frame_count: 10,
                duration_secs: 0.11,
            )),
            (FloorSlam, (
                frame_count: 10,
                duration_secs: 0.072,
            )),
            (SideSweep, (
                frame_count: 10,
                duration_secs: 0.065,
