    // The Hunny Horror wears his character's sheet (`hunny_horror_boss`):
    // idle->Rest, walk->DashEcho, slash->SideSweep, punch->FloorSlam,
    // special->FloorSlam, taunt->SpikeHalo, hurt->Hit, death->Death. The sheet
    // ships his fight's rows after these (hug, squeeze, throw, spit, run, flop,
    // stunned); his conductor draws them by name, so they need no `BossAnim`.
    //
    // `collision_scale` draws the 212 px frame 234 world units tall over his
    // 180-unit body (1.104 world units a pixel): standing, he is about 190
    // units to the tips of his ears.
    "hunny_horror_boss": (
        label_width: 100,
        frame_width: 288,
        frame_height: 212,
        rows: [
