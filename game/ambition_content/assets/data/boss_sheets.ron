            (Hit, (
                frame_count: 5,
                duration_secs: 0.09,
            )),
            (Death, (
                frame_count: 8,
                duration_secs: 0.11,
            )),
        ],
        collision_scale: 1.6,
        feet_anchor_y: -0.336,
        frame_sample_inset: 1,
        body_centered: false,
        authored_faces_left: false,
    ),
    // rest->Rest, thrust->DashEcho, bite->FloorSlam, slash->SpikeHalo (the
    // fireball tell), hit, death. The SVG-rigged redesign
    // (`mockingbird_boss_v2`, 2026-10-06), drawn facing RIGHT; the first
    // design (`mockingbird_boss/`, drawn facing left) stays published as its
    // lineage. The sheet publishes its body box, so it is drawn by the boss
    // placement law; `collision_scale` keeps the body about as wide on screen
    // as the first design's.
    "mockingbird": (
        label_width: 118,
        frame_width: 551,
        frame_height: 368,
        rows: [
