            standing_height: Some(46.8),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["hub", "faction_leader"],
        barks: (
            on_hit: ["Oi! That's my good arm.", "Fretjaw bites back!", "Cantina rules: no free hits!"],
            provoked: ["Cantina brawl!"],
            hall: ["Fretjaw's stew has a secret ingredient. The secret is you don't ask.", "House rule: the house wins. Fretjaw is the house."],
