        hall_dialogue_id: Some("hall_npc_flying_spaghetti_monster_boss"),
        ),
        // ===== Noodling: the Flying Spaghetti Monster's lesser appendage. The
        // god's `lesser_appendages` summons a pair once it is wounded: a small
        // bell with one meatball that swims at you and bites. Floating, so the
        // Aerial policy flies it; two blows end it.
        "npc_fsm_noodling": (
            display_name: "Noodling",
            manifest: "sprites/fsm_noodling_spritesheet.ron",
            tier: Basement,
