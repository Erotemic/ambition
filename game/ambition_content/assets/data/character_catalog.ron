        "npc_raptor_stalker": (
            display_name: "Raptor Stalker",
            manifest: "sprites/raptor_stalker_spritesheet.ron",
            tier: Basement,
            body_kind: Wide,
            // Its MEASURED height under the ONE spawn box every level places it
            // with, authored 2026-08-28 (D129). This row had no default, so its
            // size came out of `ldtk_box x collision_scale / FRAME_H` — a level
            // rectangle and the sheet's publishing padding, neither of which is a
            // claim about how tall anybody is. Same output today; the point is
            // that changing it is now one number.
            standing_height: Some(75.8),
            composition: None,
            default_action_set: "striker_swipe",
            // THE BODY, stated, so the row is a buildable character: the
            // T-rex's call SUMMONS raptors by this id, and a summon refuses a
            // character the cast cannot build (`preflight_planned_bodies`).
            // A raptor is a sprinter.
            locomotion: Some((run_speed: 230.0, move_style: Walk)),
            // THE WAY IT HUNTS, stated. With none, a body is lowered with the
            // default profile, whose aggro radius is 0: it notices nobody and
            // stood where the call left it (Jon, 2026-10-06). A pack hunter:
            // it notices across the hall and runs you down at full stride.
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 700.0,
                attack_range: 44.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                // Temperament (Jon 2026-10-30: "notice, space, telegraph, attack"): a
                // pouncer. It backs well off after each strike, then comes in at a
                // run and pounces from about 200 px (its running attack,
                // `movesets/raptor_stalker.ron`); caught up close, it bites. No
                // footsies: holding in a band would slow it out of its run.
                retreat_after_swing_s: 0.8,
                tactics: (notice_s: 0.45, lurk_px: 80.0, waits_its_turn: true, flinch_back_s: 0.2),
            )),
            max_health: Some(4),
            tags: ["enemy", "large"],
            cues: (notice: Some("enemy.raptor.notice"), tell: Some("enemy.raptor.tell"), swing: Some("enemy.raptor.swing"), hit: Some("enemy.raptor.hit")),
        barks: (
            on_hit: ["SHREEE!", "BITE.", "Pack closing!"],
            provoked: ["The hunt is on."],
            hall: ["Tick. Tick. That's not a clock. That's me, counting.", "Clever girl. ...You'll do."],
        ),
        hall_dialogue_id: Some("hall_npc_raptor_stalker"),
        ),
        // npc_robot_heavy intentionally removed: the renderer's
