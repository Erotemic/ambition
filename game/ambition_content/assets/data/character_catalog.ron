        "penguin_slap": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.22, active_s: 0.08, recover_s: 0.32, damage: 1, reach_px: 30.0)),
        ),
        // Willson's bill: the front wheel comes up, and the bill comes down
        // with it. Slow to start and long in the reach.
        "willson_peck": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.30, active_s: 0.12, recover_s: 0.34, damage: 2, reach_px: 58.0)),
