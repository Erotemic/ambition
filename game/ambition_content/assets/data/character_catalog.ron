        // on the goblin's skeleton and moves; `smash_skin` lets Smash offer it.
        "goblin_squat": (
            sprite_tuning: Some((collision_scale: 2.1, frame_sample_inset: 1)),
            display_name: "Goblin (Squat)",
            manifest: "sprites/goblin_squat_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
