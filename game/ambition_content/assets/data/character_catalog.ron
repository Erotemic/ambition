            contact_damage: Some((strength: 0.5, amount: 1)),
            death_traits: Some((
                corpse: Some(Vanish),
                bursts_into: Some((visual: "spectral_wolf_wisp", count: 4, speed: 300.0, damage: 1, half_extent: (22.0, 14.0), life_s: 3.0)),
            )),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 820.0,
                attack_range: 56.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                shares_sightings: true,
                retreat_after_swing_s: 0.6,
                navigates: true,
                tactics: (flinch_back_s: 0.35, fades: true),
            )),
            max_health: Some(4),
            tags: ["enemy", "evil", "animal", "wolf", "quadruped", "spirit"],
        barks: (
            on_hit: ["*a hollow yelp*", "Hhhhh."],
            idle: ["*a howl from nowhere*", "*breath, and no wolf*"],
            hall: ["*it is there, and then it is not*", "AWOOO. (The leash is gone.)"],
        ),
        hall_dialogue_id: Some("hall_npc_evil_spectral_wolf"),
        ),
        // The Risen Conscript: a dead soldier of the regime, raised in the
        // castle lab. The first and the easiest enemy of Castle Godwin (Jon,
