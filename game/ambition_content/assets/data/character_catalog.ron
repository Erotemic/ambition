            barks: (
                idle: ["The General will see you.", "It is always the hour."],
                hall: ["I keep the General's diary. It has one entry a day: 'Inspected the medals.'", "Adjutant means I am the one who knows where everything is."],
            ),
        ),
        "npc_eureka_teodora": (
            display_name: "Teodora",
            // The space elevator's lift operator at the ground station.
            manifest: "sprites/eureka_teodora_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Car up at the hour. Car down at the half. Gravity permitting.", "Mind the gap. It is thirty-six thousand kilometres."],
                hall: ["I run the elevator. Up to the station, down to dinner.", "The timetable is not a suggestion. Tell the Patent Clerk that."],
            ),
        ),
        "npc_eureka_priya": (
            display_name: "Priya",
            // A graduate student who has not slept since her experiment started.
            manifest: "sprites/eureka_priya_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(61.9),
