            on_hit: ["Asset's fighting back.", "Add it to the incident log.", "Containment breach!"],
            provoked: ["Authorization granted — force authorized!"],
            hall: ["Perimeter holding. Perimeter is me, standing here.", "Old habit: secure the room. New problem: the room's already fine."],
        ),
        hall_dialogue_id: Some("hall_npc_raid_enforcer"),
        ),
        "npc_flying_spaghetti_monster_boss": (
