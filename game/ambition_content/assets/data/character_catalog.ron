            tags: ["boss", "placeholder_brain"],
        barks: (
            on_hit: ["Ramen!", "TOUCHED BY HIS NOODLY APPENDAGE — no wait, that was me touching you.", "The sauce thickens!"],
            provoked: ["Marinara mode: engaged!"],
            idle: ["Pasta la vista.", "I have created you all with my noodly appendages.", "The sauce of creation is bottomless."],
            hall: ["You've been touched by My noodly appendage. No refunds.", "Touch the marinara and you're clergy now. Congratulations, I suppose."],
        ),
        hall_dialogue_id: Some("hall_npc_flying_spaghetti_monster_boss"),
        ),
        "npc_galwah": (
            display_name: "Galwah",
            spritesheet: "sprites/galwah_spritesheet.png",
            manifest: "sprites/galwah_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["hub", "peaceful"],
        barks: (
            on_hit: ["Galwah does not appreciate this.", "Bold move.", "You'll regret that, friend."],
            provoked: ["Galwah is DONE being nice!"],
            idle: ["The days here have a pleasant sameness.", "I wonder what lies beyond the loading zone.", "Galwah waits. Galwah is patient."],
            hall: ["Some equations no formula can ever unlock. I proved which.", "I write fast. I have always written against the dawn."],
        ),
        hall_dialogue_id: Some("hall_npc_galwah"),
        ),
        "npc_general_hero": (
            display_name: "General Hero",
            spritesheet: "sprites/general_hero_spritesheet.png",
            manifest: "sprites/general_hero_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["hub", "peaceful"],
        barks: (
            on_hit: ["This changes nothing!", "I've bled for worse causes!", "Courage costs!"],
            provoked: ["CHARGE!"],
            idle: ["A hero's work is never done.", "Stand ready. Always.", "The enemy doesn't announce itself."],
            hall: ["Standing ready looks a lot like standing around. It isn't.", "The medals weigh what they cost. Roughly."],
        ),
        hall_dialogue_id: Some("hall_npc_general_hero"),
        ),
        "npc_ghoul_skulker": (
            display_name: "Ghoul Skulker",
            spritesheet: "sprites/ghoul_skulker_spritesheet.png",
            manifest: "sprites/ghoul_skulker_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["enemy"],
        barks: (
            on_hit: ["Yeeaaargh!", "This flesh already hurts!", "STOP HITTING THE GHOUL."],
            provoked: ["Skulking intensifies!"],
            hall: ["Being dead is mostly a posture problem.", "Held together by spite and good intentions. Mostly spite."],
        ),
        hall_dialogue_id: Some("hall_npc_ghoul_skulker"),
        ),
        "npc_girdle": (
            display_name: "Girdle",
            spritesheet: "sprites/girdle_spritesheet.png",
            manifest: "sprites/girdle_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["hub", "peaceful"],
        barks: (
            on_hit: ["That hurts!", "Do you mind?", "Uncalled for!"],
            provoked: ["I am done being pleasant!"],
            idle: ["I hold things together around here.", "Structure is underappreciated.", "Nobody asks how I'm doing."],
            hall: ["Every sound system hides a truth it can't reach. I checked yours.", "Is the food safe? Is the logic? I worry about both."],
        ),
        hall_dialogue_id: Some("hall_npc_girdle"),
        ),
        "npc_gnu_ton_boss": (
            display_name: "Gnu Ton Boss",
            spritesheet: "sprites/gnu_ton_boss/gnu_ton_boss_spritesheet.png",
            manifest: "sprites/gnu_ton_boss/gnu_ton_boss_spritesheet.ron",
            tier: Basement,
            body_kind: Wide,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["boss", "placeholder_brain"],
        barks: (
            on_hit: ["Counterfeit.", "You ring false.", "Assayed. Found wanting.", "Your defiance has mass.", "Pain is data.", "Impact is merely mathematics becoming honest.", "The hypothesis has failed. Begin dissection.", "Your continued existence is statistically irritating.", "I tire of imprecision."],
            idle: ["Fall. I have already solved for where.", "The universe is not cruel. It is exact.", "I have split the sun. I can divide you.", "I know false weight when it breathes.", "Your motion was inevitable.", "I require no prophecy to know your end.", "Do not resist the law. You are made of it.", "I have measured the heavens. You are a rounding error.", "Every body attracts every other. Unfortunately for you, I am very large.", "You are not escaping. You are tracing a curve.", "Be still. I am observing.", "Hold steady. The experiment requires repetition.", "The prism does not lie. It only reveals the lie.", "Your shadow has an angle. Your death has a proof.", "Lead dreams of gold. Flesh dreams of dust.", "The furnace corrects all impurities.", "Mercury remembers the shape of every sin.", "Be transmuted.", "The world is a crucible, and you are not the gold.", "Impurity is just matter confessing.", "History is a cipher. You are a solved term.", "The end is not near. It is numbered.", "I do not predict. I calculate.", "Even apocalypse obeys arithmetic.", "God wrote in number. I learned to read.", "Creation is not chaos. It is a ledger.", "You mistake mystery for permission.", "The stars keep their stations. Learn from them.", "You are light coin.", "Clipped, debased, and due for hanging.", "Bring the scales.", "The stamp shall reveal your value.", "I have sent better men to the gallows for less.", "Fraud always leaves a shaving.", "Enough observation. Now comes proof.", "You have survived the question. Face the answer.", "Let us remove the remaining variables.", "No more approximations.", "Let the heavens fall inward.", "Now every law acts at once.", "The calculation accelerates.", "Your margin of error is closed.", "The proof concludes."],
            hall: ["You're falling toward me right now. Too slowly to be polite about it.", "An apple taught me everything. The apple asked for nothing."],
        ),
        hall_dialogue_id: Some("hall_npc_gnu_ton_boss"),
        ),
        // Sandbox kiter enemy (the ranged-skirmisher archetype). The spawn's
        // display name is "Skirmisher", which is how the renderer resolves it.
        // Sandbox kamikaze mite (the exploding-mite archetype); spawn name "Exploding Mite".
        "npc_exploding_mite": (
            display_name: "Exploding Mite",
            spritesheet: "sprites/exploding_mite_spritesheet.png",
            manifest: "sprites/exploding_mite_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors a
            // policy, and the preset it used to name carried `aggressiveness:
            // 1.0` — which is HOSTILITY, and hostility is what an `EnemySpawn`
            // placement already means.  the parrot's case was the opposite and
            // that is why this is safe: `0.0` SUPPRESSED hostility, so dropping
            // it changed a body; `1.0` restates a default, so dropping it does
            // not. Probed on the goblin first, whole suite green, then applied.
            default_action_set: "striker_swipe",
            tags: ["enemy", "robot"],
        barks: (
            on_hit: ["I EXPLODE FOR THE CAUSE!", "PROXIMITY BREACH!", "FUSE LIT — WAIT, NOT YET—"],
            provoked: ["FINAL PROTOCOL!"],
            hall: ["I am CONTAINING. Loudly. Internally. Please don't startle me.", "The radius is bigger than you'd think. Just so you know."],
        ),
        hall_dialogue_id: Some("hall_npc_exploding_mite"),
        ),
        // Sandbox splitter mite (the dividing-mite archetype); spawn name "Dividing Mite".
        "npc_dividing_mite": (
            display_name: "Dividing Mite",
            spritesheet: "sprites/dividing_mite_spritesheet.png",
            manifest: "sprites/dividing_mite_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors a
            // policy, and the preset it used to name carried `aggressiveness:
            // 1.0` — which is HOSTILITY, and hostility is what an `EnemySpawn`
            // placement already means.  the parrot's case was the opposite and
            // that is why this is safe: `0.0` SUPPRESSED hostility, so dropping
            // it changed a body; `1.0` restates a default, so dropping it does
            // not. Probed on the goblin first, whole suite green, then applied.
            default_action_set: "striker_swipe",
            tags: ["enemy", "robot"],
        barks: (
            on_hit: ["Division initiated!", "Mitosis under stress!", "Splitting... headache!"],
            provoked: ["We are multiplying!"],
            hall: ["One of me. For now. Math is patient about that.", "Don't cut me. The paperwork doubles instantly."],
        ),
        hall_dialogue_id: Some("hall_npc_dividing_mite"),
        ),
        "npc_hand_saint": (
