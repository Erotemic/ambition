            provoked: ["Galwah is DONE being nice!"],
            idle: ["The days here have a pleasant sameness.", "I wonder what lies beyond the loading zone.", "Galwah waits. Galwah is patient."],
            hall: ["Some equations no formula can ever unlock. I proved which.", "I write fast. I have always written against the dawn."],
        ),
        hall_dialogue_id: Some("hall_npc_galwah"),
        ),
        "npc_general_hero": (
            display_name: "General Hero",
            // The knight who came back, redrawn 2026-10-23 (`general_hero_v2`);
