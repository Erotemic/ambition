            abilities: Some([Walk, Jump, Attack]),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 820.0,
                attack_range: 52.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                shares_sightings: true,
