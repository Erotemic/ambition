            tags: ["boss", "placeholder_brain"],
        barks: (
            on_hit: ["Structural integrity notification.", "Repair ticket filed.", "That voided the smart warranty."],
            provoked: ["Security mode: maximum!"],
            idle: ["The thermostat disagrees but the thermostat is wrong.", "All sensors nominal. Your presence is anomalous.", "The refrigerator knows."],
            hall: ["Climate optimal. Lighting tolerable. You: logged.", "I dimmed the lights you like before you knew you liked them."],
        ),
