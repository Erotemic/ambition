            autonomous_profile: Some((
                template: Aerial,
                aggro_radius: 480.0,
                attack_range: 120.0,
                shares_sightings: false,
                tactics: (dive_tell_s: 0.5, notice_s: 0.4),
            )),
            max_health: Some(2),
            tags: ["enemy", "history", "monsoon", "gold"],
        barks: (
            on_hit: ["Pssssss!", "I just lost ten percent!"],
            provoked: ["I am worth MORE than you! For now!"],
            idle: ["*it puffs up*", "*it checks its own value. It is lower.*", "Shiny."],
            hall: ["Mansa Musa came through Cairo in 1324 and gave gold to everybody. Then everybody had gold, and gold was worth less for twelve years. I was there. I was worth a camel. Then half a camel.", "Bigger is not the same as more valuable. I learned this by getting bigger."],
