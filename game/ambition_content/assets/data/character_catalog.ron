            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["mathematician", "problem_runner", "collaborative", "peaceful"],
        barks: (
            idle: ["I reduced the impossible problem to six merely rude ones.", "Someone else may already know the lemma I am missing."],
            hall: ["One full turn is tau. The circle has filed a correction.", "Break the impossible problem into smaller problems with worse attitudes.", "A proof is a multiplayer level with unusually strict collision.", "I do not know the answer yet. Excellent."],
        ),
        hall_dialogue_id: Some("hall_npc_pipi_tau"),
        ),
        "npc_jeff_hinter": (
            display_name: "Jeff Hinter",
            spritesheet: "sprites/jeff_hinter_spritesheet.png",
