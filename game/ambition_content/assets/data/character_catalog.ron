            mass: Some(2.5),
            tags: ["enemy", "history", "lapita_voyagers", "crab"],
        barks: (
            on_hit: ["Clack! Not the good claw!", "*it backs off sideways, offended*"],
            provoked: ["*it lifts the big claw: the one that opens coconuts*"],
            idle: ["*clack*", "*it drags a coconut across the sand, slowly*", "*it climbs a palm, just to look*"],
            hall: ["I was a hermit crab once, in a borrowed shell. Then I grew, and no shell fit. Now I am the biggest crab on land, and I borrow nothing.", "They call me the robber crab: I take shiny things from the camp. A spoon, a pot, once a whole kettle. The potters here keep a close eye on me."],
        ),
        ),
        // The frigatebird: the great frigatebird of the open ocean, black, with
        // long crooked wings, a forked tail and a red throat pouch puffed up.
        // It glides; it lifts its wings high (its windup row) and swoops at
        // you hooked bill first. It has no shot: a floater that strikes in
        // melee swoops, so it is `Aerial`.
        "frigatebird": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Frigatebird",
