            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Day four. The data is beautiful. I am not.", "If the run fails I am moving to Math Town."],
                hall: ["My experiment runs until it ends. So do I.", "Coffee is a reagent. Mina disagrees."],
            ),
        ),
        "npc_eureka_dmitri": (
            display_name: "Dmitri",
            // The institute's lab technician: whatever broke, he has fixed it before.
            manifest: "sprites/eureka_dmitri_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 184 cm.
            standing_height: Some(71.2),
