            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Who touched the centrifuge.", "Duct tape is a structural material if you believe in it."],
                hall: ["Professors break it. Students break it worse. I fix it.", "The coil lab blew a fuse again. Third time this week."],
            ),
        ),
        "npc_eureka_wilbur": (
            display_name: "Wilbur",
            // The quad's porter and groundskeeper, a town pigeon who sweeps up after the other pigeons.
            manifest: "sprites/eureka_wilbur_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "pigeon", "peaceful"],
            barks: (
                idle: ["Shoo. Not you. Them.", "Forty years on this quad. Never once fed the birds."],
                hall: ["I keep the quad. The quad does not keep itself, whatever the physicists say.", "Entropy, they call it. I call it Tuesday."],
            ),
        ),
        "npc_eureka_halvorsen": (
            display_name: "Professor Halvorsen",
            // A visiting professor with a grievance about the reviewers of his paper.
            manifest: "sprites/eureka_halvorsen_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "professor", "peaceful"],
            barks: (
                idle: ["Reviewer two again. I know it is him.", "'Minor revisions.' Minor!"],
                hall: ["I came up the gate to give one lecture. I am still here, revising.", "Peer review is a contact sport played by people who never touch anything."],
            ),
        ),
        "npc_eureka_mina": (
            display_name: "Mina",
            // Keeps the cafe on the quad and knows which department owes her money.
            manifest: "sprites/eureka_mina_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 164 cm.
            standing_height: Some(63.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Physics owes me eleven coffees. Chemistry pays in cash.", "Soup today. It is always soup when the elevator is late."],
                hall: ["Everybody on this campus runs on my coffee. Nobody tips.", "The station orders pastries by elevator. They arrive cold and complaining."],
            ),
        ),
        "npc_eureka_quark": (
            display_name: "Dr. Ilse Quark",
            // Runs the Eureka Collider under the lecture hall.
            manifest: "sprites/eureka_quark_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 164 cm.
            standing_height: Some(63.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Helmet's optional. Curiosity isn't.", "Do not lick the pipe."],
                hall: ["The most expensive way anyone has ever found to break something to see what's in it.", "The beam goes round eleven thousand times a second. I go round once before lunch."],
            ),
        ),
        "npc_eureka_hum": (
            display_name: "Ottoline Hum",
            // Busks on a theremin under the gate court's arcade.
            manifest: "sprites/eureka_hum_spritesheet.ron",
