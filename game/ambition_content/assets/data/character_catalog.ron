            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Mind the antenna.", "Breathe wrong and you're a semitone flat."],
                hall: ["You play the air between your hand and the antenna.", "I've got a case of currencies from forty dimensions. One of them is technically a button."],
            ),
        ),
        "npc_eureka_pryce": (
            display_name: "Range Officer Pryce",
            // The Test Range's officer, who has signed off every test as probably fine.
            manifest: "sprites/eureka_pryce_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.7),
