        ),
        // The hoplite: a Greek citizen soldier behind a round bronze shield. He
        // lifts the shield to his eyes when he sees you (its notice row), holds
        // just out of reach, and thrusts over its rim. The shield is drawn, not
        // yet a `guards` part: his sheet publishes no part flipbook.
        "hoplite": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Hoplite",
            manifest: "sprites/hoplite_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(64.0),
            composition: None,
            default_action_set: "hoplite_thrust",
            locomotion: Some((run_speed: 120.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 520.0,
                attack_range: 66.0,
                patrol_effort: 0.4,
                chase_effort: 0.8,
                // The wall: a spear's length away, shield up, then one thrust.
                attack_cooldown_s: 1.0,
                tactics: (notice_s: 0.5, waits_its_turn: true, footsies: Some((hold_px: 96.0, wait_s: 0.9))),
            )),
            max_health: Some(6),
            mass: Some(3.0),
            tags: ["enemy", "history", "classical", "soldier"],
        barks: (
            on_hit: ["Clang! The shield holds.", "Molon labe. Come and take it. Ow."],
            provoked: ["Shields up! Phalanx!"],
            idle: ["Hold the line.", "*the crest bobs*", "Come back with your shield, or on it. That was my mother's advice."],
            hall: ["A phalanx is only as strong as the shield of the man on your left. I am the man on the left. There is nobody on mine.", "Three hundred of us at Thermopylae. And a few thousand allies. Nobody ever remembers the allies."],
        ),
        ),
        // The Immortal: a Persian royal guard in a robe of saffron and lapis,
        // with a wicker shield and a spear with a silver pomegranate at its
        // butt. They come in numbers and call out to each other: when one
        // falls, another steps up (its death row).
        "immortal": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Immortal",
            manifest: "sprites/immortal_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(64.0),
            composition: None,
            default_action_set: "immortal_thrust",
            locomotion: Some((run_speed: 130.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 520.0,
                attack_range: 60.0,
                patrol_effort: 0.5,
                chase_effort: 0.9,
                attack_cooldown_s: 0.8,
                shares_sightings: true,
                tactics: (notice_s: 0.4, waits_its_turn: true, footsies: Some((hold_px: 84.0, wait_s: 0.6))),
            )),
            max_health: Some(4),
            mass: Some(2.0),
            tags: ["enemy", "history", "classical", "soldier"],
        barks: (
            on_hit: ["Next!", "There are ten thousand of us. Well. Nine thousand, nine hundred and ninety-nine."],
            provoked: ["For the Great King!"],
            idle: ["*he stands to attention*", "Ten thousand. Always ten thousand.", "We are called the Immortals. The name is doing a lot of work."],
            hall: ["When one of us falls, another steps up, and the count never changes. Herodotus wrote that down, so it must be true.", "The silver pomegranate on my spear is not for eating. I asked."],
        ),
        ),
        // The vandal: a barbarian of the Fall of Rome with a horned helmet, a
        // pot of black paint and a brush. Quick and cheeky: in, one swipe that
        // paints a moustache on you, and out again.
        "vandal": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Vandal",
            manifest: "sprites/vandal_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(60.0),
            composition: None,
            default_action_set: "vandal_daub",
            locomotion: Some((run_speed: 230.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 480.0,
                attack_range: 40.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                // A daub and away before you can wipe it off.
                retreat_after_swing_s: 0.45,
                attack_cooldown_s: 0.45,
                tactics: (notice_s: 0.3, waits_its_turn: true, footsies: Some((hold_px: 60.0, wait_s: 0.4)), flinch_back_s: 0.3),
            )),
            max_health: Some(2),
            tags: ["enemy", "history", "classical", "barbarian"],
        barks: (
            on_hit: ["Oi! Wet paint!", "You smudged my masterpiece!"],
            provoked: ["That face needs a moustache!"],
            idle: ["*he dips his brush*", "Very nice statue. Needs a moustache.", "We sacked Rome in 455. Mostly we sacked it of its dignity."],
            hall: ["They named vandalism after us. We only borrowed things. For fourteen days. Without asking.", "Every emperor in this town has a moustache now. You are welcome."],
        ),
        ),

        // The terracotta warrior: a clay soldier of the first emperor's army,
        // cracked and slow. He lifts his halberd over his head (its windup
        // row) and chops it into the ground in front of him; he falls apart
        // into shards at his death.
        "terracotta_warrior": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Terracotta Warrior",
            manifest: "sprites/terracotta_warrior_spritesheet.ron",
            tier: MainHall,
