        // 2026-11-09: "NPCs should generally be able to attack when they
        // become aggressive or hostile").
        "bare_hands": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.30, active_s: 0.08, recover_s: 0.36, damage: 1, reach_px: 30.0)),
