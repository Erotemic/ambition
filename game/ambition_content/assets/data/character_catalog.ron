        barks: (
            on_hit: ["Yip!", "Grrr. Noted."],
            provoked: ["*a low growl*"],
            idle: ["*it sniffs the wind*", "*its ears turn*", "Owoooo."],
            hall: ["The old story says the first Mongol was born of a blue-grey wolf and a fallow doe. I am the wolf. You may bow.", "A whole people with a wolf for an ancestor, and still they keep sheep. I take it personally."],
        ),
        ),

        // The inflated coin: a gold coin that blows itself up, and is worth less
        // each time. It floats, blows up as big as it can go (its windup row),
        // and rushes at you spinning. It has no shot, so it is `Aerial`.
        "inflated_coin": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Inflated Coin",
