                attack_cooldown_s: 0.45,
                tactics: (notice_s: 0.35, waits_its_turn: true, footsies: Some((hold_px: 60.0, wait_s: 0.5)), flinch_back_s: 0.3),
            )),
            max_health: Some(2),
            tags: ["enemy", "history", "monsoon", "sea"],
        barks: (
            on_hit: ["Not the reef!", "Clack! Clack!"],
            provoked: ["*it lifts both claws*"],
            idle: ["*clack clack*", "*it walks sideways, then sideways again*"],
            hall: ["On this coast they build their houses of coral stone. I built mine of coral too. Mine walks.", "Everybody goes forward. I go to the side. We all get to the same beach."],
        ),
        ),
        // The monsoon squall: a small, cross storm cloud. It floats, keeps its
        // distance and spits rain (the `shoot` of a skirmisher): it swells dark
        // with lightning in it first (its windup row). The rain flies as a thrown
        // `Rock` does, and looks like spit (`ranged_vfx`).
