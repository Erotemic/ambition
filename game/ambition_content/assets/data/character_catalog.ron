        // ===== Giant GNU (ADR 0020 mount actor — the carried giant GNU-ton
        // rides on). A brainless, stationary MOUNT: it renders via the
        // character-sprite path from the G1 scholar-less `giant_gnu` sheet
        // (target `giant_gnu`, collision_scale 4.5 matching the giant art). Its
        // rideability + heavy mass + own HP live on the `giant_gnu` archetype
        // (character_archetypes.ron); GNU-ton (the rider) stays the boss. Not a
        // Hall exhibit as well as a gameplay mount; its gallery voice reflects
        // that support role rather than pretending it is the rider.
        "npc_giant_gnu": (
            sprite_tuning: Some((collision_scale: 4.5, frame_sample_inset: 1)),
            display_name: "Giant GNU",
            spritesheet: "sprites/gnu_ton_boss/giant_gnu_spritesheet.png",
            manifest: "sprites/gnu_ton_boss/giant_gnu_spritesheet.ron",
            tier: MainHall,
            body_kind: Wide,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors an
            // autonomous `BrainProfile`, which outranks this field everywhere it
            // is read — so naming `stand_still` was the same policy stated twice.
            //  safe for THIS preset specifically: `stand_still` holds no speeds
            // and no `aggressiveness`, so nothing came across with it. A preset
            // that carries a RELATIONSHIP (the `aggressiveness: 0.0` on
            // `parrot_lively`, which cost four attempts to understand) has to
            // move that to the placements first.
            default_action_set: "peaceful",
            tags: ["mount", "giant"],
            barks: (
                hall: ["Gnu Ton brought a quotation. I asked for a saddle.", "GNU's not Unix. I am not the rider. Please keep up.", "Everyone wants the shoulders. Nobody asks about the knees."],
            ),
            hall_dialogue_id: Some("hall_npc_giant_gnu"),
        ),

        // ===== Giant GNU Hands (Q18 / G3 — the giant's two DRIVEN limb bodies).
        // A brainless actor body rendering the scholar-less `giant_gnu_hands`
        // sheet; the gnu_ton_rider boss's strikes drive it through the limb router.
        // Same 768x576 layout / collision_scale 4.5 as the giant body (they share
        // the G1 sheet placement). Its Hall voice leans into the absurdity of a
