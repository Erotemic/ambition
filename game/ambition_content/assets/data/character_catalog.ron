            max_health: Some(6),
            mass: Some(4.0),
            tags: ["enemy", "history", "beringia", "cat"],
        barks: (
            on_hit: ["RRRAWR!", "Mind the teeth. They break, you know."],
            provoked: ["*it opens its jaw wider than a jaw should go*"],
            idle: ["*a deep purr*", "*it licks one sabre, carefully*", "Big teeth. Small brain. Great life."],
            hall: ["Thousands of us fell into the tar pits of La Brea, chasing things that had fallen in first. It was a whole bad afternoon, for about forty thousand years.", "Sabre-toothed TIGER? I am not a tiger. Nobody in my family is a tiger. Write it down."],
        ),
        ),
        // The jaguar: the great cat of the forests of the Americas, gold with
