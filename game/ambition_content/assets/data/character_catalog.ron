            max_health: Some(4),
            mass: Some(2.5),
            tags: ["enemy", "history", "viking", "soldier"],
        barks: (
            on_hit: ["Oof! Good hit. Odin saw that.", "My shield! I painted that!"],
            provoked: ["To the boats! No, wait. You are here. To YOU!"],
            idle: ["*he checks his helmet for horns. None. Good.*", "Raid in the summer, farm in the winter.", "Row. Row. Row. Are we there yet?"],
            hall: ["Horns on a helmet? In a fight? Somebody would grab them. The horns came from an opera costume in 1876. Put that on the sign.", "We went to Baghdad, to Constantinople, to America. And we are remembered for hats we never wore."],
        ),
        ),
        // The tiger: a Bengal tiger, orange with black stripes. It stalks low,
