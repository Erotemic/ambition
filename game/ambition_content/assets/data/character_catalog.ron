            )),
            max_health: Some(4),
            tags: ["enemy", "evil", "minion"],
            cues: (notice: Some("enemy.fascist.notice"), tell: Some("enemy.fascist_enforcer.tell"), swing: Some("enemy.fascist_enforcer.swing")),
        barks: (
            hall: ["Papers.", "The order authorizes itself.", "If it is wrong, I will have obeyed correctly."],
        ),
        hall_dialogue_id: Some("hall_npc_fascist_enforcer"),
        ),
        // The Fascist Swordsman: an enforcer with a drawn sabre (Jon,
        // 2026-10-30: "a few facists with swords or clubs"). He holds just out of
        // his long reach, then lunges in with a quick thrust and steps out again.
        "npc_fascist_swordsman": (
            display_name: "Fascist Swordsman",
            manifest: "sprites/fascist_swordsman_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 183 cm, as the enforcer.
            standing_height: Some(70.8),
            composition: None,
            default_action_set: "fascist_sabre_thrust",
            locomotion: Some((run_speed: 250.0, move_style: Walk)),
            contact_damage: Some((strength: 0.6, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 640.0,
                attack_range: 62.0,
                patrol_effort: 0.4,
                chase_effort: 0.9,
                // The duellist: he holds at the end of his sabre's reach, lunges in,
                // and steps back out; hit, he gives ground.
                navigates: true,
                retreat_after_swing_s: 0.35,
                tactics: (notice_s: 0.6, lurk_px: 90.0, waits_its_turn: true, footsies: Some((hold_px: 120.0, wait_s: 0.7)), flinch_back_s: 0.3),
            )),
            max_health: Some(4),
            tags: ["enemy", "evil", "minion"],
            cues: (notice: Some("enemy.fascist.notice"), tell: Some("enemy.fascist_swordsman.tell"), swing: Some("enemy.fascist_swordsman.swing")),
        barks: (
            on_hit: ["A scratch! Regulation permits scratches.", "Ow. I mean: ha!"],
            idle: ["En garde, citizen!", "The blade is regulation length."],
            hall: ["I was trained by a correspondence course.", "A sabre is a pointed opinion. I have only the one.", "Touché. That means I win."],
        ),
        hall_dialogue_id: Some("hall_npc_fascist_swordsman"),
        ),
        // The Fascist Clubman: an enforcer with an oak club bound in iron. Slow,
        // and very sure of himself: the club goes up high (a long tell), comes
        // down for two hearts, and he is bent over it a while after.
        "npc_fascist_clubman": (
            display_name: "Fascist Clubman",
            manifest: "sprites/fascist_clubman_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 183 cm, as the enforcer.
            standing_height: Some(70.8),
            composition: None,
            default_action_set: "fascist_club_overhead",
            locomotion: Some((run_speed: 190.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.7, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 560.0,
                attack_range: 48.0,
                patrol_effort: 0.3,
                chase_effort: 0.65,
                attack_cooldown_s: 0.8,
                // The brute: he walks up, waits just out of reach for you to come to
                // him, then brings the club down; he does not give ground.
                navigates: true,
                tactics: (notice_s: 0.7, lurk_px: 70.0, waits_its_turn: true, footsies: Some((hold_px: 95.0, wait_s: 1.4))),
            )),
            max_health: Some(5),
            tags: ["enemy", "evil", "minion"],
            cues: (notice: Some("enemy.fascist.notice"), tell: Some("enemy.fascist_clubman.tell"), swing: Some("enemy.fascist_clubman.swing"), hit: Some("enemy.fascist_clubman.hit")),
        barks: (
            on_hit: ["Hey! That is assault!", "Oof. Noted. Filed."],
            idle: ["Meet the persuader.", "Hold still. It is for order."],
            hall: ["This is a dialogue. I am the club half.", "Every argument ends at the club. I start there to save time.", "Persuader. Not a club. A persuader."],
        ),
        hall_dialogue_id: Some("hall_npc_fascist_clubman"),
        ),
        "npc_puppy_slug_velvet": (
            display_name: "Velvet Puppy Slug",
            manifest: "sprites/puppy_slug_velvet_spritesheet.ron",
