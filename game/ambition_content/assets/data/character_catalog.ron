            on_hit: ["Oi! I have a licence!", "That is an act of war, that is. I should know."],
            provoked: ["Hold! By letter of marque of His Majesty, your cargo is now my cargo."],
            idle: ["*he polishes the seal on his licence*", "It is not piracy if the King gets a cut.", "Yo ho, yo ho, a legally licensed life for me."],
            hall: ["A pirate robs ships. A privateer robs the ships of the King's enemies, with a paper that says he may. The ships cannot tell the difference.", "Francis Drake was a privateer. The Queen made him a knight. The Spanish called him the Dragon. Same man, same boat, different paperwork."],
        ),
        ),
        // ===== THE INDUSTRIAL AGE: era 8 of the History dimension.
        // The steam automaton: a riveted boiler on piston legs, with porthole
        // eyes and a firebox mouth. Slow and heavy: it builds pressure (its
        // windup row: the whistle, the needle in the red, steam from the seams)
        // and punches with a piston arm.
        "steam_automaton": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Steam Automaton",
            manifest: "sprites/steam_automaton_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(80.0),
            composition: None,
            default_action_set: "steam_automaton_punch",
            locomotion: Some((run_speed: 80.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.6, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 520.0,
                attack_range: 56.0,
                patrol_effort: 0.3,
                chase_effort: 0.8,
                // The pressure is spent after the punch: that is the opening.
                attack_cooldown_s: 1.2,
                tactics: (notice_s: 0.6),
            )),
            max_health: Some(10),
            mass: Some(6.0),
            tags: ["enemy", "history", "industrial", "steam"],
        barks: (
            on_hit: ["*CLANK* *hiss*", "PRESSURE. FALLING."],
            provoked: ["*WHEEEEEEEE!*"],
            idle: ["*chuff* *chuff* *chuff*", "*the needle twitches*", "COAL. MORE. COAL."],
            hall: ["James Watt did not invent the steam engine. He made it waste less coal. Everybody remembers an invention. Nobody remembers an efficiency.", "One of me does the work of many horses. Watt called it horsepower so the mill owners would understand. Nobody asked the horses."],
        ),
        ),
        // The soot sprite: a ball of soot from a mill chimney, with big white
        // eyes and an ember inside. It floats in, squashes and lights its
        // ember (its windup row), and rushes at you with a trail of soot.
        "soot_sprite": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Soot Sprite",
            manifest: "sprites/soot_sprite_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            standing_height: Some(30.0),
            composition: None,
            default_action_set: "soot_sprite_rush",
            locomotion: Some((run_speed: 160.0, move_style: Float, baseline_free_flight: Some(true))),
            autonomous_profile: Some((
                template: Aerial,
                aggro_radius: 520.0,
                attack_range: 130.0,
                shares_sightings: false,
                tactics: (dive_tell_s: 0.3, notice_s: 0.35),
            )),
            max_health: Some(1),
            tags: ["enemy", "history", "industrial", "soot"],
        barks: (
            on_hit: ["*pff!*", "*it scatters, and gathers again*"],
            provoked: ["*it puffs up, black and furious*"],
            idle: ["*it drifts*", "*smudge*", "*a small, sooty cough*"],
            hall: ["In the mill towns we turned the trees black, and the pale moths on them were easy to see and got eaten. The dark moths lived. Evolution, in one city, in fifty years. You are welcome.", "Every chimney in town makes a little of me. Together we make the fog."],
        ),
        ),
        // The robber baron: a tycoon in a top hat and a fur coat, with a cigar
        // and a sack of money. He keeps his distance and throws coins (the
        // `shoot` of a skirmisher): the coin comes out of the sack and goes back
        // over his shoulder first (his windup row). It flies as a thrown `Rock`
        // does, and looks like a coin (`ranged_vfx`).
        "robber_baron": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Robber Baron",
            manifest: "sprites/robber_baron_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(62.0),
            composition: None,
            default_action_set: "robber_baron_coin",
            ranged_vfx: Some("coin"),
            locomotion: Some((run_speed: 100.0, move_style: Walk)),
            autonomous_profile: Some((
                template: Skirmisher,
                aggro_radius: 600.0,
                attack_range: 320.0,
                patrol_effort: 0.3,
                chase_effort: 0.6,
                // Into the sack, a coin back over the shoulder, and throw.
                ranged_volley: Some((windup_s: 0.55, firing_s: 0.2, recovery_s: 1.1)),
            )),
            max_health: Some(4),
            tags: ["enemy", "history", "industrial", "tycoon"],
        barks: (
            on_hit: ["My hat! That hat cost more than your house!", "Sue him! Sue everybody!"],
            provoked: ["Here. Have a coin. Have MANY coins. Very fast."],
            idle: ["*he counts*", "I bought the railroad. Then I bought the other railroad.", "Competition is a sin. I read that somewhere. I own the paper."],
            hall: ["They call us robber barons. We call ourselves captains of industry. The men in my mills call me something I will not repeat in a gallery.", "I gave a library to every town and put my name over every door. Philanthropy is a long word for a very large sign."],
        ),
        ),
        // Their sheets are in the renderer (`targets/characters/hyena.py`,
        // `cave_lion.py`, `hippo.py`, `sea_raider.py`, on `_art_cast_kit.py` and
        // `_history_africa_kit.py`). The heights are the heights of the boxes
        // of the grid (`GRID.md`).
        // The hyena: a spotted hyena of the Cradle, laughing. Fast and low: it
        // crouches with its mane up (its windup row), lunges and bites, and
        // lopes away to come again.
        "hyena": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Hyena",
            manifest: "sprites/hyena_spritesheet.ron",
            tier: MainHall,
