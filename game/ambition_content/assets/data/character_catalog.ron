        barks: (
            on_hit: ["Ow! Hold the fly!", "That was not on the cue sheet!"],
            provoked: ["Stand by... and GO."],
            idle: ["Standing by.", "*into the headset* Copy that.", "Go on the cue. Not before."],
            hall: ["You never see us. That is the job. The scene changes, and nobody asks who changed it.", "Every sandbag up there holds something heavy over somebody's head. Mind your mark."],
        ),
        ),
        // The critic: a portly man in an opera cape who throws tomatoes. He
        // keeps his distance and throws (the `shoot` of a skirmisher): the
        // tomato goes back over his shoulder first (his windup row). It flies
        // as a thrown `Rock` does, and looks like a red fruit (`ranged_vfx`).
