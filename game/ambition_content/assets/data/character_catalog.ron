            barks: (
                idle: ["Bow to the pass.", "Fifteen to the clan. Nought to the visitors."],
                hall: ["I referee the Bamboo Pass. The visitors' column has a nought in it. I keep it very tidy.", "Daichi won once. The duelist slipped on a leaf. I wrote it down as a leaf."],
            ),
        ),
        "npc_village_tsuru": (
            display_name: "Tsuru",
            // A travelling medicine seller who stays at Ume's tea house each autumn.
            manifest: "sprites/village_tsuru_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 157 cm.
            standing_height: Some(60.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "ninja_village", "peaceful"],
            barks: (
                idle: ["The kettle's on.", "Forty-one villages, and every one has a dog."],
                hall: ["I leave a box of medicines with every house and come back next autumn. They pay for what they used.", "Nobody pays for what they didn't need. It is the most honest trade in the mountains."],
            ),
        ),
        "npc_village_moriyama": (
            display_name: "Moriyama",
            // Burns charcoal in the cedar forest; no ninja has ever got past his kiln unseen.
            manifest: "sprites/village_moriyama_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "ninja_village", "peaceful"],
            barks: (
                idle: ["Mind the smoke. It goes where you go.", "Three days and three nights, and you don't open the door."],
                hall: ["Forty years at the kiln. Every ninja in the clan has tried to sneak past it. I see them all. They smell of cedar smoke for a week.", "Charcoal is wood that has been very patient in a very hot room."],
            ),
        ),
        // The residents of the orbital station of the Science dimension, made by
        // the character generator (`targets/characters/townsfolk.py`). They
        // live and work on the station (`game/ambition_map_assets/ambition_content/generators/orbital_station/`).
        "npc_station_okafor": (
            display_name: "Officer Okafor",
            manifest: "sprites/station_okafor_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "customs", "peaceful"],
            barks: (
                idle: ["Declare it or leave it.", "The ring moves anything. That is the problem."],
                hall: ["Everything that comes through the ring stops at my desk first.", "I clear freight, not feelings.", "Seed stock, spores, mail with ideas in it. Somebody looks first. That is me."],
            ),
        ),
        "npc_station_reyes": (
            display_name: "Captain Reyes",
            manifest: "sprites/station_reyes_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "pilot", "peaceful"],
            barks: (
                idle: ["Shift change. Then we burn.", "The Remainder is slow. So is the moon."],
                hall: ["A ring takes you anywhere a ring is. I take you everywhere else.", "Freight comes through the gate and leaves on my ship.", "No gate on the survey moon. That is what haulers are for."],
            ),
        ),
        "npc_station_lindqvist": (
            display_name: "Bo Lindqvist",
            manifest: "sprites/station_lindqvist_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 186 cm.
            standing_height: Some(72.0),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "dockhand", "peaceful"],
            barks: (
                idle: ["Lift with the legs.", "Backlog's backlogged."],
                hall: ["They doubled the passenger slots. Freight waits. I wait.", "Every crate through the ring is a crate I carry.", "Ring throughput is down a third this cycle."],
            ),
        ),
        "npc_station_rahimi": (
            display_name: "Hamid Rahimi",
            manifest: "sprites/station_rahimi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 174 cm.
            standing_height: Some(67.4),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "engineer", "peaceful"],
            barks: (
                idle: ["Don't touch anything that hums.", "The plant is fine. The plant is always fine."],
                hall: ["A ring eats a reactor's worth of power. I keep the reactor fed.", "The spur took a storm. I keep it shut.", "Maintenance crawlers are supposed to fix things. Supposed to."],
            ),
        ),
        "npc_station_pell": (
            display_name: "Gus Pell",
            manifest: "sprites/station_pell_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "cook", "peaceful"],
            barks: (
                idle: ["Soup's on.", "Crackers by the door, if the ring got you."],
                hall: ["First-time travellers come out of the ring green. I keep a bucket.", "Everything here is grown upstairs or comes through the gate.", "A robot? More soup for the rest of us."],
            ),
        ),
        "npc_station_wen": (
            display_name: "Wen Liang",
            manifest: "sprites/station_wen_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 156 cm.
            standing_height: Some(60.4),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["station", "retired", "peaceful"],
            barks: (
                idle: ["Forty years, and it still looks new.", "The first link held three seconds."],
                hall: ["I tuned this station's first stable ring. Now people commute through it.", "Cheap power made gates common. It did not make them cheap.", "Look down. That is why anyone comes up here."],
            ),
        ),
        // Nikobolt Tesseract, an inventor who lives in peace in the Science
        // dimension: a sympathetic Tesla parody (renderer
        // `data/townsfolk/science_nikobolt.chargen.yaml`, drawn with the
        // hand-made overlay `data/overlays/nikobolt_tesseract.overlay.svg`).
        // Others took his inventions; he is not a villain. His home is not
        // built yet.
        "npc_science_nikobolt": (
            display_name: "Nikobolt Tesseract",
            manifest: "sprites/science_nikobolt_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 188 cm.
            standing_height: Some(72.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["science", "inventor", "peaceful"],
            barks: (
                idle: ["...twenty-six, twenty-seven. Good. Twenty-seven.", "Eighteen napkins. Then I can eat."],
                hall: ["The lamp by my door has no wire. Please stop looking for one. You are standing in the tulips.", "My coil drawings went missing. Now there is lightning over the castle on the other side of the gate.", "My wife feeds the pigeons on the roof. She says they are family. I have not asked which side."],
            ),
        ),
        // Coulomba Tesseract, Nikobolt's wife: a white pigeon (renderer
        // `data/townsfolk/science_coulomba.chargen.yaml`, drawn with the
        // hand-made overlay `data/overlays/coulomba_tesseract.overlay.svg`).
        "npc_science_coulomba": (
            display_name: "Coulomba Tesseract",
            manifest: "sprites/science_coulomba_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["science", "pigeon", "peaceful"],
            barks: (
                idle: ["*coo* ...pardon me.", "He counted the stairs again. Three times."],
                hall: ["Nikobolt lit our kitchen with no wire. I still keep candles in the drawer.", "The pigeons on our roof are not my relatives. Probably not.", "People from the other gate come asking about his lightning. I send them home with seed cake."],
            ),
        ),
        "npc_station_dobbs": (
            display_name: "Dobbs",
            // Keeps the souvenir kiosk at the tether terminus.
            manifest: "sprites/station_dobbs_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["station", "townsfolk", "peaceful"],
            barks: (
                idle: ["Shirts! Globes! Genuine orbit air!", "You look like a first time up. Everyone does."],
                hall: ["I sell bottled orbit air at the top of the ribbon. The vacuum kept escaping, so it is station air. Bottled up here, though.", "Everyone who comes up the tether wants something to hold. I sell them something to hold."],
            ),
        ),
        // A generated armsmith (renderer `data/townsfolk/armsmith_odile.chargen.yaml`):
        // the first character from the character generator published with the
        // whole clip union, so every held item sits in her fist on every row.
        "npc_armsmith_odile": (
            display_name: "Odile",
            manifest: "sprites/armsmith_odile_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            // A swing of her own, so a hand she is played with can take up and
            // use what lies on the ground; her brain never starts a fight.
            default_action_set: "striker_swipe",
            tags: ["townsfolk", "smith"],
            barks: (
                idle: ["Grip it like you mean it.", "*tests an edge on her thumbnail*"],
                hall: ["A blade, a noodle, a gun: the hand does not care. The wrist does.", "Bring it back with both ends attached."],
            ),
        ),
        // Nagisa the Gatekeeper, keeper of the Ninja Village's dimension gate:
        // an albino alligator geisha (renderer `data/townsfolk/village_nagisa.chargen.yaml`),
        // published with the whole clip union, like Odile. She stands by the
        // ring in the gate shrine; her talk is `ninja_village.yarn`.
        "npc_village_nagisa": (
            display_name: "Nagisa the Gatekeeper",
            manifest: "sprites/village_nagisa_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm, and 9 cm of geta.
            standing_height: Some(68.6),
            composition: None,
            default_brain: "stand_still",
            // A swing of her own, so a hand she is played with can take up and
            // use what lies on the ground; her brain never starts a fight.
            default_action_set: "striker_swipe",
            tags: ["townsfolk", "ninja_village", "gatekeeper"],
            barks: (
                idle: ["*tok, tok* go the geta, once round the ring.", "The gate is open. My eyes are too."],
                hall: ["They painted my face white. It was white already.", "I keep the SILENT gate. It is quiet because I am listening."],
            ),
        ),
        // The garrison of the General's tower (the Iron Bastion, `military_tower`):
