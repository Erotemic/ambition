        barks: (
            on_hit: ["HSSSS!", "*it bobs its head at you, very offended*"],
            provoked: ["*the dewlap opens like a flag*"],
            idle: ["*it basks*", "*bob* *bob* *bob*", "*a long, slow blink*"],
            hall: ["I have a third eye on the top of my head. It sees light and shadow, so I know when a hawk is over me. It cannot read. Neither can the other two.", "I can drop from a branch fifteen metres up, land on the forest floor and walk away. Mind the tail on the way down."],
        ),
        ),
        // Their sheets are in the renderer (`targets/characters/coconut_crab.py`,
        // `frigatebird.py`, `pacific_rat.py`, on `_art_cast_kit.py` and
        // `_history_americas_kit.py`). The heights are the heights of the boxes
