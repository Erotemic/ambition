            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bikini", "peaceful"],
            barks: (
                idle: ["Everything rolls up small.", "*she ties a rolled mat*", "Remember the island's name for what it was."],
                hall: ["They sent us to Rongerik, and we nearly starved. Then Kili, with no lagoon. Then home in 1968, and away again in 1978.", "Our children grew up far from Bikini."],
            ),
        ),
        "npc_primeval_twitchell": (
            display_name: "Mildred Twitchell",
