        // ===== Symmetry tutorial (Noether Chamber).
        "npc_emmy_noether": (
            sprite_tuning: Some((collision_scale: 1.1, frame_sample_inset: 2)),
            display_name: "Emmy Ethereal",
            manifest: "sprites/noether_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(61.9),
            composition: None,
            default_brain: "stand_still",
            //  2026-08-16: she authors a sixteen-move smash repertoire
            // (`emmy_noether_moveset`) across the 123 rows her rig already published,
            // and an ability and a repertoire are different questions — *may this
            // body attack* versus *what the attack is*. A `peaceful` row answered
            // the first one NO, so the table could never reach a fighter. Her
            // brain stays `stand_still`: what she does in the Hall is a policy,
            // not a capability, and her own bark is already the reply of somebody
            // who can be hit back.
            default_action_set: "striker_swipe",
            // Its strikes draw its own sheet (`emmy_noether_strike_fx`), not the stand-in wedge.
            attack_vfx: Some("emmy_noether_strike_fx"),
            // THE BODY: the hall walk, and the humanoid four. A mathematician with a
            // theorem is not a bigger body.
            locomotion_preset: Some("hall_walk"),
            max_health: Some(4),
            // HER ONE MECHANICAL JOKE, AND IT IS HER WHOLE SUBJECT. Two Emmys driven by
            // CPUs think on the same deterministic cognitive stream, so an Emmy-vs-Emmy
            // mirror match on a symmetric stage plays as a reflection: "every symmetry
            // hides a conservation law", made playable. It is not a synchronised
            // animation and must never become one. Nothing compares the two bodies or
            // copies one's action to the other; they agree because they draw from one
            // stream and read a symmetric stage. The mirror breaks the moment their
            // observations diverge (a hit, a launch, a ledge), and that is correct:
            // Noether's theorem is the claim that the symmetry has to be real for the
            // consequence to hold.
            preserves_mirror_symmetry: true,
            tags: ["hub", "guide", "tutorial"],
            gameplay_description: "Emmy intentionally preserves deterministic CPU symmetry in mirror matches: two Emmys receiving symmetric observations use the same cognitive/noise stream and therefore tend to behave as reflections of one another. This is an AUTHORED CHARACTER TRAIT, not the default Smash CPU policy -- every other character's CPUs get participant-distinct streams and diverge within a few decisions. Do not re-file it as a bug: it is authored as `preserves_mirror_symmetry: true` in her catalog row, and the reasoning is that her subject is Noether's theorem, where a symmetry implies a conservation law. It is NOT a synchronised animation and must never be implemented as one -- nothing compares the two bodies or copies one's action to the other. The reflection is an emergent consequence of identical cognition reading a symmetric stage, so it BREAKS as soon as their observations diverge (one takes a hit, one is launched further, one is nearer a ledge). That break is correct behaviour, not a regression.",
        barks: (
            on_hit: ["That violated several conservation laws.", "Every action has an equal and opposite consequence.", "The symmetry is broken now. Happy?"],
            provoked: ["By Noether's theorem — you're done!"],
            idle: ["Every symmetry hides a conservation law.", "The world is more beautiful when you find the invariant.", "Mathematics does not care what you believe."],
            hall: ["Spin the rules and the laws don't change. That's not luck.", "Energy is conserved because today is like yesterday."],
        ),
        hall_dialogue_id: Some("hall_npc_emmy_noether"),
        ),

        // ===== Pirate cove (Pirate Cove faction).
        "npc_pirate_admiral": (
            sprite_tuning: Some((collision_scale: 1.6, frame_sample_inset: 1)),
