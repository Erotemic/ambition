            standing_height: Some(77.4),
            composition: None,
            default_action_set: "heavy_raider_gun_sword",
            // A SHARK RIDER. Touching it does not hurt; its gun-sword does. It holds
            // the gun-sword, and it fires the bolt that the gun-sword fires: a
            // character states what it does and an item states what it holds.
            held_item: Some("gun_sword_heavy"),
            // It can board a shark. It is not itself a mount.
            mount: Some((pilotable_classes: ["shark"])),
            locomotion: Some((run_speed: 215.0, move_style: WalkHeavy)),
            autonomous_profile: Some((
                // It circles and fires: it notices you from across the cove and
                // commits from just inside that distance.
                template: Skirmisher,
                aggro_radius: 1200.0,
                attack_range: 1100.0,
                patrol_effort: 0.5116,
                chase_effort: 1.0,
                // A crew: when a lookout sees you, the others come.
                shares_sightings: true,
                // It plants and aims (its windup row) before each volley: the telegraph.
                ranged_volley: Some((windup_s: 0.65, firing_s: 0.4, recovery_s: 1.5)),
            )),
            provoked_profile: Some("pirate_boarder_heavy"),
            max_health: Some(6),
            tags: ["pirate", "heavy", "enemy"],
        barks: (
            on_hit: ["Iron don't flinch, ye gull!", "Pry harder, swab — I'll rust ye flat!", "Yo-ho, an' a clout to the noggin!", "Try me on a calmer sea, landlubber!"],
            provoked: ["Iron Mary breaks ye in half!"],
            hall: ["Iron doesn't flinch. Took me years to match it.", "Rust is a slow argument with time. I'm winning."],
        ),
        hall_dialogue_id: Some("hall_npc_pirate_heavy_iron_mary"),
        ),
        "npc_pirate_heavy_salt_annet": (
            sprite_tuning: Some((collision_scale: 1.95, frame_sample_inset: 1)),
            display_name: "Salt Annet",
            manifest: "sprites/pirate_heavy_salt_annet_spritesheet.ron",
            tier: MainHall,
            body_kind: Wide,
            // Its MEASURED height, authored so the number is visible and editable:
            // `Wide` has no default, so this row rode `ldtk_box x collision_scale`.
            // Identical output today (the legacy scale WAS height/body_h); the point
            // is that changing the size is now one number.
            // 216 cm, at the scale of the cast (the header of this file). It was
            // 60.4 when a person stood 48: one of the heavy crew is taller than the crew.
            standing_height: Some(83.6),
            composition: None,
            default_brain: "",
            default_action_set: "pirate_heavy_cutlass",
            provoked_profile: Some("pirate_boarder_heavy"),
            // THE BODY. The crew is one crew in three shapes (strikers, brutes, rangers),
            // and each shape's policy is a shared `autonomous_profiles` entry. The run
            // speed is the old preset's chase speed, so a pirate closes at the pace it
            // always did. Health is tuning: ordinary 4, heavy 6.
            locomotion: Some((run_speed: 75.0, move_style: WalkHeavy)),
            named_autonomous_profile: Some("pirate_brute"),
            max_health: Some(6),
            tags: ["pirate", "heavy", "enemy"],
            cues: (tell: Some("enemy.pirate_heavy.tell"), swing: Some("enemy.pirate_heavy.swing")),
        barks: (
            on_hit: ["Salt in the eye, blood in the bilge!", "Yargh! Watch yer manners on me deck!", "Wee skipper thinks he's bold, does he?", "Annet bites back, every time!"],
            provoked: ["Wee skipper picked the wrong deck!"],
            hall: ["Salt keeps things from going soft. People included.", "I can taste a coming storm. It tastes like work."],
        ),
        hall_dialogue_id: Some("hall_npc_pirate_heavy_salt_annet"),
        ),

        // ===== Burning Flying Shark (aerial pirate enemy).
        "npc_burning_flying_shark": (
            sprite_tuning: Some((collision_scale: 0.8, frame_sample_inset: 1)),
            display_name: "Burning Flying Shark",
            manifest: "sprites/burning_flying_shark_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            // The height of its body (its box, not its fire), in world px. It
            // is the size the shark had as a mount (a 108 px spawn box made
            // 55.99); stated here, the shark has that size in each place it
            // stands, the Hall too, where a stand's small box made it tiny
            // (Jon, 2026-10-13: "should also have a bigger size in the hall").
            standing_height: Some(56.0),
            composition: None,
            default_action_set: "shark_bite",
            // THE FIRST MOUNT TO BECOME A CHARACTER. A flying mount states its own
            // flight; it does not take it from its body kind.
            locomotion: Some((run_speed: 260.0, move_style: Float, baseline_free_flight: Some(true))),
            contact_damage: Some((strength: 1.10, amount: 2)),
            // A riderless shark's fast charge, stopped by a wall, makes the shark
            // explode.
            death_traits: Some((charge_crash_explodes: true)),
            // A pirate can ride it. It rides nothing, and a dead shark drops its
            // rider unharmed.
            // Its seat is the saddle drawn on its back: the sheet's published
            // `saddle` socket, frame (142.6, 54.7), on the top of the leather
            // seat, against a body box spanning x 9..194, y 29..110 (centre
            // 101.5, 69.5) at 0.6912 wu/px (MEASURED: the box is 127.87 x 55.99
            // wu) — so a rider stands IN the saddle, not on the box top, which
            // rises to the dorsal fin's tip. Re-derived for the SVG-rigged
            // redraw (renderer acf4f69); the old art's (7.4, -6.8) sat on its
            // back's crest.
            mount: Some((class: Some("shark"), saddle: Some((28.4, -10.2)))),
            // It dives at the target, crashes and recovers.
            autonomous_profile: Some((template: ChargeCrash, aggro_radius: 1200.0, attack_range: 200.0)),
            max_health: Some(6),
            // Heavier than its rider, so the pair turns around a centre of gravity
            // near the shark.
            mass: Some(6.0),
            tags: ["pirate", "aerial", "enemy"],
            cues: (tell: Some("enemy.burning_flying_shark.tell"), swing: Some("enemy.burning_flying_shark.swing"), hit: Some("enemy.burning_flying_shark.bite")),
        barks: (
            on_hit: ["SKREEE!", "BLAZE!", "BURN-CHOMP!"],
            provoked: ["FIRE SHARK ENGAGED!"],
            hall: ["STILL BURNING. STILL FLYING. STILL THRILLED.", "GRAVITY IS A SUGGESTION. FIRE IS A LIFESTYLE."],
        ),
        hall_dialogue_id: Some("hall_npc_burning_flying_shark"),
        ),

        // ===== Giant GNU (ADR 0020 mount actor: the giant GNU-ton rides). A
        // MOUNT with no brain that does not move: it draws from the `giant_gnu`
        // sheet (no scholar on it), whose authored body is its collision. The
        // RIDER is the threat: GNU-ton stays the boss. It is a Hall exhibit as
        // well as a mount; its gallery voice speaks as the mount, not the rider.
        "npc_giant_gnu": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            // The name of the giant is the whole giant's (`npc_giant_gnu_whole`):
            // two rows do not share one.
            display_name: "Giant GNU (body)",
            manifest: "sprites/gnu_ton_boss/giant_gnu_spritesheet.ron",
            tier: Giant,
            body_kind: Wide,
            composition: None,
            default_action_set: "peaceful",
            // THE ART IS THE BODY: the collision box is the sheet's authored body
            // (485x357 px: the beast and its chest, shoulders to hooves; not its
            // head, its horns or its tail) at one scale, so its feet are on the
            // floor. Its fists share the scale, so a fist is drawn the size of
            // the hand. At this scale the body is 630 x 464 and the tips of the
            // horns are 760 above the floor.
            posed_body: Some(WorldPerPixel(1.3)),
            // The art has no left/right variant: when the scholar on it turns
            // to face you, the gnu stays drawn as it is, its back where it was.
            unmirrored: true,
            // A heavy walk. GNU-ton's conductor walks it between his blows
            // (`ambition.boss.mount_walk`) at the speed its walk row is drawn
            // for: its hooves stand still on the floor at 135.4 a second
            // (`giant_art.STRIDE_SPEED`). It stands by its centre of gravity
            // (`balance`): with its centre past a ledge it goes off it.
            locomotion: Some((run_speed: 135.4, move_style: WalkHeavy, balance: Some(()))),
            mount: Some((
                class: Some("giant"),
                // The seat: where a rider's soles rest. The scholar stands on the
                // giant's right shoulder, in the middle of its epaulet (the
                // renderer's `giant_art.seat_place`: 612.5 px against the body-box
                // centre's 415.5 is 256 wu), ON the back the player stands on
                // (`back` below: its top). His own height is the mount sync's
                // business, not this number.
                saddle: Some((256.0, -232.05)),
                // Its back, while it is ridden: the way to reach the scholar is
                // to stand on the shoulders of a giant. `back` is the span the
                // conductor reads as "on its back": from the outer end of one
                // epaulet to the outer end of the other (405..655 px of the
                // frame, their top at 303 px, at 1.3 wu/px). It is not ground.
                // The back and the ground in it are the giant's, ridden or
                // not; the Hall's giant (`npc_giant_gnu_whole`) has the same.
                back: Some((left: -14.0, right: 311.0, top: -232.05, thickness: 14.0)),
                // Where the art has its gold-and-crimson trim
                // (`giant_art.stand_trim`), a body can stand (one-way ground):
                // the level part of each horn (from `gnu_horns`, about the
                // body-box centre), and the top of each epaulet.
                ledges: [
                    (left: 28.3, right: 76.3, top: -417.4, thickness: 12.0),
                    (left: 221.4, right: 269.4, top: -417.4, thickness: 12.0),
                ],
                // The top of each epaulet FOLLOWS THE ART: the sheet publishes
                // it in every frame (`surface:<name>:a` / `:b`, the renderer's
                // `giant_art.surfaces`), so a shoulder leans and lifts under a
                // body that stands on it as the torso does. Nothing over the
                // neck between them is ground.
                drawn_ledges: ["shoulder_left", "shoulder_right"],
                // The scholar's seat is on the right shoulder: it rises and
                // falls with it.
                saddle_on: Some("shoulder_right"),
                // And the hump of its back, from the rump up to its crest and
                // on to where the torso covers it: one line a body walks
                // (`walkable_lines`). It ends under the left end of the
                // shoulders, about 93 lower: a double jump goes up through the
                // one-way shoulders onto them. The points are the renderer's
                // `giant_art.hump_line_world()`: change the two together. It
                // FOLLOWS THE ART: the sheet publishes its two ends where the
                // barrel is drawn (`surface:hump`), so it bobs, turns and
                // bucks under a body that stands on it.
                slope_follows: Some("hump"),
                slope: [
                    (-294.4, -25.7), (-263.8, -50.6), (-233.1, -74.4), (-202.4, -95.8),
                    (-171.7, -113.9), (-141.1, -127.8), (-110.4, -136.8), (-79.7, -140.5),
                    (-49.0, -140.4), (-18.3, -139.3), (12.3, -137.4),
                ],
                // Whoever rides it conducts its fists and chooses its rows: in
                // the arena, the fists are GNU-ton's.
                rider_conducts: true,
            )),
            // Its two fists are bodies of their own. They hover at the height
            // of its chest on each side, clear of its flanks (its body is 315
            // to each side of its centre): every beat of GNU-ton's starts and
            // ends here. Its near fore leg kicks through a portal as a fist
            // punches through one: the hoof is a limb body of its own
            // (`hoof_right`), which rests at that hoof. The giant's picture
            // draws the leg; the limb carries its blow through the pair.
            hands: Some((character: "npc_giant_gnu_hands", rest: Some((400.0, -120.0)),
                more: [(slot: "hoof_right", rest: (192.0, 180.0))])),
            // It never looks for anyone and never strikes. Whether it is your enemy
            // is the placement's decision: the sandbox giant is `Peaceful`.
            autonomous_profile: Some((template: StandStill, aggro_radius: 0.0, attack_range: 0.0)),
            max_health: Some(42),
            // Much heavier than the scholar on it, so the pair's centre of gravity
            // is on the giant and the lighter rider turns around it when gravity
            // flips.
            mass: Some(8.0),
            tags: ["mount", "giant"],
            barks: (
                hall: ["Gnu Ton brought a quotation. I asked for a saddle.", "GNU's not Unix. I am not the rider. Please keep up.", "Everyone wants the shoulders. Nobody asks about the knees."],
            ),
            // The body the fight draws, with no arms: a part of the giant. The
            // Hall's stand is the giant whole (`npc_giant_gnu_whole`).
            part_of: Some("npc_giant_gnu_whole"),
        ),

        // ===== Giant GNU Fist (the giant's two limb bodies, conducted by
        // GNU-ton). A brainless actor body rendering the single-fist
        // `giant_gnu_fist` sheet; its definition takes its body from that
        // sheet at the giant's scale. Its Hall voice leans into the absurdity
        // of a separately cataloged, boss-driven hand instead of explaining it
        // away.
        "npc_giant_gnu_hands": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Giant GNU Hand",
            // A part of the giant: the giant carries the label.
            nameplate: false,
            manifest: "sprites/gnu_ton_boss/giant_gnu_fist_spritesheet.ron",
            // Its face is the pair of hands the generator still draws for it.
            portrait: Some((
                image: "sprites/gnu_ton_boss/giant_gnu_hands_portraits.png",
                manifest: "sprites/gnu_ton_boss/giant_gnu_hands_portraits.ron",
                default_clip: "default",
                still_clip: "",
            )),
            tier: Giant,
            body_kind: Wide,
            composition: None,
            default_action_set: "peaceful",
            // The fist sheet's authored body, at the giant's scale.
            posed_body: Some(SameAs("npc_giant_gnu")),
            // GNU-ton poses the fists each tick (`bosses::gnu_ton::conductor`), so
            // this gait and policy are not used. The conductor makes the hit
            // volumes; the fist only carries them.
            locomotion: Some((run_speed: 0.0, move_style: WalkHeavy)),
            autonomous_profile: Some((template: StandStill, aggro_radius: 0.0, attack_range: 0.0)),
            max_health: Some(42),
            // Lighter than the giant, heavy enough to feel solid.
            mass: Some(2.0),
            tags: ["limb", "giant"],
            barks: (
                hall: ["Talk to the hand. Appointment required for the giant.", "I am right-handed on alternate Tuesdays.", "Pointing is free. Punching is billable."],
            ),
            part_of: Some("npc_giant_gnu_whole"),
        ),

        // ===== Giant GNU, whole (the Hall's stand). The identity of the
        // giant: the same sheet as the body of the fight, at rest in the row
        // that has its arms on it. Jon, 2026-10-13: "the giant also needs his
        // full version with arms and we remove the hands as standalone
        // characters from the hall ... It should have one stand per 'semantic
        // identity' of a character." It is not a mount and has no fists of
        // its own: the fight uses the two parts above. A body stands on it
        // where it stands on the giant of the fight.
        "npc_giant_gnu_whole": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Giant GNU",
            manifest: "sprites/gnu_ton_boss/giant_gnu_spritesheet.ron",
            tier: Giant,
            body_kind: Wide,
            composition: None,
            default_action_set: "peaceful",
            posed_body: Some(SameAs("npc_giant_gnu")),
            unmirrored: true,
            rest_row: Some("armed_rest"),
            locomotion: Some((run_speed: 0.0, move_style: WalkHeavy, balance: Some(()))),
            // Not a mount (no class), but the same body: where its trim is, a
            // body stands on it as on the giant of the fight. The numbers are
            // `npc_giant_gnu`'s (the same sheet, at the same scale): change
            // the two together.
            mount: Some((
                back: Some((left: -14.0, right: 311.0, top: -232.05, thickness: 14.0)),
                ledges: [
                    (left: 28.3, right: 76.3, top: -417.4, thickness: 12.0),
                    (left: 221.4, right: 269.4, top: -417.4, thickness: 12.0),
                ],
                drawn_ledges: ["shoulder_left", "shoulder_right"],
                slope_follows: Some("hump"),
                slope: [
                    (-294.4, -25.7), (-263.8, -50.6), (-233.1, -74.4), (-202.4, -95.8),
                    (-171.7, -113.9), (-141.1, -127.8), (-110.4, -136.8), (-79.7, -140.5),
                    (-49.0, -140.4), (-18.3, -139.3), (12.3, -137.4),
                ],
            )),
            autonomous_profile: Some((template: StandStill, aggro_radius: 0.0, attack_range: 0.0)),
            max_health: Some(42),
            mass: Some(8.0),
            tags: ["giant"],
            barks: (
                hall: ["Gnu Ton brought a quotation. I asked for a saddle.", "GNU's not Unix. I am not the rider. Please keep up.", "Talk to the hand. Appointment required for the giant."],
            ),
            hall_dialogue_id: Some("hall_npc_giant_gnu"),
        ),

        // ===== Puppy Slug (wanderer crawlid).
        "npc_puppy_slug": (
            sprite_tuning: Some((collision_scale: 1.4, frame_sample_inset: 1)),
            display_name: "Puppy Slug",
            manifest: "sprites/puppy_slug_spritesheet.ron",
            tier: MainHall,
            body_kind: Crawler,
            composition: None,
            default_action_set: "peaceful_slither",
            // THE BODY. It crawls: it holds to the surface it stands on and does
            // not walk off a ledge (`surface_walker`), and a hit knocks it off its
            // surface until it lands again (`cling_breaks_on_hit`).
            locomotion: Some((
                run_speed: 80.0,
                move_style: Slither,
                surface_walker: true,
                cling_breaks_on_hit: true,
                baseline_free_flight: Some(false),
            )),
            // It hurts when you touch it. It does not swing, so it has no `Attack`
            // grant: an attack would be a swing that nothing describes.
            contact_damage: Some((strength: 0.55, amount: 1)),
            // It crawls, and that is its only verb. A body with one verb must
            // still seat, simulate and survive on a stage
            // (`puppy_slug_forced_seat.rs`).
            abilities: Some([Walk]),
            // The slug's own psychedelic pass.
            dream_seed: Some(0.271828),
            // Wildlife: it notices nobody and attacks nobody.
            autonomous_profile: Some((template: Wanderer, aggro_radius: 0.0, attack_range: 0.0)),
            max_health: Some(2),
            tags: ["enemy", "ai_era"],
        barks: (
            idle: ["blorb...", "schlorp.", "...weh?"],
            hall: ["*blorb*", "*content schlorp*"],
        ),
        hall_dialogue_id: Some("hall_npc_puppy_slug"),
        ),

        // ===== Ninja dojo.
        "npc_ninja_shadow_oni_leader": (
            display_name: "Shadow Oni Leader",
            manifest: "sprites/ninja_shadow_oni_leader_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 183 cm.
            standing_height: Some(70.8),
            composition: None,
            // His own mind, the striker's numbers with a notice: he stops, points
            // his sword at you (his notice row), then comes. It is his ONLY
            // policy: he names no preset (the striker preset's `aggressiveness:
            // 1.0` restated the hostility an `EnemySpawn` already means).
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 220.0,
                attack_range: 36.0,
                patrol_effort: 0.5,
                chase_effort: 1.0,
                tactics: (notice_s: 0.5),
            )),
            default_action_set: "striker_swipe",
            // Its strikes draw its own sheet (`ninja_shadow_oni_leader_strike_fx`), not the stand-in wedge.
            attack_vfx: Some("ninja_shadow_oni_leader_strike_fx"),
            // THE BODY: the striker's chase speed (110). It makes the body
            // complete, which is what let the body-assist seam go.
            locomotion: Some((run_speed: 110.0, move_style: Walk)),
            max_health: Some(6),
            tags: ["ninja", "faction_leader"],
            cues: (notice: Some("enemy.oni_leader.notice"), tell: Some("enemy.oni_leader.tell"), swing: Some("enemy.oni_leader.swing")),
        barks: (
            on_hit: ["Your form is loud.", "A warning: one breath left.", "The shadow answers."],
            provoked: ["Silence them."],
            hall: ["I permit your gaze. Note the word 'permit'.", "A leader's hardest order is the one obeyed instantly."],
        ),
        hall_dialogue_id: Some("hall_npc_ninja_shadow_oni_leader"),
        ),
        "npc_ninja_shadow_duelist": (
            display_name: "Shadow Duelist",
            manifest: "sprites/ninja_shadow_duelist_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["ninja", "enemy"],
        barks: (
            on_hit: ["Tch. Sloppy opening.", "Again? Then draw properly.", "Now we duel."],
            provoked: ["Steel decides."],
            hall: ["Mind the distance between us. I always do.", "Every duel I won began with 'I'm only looking'."],
        ),
        hall_dialogue_id: Some("hall_npc_ninja_shadow_duelist"),
        ),
        // Two more blades of the dojo, who show their eyes (Jon, 2026-10-23):
        // Looks of the Shadow Duelist's sheet, his bones and poses.
        "npc_ninja_shadow_duelist_eye_band": (
            display_name: "Ninja Swordsman",
            manifest: "sprites/ninja_shadow_duelist_eye_band_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm, as the Shadow Duelist.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "",
            default_action_set: "striker_swipe",
            // A body that can fight where it is placed as an enemy: the
            // examiner of the Ninja Village's rank exam.
            locomotion: Some((run_speed: 230.0, move_style: Walk)),
            contact_damage: Some((strength: 0.6, amount: 1)),
            named_autonomous_profile: Some("medium_striker"),
            max_health: Some(5),
            tags: ["ninja", "enemy"],
            cues: (tell: Some("enemy.ninja_duelist.tell"), swing: Some("enemy.shadow_oni.slash")),
        barks: (
            on_hit: ["Look me in the eye when you do that.", "A clean cut. Not yours.", "Again, from the guard."],
            provoked: ["Draw."],
            hall: ["The Duelist hides his eyes. I would rather see you coming.", "Stand where I can see your hands."],
        ),
        hall_dialogue_id: Some("hall_npc_ninja_shadow_duelist_eye_band"),
        ),
        "npc_ninja_shadow_duelist_blue_scarf": (
            display_name: "Blue Scarf Duelist",
            manifest: "sprites/ninja_shadow_duelist_blue_scarf_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm, as the Shadow Duelist.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["ninja", "enemy"],
        barks: (
            on_hit: ["The blue does not run.", "Straight blade, straight answer.", "You will remember the scarf."],
            provoked: ["The blue line holds."],
            hall: ["Red is the dojo's colour. I earned another.", "A straight blade forgives nothing. Neither do I."],
        ),
        hall_dialogue_id: Some("hall_npc_ninja_shadow_duelist_blue_scarf"),
        ),

        // ===== Hub guides (peaceful, dialogue-only).
        "npc_architect": (
            display_name: "Architect NPC",
            // The modernist, redrawn 2026-10-23 (`architect_v2`); the old sheet
            // is still published as `architect`.
            manifest: "sprites/architect_v2_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["hub", "guide"],
            // SCAFFOLD exemplar. on_hit/provoked migrated from features::npcs.
            barks: (
                on_hit: [
                    "Careful! I'm load-bearing.",
                    "That was not in the blueprint.",
                    "You're voiding the warranty.",
                ],
                provoked: ["Demolition protocol!"],
                hall: ["That load is not distributed correctly. I can feel it.", "Measure twice. Resent the carpenter once."],
