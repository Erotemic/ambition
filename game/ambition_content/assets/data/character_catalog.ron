            max_health: Some(2),
            tags: ["enemy", "history", "wayfinders", "bird"],
        barks: (
            on_hit: ["KRRAK!", "The pouch! It took twenty minutes to puff that up!"],
            provoked: ["*the red pouch swells, and swells*"],
            idle: ["*it hangs on the wind and does not flap once*", "*clack-clack of the long bill*"],
            hall: ["I cannot land on the sea: my feathers are not waterproof. So at dusk I fly home to land, and every navigator on the ocean watches which way I go.", "Other birds catch fish. I catch the other birds, shake them until they drop the fish, and catch the fish before it hits the water. It is called efficiency."],
        ),
        ),
