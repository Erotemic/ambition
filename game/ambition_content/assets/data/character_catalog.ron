        "npc_smirking_behemoth_boss": (
            display_name: "Smirking Behemoth",
            manifest: "sprites/smirking_behemoth_boss_spritesheet.ron",
            tier: Basement,
            body_kind: Wide,
            // Its size in its fight, its primary context (Jon, 2026-11-11): the
