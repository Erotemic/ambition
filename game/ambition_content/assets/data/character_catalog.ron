            tags: ["townsfolk", "ninja_village", "peaceful"],
            barks: (
                idle: ["Hmph.", "You. Do not get comfortable."],
                hall: ["Every week I choose a new rival. It keeps me sharp, and it keeps them humble.", "I have filled in the rival form in advance. It only needs your name."],
            ),
        ),
        "npc_village_matsuda": (
            display_name: "Matsuda",
            // Referees the Bamboo Pass and keeps the count.
            manifest: "sprites/village_matsuda_spritesheet.ron",
            tier: MainHall,
