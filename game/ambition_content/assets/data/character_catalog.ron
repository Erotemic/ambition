                hall: ["Half the village runs on the roofs. The other half runs on my tea.", "A good cup settles a stomach the gate unsettled."],
            ),
        ),
        "npc_village_daichi": (
            display_name: "Daichi",
            // A young villager who wants to pass the dojo's rank exam.
