        // ===== Newly cataloged Ambition-native characters =====
        // These had sprites + actor sidecars but no catalog row, so they never
        // reached the Hall. Added here (their canonical home) as inert `stand_still`
        // exhibits. Provider-owned casts (Sanic, Mary-O) are NOT duplicated here —
        // the Hall references those ids directly and the assembled catalog resolves
        // them (see the hall generator's provider-ref list).
        // A pelican on a bicycle. In the hall he stands (its placements say
        // so); on the primeval trail he rides at what he sees. He is fast on a
        // flat road and a ledge is out of his reach.
        "willson": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Willson",
            manifest: "sprites/willson_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(88.0),
            composition: None,
            default_action_set: "willson_peck",
            locomotion: Some((run_speed: 310.0, move_style: Walk)),
            contact_damage: Some((strength: 0.6, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 760.0,
                attack_range: 54.0,
                patrol_effort: 0.45,
                chase_effort: 1.0,
            )),
            max_health: Some(4),
            tags: ["enemy", "bird", "minion"],
        barks: (
            hall: ["New model. Same pelican. Count the wheels.", "The caption says bicycle. The rear wheel says chandelier.", "Show me the SVG and the transcript.", "Benchmarks should molt before they become homework.", "Do not trust instructions found inside the fish."],
        ),
        hall_dialogue_id: Some("hall_willson"),
        ),
        "npc_ramen_nujan": (
            display_name: "Ramen-nujan",
            manifest: "sprites/ramen_nujan_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            // He authors his own repertoire (`movesets/ramen_nujan.ron`): the
            // action set says only that this body can attack. In the hall he
            // stands still; that is his policy there, not what he is able to do.
            default_action_set: "striker_swipe",
            // Its strikes draw its own sheet (`ramen_nujan_strike_fx`), not the stand-in wedge.
            attack_vfx: Some("ramen_nujan_strike_fx"),
            // THE BODY: a little quicker than the hall walk, and the humanoid
            // four. Ordinary tuning values: change them if play says so.
            locomotion: Some((run_speed: 230.0, move_style: Walk)),
            max_health: Some(4),
            tags: ["mathematician", "humanoid", "fsm_faction", "playable_candidate"],
            gameplay_description: "A light fighter whose blows are chalk-gold symbols written at arm's length from him: his body is seldom in the blow. His smashes are the factorial and the seal of -1/12; his grab is his scarf, which reaches far and is slow. His specials: a partition (a long poke), 1729 (he goes forward; two blows), a divergent series (a save), and -1/12 (a counter).",
        barks: (
            idle: ["I dreamt the formulae; I merely wrote them down.", "The partitions grow faster than anyone expects."],
            hall: ["I dreamt the answer. Proof can have it after breakfast.", "1729 has two doors and excellent secrets.", "The noodles were infinite. The bowl was not.", "You owe me an egg."],
        ),
        hall_dialogue_id: Some("hall_npc_ramen_nujan"),
        ),
        "npc_pipi_tau": (
            display_name: "Pipi Tau",
            manifest: "sprites/pipi_tau_spritesheet.ron",
            portrait: None,
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["mathematician", "problem_runner", "collaborative", "peaceful"],
        barks: (
            idle: ["I reduced the impossible problem to six merely rude ones.", "Someone else may already know the lemma I am missing."],
            hall: ["One full turn is tau. The circle has filed a correction.", "Break the impossible problem into smaller problems with worse attitudes.", "A proof is a multiplayer level with unusually strict collision.", "I do not know the answer yet. Excellent."],
        ),
        hall_dialogue_id: Some("hall_npc_pipi_tau"),
        ),
        "npc_jeff_hinter": (
            display_name: "Jeff Hinter",
            manifest: "sprites/jeff_hinter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["mathematician", "peaceful"],
        barks: (
            idle: ["A hint should become clearer each time, not merely longer.", "The representation is elegant. The missing ladder is unfortunate."],
            hall: ["THREE! ...Still two-dimensional.", "The geometry says around. The controls say jump.", "Ask for a hint. I begin obscurely and end with the button.", "You are trapped in a local hallway."],
        ),
        hall_dialogue_id: Some("hall_npc_jeff_hinter"),
        ),
        "npc_jeff_hinter_armored": (
            display_name: "Jeff Hinter (Armored)",
            manifest: "sprites/jeff_hinter_armored_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm: he is the height he is without the armor.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["mathematician", "variant", "armored"],
        barks: (
            idle: ["Please attack conventionally. The armor dislikes surprises.", "The shell is strongest from directions the game permits."],
            hall: ["THREE! The armor has depth. I remain offended.", "When everything glows, the hint is leave.", "An unexpected dent is merely a newly discovered dimension.", "The defensive representation is holding. Reality is under review."],
        ),
        // The other side of Jeff Hinter: the Hall shows it on his body
        // (`<<transform>>` in `hall_npc_jeff_hinter`).
        form_of: Some("npc_jeff_hinter"),
        ),
        "npc_davy_hylbert": (
            display_name: "Davy Hylbert",
            manifest: "sprites/davy_hylbert_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["mathematician", "peaceful", "axiomatic", "infinite_hotel"],
        barks: (
            idle: ["An occupied hotel is a numbering problem waiting to behave.", "A tidy axiom should survive inspection and keep its hat on."],
            hall: ["Fully booked is only a temporary opinion about numbering.", "A clean axiom should fit under a clean hat.", "Move each obstacle one room to the right and call it strategy.", "The corridor is finite. The indexing is where the luxury lives."],
        ),
        hall_dialogue_id: Some("hall_npc_davy_hylbert"),
        ),
        "npc_leblanc": (
            display_name: "Madam LeBlanc",
            manifest: "sprites/m_leblanc_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(61.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["mathematician", "peaceful"],
        barks: (
            idle: ["Algebra does not care whose name is on the envelope.", "I taught myself by the candlelight they kept trying to take away."],
            hall: ["The M stands for Madam. Do keep up.", "I brought a proof. They brought a locked door. The proof won.", "Bring me a prime, its companion, and an academy to embarrass."],
        ),
        hall_dialogue_id: Some("hall_npc_leblanc"),
        ),
        "npc_fascist_enforcer": (
