            mass: Some(6.0),
            tags: ["enemy", "history", "ice_age", "bear"],
        barks: (
            on_hit: ["GRAWR!", "I was having a nap. For the winter."],
            provoked: ["*a roar that fills the cave*"],
            idle: ["*sniff* *sniff*", "*it scratches its back on the rock*", "Mmm. Roots."],
            hall: ["This was MY cave first. Then people came in with lamps and painted a hundred horses on my walls, and hardly any bears.", "Mostly I ate plants. Look at the size of me, and I ate plants. Nobody believes it."],
        ),
        ),
        // The Viking raider: a ginger beard in braids, a conical helmet with a
        // nose guard and NO horns, a red and white shield and a bearded axe. He
        // bangs his axe on his shield when he sees you, lifts it high behind his
        // head (his windup row), steps in and chops, and steps back again.
        "viking_raider": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
