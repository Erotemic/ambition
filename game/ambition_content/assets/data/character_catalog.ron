            body_kind: Standard,
            standing_height: Some(60.0),
            composition: None,
            default_action_set: "sea_raider_cut",
            locomotion: Some((run_speed: 240.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 560.0,
                attack_range: 90.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                // In fast with the cut, and back behind the shield.
                retreat_after_swing_s: 0.35,
                attack_cooldown_s: 0.7,
                tactics: (notice_s: 0.4, waits_its_turn: true, footsies: Some((hold_px: 120.0, wait_s: 0.5)), flinch_back_s: 0.3),
            )),
            max_health: Some(4),
            mass: Some(2.5),
            tags: ["enemy", "history", "bronze_age", "raider"],
        barks: (
            on_hit: ["My feathers!", "Ow. Write that on a wall, then."],
            provoked: ["From the sea! Nobody expects the sea!"],
            idle: ["*the feathers nod*", "Which kingdom is next?", "We came by boat. We do not talk about why."],
            hall: ["In 1177 BCE every great kingdom of the Bronze Age fell at once, and the Egyptians carved us on a temple wall as the reason. Drought, famine and earthquakes helped. Nobody carved them.", "Historians still argue about who we were. We would tell them, but nobody wrote it down. Least of all us."],
        ),
        ),
        // ===== THE HISTORY DIMENSION'S EUROPE: the Ice Age and the Viking north.
        // Their sheets are in the renderer
        // (`targets/characters/_history_europe_kit.py`).
        // The woolly mammoth: the great beast of the Ice Age, in a coat of long
        // red-brown hair, with long curved tusks. A charge (as the aurochs's):
        // it trumpets with its trunk up when it sees you, puts its head down and
        // stamps (its windup row), charges head low and sweeps its tusks up,
        // then stands a long moment: the opening.
        "woolly_mammoth": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Woolly Mammoth",
            manifest: "sprites/woolly_mammoth_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(110.0),
            composition: None,
            default_action_set: "woolly_mammoth_charge",
            locomotion: Some((run_speed: 100.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.8, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 640.0,
                attack_range: 80.0,
                patrol_effort: 0.3,
                chase_effort: 0.9,
                // Very slow between charges: the gap is the opening.
                attack_cooldown_s: 1.3,
                tactics: (notice_s: 0.7, footsies: Some((hold_px: 200.0, wait_s: 0.9))),
            )),
            max_health: Some(14),
            mass: Some(10.0),
            tags: ["enemy", "history", "ice_age", "mammoth"],
        barks: (
            on_hit: ["HRRRUMPH!", "That was my good tusk."],
            provoked: ["*a trumpet that shakes the snow off the pines*"],
            idle: ["*the crunch of frozen grass*", "*it swings its trunk*", "Cold today. Cold every day. For a hundred thousand years."],
            hall: ["The last of us lived on Wrangel Island until about four thousand years ago. The Great Pyramid was already built. We were the late guests of history.", "They built their houses out of our bones. Very cosy. I have opinions."],
        ),
        ),
        // The cave bear: the huge bear of the caves, dark brown with a grizzled
        // hump and a steep forehead. Heavy: it roars when it sees you, rears up
        // on its hind legs with its claws out (its windup row) and comes down on
        // you with both paws, then needs a moment to get up again.
        "cave_bear": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
