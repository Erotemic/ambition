// Ambition character catalog — provider-owned cast metadata, presentation,
// writing defaults, controller-profile references, and other catalog-shaped
// authoring data. It participates in character preparation, but it is NOT a
// second body-construction authority. Runtime bodies are constructed from the
// resolved `PreparedCharacterDefinition` produced from registered
// `CharacterDefinition` values plus any catalog/source fragments they consume.
//
// Schema and loading live in
// `crates/ambition_characters/src/actor/character_catalog/`.
// Current architecture: `docs/systems/actors-brains-and-character-content.md`.
// Authoring workflow: `docs/recipes/adding-a-character.md`.
//
// A catalog row alone does not make a spawnable body. Add or update the provider
// metadata here when the character uses it, and register/author the corresponding
// `CharacterDefinition` through the current Ambition content seam.

(
    // Reusable autonomous-controller profiles, by name — the second of the
    // three authorities (D73 / the overnight campaign). Several characters name
    // one of these and keep their own bodies, which is what an enemy ARCHETYPE
    // could never express: `medium_striker` is a whole BODY worn by five
    // goblins, a lab raider and a skitter, so sharing their decision-making
    // meant sharing their health, reach and top speed too.
    //
    //  these author normalized EFFORT (a fraction of each body's own
    // `run_speed`), never px/s — §4.7's brain→body seam. A policy that authored
    // absolute speeds could not be shared by a mite and a giant.
    autonomous_profiles: {
        // The goblin band's fighting style, lifted verbatim off the
        // `medium_striker` archetype's controller half: notice at 460px, commit
        // the swing at 150, poke with a thrown rock before closing, and dash to
        // shut a large gap. Nothing here says how much punishment the body takes
        // or how fast it can move — that is the character's half.
        "medium_striker": (
            template: Smash,
            aggro_radius: 460.0,
            attack_range: 150.0,
            patrol_effort: 0.6176,
            chase_effort: 1.0,
            smash_hit_band: 32.0,
            smash_sprint_to_close: true,
        ),
        //  A WANDERING SENTRY that notices late and never hurries. Not a
        // creature — a WAY OF PLAYING one, which is the whole point of a shared
        // policy: the same body on a patrol route and the same body holding a
        // doorway are two placements of one character, and the level decides.
        //
        //  effort is a FRACTION of whatever body wears it, so a fast creature
        // patrolling at 0.35 is still faster than a slow one at 1.0. That is why
        // a policy can be shared across bodies at all.
        //  THE CELLULAR AUTOMATON'S FIGHTING STYLE, published so the
        // creature can name it when PROVOKED (ledger D89). Lifted off the
        // `cellular_automaton_fighter` archetype's controller half: notice from
        // across the arena, commit the swing at 150, dash to shut a gap, and play
        // the duelist neutral game — footsies and spacing rather than
        // close-and-camp.
        //
        //  a provoked creature rebuilds its MIND, and this is the mind. The
        // PCA reached this policy through `hostile_brain_id_for_actor`, a matcher
        // that read its display name; a character that publishes its own policy
        // needs no matcher to recognise it.
        "cellular_duelist": (
            template: Smash,
            aggro_radius: 540.0,
            attack_range: 150.0,
            patrol_effort: 0.5714,
            chase_effort: 1.0,
            smash_sprint_to_close: true,
            smash_duelist: true,
        ),
        "patroller": (
            template: Wanderer,
            aggro_radius: 140.0,
            attack_range: 40.0,
            patrol_effort: 0.35,
            chase_effort: 0.8,
        ),
        //  THE ROBOT'S OWN FIGHTING STYLE, lifted off the `player_robot`
        // archetype's controller half: notices across the room, commits the
        // swing close in, dashes to shut a gap, and plays the duelist neutral
        // game (footsies and spacing) rather than closing and camping.
        //
        //  nothing here says how much punishment the body takes or how fast it
        // can move — that is the character's half, and the whole reason the
        // eighty-line archetype row could not simply become a definition.
        "robot_duelist": (
            template: Smash,
            aggro_radius: 560.0,
            attack_range: 60.0,
            patrol_effort: 0.55,
            chase_effort: 1.0,
            smash_sprint_to_close: true,
            smash_duelist: true,
        ),
        //  WHAT A COVE RAIDER BECOMES WHEN YOU HIT IT, lifted off the
        // `pirate_raider` archetype's controller half (2026-08-11, ledger D84).
        //
        //  a PROVOKED policy is still just a policy. Provocation used to
        // hand the body a different ARCHETYPE — new tuning, new HP pool, new
        // capabilities — because the archetype WAS the creature. A raider that
        // takes a swing is the same raider; only its mind changes.
        "pirate_boarder": (
            template: Smash,
            aggro_radius: 460.0,
            attack_range: 140.0,
            patrol_effort: 0.6842,
            chase_effort: 1.0,
        ),
        //  THE HEAVY'S VERSION. A brute rather than a duelist, and it
        // notices only what comes to it — `aggro_radius: 0.0` is the row's own
        // number, with `provoke_forced_brute_min_aggro` doing the noticing on the
        // legacy path.
        "pirate_boarder_heavy": (
            template: MeleeBrute,
            aggro_radius: 500.0,
            attack_range: 90.0,
            patrol_effort: 0.5769,
            chase_effort: 1.0,
        ),
        //  KEEPS ITS DISTANCE AND SHOOTS, lifted off the
        // `ranged_skirmisher` archetype's controller half (2026-08-11): notices
        // across the room, opens fire from almost as far, and ambles rather than
        // charges. What it fires is the BODY's business — a raider's gun-sword
        // and a mage's bolt are the same policy with different weapons.
        "skirmisher": (
            template: Skirmisher,
            aggro_radius: 540.0,
            attack_range: 520.0,
            patrol_effort: 0.6,
            chase_effort: 1.0,
        ),
        //  HOLDS ITS GROUND. Notices a long way off and commits hard, but
        // barely drifts from where it was placed — a door guard rather than a
        // hunter. The counterpart to `patroller` on the one axis a level cares
        // about: does this one come looking for you, or wait.
        "door_guard": (
            template: Smash,
            aggro_radius: 320.0,
            attack_range: 120.0,
            patrol_effort: 0.08,
            chase_effort: 1.0,
            smash_hit_band: 36.0,
        ),
    },
    brain_presets: {
        "stand_still": StandStill,
        "patrol_peaceful": Patrol(
            spawn_local_x: 0.0,
            radius: 64.0,
            speed: 28.0,
            aggressiveness: 0.0,
            aggro_radius: 80.0,
            attack_range: 0.0,
        ),
        "wanderer_puppy_slug": Wanderer(
            speed: 36.0,
            aggressiveness: 0.0,
        ),
        "melee_brute_striker": MeleeBrute(
            aggressiveness: 1.0,
            aggro_radius: 220.0,
            attack_range: 36.0,
            chase_speed: 110.0,
        ),
        "melee_brute_brute": MeleeBrute(
            aggressiveness: 1.0,
            aggro_radius: 240.0,
            attack_range: 44.0,
            chase_speed: 75.0,
        ),
        "skirmisher_ranger": Skirmisher(
            aggressiveness: 1.0,
            aggro_radius: 320.0,
            standoff_px: 140.0,
            strafe_speed: 85.0,
            fire_cooldown_s: 0.8,
        ),
        // Lively peaceful flyer (the cove parrot): flits between airborne perches
        // and ground spots, and drops down beside the player to be talked to.
        // Needs a `Floating` body_kind (gravity-free) to actually fly.
        // Aggressive flying melee archetype for the Perfect Cellular Automaton.
        // The body must be `Floating` so the Aerial brain's 2D velocity drives
        // the fly row instead of walking on the ground.
    },

    action_set_presets: {
        "peaceful": (
            move_style: Walk,
            melee: None,
            ranged: None,
            special: None,
        ),
        "peaceful_float": (
            move_style: Float,
            melee: None,
            ranged: None,
            special: None,
        ),
        "peaceful_slither": (
            move_style: Slither,
            melee: None,
            ranged: None,
            special: None,
        ),
        "striker_swipe": (
            move_style: Walk,
            melee: Some(Swipe(
                windup_s: 0.28,
                active_s: 0.08,
                recover_s: 0.32,
                damage: 1,
                reach_px: 28.0,
            )),
            ranged: None,
            special: None,
        ),
        //  THE ROBOT'S OWN KIT, lifted off the `player_robot` archetype
        // row's combat half (2026-08-11, ledger D83): the snappy player-like
        // strike and the signature projectile. The row's numbers verbatim — a
        // migration that retuned on the way would be two changes wearing one
        // commit.
        "robot_duelist_kit": (
            move_style: Walk,
            melee: Some(Swipe(
                windup_s: 0.16,
                active_s: 0.06,
                recover_s: 0.20,
                damage: 1,
                reach_px: 34.0,
            )),
            ranged: Some(Rock(speed: 360.0, damage: 1)),
            special: None,
        ),
        "brute_lunge": (
            move_style: WalkHeavy,
            melee: Some(Lunge(
                windup_s: 0.45,
                active_s: 0.12,
                recover_s: 0.45,
                damage: 2,
                reach_px: 40.0,
                step_px: 18.0,
            )),
            ranged: None,
            special: None,
        ),
        "ranger_arrow": (
            move_style: Strafe,
            melee: None,
            ranged: Some(Arrow(speed: 520.0, damage: 2)),
            special: None,
        ),
        "pirate_pistol": (
            move_style: Walk,
            melee: Some(Swipe(
                windup_s: 0.28,
                active_s: 0.08,
                recover_s: 0.32,
                damage: 1,
                reach_px: 28.0,
            )),
            ranged: Some(Pistol(speed: 480.0, damage: 1)),
            special: None,
        ),
        "sandbag_punch": (
            move_style: Walk,
            melee: Some(PunchWeak(
                windup_s: 0.15,
                active_s: 0.08,
                recover_s: 0.40,
                damage: 1,
                reach_px: 22.0,
            )),
            ranged: None,
            special: None,
        ),
    },

    characters: {
        // ===== Base characters (player, robot, goblin, sandbag). The
        // player slot is special-cased by the runtime (Brain::Player);
        // its catalog entry exists only to keep the sprite registry
        // and catalog symmetrical so Phase 6 can delete the registry.
        "npc_busy_beaver": (
            display_name: "Busy Beaver",
            spritesheet: "sprites/busy_beaver_spritesheet.png",
            manifest: "sprites/busy_beaver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "beaver", "mathematician", "foreman", "peaceful"],
            fallback_dialogue: [
                "One more course. Then I stop. Probably.",
                "The dam is finished when I say it is, and I have not said it.",
            ],
        barks: (
            on_hit: ["That was not in the plan!", "Noted. Adding a course."],
            idle: ["One more course. Then I stop.", "I could halt here. I could.", "Nobody can tell me how long this takes. That is the interesting part."],
            hall: ["Ask me how many more courses and I will give you a number. The number will be wrong, and no honest beaver could have given you a right one.", "Every dam I have built could have been one log longer. That is not regret. That is the job.", "I am not slow. I am maximizing.", "The river does not halt either, and nobody calls IT overcommitted."],
        ),
        hall_dialogue_id: Some("hall_npc_busy_beaver"),
        ),
        "npc_charley_beagle_svg": (
            display_name: "Charley Beagle",
            spritesheet: "sprites/charley_beagle_svg_spritesheet.png",
            manifest: "sprites/charley_beagle_svg_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "dog", "naturalist", "scientist", "peaceful"],
            fallback_dialogue: [
                "Everything here is descended from something that nearly did not make it.",
                "I collect. I compare. Eventually the pattern collects me.",
            ],
        barks: (
            on_hit: ["A selective pressure!", "Noted, catalogued, survived."],
            idle: ["Everything here is descended from something that nearly did not make it.", "The finches were the small clue. The small clues are always the ones.", "Five years at sea and the important part was the notebook."],
            hall: ["I do not think the strongest survive. I think the ones that fit the afternoon survive, and the afternoon keeps changing.", "Give me a voyage and a notebook and I will give you an argument nobody wanted.", "Selection is not cruelty. It is bookkeeping that eventually gets read out loud.", "I sat on this for twenty years. Being right early and alone is not the same as being right."],
        ),
        hall_dialogue_id: Some("hall_npc_charley_beagle_svg"),
        ),
        "npc_niels_boar": (
            display_name: "Niels Boar",
            spritesheet: "sprites/niels_boar_spritesheet.png",
            manifest: "sprites/niels_boar_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "boar", "physicist", "scientist", "peaceful"],
            fallback_dialogue: [
                "The opposite of a small truth is a falsehood. The opposite of a great truth is another great truth.",
                "You are asking where the electron IS. I am telling you that is the wrong verb.",
            ],
        barks: (
            on_hit: ["A transition!", "I have changed levels. Loudly."],
            idle: ["The opposite of a great truth is another great truth.", "You want a picture. I have a formalism. We can still be friends.", "It orbits nothing. It occupies. Try to feel the difference."],
            hall: ["Complementarity is not a dodge. It is the admission that one question can only be answered by giving up another.", "Prediction is very difficult, especially about the future — and I am told I said that, which is itself hard to predict.", "Everything we call real is made of things that cannot be regarded as real. I have made my peace with this. You may take longer.", "The orbits are a lie I keep because it is a USEFUL lie, and you can see it from across the room."],
        ),
        hall_dialogue_id: Some("hall_npc_niels_boar"),
        ),
        //  the two SNAKE-PLANE swarms left this catalog on 2026-08-13: Mary-O
        // is their one provider now (definition AND catalog rows, in
        // `ambition_demo_mary_o`), which is what retired the standalone demo's
        // archetype-row fallback. The Hall still stages them by id from the
        // merged catalog; characters are shared by ID, not owned per provider.
        "npc_vera_ruin": (
            display_name: "Vera Ruin",
            spritesheet: "sprites/vera_ruin_spritesheet.png",
            manifest: "sprites/vera_ruin_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "astronomer", "scientist", "peaceful"],
            fallback_dialogue: [
                "The edges turn as fast as the middle. Something is out there holding on.",
                "I did not find the dark. I found the grip it has.",
            ],
        barks: (
            on_hit: ["Measured.", "That was mass I could see."],
            idle: ["The edges turn as fast as the middle.", "Most of the galaxy declined to be photographed.", "I looked at the rotation curve until it stopped being a mistake."],
            hall: ["Everyone expected the outside to lag. It does not. Whatever is holding those stars, you and I are not made of it.", "I did not find the dark. I found the grip it has, which is the only honest thing to find.", "Nine tenths of the universe is not hiding. It simply never agreed to shine.", "They told me the data was noisy. The data was fine. The expectation was noisy."],
        ),
        hall_dialogue_id: Some("hall_npc_vera_ruin"),
        ),
        "player_robot_v3": (
            sprite_tuning: Some((collision_scale: 1.35, frame_sample_inset: 1)),
            display_name: "Player Robot v3",
            spritesheet: "sprites/player_robot_v3_spritesheet.png",
            manifest: "sprites/player_robot_v3_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            // The protagonist's PLAYABLE kit is host-code-owned: its combat is the
            // runtime `AbilitySet` dev-toggle / progression kit, not this catalog
            // row. `default_action_set: "peaceful"` above describes its Hall
            // pedestal / NPC face, NOT what the worn home box can do. Being the
            // content default is now unrelated to keeping the code kit — a demo
            // whose default authors its own kit (Sanic) gets that kit.
            //  AUTHORED since 2026-08-11 (GPT 5.6 §5). v3 states its own
            // repertoire -- a swipe, a bolt and a bubble shield -- on its
            // definition, and `ranged_execution: ChargedProjectile` keeps the
            // Hadouken charging now that the charge is a character fact rather
            // than a property of this row saying `HostCode`.
            // The protagonist's blade, and ONLY the protagonist's: the sheet's
            // silhouette is sampled from v3's own hit polygon, so a character
            // with a different swing that named it would wear art cut for
            // somebody else's volume. A character that names nothing draws its
            // hit volume instead of borrowing this.
            attack_vfx: Some("robot_slash"),
            tags: ["player"],
            // AF4b: v3's OWN voice, which used to be authored a second time in
            // `player_robot_lineage.rs`. `barks.hall` only covers a pedestal.
            fallback_dialogue: [
                "Currently shipping. Ask me again in a version.",
                "I inherited the antenna and the debt.",
                "Every version of you thinks it is the last one.",
            ],
        barks: (
            hall: ["Jump, fall, repeat. That's the whole job.", "Somewhere, someone is holding a controller. I try not to dwell."],
        ),
        hall_dialogue_id: Some("hall_player"),
        ),
        // Sanic (the momentum-demo speedster) is no longer authored here: that
        // identity now belongs to the standalone Sanic experience PROVIDER
        // (`ambition_demo_sanic`). A single character id has a single owning
        // provider, so the Ambition launcher host surfaces Sanic by LINKING that
        // provider (see the App-local catalog composition), not by duplicating
        // the row in Ambition's own roster.
        "robot": (
            sprite_tuning: Some((collision_scale: 2.1, frame_sample_inset: 1)),
            // Jon, 2026-08-05: *"'Robot' should be named to 'Robot V1'."* The id
            // stays `robot` — it is the lineage's root and every reference in
            // the tree spells it that way; only what a player READS changes.
            display_name: "Robot V1",
            spritesheet: "sprites/robot_spritesheet.png",
            manifest: "sprites/robot_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["base", "robot"],
            // AF4b: the incarnation's OWN voice, which used to be authored a
            // second time in `player_robot_lineage.rs`. `barks.hall` only covers
            // a pedestal; this covers every other situation, so v0 is not mute
            // the moment it is anywhere else.
            fallback_dialogue: [
                "Version zero. Everything after me was a patch note.",
                "Beep. ...I don't actually beep. People expect it.",
                "They kept the antenna. I consider that a win.",
            ],
        barks: (
            hall: ["Beep. ...I don't actually beep. People expect it.", "Version zero. Everything after me was a patch note."],
        ),
        hall_dialogue_id: Some("hall_robot"),
        ),
        "goblin": (
            sprite_tuning: Some((collision_scale: 2.1, frame_sample_inset: 1)),
            display_name: "Goblin",
            spritesheet: "sprites/goblin_spritesheet.png",
            manifest: "sprites/goblin_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_action_set: "striker_swipe",
            tags: ["enemy", "base"],
        barks: (
            on_hit: ["Gah! Watch it!", "Dirty trick!", "I'll remember that!"],
            provoked: ["Come on then!"],
            hall: ["My cave is UNGUARDED right now. Do you understand?", "I bite ankles professionally. It's a craft."],
        ),
        hall_dialogue_id: Some("hall_goblin"),
        ),
        "sandbag": (
            sprite_tuning: Some((collision_scale: 1.38, frame_sample_inset: 1)),
            display_name: "Sandbag",
            spritesheet: "sprites/sandbag_spritesheet.png",
            manifest: "sprites/sandbag_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors an
            // autonomous `BrainProfile`, which outranks this field everywhere it
            // is read — so naming `stand_still` was the same policy stated twice.
            //  safe for THIS preset specifically: `stand_still` holds no speeds
            // and no `aggressiveness`, so nothing came across with it. A preset
            // that carries a RELATIONSHIP (the `aggressiveness: 0.0` on
            // `parrot_lively`, which cost four attempts to understand) has to
            // move that to the placements first.
            default_action_set: "sandbag_punch",
            tags: ["training"],
        barks: (
            on_hit: ["..."],
            hall: ["Hit me. Don't hit me. The sandbag abides either way.", "Ten thousand blows and one compliment. I remember the compliment."],
        ),
        hall_dialogue_id: Some("hall_sandbag"),
        ),
        //  THE IMMORTAL DUMMY IS A DIFFERENT CREATURE (D77). It shares the
        // sandbag's sheet and its stance and differs in the one fact that
        // matters to a combat-feel lab: it cannot be destroyed. `never_dies` is
        // a CHARACTER trait (`CharacterDeathTraits`), not a placement one, so
        // "the same sandbag, made invincible here" is not expressible — and
        // pretending it is would put a mortality policy on a spawn point.
        "sandbag_infinite": (
            sprite_tuning: Some((collision_scale: 1.38, frame_sample_inset: 1)),
            display_name: "Infinite Sandbag",
            spritesheet: "sprites/sandbag_spritesheet.png",
            manifest: "sprites/sandbag_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors an
            // autonomous `BrainProfile`, which outranks this field everywhere it
            // is read — so naming `stand_still` was the same policy stated twice.
            //  safe for THIS preset specifically: `stand_still` holds no speeds
            // and no `aggressiveness`, so nothing came across with it. A preset
            // that carries a RELATIONSHIP (the `aggressiveness: 0.0` on
            // `parrot_lively`, which cost four attempts to understand) has to
            // move that to the placements first.
            default_action_set: "sandbag_punch",
            tags: ["training"],
        barks: (
            on_hit: ["...", "Again."],
            hall: ["My colleague over there has six hit points. I have nine thousand nine hundred and ninety-nine, and I have never used one.", "Every fighter in this hall learned something on me. None of them learned my name."],
        ),
        hall_dialogue_id: Some("hall_sandbag_infinite"),
        ),


        // ===== Faction leaders (hub NPCs).
        "npc_general": (
            sprite_tuning: Some((collision_scale: 1.15, frame_sample_inset: 2)),
            display_name: "General",
            spritesheet: "sprites/absurd_general_spritesheet.png",
            manifest: "sprites/absurd_general_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["hub", "faction_leader"],
        barks: (
            on_hit: ["Soldier, explain yourself.", "That is insubordination.", "Court-martial posture engaged."],
            provoked: ["Weapons free!"],
            hall: ["At ease. You couldn't manage anything else near me.", "Everything's a defensive position if you're paranoid enough. I am."],
        ),
        hall_dialogue_id: Some("hall_npc_general"),
        ),
        //  THE GOBLIN BRUTE — Jon's 2026-08-13 casting of `large_brute`,
        // the goblin lab's heavy: "author a distinct Goblin Brute character …
        // a separate reusable character identity rather than a generic archetype
        // row or an alias for an existing named goblin."
        //
        //  its sprite generator already existed and was never wired in.
        // `configs/review/goblin_brute_hammer.yaml` has `target: goblin` with its
        // own name, seed, `archetype: brute` and `variant: bruiser_heavy` — which
        // is exactly the shape he asked for: "it may initially use the same broad
        // goblin visual design/template, scaled/designed as a bigger brute …
        // however, its sprite must have a SEPARATE Python sprite generator/target,
        // even if that generator initially shares helpers or visual vocabulary
        // with the ordinary goblin." The sheet is generated and on disk; all that
        // was missing was this row.
        //
        //  `body_kind: Wide` and the heavier collision scale come from the
        // generator config's own `body_kind: Wide` / `mass_class: Heavy`, so the
