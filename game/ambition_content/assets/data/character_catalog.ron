            autonomous_profile: Some((
                template: Skirmisher,
                aggro_radius: 600.0,
                attack_range: 300.0,
                patrol_effort: 0.4,
                chase_effort: 0.8,
                ranged_volley: Some((windup_s: 0.6, firing_s: 0.25, recovery_s: 1.2)),
            )),
            max_health: Some(3),
            tags: ["enemy", "history", "monsoon", "weather"],
        barks: (
            on_hit: ["Hey! I was raining there!", "*a sulky rumble*"],
            provoked: ["You want weather? Here is weather."],
            idle: ["*rumble*", "Six months east. Six months west. Every year.", "*drip*"],
            hall: ["The dhow captains plan their whole year round me: east with the summer monsoon, home with the winter one. Nobody asks what I want.", "The word monsoon comes from the Arabic for season. I am not a season. I am a mood."],
        ),
