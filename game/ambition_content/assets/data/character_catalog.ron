                retreat_after_swing_s: 0.4,
                attack_cooldown_s: 0.5,
                tactics: (notice_s: 0.25, waits_its_turn: true, footsies: Some((hold_px: 70.0, wait_s: 0.35)), flinch_back_s: 0.25),
            )),
            max_health: Some(1),
            tags: ["enemy", "history", "rapa_nui", "rodent"],
        barks: (
            on_hit: ["Squeak!", "*it is gone, and back, and gone*"],
            provoked: ["*whiskers forward*"],
            idle: ["*sniff sniff*", "*it washes its face, very fast*", "Seeds? Any seeds?"],
            hall: ["I crossed the Pacific on the canoes with the people, island after island. Some say as food, some say as a stowaway. I say: first class.", "On Rapa Nui they say we ate the nuts of the great palms, so no new palms grew. ...We did eat a lot of nuts. They were very good nuts."],
        ),
        ),
        // The driver ants (siafu) of the West African forest: a marching
        // column that moves as one low body, big-jawed soldiers at its front.
        // Slow, low and hard to jump over: it bunches up and surges.
        "driver_ants": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Driver Ants",
            manifest: "sprites/driver_ants_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(24.0),
            composition: None,
            default_action_set: "driver_ants_bite",
            locomotion: Some((run_speed: 110.0, move_style: Walk)),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 360.0,
                attack_range: 48.0,
                patrol_effort: 0.6,
                chase_effort: 0.8,
                // The column surges, then takes its time to form up again.
                retreat_after_swing_s: 0.3,
                attack_cooldown_s: 0.9,
                tactics: (notice_s: 0.5, waits_its_turn: true, footsies: Some((hold_px: 60.0, wait_s: 0.5)), flinch_back_s: 0.2),
            )),
            max_health: Some(4),
            mass: Some(2.0),
            tags: ["enemy", "history", "benin_city", "insect"],
        barks: (
            on_hit: ["*the column breaks, and closes again*", "*a hundred jaws turn to you*"],
            provoked: ["*the soldiers rear up, jaws wide*"],
            idle: ["*a rustle like rain on leaves*", "*the column goes on, and on*", "*march*"],
            hall: ["We are one column of millions, and we do not stop for a city, a wall or an Oba. People step aside. Then they come back, and the house has no cockroaches.", "Our soldiers' jaws hold so hard that healers close a wound with them: let one bite across the cut, then pinch off the body. We are stitches with legs."],
        ),
        ),
        // A soldier of Leclerc's expedition (1802), which Napoleon sent to
        // take Saint-Domingue back. A soldier, not a caricature: a bicorne, a
        // blue coat, a musket with a bayonet.
        "napoleonic_grenadier": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Grenadier of Leclerc's Army",
            manifest: "sprites/napoleonic_grenadier_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(64.0),
            composition: None,
            default_action_set: "napoleonic_grenadier_thrust",
            locomotion: Some((run_speed: 140.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 460.0,
                attack_range: 52.0,
                patrol_effort: 0.5,
                chase_effort: 0.8,
                // A drilled thrust, and a step back to guard.
                retreat_after_swing_s: 0.4,
                attack_cooldown_s: 0.9,
                tactics: (notice_s: 0.4, waits_its_turn: true, footsies: Some((hold_px: 90.0, wait_s: 0.5)), flinch_back_s: 0.3),
            )),
            max_health: Some(4),
            mass: Some(3.0),
            tags: ["enemy", "history", "haitian_revolution", "soldier"],
        barks: (
            on_hit: ["Aagh!", "*he stumbles back and comes to guard again*"],
            provoked: ["En garde!"],
            idle: ["*he wipes his face; the heat never stops*", "These mountains go on for ever.", "*he looks up at the ridge, where something moved*"],
            hall: ["They told us it would be a short campaign. Of the tens of thousands they sent, most never went home: the war took many, and yellow fever took more.", "We came to take an island back. The island had other plans."],
        ),
        ),
        // The Andean condor: the largest flying land bird of the Americas,
        // black with a white ruff, soaring on flat wings with the tips spread
        // like fingers. It rarely flaps; it swoops.
        "andean_condor": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Andean Condor",
            manifest: "sprites/andean_condor_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            standing_height: Some(40.0),
            composition: None,
            default_action_set: "andean_condor_swoop",
            locomotion: Some((run_speed: 150.0, move_style: Float, baseline_free_flight: Some(true))),
            autonomous_profile: Some((
                template: Aerial,
                aggro_radius: 620.0,
                attack_range: 170.0,
                shares_sightings: false,
                tactics: (dive_tell_s: 0.5, notice_s: 0.5),
            )),
            max_health: Some(3),
            tags: ["enemy", "history", "andean_highlands", "bird"],
        barks: (
            on_hit: ["*a hiss: condors have no voice to scream with*", "*it wobbles, and finds the wind again*"],
            provoked: ["*it tips one wing and turns, without a flap*"],
            idle: ["*it has not flapped in an hour*", "*a shadow three metres wide crosses the ground*"],
            hall: ["My wings are three metres across, and I can soar for hours without one flap. I let the mountains do the work. Smart birds do.", "I eat what is already dead. Look on the bright side: I am not hunting you. I am waiting."],
        ),
        ),

        // ===== THE EVIL DIMENSION (Jon, 2026-10-15). Wolfenstein, the boss of
        // Castle Godwin: Frankenstein's monster with the head of Insanity Wolf,
        // and the armband of the regime. His fight is `wolfenstein_boss`
        // (`data/boss_profiles.ron`); this row is his body, his parts and his
        // place in the hall (at the END of the catalog: see the flock above).
        "npc_wolfenstein_boss": (
            display_name: "Wolfenstein",
            manifest: "sprites/wolfenstein_spritesheet.ron",
            tier: Basement,
            body_kind: Standard,
            // Its size in its fight, its primary context (Jon, 2026-11-11): the
            // boss's arena spawn box (84x140) x its sheet's collision_scale over the
            // frame, applied to this row's idle body.
            standing_height: Some(142.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["boss", "evil", "monster", "wolf"],
        barks: (
            on_hit: ["AWOOO-- what.", "Stitches hold. STITCHES HOLD."],
            idle: ["*a howl that goes on too long*", "Bolts tight. Teeth out."],
            hall: ["They sewed a wolf to the order. The order did not ask the wolf.", "Papers? I ATE the papers.", "AWOOOOO. Sorry. Every time."],
        ),
        hall_dialogue_id: Some("hall_npc_wolfenstein_boss"),
        ),
        // The Inugami: his head, torn off his dead body and risen as a red
        // spirit (Jon, 2026-10-20). Its fight is `wolfenstein_inugami`. It is
        // a look of Wolfenstein, not a second character: the Hall's stand is
        // his.
        "npc_wolfenstein_inugami": (
            display_name: "Inugami Wolfenstein",
            manifest: "sprites/wolfenstein_inugami_spritesheet.ron",
            tier: Basement,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["boss", "evil", "monster", "wolf", "spirit"],
        barks: (
            on_hit: ["No BODY orders me now!", "You cannot cut what is not sewn."],
            idle: ["*a howl with nothing under it*", "Free. FREE. Sorry. Free."],
            hall: ["They sewed me on. I came off."],
        ),
        form_of: Some("npc_wolfenstein_boss"),
        ),
        // Kagero: the kunoichi who hunts the spirits the regime makes (Jon,
        // 2026-10-21: a ninja comes to your aid in the Inugami's fight, a few
        // cuts, and she goes up her line). The Inugami summons her on your
        // side; her module performs her visit (`ambition_content_modules::
        // kagero`). She flies: her line carries her.
        "npc_ninja_kagero": (
            display_name: "Kagero",
            manifest: "sprites/ninja_kagero_spritesheet.ron",
            tier: Basement,
            body_kind: Floating,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            locomotion: Some((run_speed: 300.0, move_style: Float, baseline_free_flight: Some(true))),
            // Her visit is short: she does not stay long enough to fall.
            max_health: Some(200),
            tags: ["ninja", "ally", "spirit_hunter"],
        barks: (
            on_hit: ["Tch. Watch the noise.", "Not me, ripple-foot. It."],
            hall: ["You did not sneak in. You arrived incorrectly.", "A spirit is a debt. I collect."],
        ),
        ),
        // The Iron Trooper: the regime's heavy, in riveted plate, with a chain
        // gun (a held item, not his drawing). He stands back and fires; close
        // in, he smashes with the gun.
        "npc_evil_heavy": (
            display_name: "Iron Trooper",
            manifest: "sprites/evil_heavy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 205 cm.
            standing_height: Some(79.4),
            composition: None,
            default_action_set: "evil_chain_gun",
            held_item: Some("evil_chain_gun"),
            locomotion: Some((run_speed: 170.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.7, amount: 1)),
            autonomous_profile: Some((
                template: Skirmisher,
                aggro_radius: 900.0,
                attack_range: 480.0,
                patrol_effort: 0.3,
                chase_effort: 0.7,
                // Hold aim, fire through the gun's own 0.18 s refire gate,
                // then provide a clear interval to close the distance.
                ranged_volley: Some((windup_s: 0.55, firing_s: 0.78, recovery_s: 1.45)),
                shares_sightings: true,
            )),
            max_health: Some(10),
            mass: Some(6.0),
            tags: ["enemy", "evil", "heavy"],
        barks: (
            on_hit: ["Plate holds.", "Iron. All the way down."],
            idle: ["*the barrels turn, slowly*", "Quota: unmet."],
            hall: ["Twelve layers of rivets and one layer of orders.", "I do not argue. The gun argues."],
        ),
        hall_dialogue_id: Some("hall_npc_evil_heavy"),
        ),
        // A Failed Prototype: what the castle's lab made on the way to
        // Wolfenstein. Small stitched wolf-men that come in packs; one is weak,
        // three are not.
        "npc_evil_failed_prototype": (
            display_name: "Failed Prototype",
            manifest: "sprites/evil_failed_prototype_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // About 102 cm as it crouches (130 cm if it stood up).
            standing_height: Some(39.5),
            composition: None,
            default_action_set: "striker_swipe",
            locomotion: Some((run_speed: 330.0, move_style: Walk)),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 720.0,
                attack_range: 40.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                shares_sightings: true,
                // A swipe, a skitter back: the pack takes turns.
                retreat_after_swing_s: 0.35,
                // A skittering pack: it hops after you onto a platform, bites and
                // darts off, scatters when hit, and the pack takes turns.
                navigates: true,
                tactics: (notice_s: 0.5, lurk_px: 90.0, waits_its_turn: true, flinch_back_s: 0.3),
            )),
            max_health: Some(2),
            tags: ["enemy", "evil", "monster", "minion"],
            cues: (notice: Some("enemy.failed_prototype.notice"), tell: Some("enemy.failed_prototype.tell"), swing: Some("enemy.failed_prototype.swing")),
        barks: (
            on_hit: ["Yip!", "*a wet whimper*"],
            idle: ["*it scratches the stitches*", "Seven. Seven. Number seven."],
            hall: ["They said I was number seven. Number eight never came out.", "AWOO. No. Wrong. Again: awoo."],
        ),
        hall_dialogue_id: Some("hall_npc_evil_failed_prototype"),
        ),
        // The Attack Hound: the regime's guard dog, drawn on the house dogs'
