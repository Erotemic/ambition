            max_health: Some(2),
            tags: ["enemy", "history", "silk", "raider"],
        barks: (
            on_hit: ["Hah! Lucky!", "My camel left me for this?"],
            provoked: ["Your silk or your life!"],
            idle: ["*he turns his sword over in his hand*", "Nice caravan. Shame if it got lighter.", "The Silk Road is four thousand miles long. I work the middle."],
            hall: ["Nobody walks the whole Silk Road. The goods go from hand to hand to hand. Sometimes the hand is mine.", "My camel went on without me. Camels have no loyalty. Neither do I. We understood each other."],
        ),
        ),
        // The silk moth: a big pale moth with feathered antennae. It floats,
        // lifts its nose and wings (its windup row), and dives at you nose
        // first. It has no spit: a floater that strikes in melee dives, so it
        // is `Aerial`, as the red herring is.
