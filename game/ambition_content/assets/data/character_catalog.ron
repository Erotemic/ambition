            max_health: Some(3),
            tags: ["enemy", "history", "olmec_heartland", "monkey"],
        barks: (
            on_hit: ["HOO! Hoo. Ow.", "Rude. I was howling."],
            provoked: ["*a roar that rolls on through the forest for kilometres*"],
            idle: ["*a long, low howl at dawn*", "*it chews a leaf. Slowly. It has all day.*", "Hooooo."],
            hall: ["You can hear a howler monkey five kilometres away. That is not shouting. That is telling the next troop where we are, so nobody has to walk over.", "I eat leaves and I sleep most of the day. Leaves are not very nourishing. The howl is the only energetic thing I do, so I do it properly."],
        ),
        ),
