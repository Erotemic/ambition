            standing_height: Some(40.0),
            composition: None,
            default_action_set: "hyena_bite",
            locomotion: Some((run_speed: 270.0, move_style: Walk)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 560.0,
                attack_range: 80.0,
                patrol_effort: 0.6,
                chase_effort: 1.0,
                // In with the bite, and out again, laughing.
                retreat_after_swing_s: 0.4,
                attack_cooldown_s: 0.6,
                tactics: (notice_s: 0.3, waits_its_turn: true, footsies: Some((hold_px: 110.0, wait_s: 0.45)), flinch_back_s: 0.3),
            )),
            max_health: Some(2),
            tags: ["enemy", "history", "cradle", "beast"],
        barks: (
            on_hit: ["Hee hee! Ow. Hee.", "That is not funny. It is a LITTLE funny."],
            provoked: ["Hee hee hee hee!"],
            idle: ["Hee hee.", "*it giggles at nothing*", "Ha! Ha. Ha... I forget why."],
            hall: ["Everyone thinks we only steal. We hunt most of what we eat. We just laugh about it, and that gives us a reputation.", "The first humans came down out of the trees right here. We were waiting. We have been laughing about it ever since."],
        ),
        ),
