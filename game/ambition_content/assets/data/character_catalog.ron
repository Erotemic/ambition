            tags: ["enemy", "history", "green_sahara", "beast"],
        barks: (
            on_hit: ["HRRUMPH!", "You will regret that. I already regret you."],
            provoked: ["*the jaws open. And open. And keep opening.*"],
            idle: ["*an angry snort*", "*glug*", "Hmph."],
            hall: ["When the Sahara was green there were lakes all the way across it, and hippos in all of them. Then it dried up. I blame you.", "People say I look sleepy. I am not sleepy. I am waiting for someone to come close enough."],
        ),
        ),
        // The sea raider: one of the Sea Peoples of the Bronze Age collapse, as
        // the reliefs of Medinet Habu show them: a headdress of feathers, a
        // round shield and a long bronze sword. He draws the sword back over
        // his head (its windup row), runs in and cuts down.
        "sea_raider": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Sea Raider",
            manifest: "sprites/sea_raider_spritesheet.ron",
