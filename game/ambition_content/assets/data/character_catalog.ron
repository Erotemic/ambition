            contact_damage: Some((strength: 0.3, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 360.0,
                attack_range: 44.0,
                patrol_effort: 0.0,
                chase_effort: 0.7,
                attack_cooldown_s: 1.2,
                shares_sightings: false,
                // The lurker: it lies still out of your reach and waits for you to
