            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((
                template: Aerial,
                aggro_radius: 900.0,
                attack_range: 50.0,
                shares_sightings: false,
            )),
            max_health: Some(2),
            tags: ["enemy", "minion"],
        barks: (
            on_hit: ["Ramen!"],
            idle: ["Blub.", "Noodle."],
            hall: ["I am a lesser appendage. The greater one is on the next pedestal.", "One meatball. It is enough. It is all I was given."],
        ),
        hall_dialogue_id: Some("hall_npc_fsm_noodling"),
        ),
        "npc_galwah": (
            display_name: "Galwah",
            manifest: "sprites/galwah_spritesheet.ron",
