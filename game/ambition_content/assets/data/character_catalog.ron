            tags: ["enemy", "evil", "animal", "dog", "quadruped"],
            cues: (notice: Some("enemy.attack_hound.notice"), tell: Some("enemy.attack_hound.tell"), swing: Some("enemy.attack_hound.swing"), hit: Some("enemy.attack_hound.hit")),
        barks: (
            on_hit: ["*a yelp*", "Grrrk!"],
            idle: ["*a low growl*", "Rrrrr."],
            hall: ["GRRRR. *it will not be petted*", "Woof. (Papers.)"],
        ),
        hall_dialogue_id: Some("hall_npc_evil_attack_hound"),
        ),
        // The Spectral Wolf: a dog of the regime, dead and risen, red like the
        // Inugami (Jon, 2026-10-22). It FADES between its attacks: faint and
        // intangible while it circles you, solid from its windup to the end of
        // its recovery (`tactics.fades`). It holds off out of reach, comes in,
        // bites and is gone again. When it dies it bursts into wisps that run
        // the floor out of it (`bursts_into`). A test placement outside the
        // castle; Jon will use it more later.
        "npc_evil_spectral_wolf": (
            display_name: "Spectral Wolf",
