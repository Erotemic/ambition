            max_health: Some(14),
            mass: Some(10.0),
            tags: ["enemy", "history", "silk", "clay"],
        barks: (
            on_hit: ["*a chip of clay falls*", "Careful. I have been fired once already."],
            provoked: ["*the clay head turns, slowly*"],
            idle: ["...", "*a little dust falls*", "I was painted once. Red, green, violet. It flaked."],
            hall: ["Eight thousand of us, buried with the first emperor, so that he would have an army after he died. He never once inspected us.", "Every one of us has a different face. Mine has a very good moustache. It was modelled from life."],
        ),
        ),
        // The desert bandit: a quick raider on foot in an indigo face wrap,
        // with a curved sword. He coils low (its windup row), lunges with a
        // wide slash, and backs off again.
        "desert_bandit": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Desert Bandit",
            manifest: "sprites/desert_bandit_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(58.0),
            composition: None,
            default_action_set: "desert_bandit_slash",
