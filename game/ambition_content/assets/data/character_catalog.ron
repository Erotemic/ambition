            mass: Some(4.0),
            tags: ["enemy", "history", "south_asia", "cat"],
        barks: (
            on_hit: ["RRRAOWR!", "*a flat-eared snarl*"],
            provoked: ["*the tail stops moving*"],
            idle: ["*a low chuff*", "*it licks a paw, and watches you over it*", "*the stripes vanish into the reeds*"],
            hall: ["My stripes are on my skin too. Shave me and you would still see them. Please do not try.", "Every stripe is different. I counted mine once. I lost count at the tail."],
        ),
        ),
