                patrol_effort: 0.5,
                chase_effort: 0.9,
                attack_cooldown_s: 0.5,
                shares_sightings: true,
                // It stabs and scuttles back out of reach.
                retreat_after_swing_s: 0.7,
                // It skitters in, strikes, skitters off; hit, it scurries away.
                tactics: (lurk_px: 60.0, waits_its_turn: true, flinch_back_s: 0.5, notice_s: 0.4),
            )),
            max_health: Some(2),
            tags: ["enemy", "evil", "machine", "crawler"],
            cues: (notice: Some("enemy.searchlight_crawler.notice"), tell: Some("enemy.searchlight_crawler.tell"), swing: Some("enemy.searchlight_crawler.swing")),
        barks: (
            on_hit: ["*a sharp electronic squeal*"],
            idle: ["*servos tick*", "*the lamp hums*"],
            hall: ["*the lamp turns to you and stays there*", "*click. click. click.*"],
        ),
        hall_dialogue_id: Some("hall_npc_searchlight_crawler"),
        ),
        // The Steel Man and the Straw Man (Jon, 2026-10-23): the opposing
        // argument at its strongest, and the misrepresentation that is easy to
        // knock down (comic relief). Art and rows only: they stand in the Hall
        // and have no place, dialogue or fight yet.
        "npc_steel_man": (
            display_name: "The Steel Man",
            // The girder: riveted blued plate over red-lead I-beams (`steel_man`).
            manifest: "sprites/steel_man_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 196 cm.
            standing_height: Some(75.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["philosophy", "construct", "peaceful"],
            barks: (
                idle: ["*rivets settle*", "*a long, even breath of steam*"],
                hall: ["Before you answer me, let me put your side better than you did.", "I have read your best argument. I am still standing here.", "If I am wrong, show me where it bears the load.", "Disagree with me at my strongest. Anything less proves nothing."],
            ),
        ),
        "npc_straw_man": (
            display_name: "The Straw Man",
            // The sheaf: wheat bound in jute, shedding straw (`straw_man`).
            manifest: "sprites/straw_man_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 185 cm.
            standing_height: Some(71.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["philosophy", "construct", "peaceful"],
            barks: (
                idle: ["*rustle*", "*a straw drifts loose*"],
                hall: ["So what you are saying is that I am right.", "Nobody has ever beaten me in an argument. I have checked. Mostly with myself.", "Go on, knock me down. That is what I am for.", "I awarded myself this ribbon. The judges agreed. I was the judges."],
            ),
        ),

        // ===== Residents of the gate network's districts (2026-10-24): ordinary
