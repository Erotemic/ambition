        barks: (
            on_hit: ["Bzzt! There are fewer of us now. Slightly.", "You hit one of us. There are a billion of us."],
            provoked: ["Was that a field of barley? It was."],
            idle: ["*bzzzzzzzz*", "Crunch.", "Harvest tax. We collect all of it."],
            hall: ["Farming fed ten times as many people as hunting did. And us. Mostly us.", "The first farmers stored grain against the bad years. We are the bad years."],
        ),
        ),
