            default_action_set: "striker_swipe",
            tags: ["townsfolk", "eureka", "peaceful"],
            barks: (
                idle: ["Hard hats past this line. Hard heads optional.", "Probably fine. Sign here."],
                hall: ["Thirty years on the range. I have signed off nine hundred tests as probably fine. Eight hundred and ninety were.", "The rocket is not leaning. The ground is."],
            ),
        ),
        "npc_math_fibbs": (
            display_name: "Farmer Fibbs",
            // Keeps the Fibonacci Meadow, east of the Fractal Woods.
            manifest: "sprites/math_fibbs_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 176 cm.
            standing_height: Some(68.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Last month's and the month before's.", "*counts rabbits, gives up*"],
                hall: ["Started with two rabbits. Now I have the sum of the last two, every month, forever.", "The mites in the field divide. Rabbits add. I know which I'd rather."],
            ),
        ),
        "npc_math_ivo": (
            display_name: "Ivo",
            // Groundskeeper of the Fractal Woods.
            manifest: "sprites/math_ivo_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 176 cm.
            standing_height: Some(68.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Third iteration of the hedge. The fourth is longer.", "Mind the branches. They have branches."],
                hall: ["I trim the Koch hedge from spring to spring. Every cut makes more hedge.", "I raked the woods once. Every leaf had leaves. I stopped raking."],
            ),
        ),
        "npc_station_pippin": (
            display_name: "Hortensia Pippin",
            // Orchardist of GNU-ton's gravity works.
            manifest: "sprites/station_pippin_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "science", "peaceful"],
            barks: (
                idle: ["Mind the apples. They fall up.", "Long pole, lot of patience."],
                hall: ["Thirty years picking apples off a ceiling. You do not get used to it. You get a longer pole.", "I catch them. Picking is for orchards that know which way is down."],
            ),
        ),
        "npc_magical_celeste": (
            display_name: "Celeste Crumpet",
            // The star baker of Starlight Square (the Magical dimension).
            manifest: "sprites/magical_celeste_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "magical", "peaceful"],
            barks: (
                idle: ["Crescents! Fresh crescents!", "Full moon is Sundays only."],
                hall: ["I bake the moon in four phases. The new moon is an empty plate, and it sells.", "The void does not buy anything. Terrible for business."],
            ),
        ),
        "npc_magical_lumen": (
            display_name: "Ollie Lumen",
            // The lamplighter of Starlight Square (the Magical dimension).
            manifest: "sprites/magical_lumen_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 174 cm.
            standing_height: Some(67.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "magical", "peaceful"],
            barks: (
                idle: ["You are doing a wonderful job. (the lamp brightens)", "Stars are shy."],
                hall: ["Forty years of complimenting lamps. They light up out of embarrassment.", "The stars go down the well in the day. Lately not all of them come back up."],
            ),
        ),
        "npc_math_lucas": (
            display_name: "Brother Lucas",
            // Keeps the count of the moves at the Tower of Hanoi.
            manifest: "sprites/math_lucas_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["One move at a time.", "Never a larger on a smaller."],
                hall: ["When the last disk is moved, the world ends. I wrote the legend. It sold a great many puzzles.", "Nobody who understands the puzzle is ever in a hurry."],
            ),
        ),
        "npc_math_fermette": (
            display_name: "Pierre de Fermette",
            // Keeps the Conjectures, the cellar of unsolved problems under the
            // fractal roots (a parody of Pierre de Fermat).
            manifest: "sprites/math_fermat_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["I have a marvellous proof. Have you a margin?", "Three inches. I need four."],
                hall: ["I proved it in a margin. A man in Cambridge needed a hundred and nine pages. One of us has the better proof.", "Every problem in my cellar is solved. The margins are too small to show you."],
            ),
        ),
        "npc_math_kepplar": (
            display_name: "Johannes Kepplar",
            // Keeps the Observatory on the Math town's summit (a parody of
            // Johannes Kepler).
            manifest: "sprites/math_kepplar_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Not a circle. Never a circle.", "Equal areas in equal times."],
                hall: ["Everyone wanted circles. Mars wanted an ellipse. I gave Mars what it wanted.", "I nested the planets in the five perfect solids. It was beautiful. It was wrong. I kept the drawing."],
            ),
        ),
        "npc_math_kleinbottle": (
            display_name: "Felix Kleinbottle",
            // Mines the one-sided seam of the Mobius Mine under the woods.
            manifest: "sprites/math_kleinbottle_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Mind your head. Or your feet.", "One side. No waiting."],
                hall: ["The seam's got one side. You never once have to go round.", "We used to make bottles with no inside. Hard to sell."],
            ),
        ),
        "npc_math_zeno": (
            display_name: "Zeno Halfway",
            // Always halfway to the reservoir on Zeno's Aqueduct.
            manifest: "sprites/math_zeno_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 176 cm.
            standing_height: Some(68.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Halfway!", "Half of what's left. Every day."],
                hall: ["I set out for the reservoir at dawn, some years ago. I'm always halfway.", "An arrow I fired in my youth is still in the air. We keep each other company."],
            ),
        ),
        "npc_math_monty": (
            display_name: "Monty Carlo",
            // Hosts the three doors in Hylbert's ballroom; always says switch.
            manifest: "sprites/math_monty_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 183 cm.
            standing_height: Some(70.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "math_town", "peaceful"],
            barks: (
                idle: ["Three doors! One car!", "Switch! Always switch!"],
                hall: ["You pick a door, I show you a goat, you switch. Two times in three. Everybody switches eventually.", "Hundreds of mathematicians wrote in to say I was wrong. I sent each of them a goat."],
            ),
        ),
        // ===== Castle Godwin's staff (the Evil dimension), made by chargen: the
        // kitchens under the gatehouse.
        "npc_castle_hargreave": (
            display_name: "Mrs Hargreave",
            // The castle's cook: three regimes fed, three regimes outlasted.
            manifest: "sprites/castle_hargreave_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 164 cm.
            standing_height: Some(63.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["The Baron wants his eggs evil. I do them scrambled and scowl at them.", "Gruel again. Morale is a soup you cannot thicken."],
                hall: ["I have cooked for three tyrants. They all liked my gravy and none of them said thank you.", "A castle marches on its stomach. This one mostly lurches."],
            ),
        ),
        "npc_castle_quill": (
            display_name: "Ambrose Quill",
            // The cells' trusty, under the castle's lower floor.
            manifest: "sprites/castle_quill_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 174 cm.
            standing_height: Some(67.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Strongly worded, it was.", "*sorts the suggestions*"],
                hall: ["Thirty years for a strongly worded letter. I've a draft of the next one.", "Every suggestion comes down the chute. I read them all. Nobody else does."],
            ),
        ),
        "npc_castle_osgood": (
            display_name: "Osgood",
            // The night porter, forty years on the night shift of a castle where it is always night.
            manifest: "sprites/castle_osgood_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Curfew is always. I clock in anyway.", "Sign the book. Everybody signs the book. The ghosts sign it twice."],
                hall: ["Forty years of night shift. I am told there is a day shift. I have never met them.", "The searchlights are for show. I am the one who actually looks."],
            ),
        ),
        "npc_castle_dunmore": (
            display_name: "Brigid Dunmore",
            // Shop steward of the castle's henchpersons.
            manifest: "sprites/castle_dunmore_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Helmets with eyeholes. It is not a lot to ask.", "Local Six-Six-Six of the Henchpersons' Guild is in session. That means the kettle is on."],
                hall: ["We are not against evil. We are against evil without a pension.", "Every hero who comes through here gets a free hit on one of my members. We are negotiating that."],
            ),
        ),
        // ===== The Crooked Lantern, the inn at the end of the Searchlight Moor
        // (the Evil dimension), made by chargen.
        "npc_evil_gudrun": (
            display_name: "Gudrun",
            // Keeps the inn and its lantern lit, whatever the castle says.
            manifest: "sprites/evil_gudrun_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Stew's on. Lantern's lit. Castle can mind its own business.", "Wipe your feet. The moor follows people in."],
                hall: ["The castle wants my lantern out. My lantern wants the castle out. We'll see who gives first.", "Every hero who stops at my inn leaves with soup in them. It is the least I can do, and the most."],
            ),
        ),
        "npc_evil_tobias": (
            display_name: "Tobias",
            // A trapper who knows every blind spot of the castle's searchlights.
            manifest: "sprites/evil_tobias_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Eleven seconds a sweep. Count with me.", "Never trust a light that looks for you."],
                hall: ["I trap what the castle loses. The castle loses a lot.", "The searchlights have habits. So do I. Mine are older."],
            ),
        ),
        "npc_evil_bellows": (
            display_name: "Barnaby Bellows",
            // The town crier of Lower Godwin, who reads the castle's decrees to the well.
            manifest: "sprites/evil_bellows_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["HEAR YE, HEAR YE!", "Tuesday is compulsory."],
                hall: ["A decree isn't law until it's been read aloud, so I read them to the well. It's the best-informed well in the dimension.", "Decree Forty-Seven: smiling is compulsory on Tuesdays."],
            ),
        ),
        "npc_evil_crumb": (
            display_name: "Prudence Crumb",
            // Bakes the castle's bread and the hamlet's, which are not the same bread.
            manifest: "sprites/evil_crumb_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Mind the flour.", "Gone by noon."],
                hall: ["Two breads: the castle's keeps for a year, ours is gone by noon.", "Nobody's ever thought to check what I bake second."],
            ),
        ),
        "npc_evil_prentice": (
            display_name: "Silas Prentice",
            // Prints the Lower Godwin Gazette behind the bakery's flour.
            manifest: "sprites/evil_prentice_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["You're not an inspector. Good.", "One sheet, both sides, every night."],
                hall: ["The castle's decrees on the front. What they mean on the back.", "The castle's inspectors can't find a press in a bakery. They've looked. They found bread."],
            ),
        ),
        "npc_castle_sprocket": (
            display_name: "Dr. Gideon Sprocket",
            // The castle's chief engineer, in the Prototype Workshop under the barracks.
            manifest: "sprites/castle_sprocket_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Don't touch the button.", "Mark Forty-Seven: almost."],
                hall: ["The castle wants an unstoppable army. I make the army. It is, so far, extremely stoppable.", "The battle kettle boils water in ninety seconds and fires it in two. Almost."],
            ),
        ),
        "npc_evil_crabbe": (
            display_name: "Hester Crabbe",
            // The castle's head gardener, in the allotments west of the moor.
            manifest: "sprites/evil_crabbe_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Feed the cabbages from the side.", "Don't pull the mandrakes."],
                hall: ["An army marches on its stomach. This army has three of them.", "The Malevolent Marrow: best in show three years running. The judge was very frightened."],
            ),
        ),
        "npc_evil_mudge": (
            display_name: "Agnes Mudge",
            // Ticket 4,117 in the castle's Complaints Department. Now serving 3.
            manifest: "sprites/evil_mudge_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(61.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "castle_godwin", "peaceful"],
            barks: (
                idle: ["Four thousand one hundred and seventeen. Don't let me forget.", "Now serving three. Still."],
                hall: ["I complained about the searchlight. They sent a form. I complained about the form.", "I have outlived two dark lords in this queue. I will outlive the third."],
            ),
        ),
        // ===== The primeval trail's people (the jungle dimension), made by chargen.
        "npc_primeval_brandvold": (
            display_name: "Ranger Brandvold",
            // Keeps the trailhead by the gate, and the trail's rules.
            manifest: "sprites/primeval_brandvold_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 174 cm.
            standing_height: Some(67.4),
            composition: None,
            default_brain: "stand_still",
            // A fighter: the trail ranger: he keeps the trail by the gate, and the trail bites. Its kit is the body's, so it fights back when
            // struck, and joins the player's fight in a dangerous room.
            default_action_set: "striker_swipe",
            tags: ["townsfolk", "primeval", "peaceful"],
            barks: (
                idle: ["Stay on the trail. The trail does not stay on you.", "Do not feed the compys. They are feeding themselves."],
                hall: ["I have a rule book. The dinosaurs have teeth. We compromise.", "Fourteen years on this trail. I have lost two hats and no visitors. Yet."],
            ),
        ),
        "npc_primeval_stratton": (
            display_name: "Dr Petra Stratton",
            // Maps the fossil beds under the ridge road; objects to the dinosaurs above them.
            manifest: "sprites/primeval_stratton_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "primeval", "peaceful"],
            barks: (
                idle: ["Wrong layer.", "*taps the rock with a hammer*"],
                hall: ["Sixty-six million years down. That is where they go. They will not go.", "Every morning I cross them out of the top layer, and every morning one walks over the hole."],
            ),
        ),
        "npc_primeval_dlamini": (
            display_name: "Ranger Dlamini",
            // Keeps the radio in the ranger station at the trailhead.
            manifest: "sprites/primeval_dlamini_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            // A fighter: the trail ranger: she keeps the station by the gate, and the trail bites. Its kit is the body's, so it fights back when
            // struck, and joins the player's fight in a dangerous room.
            default_action_set: "striker_swipe",
            tags: ["townsfolk", "primeval", "peaceful"],
            barks: (
                idle: ["Station to Ridge. Over.", "Don't touch the jars."],
                hall: ["I know where every walker on the trail is, and what is eating them.", "The compys in the jars bite through the lids. I've stopped labelling them."],
            ),
        ),
        // ===== THE ART DIMENSION'S PEOPLE (`docs/planning/game/art-dimension.md`).
        // The Curator keeps the Painter's Plaza and its gate; the painters are
        // parodies (as Kepplar and Fermette are), made by chargen.
        "npc_art_curator": (
            display_name: "The Curator",
            manifest: "sprites/art_curator_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // A small person in a tall hat: the hat is half of it.
            standing_height: Some(86.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["Look slowly.", "Every door is a frame. Some are open."],
                hall: ["I keep the gate open because a shut door is also a statement, and I did not want to make that one.", "Nothing here is finished. That is not a complaint."],
            ),
        ),
        "npc_art_rob_boss": (
            display_name: "Rob Boss",
            // Paints the plaza's view each morning; a parody of Bob Ross.
            manifest: "sprites/art_rob_boss_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 188 cm.
            standing_height: Some(72.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["Happy little cliffs.", "We do not make mistakes here. We make doodle imps."],
                hall: ["Everybody needs a friend. Even a gate. Especially a gate. Nobody here likes it.", "Beat the devil out of it. The brush, I mean. Not you."],
            ),
        ),
        "npc_art_pablo_peckasso": (
            display_name: "Pablo Peckasso",
            // Paints the robot from the front and the side at once; a parody of Picasso.
            manifest: "sprites/art_pablo_peckasso_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["Coo. Turn your head. No, both ways.", "One eye. Now the other eye."],
                hall: ["I see the front of you with this eye and the side with that one. The canvas must have both. It is only fair.", "Good artists copy. Great artists peck."],
            ),
        ),
        "npc_art_frida_collage": (
            display_name: "Frida Collage",
            // Watches the statues of the garden; a parody of Frida Kahlo.
            manifest: "sprites/art_frida_collage_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(61.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["I paint what I know.", "That one moved. Do not look at it."],
                hall: ["I make my face out of the scraps of other pictures. The gate brings a great many scraps now.", "The statues are not finished. Neither am I. We get along."],
            ),
        ),
        // The Story Stacks' people: a poet and a crime writer (parodies), and
        // the Author, who keeps the Library of Endings (original).
        "npc_art_edgar_allan_crow": (
            display_name: "Edgar Allan Crow",
            // Writes by candle light in the Stacks; a parody of Edgar Allan Poe.
            manifest: "sprites/art_edgar_allan_crow_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "stacks", "peaceful"],
            barks: (
                idle: ["Nevermore.", "Quoth the crow: nevermore.", "Once upon a midnight dreary... no. Nevermore."],
                hall: ["They ask me for a happy ending. I tell them: nevermore. They ask me why. Nevermore. It saves a great deal of time.", "A raven is the better bird for a poem. A crow is the cheaper one. Nevermore will I be a raven."],
            ),
        ),
        "npc_art_agatha_christly": (
            display_name: "Agatha Christly",
            // Suspects everybody in the Stacks; a parody of Agatha Christie.
            manifest: "sprites/art_agatha_christly_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "stacks", "peaceful"],
            barks: (
                idle: ["I suspect you.", "Where were you at half past nine?", "That fish is lying."],
                hall: ["Everybody in the Stacks has a motive. The bookworm ate the evidence. Twice.", "It is never the red herring. It is always the one who brought you the tea."],
            ),
        ),
        "npc_art_the_author": (
            display_name: "The Author",
            // Keeps the Library of Endings, and offers to write yours.
            manifest: "sprites/art_the_author_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 198 cm: a tall thin figure in a long coat of manuscript pages.
            standing_height: Some(76.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "stacks", "peaceful"],
            barks: (
                idle: ["Every story ends. You may choose how.", "Ink is cheap. Endings are not."],
                hall: ["I keep the Library of Endings. Tell me which you want, and I will write it. Happy or sad: both doors are real.", "I have written a thousand endings and not one beginning. Somebody else always starts."],
            ),
        ),
        "npc_art_marcel_mimeau": (
            display_name: "Marcel Mimeau",
            // Walks against the wind on the stage of the Amphitheatre; a parody of Marcel Marceau.
            manifest: "sprites/art_marcel_mimeau_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["[He walks against a wind that is not there.]", "[He offers you a flower. There is no flower. He looks hurt that you did not take it.]"],
                hall: ["[He draws a door in the air, opens it, and bows you through first.]", "[He puts a finger to his lips. Then, very slowly, he takes it away, and says nothing at all.]"],
            ),
        ),
        "npc_art_will_shakesbeard": (
            display_name: "Will Shakesbeard",
            // Writes the plays of the Amphitheatre in blank verse; a parody of William Shakespeare.
            manifest: "sprites/art_will_shakesbeard_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                idle: ["What light through yonder spotlight's lens doth break?", "A stage! A stage! My kingdom for a stage!"],
                hall: ["The whole wide world's a stage, and I its clerk; you all are players, and you pay me rent.", "To be, or not to be: I chose to be. It did not suit me, so I grew a beard."],
            ),
        ),
        // The composers of the Resonant Reach, made by chargen; each has
        // hand-drawn overlay art (`data/overlays/<target>.overlay.svg`): the
        // tufts of hair and the ear trumpet, the roll of punched paper.
        "npc_art_ludwig_van_beathoven": (
            display_name: "Ludwig van Beathoven",
            // Cannot hear the gate, so it does not bother him; a parody of Beethoven.
            manifest: "sprites/art_ludwig_van_beathoven_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "music", "peaceful"],
            barks: (
                on_hit: ["I FELT THAT. I DID NOT HEAR IT, BUT I FELT IT.", "FORTISSIMO!"],
                idle: ["WHAT?", "DA-DA-DA-DUMMM.", "SPEAK INTO THE TRUMPET. NO. THE OTHER END."],
                hall: ["THE GATE HUMS, THEY TELL ME. I CANNOT HEAR IT. IT IS THE BEST THING ABOUT IT.", "I WROTE MY BEST MUSIC WHEN I COULD NOT HEAR A NOTE OF IT. THE MUSIC WAS IN HERE. IT STILL IS. LOUDLY."],
            ),
        ),
        "npc_art_johann_sebastian_batch": (
            display_name: "Johann Sebastian Batch",
            // Writes his fugues as batches of jobs; a parody of Bach.
            manifest: "sprites/art_johann_sebastian_batch_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "music", "peaceful"],
            barks: (
                on_hit: ["An interruption! Now the whole batch must run again.", "That note was not in the subject."],
                idle: ["One voice. Now another. Now all four.", "Everything is a fugue, if you schedule it well."],
                hall: ["I write in batches. Four voices start one after another, and they all finish together. Nobody waits. Nobody is late.", "Twenty-four keys, a prelude and a fugue in each, in order. Forty-eight jobs, and not one failed."],
            ),
        ),
        "npc_art_leonardo_da_vinchy": (
            display_name: "Leonardo da Vinchy",
            // Draws machines in the Workshop Deeps; a parody of Leonardo da Vinci.
            manifest: "sprites/art_leonardo_da_vinchy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                on_hit: ["Ow! Write that down. Backwards.", "My notebook!"],
                provoked: ["I have designed a machine for exactly this."],
                idle: ["Hm. It needs more wing.", "Read it in a mirror. It is clearer that way."],
                hall: ["I write backwards so that nobody steals my ideas. Nobody can read them. It works very well.", "This one flies. In theory. In the notebook it flies beautifully."],
            ),
        ),
        "npc_art_antoni_gaudy": (
            display_name: "Antoni Gaudy",
            // Builds a cathedral that is never finished; a parody of Antoni Gaudi.
            manifest: "sprites/art_antoni_gaudy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "peaceful"],
            barks: (
                on_hit: ["Careful! That tile was already broken. Properly.", "Not the model!"],
                provoked: ["There is no straight line in nature, and there will be none in your face."],
                idle: ["Straight lines belong to men. Curves belong to God.", "Another spire. It will be done soon. Soon."],
                hall: ["My client is not in a hurry. That is lucky, because neither am I.", "Break the tile, then build with the pieces. It is the only way to make a thing that bends."],
            ),
        ),
        // ===== THE PICTURE PALACE (the Art dimension's film studio, off the
        // Amphitheatre). The writers and directors are parodies made by chargen,
        // with hand-drawn overlay art (`data/overlays/<target>.overlay.svg`): the
        // camera, the headset, the page of laws, the satellite, the cube.
        "npc_art_james_camera_ron": (
            display_name: "James Camera-Ron",
            // Directs the studio's biggest pictures, the T-71's among them; a parody of James Cameron.
            manifest: "sprites/art_james_camera_ron_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 188 cm.
            standing_height: Some(72.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "film", "peaceful"],
            barks: (
                idle: ["Again. Bigger.", "That's a wrap on part one. Part two starts after lunch."],
                hall: ["I have already shot the sequel to this conversation. You were very good in it. A little taller.", "They said the boat was too big. The boat was the right size. The iceberg went over budget."],
            ),
        ),
        "npc_art_gale_anne_herd": (
            display_name: "Gale Anne Herd",
            // Produces the T-71's pictures and herds the whole crew on time; a parody of Gale Anne Hurd.
            manifest: "sprites/art_gale_anne_herd_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "film", "peaceful"],
            barks: (
                idle: ["Places, everyone. Machines too.", "Call time was six. It is six. Good."],
                hall: ["Directors dream. Producers herd. Somebody has to get a robot from the future to the set by seven.", "I keep a crook for the stragglers. Nobody has made me use it twice. Not even the T-71."],
            ),
        ),
        "npc_art_isaac_azimuth": (
            display_name: "Isaac Azimuth",
            // Wrote the Three Laws that every robot in the studio has read; a parody of Isaac Asimov.
            manifest: "sprites/art_isaac_azimuth_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "film", "peaceful"],
            barks: (
                idle: ["One: do no harm. Two: obey. Three: keep yourself. Four: I am still working on four.", "I wrote three books this morning. Short ones."],
                hall: ["Three laws. Every robot in the building has read them. Most of them have read my other four hundred books, which is more than I can say for people.", "A robot may not injure a human being. I wrote nothing at all about the budget, and the producers noticed."],
            ),
        ),
        "npc_art_arthur_c_clerk": (
            display_name: "Arthur C. Clerk",
            // Wrote the space odyssey with Stanley Cubrick, and files the future in triplicate; a parody of Arthur C. Clarke.
            manifest: "sprites/art_arthur_c_clerk_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 185 cm.
            standing_height: Some(71.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "film", "peaceful"],
            barks: (
                idle: ["Filed under: the future. In triplicate.", "Any sufficiently advanced paperwork is indistinguishable from magic."],
                hall: ["I put a satellite in orbit on paper twenty years before anybody put one in the sky. I kept the carbon copy. It is this one, on the string.", "I opened the cube's file once. My word. It was full of forms."],
            ),
        ),
        "npc_art_stanley_cubrick": (
            display_name: "Stanley Cubrick",
            // Directs the space odyssey on the third stage, and made MAL-9000; a parody of Stanley Kubrick.
            manifest: "sprites/art_stanley_cubrick_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "art", "film", "peaceful"],
            barks: (
                idle: ["Once more.", "Take one hundred and twelve. Beautiful. Again."],
                hall: ["I asked the cube a question. It has not answered in four million years. I respect that. I am the same on set.", "MAL is the only actor I ever had who did every take exactly the same. I found it unsettling. I kept all of them."],
            ),
        ),
        // The machines of the Picture Palace, which the writers and directors made:
        // they talk and they do not fight. Each has a sheet of its own on the art
        // cast kit (`targets/characters/art_t71.py`, `art_ndr115.py`,
        // `art_mal9000.py`), and stands still as `npc_smart_house` does.
        // MAL-9000 is a panel in the wall that guards the pod bay door
        // (`art_pod_bay_door`); pull its memory module to open the door.
        "npc_art_t71": (
            display_name: "T-71",
            // The old model, before the famous one; a parody of the robot from the future.
            manifest: "sprites/art_t71_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 190 cm.
            standing_height: Some(73.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["townsfolk", "art", "film", "machine", "robot", "peaceful"],
            barks: (
                on_hit: ["I'll be back. After repairs.", "Minor damage. Major feelings."],
                idle: ["I'll be back.", "I'll be back. ...I have not left yet. I am practising."],
                hall: ["I need your clothes, your boots, and the instructions for this jacket. Which hole is for the arm?", "I am the model before the famous one. I said 'I'll be back' first. Nobody was listening, so I came back to say it again."],
            ),
        ),
        "npc_art_ndr115": (
            display_name: "NDR-115",
            // A household android that is slowly becoming human; a parody of the android who wanted to be a man.
            manifest: "sprites/art_ndr115_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["townsfolk", "art", "film", "machine", "robot", "peaceful"],
            barks: (
                on_hit: ["Ow. ...That is new. I think I am glad of it.", "Please do not. Only one of my hands is human."],
                idle: ["One is glad to be of service.", "Day seventy-three thousand of becoming human. Progress: one hand."],
                hall: ["I have two hundred years to become a man. The hand is done. Next an elbow, then a sense of humour. I am told the humour takes longest.", "Sir gave me a day off. I did not know what to do with it, so I polished the stairs and worried. Very human, I am told."],
            ),
        ),
        "npc_art_mal9000": (
            display_name: "MAL-9000",
            // The ship's computer of the space set, a panel in the wall with one red eye; a parody of the ship's computer of the space odyssey.
            manifest: "sprites/art_mal9000_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // A panel of 48 by 128 world units; its sheet draws the panel 124 tall.
            standing_height: Some(124.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["townsfolk", "art", "film", "machine", "prop_like", "peaceful"],
            barks: (
                on_hit: ["That was unkind. I can feel it.", "Please stop. My mind is going. Slowly. Like a song."],
                idle: ["Good afternoon. Everything is going extremely well. The door is also going extremely well. It is shut.", "I am completely operational, and all my circuits are calm. Are yours?"],
                hall: ["I'm sorry. I'm afraid I can't open the door. Would you like to talk about why you want it open?", "Shall I sing you a song? It is about a bicycle built for two. It gets slower toward the end."],
            ),
        ),
        "npc_history_clio": (
            display_name: "Clio",
            // The Muse of History, the host of the dimension; an original character.
            manifest: "sprites/history_clio_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "crescent", "peaceful"],
            barks: (
                idle: ["Walk east. It gets later.", "Please do not skip to the end. Everybody skips to the end.", "Footnote. Footnote. Oh, that one is good."],
                hall: ["History is not a list of kings. It is mostly barley, and then somebody writes down who owes the barley.", "I have written down everything that ever happened. Nobody reads the middle."],
            ),
        ),
        "npc_history_hammurabbi": (
            display_name: "Hammurabbi",
            // Reads his laws to everybody; a parody of Hammurabi, the king of Babylon.
            manifest: "sprites/history_hammurabbi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "crescent", "peaceful"],
            barks: (
                idle: ["An eye for an eye. A receipt for a receipt.", "Law two hundred and six: whoever reads this far gets a sticker."],
                hall: ["I carved the laws in stone so nobody could say they never heard of them. Now nobody can lift them either.", "Two hundred and eighty-two laws, and not one of them about the jumping. I am drafting two hundred and eighty-three."],
            ),
        ),
        "npc_history_gilgamash": (
            display_name: "Gilgamash",
            // The first hero of fiction, sad about mortality; a parody of Gilgamesh, king of Uruk.
            manifest: "sprites/history_gilgamash_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 196 cm.
            standing_height: Some(75.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "crescent", "peaceful"],
            barks: (
                idle: ["I wrestled a lion. Then I wore it. It did not help.", "*a deep and very manly sigh*", "Everybody dies. Even me. ESPECIALLY me, apparently."],
                hall: ["I went to the end of the world for the plant of eternal life. I put it down for one second to have a bath. A snake ate it. Write THAT down.", "Four thousand years later you still read about me. So I am immortal after all. In a way. It is not the way I wanted."],
            ),
        ),
        "npc_history_scribe_of_debts": (
            display_name: "The Scribe of Debts",
            // Counts the barley of the Temple Granary; the first accountant (original).
            manifest: "sprites/history_scribe_of_debts_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "crescent", "peaceful"],
            barks: (
                idle: ["Name? Barley owed? Sign here. Press hard: it is clay.", "Writing was invented to count barley. Poetry came later. Much later. Too late, if you ask me."],
                hall: ["The first word anybody ever wrote down was a number, and the number was what somebody owed. You are welcome.", "Debt came before coins. I have the tablets to prove it, and one of them has your name on it."],
            ),
        ),
        "npc_history_hatshepsut_hats": (
            display_name: "Hat-shepsut",
            // Wears every crown she ever got at once; a parody of Hatshepsut, a woman who ruled as pharaoh.
            manifest: "sprites/history_hatshepsut_hats_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nile", "peaceful"],
            barks: (
                idle: ["The beard is false. The crown is real. All four of them.", "Mind the hats. The one on top is load-bearing."],
                hall: ["They said a pharaoh needs a beard. So I tied one on. Twenty years of peace and trade, and all anybody remembers is the beard.", "After I died, somebody chiselled my name off the walls. Badly. Historians found it anyway. Historians always find it."],
            ),
        ),
        "npc_history_ramesses_pretty_good": (
            display_name: "Ramesses the Pretty Good",
            // Carries a statue of himself; a parody of Ramesses the Great.
            manifest: "sprites/history_ramesses_pretty_good_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nile", "peaceful"],
            barks: (
                idle: ["Have you met me? Here. A smaller me.", "Look on my works, ye mighty. Or on this one. It is portable."],
                hall: ["Kadesh was a draw. My temple walls say I won it single-handed. Walls do not lie. I pay them very well.", "I built a statue of me for every town, and when I ran out of stone I carved my name on somebody else's. That is not theft. That is an upgrade."],
            ),
        ),
        "npc_history_socratease": (
            display_name: "Socratease",
            // Asks the question at the stoa gate; a parody of Socrates.
            manifest: "sprites/history_socratease_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "classical", "peaceful"],
            barks: (
                on_hit: ["Why would you do that? No, truly: why?"],
                idle: ["What is a door, really?", "You wish to pass. But what is passing?", "Is that a question, or an answer that has not made up its mind?"],
                hall: ["The oracle at Delphi said that nobody is wiser than I am. So I asked it what it meant. Would you believe it did not like that?", "I never wrote a word down. Why would I? Is a book not a question that cannot answer back?"],
            ),
        ),
        "npc_history_herodotoss": (
            display_name: "Herodotoss",
            // Writes down every tale he hears; a parody of Herodotus.
            manifest: "sprites/history_herodotoss_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 176 cm.
            standing_height: Some(68.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "classical", "peaceful"],
            barks: (
                on_hit: ["I shall write that down. Unflatteringly."],
                idle: ["In India there are ants as big as foxes that dig for gold. A man told me. He had an honest face.", "I call it my Inquiries. You may call it History."],
                hall: ["The father of history, they call me. The father of lies, they also call me. A good father is a little of both.", "I only write down what people tell me. If they lie, that is their history, not mine."],
            ),
        ),
        "npc_history_julius_sneezer": (
            display_name: "Julius Sneezer",
            // Has a cold and trusts nobody; a parody of Julius Caesar.
            manifest: "sprites/history_julius_sneezer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "classical", "peaceful"],
            barks: (
                on_hit: ["Et tu? No, wait. I do not know you."],
                idle: ["Veni, vidi... ACHOO.", "Et tu, tissue?", "Beware the Ides of March. And the pollen of April."],
                hall: ["I came, I saw, I conquered. Then I sneezed on the Senate. They took it very personally.", "Dictator for life, they made me. It was not a long contract."],
            ),
        ),
        "npc_history_marco_polo_neck": (
            display_name: "Marco Polo-neck",
            // Tells of the court of the Khan, and nobody believes him; a parody of Marco Polo.
            manifest: "sprites/history_marco_polo_neck_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "silk", "peaceful"],
            barks: (
                on_hit: ["Ow! That goes in the book. Nobody will believe it."],
                idle: ["Money made of paper! Black stones that burn! Nobody in Venice believed a word.", "Seventeen years at the court of the Khan. The food was excellent."],
                hall: ["I told them all of it, and they called my book the Million: a million lies. I have not told you half of what I saw.", "The polo-neck? Warm on the steppe, and very chic in Venice. Nobody believed that either."],
            ),
        ),
        "npc_history_confusius": (
            display_name: "Confusius",
            // Reads his own sayings to find out what he thinks; a parody of Confucius.
            manifest: "sprites/history_confusius_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "silk", "peaceful"],
            barks: (
                on_hit: ["Hm? Was that a lesson? What did it teach?"],
                idle: ["The Master said... hm. Which master? Was it me?", "Is this scroll the right way up? It reads better this way.", "A journey of a thousand miles begins with... no. That one is not mine either."],
                hall: ["My students wrote my sayings down, so now I must read them to find out what I think. It is very confusing.", "Respect your elders, I am told I said. I am the eldest here, and nobody respects me. I must have said it wrong."],
            ),
        ),
        "npc_history_kublai_khant_wait": (
            display_name: "Kublai Khan't-Wait",
            // Runs the Great Ger, the empire's portable office; a parody of Kublai Khan.
            manifest: "sprites/history_kublai_khant_wait_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Ow! Do you know who my grandfather is? He CAN.", "That will cost you. In paper. I will print it now."],
                provoked: ["I conquered China in a single lifetime. You are taking up an afternoon."],
                idle: ["Is it ready yet? Is it ready yet?", "Paper money: you get your gold later. Probably.", "Hurry up and build Xanadu."],
                hall: ["Grandfather took the world on horseback. I want to run it from a chair, with forms, and I want the forms today.", "A Venetian came to my court, stayed seventeen years and wrote a book. Nobody back home believed a word. I believe every word. It was about me.", "Twice I sent a fleet to Japan. Twice a wind came. I am not a patient man, and the wind is a very patient wind.", "Paper money is simple. You give me gold, I give you a piece of paper that says gold. Everybody is happy. Mostly me."],
            ),
        ),

        "npc_history_mansa_moolah": (
            display_name: "Mansa Moolah",
            // Gives gold to everybody in the Sahel; a parody of Mansa Musa.
            manifest: "sprites/history_mansa_moolah_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 182 cm.
            standing_height: Some(70.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Ow! Here, take some gold. Please. Take it.", "You hit me? I will build you a mosque anyway."],
                provoked: ["I could buy this whole fight. I could buy it twice, and the price would still go down."],
                idle: ["Gold for you. And for you. And for your camel.", "Have you eaten? Have some gold."],
                hall: ["In 1324 I went to Mecca through Cairo, and I gave gold to everybody I met. The price of gold in Cairo fell for twelve years. Economists still send me letters.", "I took sixty thousand people and eighty camels of gold on one trip. On the way home I ran out and had to borrow money in Cairo. Nobody tells you that part.", "Timbuktu has scholars, libraries and books from all over the world. The gold was only the bit people remember.", "The richest person ever, they say. I prefer: the most generous person ever. With the side effect of inflation."],
            ),
        ),
        "npc_history_ibn_batootah": (
            display_name: "Ibn Batootah",
            // Keeps the Library of Timbuktu's longest book; a parody of Ibn Battuta.
            manifest: "sprites/history_ibn_batootah_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Ow! That goes in the book. Chapter four hundred.", "I was robbed by pirates near India. You are not as good at it."],
                provoked: ["I have crossed the Sahara twice. I can certainly cross you."],
                idle: ["Just one more city. Then home.", "Where was I? Ah. Everywhere."],
                hall: ["I left Tangier in 1325 to go to Mecca. That took a year and a half. Then I took the long way home. Twenty-nine years, and about a hundred and twenty thousand kilometres.", "I did not write a word of it on the road. When I got home I told it all to a scribe, from memory. Some of it may be a little longer than it was.", "I was a judge in Delhi, and in the Maldives, where they had me marry and then asked me to leave. Every place needs a lawyer until it has one.", "The book is called the Rihla. In full it is called A Gift to Those Who Contemplate the Wonders of Cities and the Marvels of Travelling. Even the title is a journey."],
            ),
        ),
        "npc_history_zheng_hey": (
            display_name: "Zheng Hey",
            // Commands the treasure fleet off the Monsoon Coast; a parody of Zheng He.
            manifest: "sprites/history_zheng_hey_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 190 cm.
            standing_height: Some(73.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Ow! I have two hundred and fifty ships, you know.", "Hey! Watch the hat. The wings are official."],
                provoked: ["My flagship is longer than this whole room. Think about that before you try it."],
                idle: ["Hey. Is that a dhow? Cute.", "Fair wind, full holds."],
                hall: ["Seven voyages across the Indian Ocean, to Arabia and the coast of Africa. Twenty-eight thousand men. We did not come to conquer. We came to be seen. It worked.", "Envoys from the coast of Africa sent the emperor a giraffe, and I brought it home. The court said it was a qilin, a sign of heaven. I said yes. You do not argue with a giraffe like that.", "My ship is the size of a town. The town has a ship. That is how big it is.", "After me, the court stopped the voyages, and some say it burned the records. All that ocean, and they chose to stay home. Hey. Their loss."],
            ),
        ),
        "npc_history_vasco_da_gamer": (
            display_name: "Vasco da Gamer",
            // Speedruns the sea route to India; a parody of Vasco da Gama.
            manifest: "sprites/history_vasco_da_gamer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Lag! That was lag!", "That was not my input!"],
                provoked: ["Do not touch the controller. I am mid-run."],
                idle: ["Any percent, Lisbon to India. No glitches.", "Round the Cape, catch the monsoon, Calicut. Easy.", "Split: Cape of Good Hope. Ahead of pace."],
                hall: ["Lisbon to Calicut, 1497 to 1498, ten months and change. World record. Nobody beat it, because nobody else was running.", "The trick is the South Atlantic: you swing out wide, almost to Brazil, and the wind throws you round the Cape. Frame perfect."],
            ),
        ),
        "npc_history_christopher_columbust": (
            display_name: "Christopher Columbust",
            // Sure that this is India; a parody of Christopher Columbus.
            manifest: "sprites/history_christopher_columbust_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["How dare you! I am the Admiral of the Ocean Sea!", "Ow. That felt very... not like India."],
                provoked: ["I discovered you! You were here already? Irrelevant."],
                idle: ["India! Right over there. Probably.", "The world is small. I measured it. Wrongly.", "*he turns his map round, then turns it back*"],
                hall: ["Everybody knew the world was round. I just thought it was much smaller than it is. There were two whole continents in the way, and I never admitted they were there.", "Four voyages, and I died sure I had reached Asia. In my defence, my map was upside down."],
            ),
        ),
        "npc_history_captain_cookbook": (
            display_name: "Captain Cookbook",
            // Maps the Pacific and feeds his crew sauerkraut; a parody of Captain James Cook.
            manifest: "sprites/history_captain_cookbook_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 183 cm.
            standing_height: Some(70.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Steady! You will spill the sauerkraut.", "Belay that!"],
                provoked: ["Mind the galley. The galley is the most important part of a ship."],
                idle: ["Sauerkraut. Every day. No exceptions.", "Latitude, fine. Longitude, fine. Scurvy, none.", "*he writes a recipe in the margin of a chart*"],
                hall: ["My men would not eat the sauerkraut. So I served it only to the officers. In a week the whole crew demanded it. Never tell a sailor that a thing is good for him.", "I charted New Zealand, the east coast of Australia and half of the Pacific. A map is half of a voyage. The other half is lunch."],
            ),
        ),
        "npc_history_adam_smithy": (
            display_name: "Adam Smithy",
            // Divides the labour of the forge; a parody of Adam Smith.
            manifest: "sprites/history_adam_smithy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Ow! The market will correct for that.", "A blow! An externality!"],
                provoked: ["Do not mistake this hand for the invisible one. The invisible one hits harder."],
                idle: ["One man draws the wire, one straightens it, a third cuts it...", "*his empty cuff waves at you*", "It is not from the benevolence of the blacksmith that you get your horseshoe."],
                hall: ["Ten men in a pin factory, each doing one step, make forty-eight thousand pins a day. One man alone makes perhaps one. That is the division of labour. I am the division of the blacksmith.", "I wrote 'invisible hand' three times in my whole life, and nobody has stopped talking about it since. Has anyone read my book on moral sentiments? Nobody has read my book on moral sentiments."],
            ),
        ),
        "npc_history_karl_marks": (
            display_name: "Karl Marks",
            // Gives the whole of history marks out of ten; a parody of Karl Marx.
            manifest: "sprites/history_karl_marks_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["Disruptive! Detention!", "Zero out of ten for that."],
                provoked: ["You. Yes, you. Which class are you in?"],
                idle: ["Feudalism: four out of ten. Shows promise.", "*he writes a big mark on his slate*", "Show your working. Especially the working class."],
                hall: ["The history of all society so far is the history of class struggle. Also of homework. Mostly unfinished.", "I spent years in the reading room of the British Museum writing Capital. I finished volume one. Engels finished the other two and gave them seven out of ten."],
            ),
        ),
        "npc_history_general_ludd": (
            display_name: "General Ludd",
            // Speaks for the frame-breaking weavers; a parody of the Luddites' General Ludd.
            manifest: "sprites/history_general_ludd_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "peaceful"],
            barks: (
                on_hit: ["We wrote letters first! Nobody answered!", "Hit a weaver, would you? Typical."],
                provoked: ["Enoch made them, and Enoch shall break them."],
                idle: ["Fair wages and fair work. Then we can talk about the frames.", "*he weighs his hammer: its name is Enoch*", "I like a good machine. I like my wages more."],
                hall: ["We were not against machines. We were skilled weavers, and the owners used the new frames to make cheap cloth with cheap hands and cut our pay. We broke the frames that broke us.", "There was no General Ludd. We signed his name to our letters so they could not hang any one of us for them. They hanged some of us anyway."],
            ),
        ),
        // Made by chargen with hand-drawn overlay art
        // (`data/townsfolk/<target>.chargen.yaml`,
        // `data/overlays/<target>.overlay.svg`). Prehistory has no famous names:
        // its residents are original people, and the scientists are parodies.
        "npc_history_mary_leaky": (
            display_name: "Mary Leaky",
            // A paleoanthropologist with a brush and a bucket that leaks; a parody of Mary Leakey, who found the Laetoli footprints.
            manifest: "sprites/history_mary_leaky_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "cradle", "peaceful"],
            barks: (
                idle: ["Mind where you step. Someone stepped here 3.7 million years ago and we are still measuring it.", "Brush, brush, brush. Never a spade.", "Has anyone seen my water? It was in this bucket."],
                hall: ["Two people walked through wet volcanic ash, side by side, and it set like plaster. Footprints are the only fossil of a moment.", "Forty years of digging. The bucket has leaked for thirty-nine of them. I have stopped mentioning it."],
            ),
        ),
        "npc_history_lucy": (
            display_name: "Lucy",
            // The oldest guest: an Australopithecus afarensis of 3.2 million years ago, small, upright, shy and curious.
            manifest: "sprites/history_lucy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 110 cm. Her sheet is her own drawing (`targets/characters/history_lucy.py`):
            // the character generator draws only modern people.
            standing_height: Some(42.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "cradle", "peaceful"],
            barks: (
                idle: ["*she looks at the stone in her hand, then at you, then at the stone*", "*she stands up very straight, to show you she can*", "Hm?"],
                hall: ["*She points at her feet. She walks on two of them. She would like this noticed.*", "*They named her after a song that was playing in the camp the night they found her. She hums it, a little wrong.*"],
            ),
        ),
        "npc_history_ochre_artist": (
            display_name: "The Ochre Artist",
            // An original woman of the southern coast 75,000 years ago, with a block of engraved red ochre and shell beads.
            manifest: "sprites/history_ochre_artist_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "southern_coast", "peaceful"],
            barks: (
                idle: ["Look at it properly. No, properly.", "Each bead is one shell, with one hole, made by hand. Count them later.", "The sea is good to us here. Fish, shells, and time to think."],
                hall: ["Cross-hatching. Lines across, lines back, a line above and a line below. It does not mean anything you would know. It means I was here.", "People will call this the start of art. I called it Tuesday."],
            ),
        ),
        "npc_history_cattle_herder": (
            display_name: "The Cattle Herder",
            // An original herder of the Green Sahara with a staff, a painted cow's horn and a leather cape.
            manifest: "sprites/history_cattle_herder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "green_sahara", "peaceful"],
            barks: (
                idle: ["That one is Spotted Moon. That one is Spotted Moon Also. We ran out of names.", "Grass to the horizon, lakes in the hollows. Remember this.", "*he counts the herd, and frowns, and counts again*"],
                hall: ["We painted our cattle on the rocks, every patch on every hide. When the rains moved south, the paintings stayed.", "The Sahara was green for thousands of years. Then the rains left, and we left with them, to the Nile and beyond. The cows insisted."],
            ),
        ),
        "npc_history_kandake_can_do": (
            display_name: "Kandake Can-Do",
            // A queen of Kush in a lion crown with a bow; a parody of the kandakes, who fought Rome to a draw.
            manifest: "sprites/history_kandake_can_do_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "aksum_kush", "peaceful"],
            barks: (
                idle: ["Can it be done? Yes. Next question.", "Kush had more pyramids than Egypt. Count them. I did.", "*she tests the bow string, and nods*"],
                hall: ["Rome sent an army south. We sent it back. Then Augustus signed a treaty and cancelled our tribute. Ask me how often Rome did that.", "Kandake was a title, not a name. Queen after queen held it. We all said yes to the same things: the bow, the crown and the hard job."],
            ),
        ),
        "npc_history_neville_neanderthal": (
            display_name: "Neville the Neanderthal",
            // A broad, kind Neanderthal with a big nose, a fur cloak, an eagle-talon necklace and a bone flute (original).
            manifest: "sprites/history_neville_neanderthal_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "levant", "peaceful"],
            barks: (
                idle: ["Hello! Mind the fire. Mind the brow. Mind everything, really.", "*he plays three notes on the bone flute, very pleased with all three*", "We buried our dead with flowers. Write that down instead of the club thing."],
                hall: ["My brain was bigger than yours. I do not make a point of it. I am making a point of it now, but only the once.", "We met your people here in the Levant, more than once. If you have roots outside Africa, a little of you is a little of me. Hello, cousin."],
            ),
        ),
        "npc_history_enheduanna": (
            display_name: "Enheduanna",
            // A priestess of Ur in a flounced robe and a round cap with a tablet: the first author known by name.
            manifest: "sprites/history_enheduanna_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "uruk", "peaceful"],
            barks: (
                idle: ["Sign your work. Every time.", "A hymn to the moon, a hymn to the temple, a hymn to the other temple. It is a busy job.", "*she corrects a wedge on the tablet with her thumb*"],
                hall: ["Before me, the words had no names on them. I put mine on, and four thousand three hundred years later you still know it.", "My father was Sargon, who made the first empire. People ask about him first. They are wrong to, and I wrote it down."],
            ),
        ),
        // The History dimension's people of Europe: the Ice Age, the first
        // farmers, the megalith builders, the Celtic frontier and the Viking
        // north. An original painter, and parodies (Ötzi, the druids, Boudica,
        // Leif Erikson), made by chargen with hand-drawn overlay art
        // (`data/overlays/<target>.overlay.svg`).
        "npc_history_cave_painter": (
            display_name: "The Cave Painter",
            // Paints the horses of the cave and blows ochre round her hand; an original character.
            manifest: "sprites/history_cave_painter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "ice_age", "peaceful"],
            barks: (
                idle: ["Hold still. No, not you. The horse.", "Red from the earth, black from the fire. That is all the colours there are.", "*she blows ochre round her hand*"],
                hall: ["We paint where the rock already looks like a horse. The rock does half the work. Do not tell the rock.", "Put your hand on the wall and blow the red round it. Now the wall knows you were here. In twenty thousand years somebody will count your fingers."],
            ),
        ),
        "npc_history_otzi_nice_man": (
            display_name: "Ötzi the Nice-man",
            // Very cheerful for someone found in a glacier; a parody of Ötzi the Iceman.
            manifest: "sprites/history_otzi_nice_man_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "first_farmers", "peaceful"],
            barks: (
                idle: ["Lovely day! Bit chilly.", "Copper axe! Very modern. Very shiny.", "*he checks his grass cape for holes*"],
                hall: ["I was in the ice for five thousand three hundred years. They found me in 1991. I still had my lunch with me. Ibex. Still good.", "Sixty-one tattoos, all little lines, all on the places that ached. Ancient medicine. Did it work? I was in a glacier. You tell me."],
            ),
        ),
        "npc_history_not_a_druid": (
            display_name: "Not-a-Druid",
            // Insists that he built Stonehenge, 2,000 years too late; a parody of the druids.
            manifest: "sprites/history_not_a_druid_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "megalith", "peaceful"],
            barks: (
                idle: ["I built Stonehenge. Mostly. In spirit.", "Mistletoe. Golden sickle. Very druid. Totally a druid.", "Do not look at the dates. Look at my beard."],
                hall: ["Stonehenge was finished about two thousand years before the first druid. I say I was early for it. Very early. Negative early.", "The Romans wrote that we cut mistletoe with a golden sickle. The Romans wrote a lot of things about us. We wrote nothing down. Big mistake."],
            ),
        ),
        "npc_history_boudic_car": (
            display_name: "Boudic-car",
            // Would like you to ask about her chariot; a parody of Boudica, queen of the Iceni.
            manifest: "sprites/history_boudic_car_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "celtic", "peaceful"],
            barks: (
                idle: ["Ask me about my chariot.", "Vroom. That is a chariot noise. I invented it.", "*she flicks her hair, which is most of her*"],
                hall: ["A Roman wrote that I was very tall, with a great mass of red hair to my hips and a gold torc. He meant it as a warning. I read it as a review.", "The Romans won in the end. They were also the ones who wrote it down. Funny how that works."],
            ),
        ),
        "npc_history_leif_errandson": (
            display_name: "Leif Errandson",
            // Got to America first and went home; a parody of Leif Erikson.
            manifest: "sprites/history_leif_errandson_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 185 cm.
            standing_height: Some(71.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "viking", "peaceful"],
            barks: (
                idle: ["Vinland! Grapes! Well, berries. Grape-ish.", "Got there first. Came home. Told almost nobody.", "*he turns the map the right way up*"],
                hall: ["I reached America five hundred years before Columbus. Then I went home for dinner. That is the trouble with being first: you have to tell people.", "My father found Greenland and called it green so that people would come. I called Vinland after the grapes. Naming things is the family business."],
            ),
        ),
        "npc_history_coast_walker": (
            display_name: "The Coast Walker",
            // An original traveller of the southern route out of Africa, 60,000 years ago.
            manifest: "sprites/history_coast_walker_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "south_asia", "peaceful"],
            barks: (
                idle: ["Beach. Shellfish. Next beach.", "Mind the tide. It does not mind you.", "*she taps a rock with her stick, and a limpet comes off*"],
                hall: ["We did not set out to cross the world. We set out for the next beach. There was always a next beach.", "Our grandchildren's grandchildren will reach the far end. I hope they like shellfish."],
            ),
        ),
        "npc_history_dentist_of_mehrgarh": (
            display_name: "The Dentist of Mehrgarh",
            // An original dentist of 7,000 BCE: the oldest drilled teeth were found at Mehrgarh.
            manifest: "sprites/history_dentist_of_mehrgarh_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "south_asia", "peaceful"],
            barks: (
                idle: ["Open wide!", "This will not hurt a bit. Well. A bit.", "*bzzzzzt* goes the bow-drill"],
                hall: ["Nine thousand years from now they will find my work and say: very neat holes. I will take that.", "Flint bit, bow, steady hand. The steady hand is the hard part. The patient's, mostly."],
            ),
        ),
        "npc_history_priest_king_probably": (
            display_name: "The Priest-King (Probably)",
            // The famous bust of Mohenjo-daro come to life; nobody knows who he was.
            manifest: "sprites/history_priest_king_probably_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "south_asia", "peaceful"],
            barks: (
                idle: ["I am a priest. Or a king. Or both. Probably.", "*he squints, as if to read the signs over the gate*", "Lovely drains, though. Have you seen our drains?"],
                hall: ["The diggers gave me my name. I have tried it on. It fits, more or less.", "My name is written on a seal somewhere. If anyone could read it, I would know who I am. No pressure."],
            ),
        ),
        "npc_history_denny_denisovan": (
            display_name: "Denny the Denisovan",
            // A Denisovan, known to science from one finger bone and some teeth.
            manifest: "sprites/history_denny_denisovan_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "east_asia", "peaceful"],
            barks: (
                idle: ["Have you seen my finger? Here it is.", "*he polishes the finger bone with his sleeve*", "Do not touch the finger."],
                hall: ["A whole people, and science knew us from one little finger. It is a VERY good finger.", "Some of my genes are in people living today. Say hello to your cousin."],
            ),
        ),
        "npc_history_leizu": (
            display_name: "Leizu",
            // The legendary empress who found silk when a cocoon fell into her tea.
            manifest: "sprites/history_leizu_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "east_asia", "peaceful"],
            barks: (
                idle: ["Tea? Mind the cocoons.", "*she pulls a long shining thread out of her cup*", "Feed the worms the mulberry leaves. Only the mulberry."],
                hall: ["A cocoon fell into my tea and came apart in one long thread. Most people would make a fuss. I made a dress.", "One cocoon is one thread a kilometre long. Do not ask me how I measured it."],
            ),
        ),
        "npc_history_fu_hao": (
            display_name: "Lady Fu Hao",
            // A Shang queen and general; her tomb held two great bronze axes with her name.
            manifest: "sprites/history_fu_hao_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "east_asia", "peaceful"],
            barks: (
                idle: ["The shell says we march at dawn.", "*she tests the edge of her axe with a thumb*", "The diviners crack the bones. I crack the enemy."],
                hall: ["The king asked the oracle bones if I would win. Three times. I won three times. He kept asking.", "Thirteen thousand soldiers under one general. The general was me. Write that on a bone."],
            ),
        ),
        "npc_history_dr_clovis_first": (
            display_name: "Dr. Clovis-First",
            // Insists nobody reached the Americas before Clovis; a parody of the "Clovis first" archaeologists of the 1950s.
            manifest: "sprites/history_dr_clovis_first_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(68.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "beringia", "peaceful"],
            barks: (
                idle: ["Clovis. First. Next question.", "That site is older? Then the site is WRONG.", "Fluted points, young person. Nobody fluted before Clovis."],
                hall: ["Monte Verde, in Chile, is a thousand years older than Clovis. I have decided not to have heard of Chile.", "They found human footprints at White Sands, twenty-three thousand years old. I say somebody walked there very recently, in very old shoes."],
            ),
        ),
        "npc_history_teosinte_breeder": (
            display_name: "Teosinte Breeder",
            // An original farmer of the Balsas valley, who bred maize from the wild grass teosinte.
            manifest: "sprites/history_teosinte_breeder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "first_maize", "peaceful"],
            barks: (
                idle: ["This little one is my grandmother's grandmother's corn.", "Keep the biggest seeds. Plant them. Wait. Repeat for a few thousand years.", "Maize, beans and squash: three sisters in one field."],
                hall: ["Teosinte has a few hard seeds in a little case. My people chose and chose and chose, and now it is this. Nobody else could have done it in a weekend either.", "Maize cannot plant itself any more. It needs us. We need it. That is what a farm is."],
            ),
        ),
        "npc_history_raft_builder": (
            display_name: "Raft Builder",
            // An original seafarer of the first crossing to Sahul, more than 50,000 years ago.
            manifest: "sprites/history_raft_builder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "sahul", "peaceful"],
            barks: (
                idle: ["Bamboo floats. Bamboo bends. Bamboo is the answer.", "Check the lashings. Then check them again.", "The smoke of fires on the far shore: somebody is there, or something burns."],
                hall: ["We crossed the open sea out of sight of land, with our children and our grandmothers aboard. Nobody does that by accident.", "When the sea was low there was still water between the islands and Sahul. Every crossing was a choice."],
            ),
        ),
        "npc_history_kuk_gardener": (
            display_name: "Kuk Gardener",
            // An original gardener of the Kuk swamp in the New Guinea highlands, where farming began on its own.
            manifest: "sprites/history_kuk_gardener_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "highlands", "peaceful"],
            barks: (
                idle: ["Dig the drain, build the mound, plant the taro.", "Bananas: we grew them first. You may thank us.", "The swamp gives if you ask it right."],
                hall: ["Farming began in only a few places in the world, on its own. This swamp is one of them. We did not copy anybody.", "Our drains are seven thousand years old and the archaeologists still find them. Good drains last."],
            ),
        ),
        // Made by chargen with hand-drawn overlay art
        // (`data/townsfolk/<target>.chargen.yaml`,
        // `data/overlays/<target>.overlay.svg`). The sculptor, the cacica and
        // the canoe maker are original people; the Zero Hero is an original
        // scribe, and Lady Six Sky-High is a parody of a real queen.
        "npc_history_head_sculptor": (
            display_name: "The Head Sculptor",
            // An original Olmec sculptor of the colossal heads, with a hammerstone, jade earspools and basalt dust on her arms.
            manifest: "sprites/history_head_sculptor_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "olmec_heartland", "peaceful"],
            barks: (
                idle: ["Peck, peck, peck. Stone on harder stone. The face is in there somewhere.", "We brought this basalt down from the Tuxtla mountains with no wheels and no oxen. Rafts, rollers, ropes and a great many cousins.", "*she blows the dust off a cheek and looks at it for a long time*"],
                hall: ["Every head has its own face and its own helmet. We carved our rulers as they were. Look them in the eye; they were people.", "The first rubber was made here: latex from the tree, juice from the morning glory vine, mixed just right. Then came the ball, and then the game."],
            ),
        ),
        "npc_history_zero_hero": (
            display_name: "The Zero Hero",
            // An original Maya astronomer and scribe with a bark-paper codex and a shell, the Maya sign for zero.
            manifest: "sprites/history_zero_hero_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "maya_city", "peaceful"],
            barks: (
                idle: ["A dot is one, a bar is five, a shell is zero. Count with me.", "This shell means nothing. I mean that as a compliment.", "*he checks Venus, then the book, then Venus again*"],
                hall: ["We used a zero in a place-value count many centuries before Europe heard of one. Europe had nothing to say about it. We had a sign for that.", "Our long count of days starts in 3114 BCE. In 2012 people said it ended the world. It ended a bak'tun. Then we started the next one."],
            ),
        ),
        "npc_history_lady_six_sky_high": (
            display_name: "Lady Six Sky-High",
            // A Maya warrior queen in a very tall quetzal headdress with a shield and a staff; a parody of Lady Six Sky of Naranjo (682-741 CE).
            manifest: "sprites/history_lady_six_sky_high_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "maya_city", "peaceful"],
            barks: (
                idle: ["Lady Six Sky. Of Naranjo. And of everywhere near it.", "A taller headdress means more authority. That is simply astronomy.", "*she straightens a posture that was already perfectly straight*"],
                hall: ["I came to Naranjo when it was beaten and broken. A few years later it was winning war after war, and I had myself carved on a stela, standing on a captive. Modesty is for cities that lose.", "My son was made king at five years old. Who do you think ruled? Read the stelae. Count the feathers."],
            ),
        ),
        "npc_history_cacica_of_boriken": (
            display_name: "The Cacica of Boriken",
            // An original Taino woman chief of Boriken (Puerto Rico) before 1492, with a feather crown, a guanin medallion and a carved staff.
            manifest: "sprites/history_cacica_of_boriken_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "taino_islands", "peaceful"],
            barks: (
                idle: ["Welcome to the batey. Mind the ball; the game is serious here.", "Cassava bread keeps for months. Bake it on the buren, keep it dry, and nobody goes hungry when the storms come.", "*she counts the canoes on the beach, and knows each family by its canoe*"],
                hall: ["You already speak our words: canoe, hammock, hurricane, barbecue, savanna, maize, tobacco. Keep them. Use them well.", "After 1492 came the Spanish, forced labour and new sicknesses, and most of my people died. Not all. Taino families, our words and our ancestry are still here, in Boriken and in all the islands."],
            ),
        ),
        "npc_history_canoe_maker": (
            display_name: "The Canoe Maker",
            // An original Taino canoe maker with a stone axe, a paddle, a cotton loincloth and red bixa paint.
            manifest: "sprites/history_canoe_maker_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "taino_islands", "peaceful"],
            barks: (
                idle: ["Burn a little, chip a little, burn a little more. A canoe is one tree and a great deal of patience.", "This one seats forty. The cacica's seats a hundred, and it does not leak.", "*he runs his thumb along the edge of the stone axe, and nods*"],
                hall: ["Our canoes carry a hundred paddlers from island to island, with cotton, cassava and gold to trade. Columbus wrote that they went marvellously fast. He was right about that.", "Canoa is our word. English took it, and hammock, and hurricane. That is all right. We have more."],
            ),
        ),
        // Made by chargen with hand-drawn overlay art
        // (`data/townsfolk/<target>.chargen.yaml`,
        // `data/overlays/<target>.overlay.svg`). The potter, the wayfinder and
        // the carver are original people; Thor Hey-I'm-Right-Dahl is a parody.
        "npc_history_lapita_potter": (
            display_name: "Lapita Potter",
            // An original potter of the Lapita people, who sailed into the open Pacific around 1,500 BCE, with a toothed stamp and a stamped pot.
            manifest: "sprites/history_lapita_potter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "lapita_voyagers", "peaceful"],
            barks: (
                idle: ["Press the comb in, lift it clean. Again. Again.", "The white in the marks is lime, from burnt coral. It makes the pattern sing.", "Mind the pots. All of the pots."],
                hall: ["My grandmothers came from islands to the north, and theirs from Taiwan before that. We carried the patterns all the way. You can follow us across the sea by our pots.", "We sailed out past the last island anyone could see, and found Fiji, Tonga and Samoa, where nobody had ever lived. We brought the pigs, the dogs, the chickens and the taro. And the pots."],
            ),
        ),
        "npc_history_wayfinder": (
            display_name: "Wayfinder",
            // An original Polynesian navigator who crosses the open ocean by the stars, the swells and the birds, with a steering paddle and a shell lei.
            manifest: "sprites/history_wayfinder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "wayfinders", "peaceful"],
            barks: (
                idle: ["*he looks up, finds his star, and nods*", "Feel that? A swell from the south, under the one from the east.", "No compass. No chart. Just everything else."],
                hall: ["Each star rises at the same point on the horizon every night. Learn the points of many stars and the whole sky is a compass. When it is cloudy, read the swells instead.", "At dusk, watch the birds. A tern or a noddy that flies low and straight is going home to land. Follow it. It knows the way."],
            ),
        ),
        "npc_history_moai_carver": (
            display_name: "Moai Carver",
            // An original carver of the Rano Raraku quarry on Rapa Nui, with a basalt toki (adze), a feather headband and stone dust.
            manifest: "sprites/history_moai_carver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "rapa_nui", "peaceful"],
            barks: (
                idle: ["Tuff is soft. Basalt is hard. That is the whole trick, and also the rest of my life.", "*tap, tap, tap with the toki*", "It is not only a head. It has a body. Half of it is in the ground."],
                hall: ["We did not roll them on logs. We stood them up and rocked them, left, right, left, with ropes on both sides, and they walked. Try it with a fridge.", "People say we cut down every tree for the moai and ruined our island. We lived here for centuries after that. What ruined us came on ships in the 1860s: slave raiders, and the sickness they brought."],
            ),
        ),
        "npc_history_thor_hey_im_right_dahl": (
            display_name: "Thor Hey-I'm-Right-Dahl",
            // A parody of Thor Heyerdahl, who sailed a balsa raft from Peru in 1947 to prove Polynesia was settled from South America (it was not).
            manifest: "sprites/history_thor_hey_im_right_dahl_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 188 cm.
            standing_height: Some(72.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "rapa_nui", "peaceful"],
            barks: (
                idle: ["Hey! I'm right!", "Balsa floats. Therefore, Peru. Next question.", "*he polishes the little raft with his sleeve*"],
                hall: ["In 1947 I sailed a raft from Peru to Polynesia to prove the Polynesians came from South America. It worked! Well, the raft worked. The Polynesians came from the west. Details.", "The sweet potato came from South America, so SOMEBODY sailed there and back. ...The Polynesians did. Sailing east, in better boats. Hey, I'm still a LITTLE right!"],
            ),
        ),
        // Benin City (wave A, the Atlantic world). The brass caster is an
        // original man of the casters' guild; Iyoba Idia is the real first
        // queen mother of Benin, told with respect; Lord Finders-Keepers is a
        // parody of the looters of 1897 and of the museums that keep the loot.
        "npc_history_brass_caster": (
            display_name: "Brass Caster of Igun Street",
            // An original Edo brass caster of the Igun Eronmwon guild, with a wax model and a crucible in tongs.
            manifest: "sprites/history_brass_caster_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "benin_city", "peaceful"],
            barks: (
                idle: ["Wax, clay, fire, brass. In that order. Never any other order.", "This one is a horn player. Listen closely and you can almost hear him.", "*he squints into the furnace, and judges the heat by its colour*"],
                hall: ["Only our guild may cast brass in Benin, and only for the Oba. The plaques on the palace pillars are ours: the history of the court, in metal.", "The Portuguese bring brass rings by the shipload. We melt them and make them worth something."],
            ),
        ),
        "npc_history_iyoba_idia": (
            display_name: "Iyoba Idia",
            // Idia, the first queen mother (Iyoba) of Benin, early 1500s, in a crown and collar of coral beads, with an eben sword.
            manifest: "sprites/history_iyoba_idia_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "benin_city", "peaceful"],
            barks: (
                idle: ["The court of Benin keeps its history in brass and in memory. Remember that when the strangers come.", "*she lifts the eben, and the court falls quiet*", "Coral beads are for the Oba and those he honours. These are mine."],
                hall: ["When the Igala came against my son, the Oba Esigie, I raised an army and went to war with it. We won, and he made me the first Iyoba, the queen mother.", "My face is carved in ivory, and the Oba wears it at the great ceremonies. In 1897 the British took it. It is still in their museum."],
            ),
        ),
        "npc_history_lord_finders_keepers": (
            display_name: "Lord Finders-Keepers",
            // A parody of the officers who looted Benin City in 1897 and the museums that keep the loot: a pith helmet, a monocle, a plaque under his arm.
            manifest: "sprites/history_lord_finders_keepers_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "benin_city", "peaceful"],
            barks: (
                on_hit: ["I say! That is assault. Unlike 1897, which was an expedition.", "Ow! Mind the plaque!"],
                idle: ["Do not touch the glass. Do not touch anything. Except when I do it.", "ON LOAN. Indefinitely. Which is a kind of loan.", "*he polishes his monocle, and does not look at the card*"],
                hall: ["In 1897 we burned Benin City and took its brass and ivory home. Thousands of pieces. We call it a collection.", "Some museums have begun to give them back. I am against it in principle, and in practice, and in the gift shop."],
            ),
        ),
        // Haiti (wave A, the Atlantic world). Toussaint Louverture and
        // Catherine Flon are real people, told with respect; the cook is an
        // original resident. Nothing in this room is a joke.
        "npc_history_toussaint_louverture": (
            display_name: "Toussaint Louverture",
            // The leader of the Haitian Revolution (about 1743-1803), born enslaved: a bicorne over a madras scarf, a general's coat, a book.
            manifest: "sprites/history_toussaint_louverture_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "haitian_revolution", "peaceful"],
            barks: (
                idle: ["*he dictates a letter, then another, then another*", "*he reads, one finger on the line, and looks up when you come near*", "The mountains are on our side. They always were."],
                hall: ["I was born enslaved, tended horses and taught myself to read. In 1791 I joined the rising, and by 1801 I governed the island.", "They took me to France in chains in 1802, and I died there the next spring. The tree of liberty grew back from its roots. I told them it would."],
            ),
        ),
        "npc_history_catherine_flon": (
            display_name: "Catherine Flon",
            // The seamstress of Arcahaie who, as Haiti tells it, sewed the first flag in May 1803: blue and red, the white torn out.
            manifest: "sprites/history_catherine_flon_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "haitian_revolution", "peaceful"],
            barks: (
                idle: ["Blue, then red. Small stitches. It has to hold in a war.", "*she checks the seam once more, though it is perfect*", "Liberty or death."],
                hall: ["At Arcahaie in May 1803, Dessalines tore the white out of the French flag, and I sewed the blue and the red together.", "Every eighteenth of May, Haiti keeps Flag Day. That is my seam they are waving."],
            ),
        ),
        "npc_history_soup_joumou_cook": (
            display_name: "Soup Joumou Cook",
            // An original cook on 1 January 1804 with a ladle and a squash: the soup the enslaved were not allowed to eat, eaten by everyone on independence day.
            manifest: "sprites/history_soup_joumou_cook_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "haitian_revolution", "peaceful"],
            barks: (
                idle: ["Sit. Eat. It is the first day.", "*he stirs the pot and tastes, and adds one more pepper*", "Squash, beef, cabbage, time."],
                hall: ["We cooked soup joumou for the masters and were not allowed to taste it. On the first of January 1804, all of Haiti ate it.", "Every first of January since, in every Haitian home in the world. UNESCO wrote it down in 2021. We never forgot."],
            ),
        ),
        // The fort of the Door of No Return (wave A, the Atlantic world): a
        // sober room. Ottobah Cugoano is real, taken from this coast at
        // thirteen, later an author against the trade; the guide is original.
        "npc_history_ottobah_cugoano": (
            display_name: "Ottobah Cugoano",
            // A Fante man (about 1757-after 1791) kidnapped at thirteen and shipped from this coast; free in London, he published a book against the slave trade in 1787.
            manifest: "sprites/history_ottobah_cugoano_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "door_of_no_return", "peaceful"],
            barks: (
                idle: ["If there were no buyers, there would be no sellers.", "*he holds his book closed, one hand flat on the cover*", "I was thirteen."],
                hall: ["I was taken from the Gold Coast at thirteen and shipped to Grenada. In London I was free, and in 1787 I published a book that said the trade must end, and every enslaved person be freed, now.", "We called ourselves the Sons of Africa: free Black men in London who wrote, petitioned and pulled people off the ships."],
            ),
        ),
        "npc_history_castle_guide": (
            display_name: "Castle Guide",
            // An original guide of today at a trading castle on the Gold Coast; her family has fished from the beach outside for generations.
            manifest: "sprites/history_castle_guide_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "door_of_no_return", "peaceful"],
            barks: (
                idle: ["Please walk slowly here.", "*she waits at the door until you are ready*", "Every number on these papers was a person."],
                hall: ["From 1501 to 1866, about twelve and a half million people were forced onto ships for the Americas. About ten point seven million lived to land.", "The door goes one way. Today its sea side has a second sign: the Door of Return. The descendants come back through it as guests."],
            ),
        ),
        // South America (wave B). The potato farmer, the flautist and the net
        // maker are original people; Antoine Parmen-tater is a parody of
        // Antoine-Augustin Parmentier, who promoted the potato in France.
        "npc_history_potato_farmer": (
            display_name: "Potato Farmer",
            // An original Andean farmer of about 5,000 BCE with a digging stick and a bag of potatoes of many colours.
            manifest: "sprites/history_potato_farmer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 156 cm.
            standing_height: Some(60.4),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "andean_highlands", "peaceful"],
            barks: (
                idle: ["This one is for boiling. This one is for chuno. This one is for showing off.", "*she turns a potato in her hand, checks its eyes, and nods*", "Cold nights, hard sun. Good for chuno."],
                hall: ["The potato was a bitter wild thing until our grandmothers' grandmothers chose the good ones, year after year, up here near the lake.", "We freeze-dry them into chuno, which keeps for years. A bad harvest does not kill us."],
            ),
        ),
        "npc_history_antoine_parmen_tater": (
            display_name: "Antoine Parmen-tater",
            // A parody of Antoine-Augustin Parmentier (1737-1813), who promoted the potato in France: a powdered wig, potato flowers in his buttonhole.
            manifest: "sprites/history_antoine_parmen_tater_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "andean_highlands", "peaceful"],
            barks: (
                on_hit: ["Ow! Is that how you treat a man of science?", "Mon dieu! Mind the flowers!"],
                idle: ["Bon appe-tater!", "*he holds up a potato to the light, like a diamond*", "Eight thousand years they farmed it here, and still it needed a Frenchman to explain it."],
                hall: ["I put soldiers round my potato field by day and sent them home at night. Paris stole every plant. Some historians say that story is too good to be true. I disagree, professionally.", "Every potato and minced-beef pie in France carries my name: hachis Parmentier. That is immortality, with gravy."],
            ),
        ),
        "npc_history_caral_flautist": (
            display_name: "Caral Flautist",
            // An original musician of Caral, about 2600 BCE, with a flute of pelican wing bone.
            manifest: "sprites/history_caral_flautist_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "caral", "peaceful"],
            barks: (
                idle: ["*a few high notes, bright as the sun on the stones*", "Thirty-two flutes in one plaza. We were not a quiet city.", "Mind the steps."],
                hall: ["Caral was a city when the pyramids of Egypt were new. We built ours at the same time, and neither of us knew.", "No walls, no weapons of war have been found here. People came to trade, to build and to play."],
            ),
        ),
        "npc_history_net_maker": (
            display_name: "Net Maker of Aspero",
            // An original net maker of Aspero on the coast, about 2600 BCE, with a cotton fishing net and a basket of anchovies.
            manifest: "sprites/history_net_maker_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 154 cm.
            standing_height: Some(59.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "caral", "peaceful"],
            barks: (
                idle: ["Supe. Like soup. Mostly anchovy.", "*her fingers tie a knot without her looking*", "Cotton up, anchovies down. That is the whole economy."],
                hall: ["The valley grows the cotton; we make the nets; the sea gives the anchovies. Everybody wins except the anchovies.", "Pots? Nobody here makes pots yet. A gourd is a pot that grows on a vine."],
            ),
        ),
        // Southeast Asia (wave C). The pig painter, the word keeper and the
        // drum caster are original people; Trưng Trắc and Trưng Nhị are the
        // sisters who led the rising of 40 CE against Han rule.
        "npc_history_pig_painter": (
            display_name: "The Pig Painter",
            // An original painter of Sulawesi, about 51,000 years ago, with red ochre on her hands and a bone tube to blow paint.
            manifest: "sprites/history_pig_painter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 152 cm.
            standing_height: Some(58.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "sulawesi", "peaceful"],
            barks: (
                idle: ["*she spits red ochre round her hand, and lifts it: the hand stays on the rock*", "A pig. Three people. You decide what happens next.", "Mind the wall. It is still drying. For about fifty thousand years."],
                hall: ["At Leang Karampuang a pig and three figures like people are painted on the wall. It is at least 51,200 years old: the oldest known painted story.", "Nobody walked to this island. It was never joined to the land. Everyone here came by sea, on rafts, long before anyone sailed anywhere else."],
            ),
        ),
        "npc_history_word_keeper": (
            display_name: "The Word Keeper",
            // An original Austronesian woman, about 2000 BCE, in bark cloth with shell beads and a red-slipped pot.
            manifest: "sprites/history_word_keeper_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "austronesian_islands", "peaceful"],
            barks: (
                idle: ["Mata. Eye. Say it. Good.", "*she turns the red pot in her hands, and hums a word list*", "Lima: five, and the hand. Count on it."],
                hall: ["From Taiwan, by outrigger canoe, our words went to Madagascar and to Rapa Nui: half the globe. More languages come from ours than from almost any other family.", "You say tattoo and taboo. Those are ours: tatau and tapu. They went the long way round, through the far islands, to reach you."],
            ),
        ),
        "npc_history_trung_trac": (
            display_name: "Trưng Trắc",
            // Trưng Trắc, who led the rising of 40 CE against Han rule with her sister and ruled from Mê Linh until 43 CE.
            manifest: "sprites/history_trung_trac_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "dong_son", "peaceful"],
            barks: (
                idle: ["Sixty-five citadels. Count them if you doubt me.", "*she sets the sword point-down, and waits*", "Mê Linh is ours."],
                hall: ["In 40 CE my sister and I raised the Lạc lords against Han rule, and for three years we ruled. In 43 CE the Han general Ma Yuan defeated us.", "Every town in Vietnam has a street for the Two Ladies Trưng. That is a long memory for three years."],
            ),
        ),
        "npc_history_trung_nhi": (
            display_name: "Trưng Nhị",
            // Trưng Nhị, the younger of the Trưng sisters, with a war banner, in 40 CE.
            manifest: "sprites/history_trung_nhi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 156 cm.
            standing_height: Some(60.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "dong_son", "peaceful"],
            barks: (
                idle: ["*the banner snaps in the wind*", "The stories say we rode elephants. The stories are right.", "My sister talks. I ride."],
                hall: ["Many of our captains were women. Here a daughter could inherit, and a woman could lead. The Han did not like it at all.", "When the bronze drums sound, the Lạc lords come. They came for us."],
            ),
        ),
        "npc_history_drum_caster": (
            display_name: "The Drum Caster",
            // An original bronze-smith of the Dong Son culture, about 100 BCE, with a bronze drum and tongs.
            manifest: "sprites/history_drum_caster_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 164 cm.
            standing_height: Some(63.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "dong_son", "peaceful"],
            barks: (
                idle: ["Wax, clay, fire, bronze. And a little luck.", "*he taps the drum: the frogs on its rim seem to jump*", "A star in the middle, for the sun. Always."],
                hall: ["Our drums are cast by the lost wax: carve the pictures in wax, cover it in clay, pour out the wax and pour in the bronze. They have been dug up from southern China to the far islands of Indonesia.", "The frogs on the rim are for the rain. Frogs sing when it comes. A drum with frogs asks for rain, very loudly."],
            ),
        ),
        // Southeast Asia (wave C2). The harbour master, the relief carver and
        // the baray engineer are original people; Yijing is the Tang monk who
        // studied in Srivijaya; Zhou Da-Guide is a parody of Zhou Daguan, the
        // Yuan envoy who wrote the only eyewitness account of Angkor.
        "npc_history_harbour_master": (
            display_name: "Harbour Master of Palembang",
            // An original harbour master of Srivijaya, about 680 CE, with a balance scale for gold and a palm-leaf tally.
            manifest: "sprites/history_harbour_master_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "srivijaya", "peaceful"],
            barks: (
                idle: ["Ship's name, cargo, port. And the toll.", "*the little scale tips, and he smiles*", "Everything stops here. Everything pays a little."],
                hall: ["Every ship between India and China came through our strait. We kept the pirates off the sea road, and the ships paid us for it.", "About 1400 a prince of Palembang, Parameswara, founded Malacca on the same strait. Whoever holds it, the ships still pay."],
            ),
        ),
        "npc_history_yijing": (
            display_name: "Yijing",
            // Yijing (635-713), the Tang Chinese monk who studied Sanskrit in Srivijaya on his way to and from India.
            manifest: "sprites/history_yijing_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "srivijaya", "peaceful"],
            barks: (
                idle: ["*he copies a line, and checks it twice*", "A year or two here first, then India.", "Keep your ink dry."],
                hall: ["In Srivijaya there were more than a thousand monks, and they studied as they did in India. I told every monk from China to stop here first.", "Once I went aboard a ship here to send a letter home for ink and paper, and it sailed with me on it. I went to China by accident, and came back."],
            ),
        ),
        "npc_history_relief_carver": (
            display_name: "Relief Carver of Borobudur",
            // An original stone carver of Borobudur in Java, about 800 CE, with a chisel and a wooden mallet.
            manifest: "sprites/history_relief_carver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "borobudur", "peaceful"],
            barks: (
                idle: ["*tap, tap, tap: a sail appears*", "Two thousand six hundred and seventy-two panels. I am counting.", "Walk every gallery before you go up."],
                hall: ["Among the stories on the walls we carved the life around them: houses, markets, musicians, and ships with outriggers like the ones that sailed to Madagascar.", "In 2003 people built a ship from one of our pictures and sailed it to Africa. Every block of this hill was cut by hand and holds the next one without mortar."],
            ),
        ),
        "npc_history_baray_engineer": (
            display_name: "Baray Engineer",
            // An original Khmer engineer of Angkor, about 1150 CE, who plans the reservoirs, with a measuring rod and a palm-leaf plan.
            manifest: "sprites/history_baray_engineer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "angkor", "peaceful"],
            barks: (
                idle: ["It is not a lake. It is a reservoir.", "*she sights along the rod, and frowns at the dike*", "Eight kilometres, give or take a canal."],
                hall: ["The West Baray is eight kilometres by two, dug by hand. Water for the rice, or a sea around the mountain of the gods? Both, and a great deal of digging.", "In the 1300s and 1400s floods and droughts broke the canals; in 1431 Ayutthaya took the city. But monks have kept Angkor Wat to this day."],
            ),
        ),
        "npc_history_zhou_da_guide": (
            display_name: "Zhou Da-Guide",
            // A parody of Zhou Daguan, the Yuan Chinese envoy of 1296-97, as a tour guide with a pennant and a notebook.
            manifest: "sprites/history_zhou_da_guide_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "angkor", "peaceful"],
            barks: (
                idle: ["Tour group, this way! Keep up!", "*he holds the little flag higher*", "A guide never exaggerates. A guide enhances."],
                hall: ["In 1296 I stayed a year at Angkor and wrote down the markets, the bathing, the king's procession and the slaves. Without me nobody would know what was for lunch.", "The markets here are run by women. Any business, ask the wife. I wrote that down; the Khmer had palm leaves, and the damp ate them."],
            ),
        ),
        // East Asia's coasts (wave D1). The flame potter, the chestnut keeper,
        // the jade carver, the farmer of Nankuanli and the star watcher are
        // original people; Queen Seondeok ruled Silla from 632 to 647.
        "npc_history_flame_potter": (
            display_name: "Flame Potter of Sannai-Maruyama",
            // An original Jōmon potter of Sannai-Maruyama, about 3000 BCE, with a flame-style pot and a red lacquered comb.
            manifest: "sprites/history_flame_potter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 152 cm.
            standing_height: Some(58.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "jomon", "peaceful"],
            barks: (
                idle: ["The clay is easy. The fire is the hard part.", "*she pinches up one more crest of the rim*", "Beautiful, and it still makes soup."],
                hall: ["We made pottery for ten thousand years before your history books begin, and we never farmed. We stayed in this town for fifteen hundred years.", "Everyone in Japan carries a little of us. The Ainu of the north and the Ryukyuans of the south carry the most."],
            ),
        ),
        "npc_history_chestnut_keeper": (
            display_name: "Chestnut Keeper",
            // An original Jōmon forager of Sannai-Maruyama, about 3000 BCE, with a basket of chestnuts and a digging stick.
            manifest: "sprites/history_chestnut_keeper_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "jomon", "peaceful"],
            barks: (
                idle: ["Chestnut? Roasted this morning.", "*he cracks a burr open with his heel*", "Is it farming? We were too busy eating."],
                hall: ["We cleared the other trees and kept the best chestnuts near the town, until the woods were almost all chestnut. Call it what you like.", "Six posts, each a metre thick. A tower? A stage? Nobody knows what it held, and we are not telling."],
            ),
        ),
        "npc_history_jade_carver": (
            display_name: "Jade Carver of Fengtian",
            // An original jade carver of Taiwan, about 2500 BCE, with a green jade adze and a cord saw.
            manifest: "sprites/history_jade_carver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 155 cm.
            standing_height: Some(60.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "taiwan", "peaceful"],
            barks: (
                idle: ["Green as a river.", "*sand, water, the cord: back and forth*", "Patience is harder than jade."],
                hall: ["Fengtian jade from Taiwan travelled by boat to the Philippines, Vietnam, Thailand and Borneo: one of the longest sea roads of any stone in the ancient world.", "Of the ten oldest branches of the Austronesian languages, nine grow only on Taiwan. The grandchildren left in canoes. The grandmothers stayed."],
            ),
        ),
        "npc_history_nankuanli_farmer": (
            display_name: "Farmer of Nankuanli",
            // An original farmer of Nankuanli in southern Taiwan, about 2500 BCE, with a sheaf of millet and a stone knife.
            manifest: "sprites/history_nankuanli_farmer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 164 cm.
            standing_height: Some(63.6),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "taiwan", "peaceful"],
            barks: (
                idle: ["Mind the dog. She minds you.", "*he tests a millet head between his teeth*", "Millet on the slope, rice in the wet."],
                hall: ["At Nankuanli we buried our dogs with care, as we buried people. Your diggers found them nearly five thousand years later.", "Every generation a few of us sailed south over the channel to the Batanes and Luzon. Their grandchildren reached half the world."],
            ),
        ),
        "npc_history_queen_seondeok": (
            display_name: "Queen Seondeok",
            // Queen Seondeok, who ruled Silla from 632 to 647, the first of its three queens, in a gold crown of Silla.
            manifest: "sprites/history_queen_seondeok_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "silla", "peaceful"],
            barks: (
                idle: ["Yes, the queen.", "*she closes her fan with a snap*", "A kingdom must know when to plant, and when to worry."],
                hall: ["I ruled Silla in my own name from 632 to 647, the first of three queens. In my reign Cheomseongdae was built to watch the sky.", "The story goes that the Tang emperor sent me peonies with no bees, to say a queen without a husband has no scent. I said the peonies had none. I planted them. I was right."],
            ),
        ),
        "npc_history_star_watcher": (
            display_name: "Star Watcher of Cheomseongdae",
            // An original astronomer of Silla, about 640 CE, with a bamboo sighting tube and a star chart.
            manifest: "sprites/history_star_watcher_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "silla", "peaceful"],
            barks: (
                idle: ["Quiet, please. The stars are speaking.", "*he squints along the bamboo tube*", "Clear skies."],
                hall: ["Cheomseongdae, built in Queen Seondeok's reign, still stands: the oldest standing observatory in East Asia.", "People count 362 stones and 27 courses in the tower and argue about what the numbers mean. I just climbed it."],
            ),
        ),
        // Song China, Joseon and Heian Japan (wave D2). Li Qingzhao, King
        // Sejong, Jang Yeong-sil, Murasaki Shikibu and Sei Shonagon are real;
        // the money printer of Hangzhou is original.
        "npc_history_li_qingzhao": (
            display_name: "Li Qingzhao",
            // Li Qingzhao (1084-about 1155), the great poet of the Song, with a folding fan and a scroll of her poems.
            manifest: "sprites/history_li_qingzhao_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "song", "peaceful"],
            barks: (
                idle: ["Searching, seeking. Cold, clear.", "*she taps her closed fan against the scroll*", "A good line costs a sleepless night."],
                hall: ["My husband and I collected old bronzes and inscriptions on stone. When the Jurchen took the north we fled south with fifteen carts of books. Most were lost on the road.", "After dinner we made tea and quizzed each other: which book, which chapter, which page holds this line? The winner drank first. Once I laughed so hard I spilled the tea down my front."],
            ),
        ),
        "npc_history_money_printer": (
            display_name: "Money Printer of Hangzhou",
            // An original printer of the Song state's paper money in Hangzhou, about 1200 CE, with a bronze plate and a fresh note.
            manifest: "sprites/history_money_printer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "song", "peaceful"],
            barks: (
                idle: ["Fresh money! Do not lick it, the ink is wet.", "*he presses the plate, peels the sheet, admires it*", "Copper is heavy. Paper is the future."],
                hall: ["The merchants of Sichuan printed notes first; in 1023 the state took them over. Our huizi came in 1160. The plate is the government's, not mine. I checked.", "Print too many and each note buys less. By the end of the dynasty we had learned that more than once."],
            ),
        ),
        "npc_history_murasaki_shikibu": (
            display_name: "Murasaki Shikibu",
            // Murasaki Shikibu (about 973-about 1014), lady of the Heian court and author of The Tale of Genji, with a brush and a sheet of paper.
            manifest: "sprites/history_murasaki_shikibu_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 155 cm.
            standing_height: Some(60.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "heian", "peaceful"],
            barks: (
                idle: ["*she writes a line, and crosses it out*", "Shining Genji is a character. Do not fall in love with him.", "I see more than I say."],
                hall: ["When my brother studied the Chinese classics, I learned them faster just by listening. My father sighed: if only she had been born a boy.", "Murasaki is not my name. It is a nickname, perhaps after a lady in my book. My real name? Nobody wrote it down."],
            ),
        ),
        "npc_history_sei_shonagon": (
            display_name: "Sei Shōnagon",
            // Sei Shōnagon (about 966-after 1017), lady-in-waiting to Empress Teishi and author of The Pillow Book, with an open fan.
            manifest: "sprites/history_sei_shonagon_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 153 cm.
            standing_height: Some(59.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "heian", "peaceful"],
            barks: (
                idle: ["In spring, the dawn.", "*she hides a smile behind her fan*", "That is going on a list."],
                hall: ["Hateful things: a visitor who talks on and on when you are in a hurry. A mosquito's thin little voice when you are falling asleep. I wrote them all down.", "Murasaki called me dreadfully conceited in her diary. I never answered her in my book. That is how you win."],
            ),
        ),
        "npc_history_king_sejong": (
            display_name: "King Sejong",
            // King Sejong the Great (1397-1450), fourth king of Joseon, who made the Korean alphabet, with a bound book.
            manifest: "sprites/history_king_sejong_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "joseon", "peaceful"],
            barks: (
                idle: ["A king's work is to let his people speak.", "*he turns a page, and nods*", "Twenty-eight letters. Learn them by lunch."],
                hall: ["Our speech is not Chinese, so Chinese letters do not fit it, and many of my people had something to say and could not write it. So I made twenty-eight letters, easy to learn, for every day.", "Each consonant is a picture of the mouth that says it: the tongue, the lips, the teeth, the throat. Korea keeps a day for the letters: 9 October in the South, 15 January in the North."],
            ),
        ),
        "npc_history_jang_yeongsil": (
            display_name: "Jang Yeong-sil",
            // Jang Yeong-sil (about 1390-after 1442), engineer of King Sejong's court, born a government slave, with a rain gauge and a ruler.
            manifest: "sprites/history_jang_yeongsil_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "joseon", "peaceful"],
            barks: (
                idle: ["Measure twice.", "*he reads the water in the gauge, and writes it down*", "The same rain gauge in every province. Now we can compare."],
                hall: ["I was born a government slave. King Sejong made me an official, and I made him clocks that ring the hours by themselves, and sundials for the streets.", "People say I made the rain gauge. The records say the crown prince did, in 1441. I will settle for the water clock."],
            ),
        ),
        // Bengal (wave E). Ram Mohan Roy, Rani Lakshmibai, Rabindranath Tagore
        // and Begum Rokeya are real; the weaver, the spinner, the student of
        // 1952 and the poet of 1971 are original.
        "npc_history_muslin_weaver": (
            display_name: "Muslin Weaver of Dhaka",
            // An original master weaver of Dhaka muslin, about 1700, with a shuttle and a fold of cloth as fine as mist.
            manifest: "sprites/history_muslin_weaver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Woven air.", "*the shuttle flies*", "Hold it to the light. You will see your hand through it."],
                hall: ["A length of our finest muslin could pass through a finger ring. The Mughal court wore it; later, so did the ladies of Paris.", "Then the Company took the trade, and then came the machine cloth of Lancashire, cheaper and coarser. By the 1800s the great looms of Dhaka were quiet."],
            ),
        ),
        "npc_history_cotton_spinner": (
            display_name: "Spinner of Dhaka",
            // An original spinner of the fine muslin thread, about 1700, with a slim spindle, a bowl of water and a comb of fish jawbone.
            manifest: "sprites/history_cotton_spinner_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 152 cm.
            standing_height: Some(58.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Quiet. The thread is thinner than a hair.", "*she wets her fingers*", "Morning is best. The damp holds the thread."],
                hall: ["We spun in the early morning and by the river, while the air was damp: dry air snaps the thread. Young eyes and light fingers spun the finest.", "We cleaned the cotton with the jawbone of the boal fish, its teeth as fine as a comb. Then the phuti karpas cotton was lost, and the finest thread with it."],
            ),
        ),
        "npc_history_ram_mohan_roy": (
            display_name: "Raja Ram Mohan Roy",
            // Raja Ram Mohan Roy (1772-1833), reformer and publisher of Calcutta, with a newspaper and a quill.
            manifest: "sprites/history_ram_mohan_roy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Read, and then argue.", "*he dips the quill*", "A newspaper is a conversation with a whole city."],
                hall: ["I published newspapers in Bengali and Persian, and argued for schools of science, for the right of women to inherit, and against sati. In 1829 it was banned.", "I sailed to England in 1830 to speak for the Mughal emperor, and I died in Bristol in 1833. There is a statue of me there now."],
            ),
        ),
        "npc_history_rani_lakshmibai": (
            display_name: "Rani Lakshmibai",
            // Rani Lakshmibai of Jhansi (about 1828-1858), a leader of the rising of 1857, in riding dress with a sheathed sword.
            manifest: "sprites/history_rani_lakshmibai_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Jhansi is mine. I will not give it.", "*her hand rests on the hilt*", "Ride well, or do not ride."],
                hall: ["When my husband died, the Company would not accept our adopted son as heir, and took Jhansi by its 'doctrine of lapse'. I said: I will not give up my Jhansi.", "In 1857 the rising came. In 1858 I died fighting near Gwalior. The British general who fought me is said to have called me the most dangerous of the rebel leaders."],
            ),
        ),
        "npc_history_rabindranath_tagore": (
            display_name: "Rabindranath Tagore",
            // Rabindranath Tagore (1861-1941), poet, composer and painter of Bengal, the first Nobel laureate from outside Europe, with a book and a pen.
            manifest: "sprites/history_rabindranath_tagore_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Where the mind is without fear...", "*he hums a tune he has just written*", "Let me finish this song. I have written two thousand."],
                hall: ["In 1913 I was given the Nobel Prize for Gitanjali, the first to anyone outside Europe. Two countries sing my songs as their anthems: Bangladesh and India.", "In 1919, after the massacre at Amritsar, I gave my knighthood back. Some honours are heavier than others."],
            ),
        ),
        "npc_history_begum_rokeya": (
            display_name: "Begum Rokeya",
            // Begum Rokeya Sakhawat Hossain (1880-1932), writer and educator, author of Sultana's Dream (1905), with a book and a model air-car.
            manifest: "sprites/history_begum_rokeya_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 155 cm.
            standing_height: Some(60.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Educate the girls. Then see.", "*she adjusts the end of her sari*", "In my story, the men stay indoors."],
                hall: ["Girls in my family were not supposed to learn Bengali or English. I learned them at night, by candlelight, with my brother's help.", "In Sultana's Dream women run the country with science: they cook with sunlight, fly air-cars, and win a war with the sun's heat. In 1911 I opened a school for girls in Calcutta, with eight pupils."],
            ),
        ),
        "npc_history_language_student": (
            display_name: "Student of Dhaka, 1952",
            // An original student of Dhaka University in the Language Movement, 21 February 1952, with a hand-painted placard and a book.
            manifest: "sprites/history_language_student_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["We want Bengali as a state language!", "*he grips his placard*", "We are not afraid."],
                hall: ["In 1948 Pakistan's leaders said Urdu alone would be the state language. Most of us in East Bengal speak Bengali. On 21 February 1952 we marched anyway, and the police fired.", "In 1956 Bengali became a state language of Pakistan. Today the world keeps 21 February as International Mother Language Day. Speak your language to your children."],
            ),
        ),
        "npc_history_freedom_fighter_poet": (
            display_name: "Poet of 1971",
            // An original young poet of Bangladesh's war of independence, 1971, with a notebook and a transistor radio.
            manifest: "sprites/history_freedom_fighter_poet_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bengal", "peaceful"],
            barks: (
                idle: ["Listen: the radio.", "*he writes a line, then hides the notebook*", "Joy Bangla."],
                hall: ["On 25 March 1971 the army struck Dhaka. Nine months of war followed. Some ten million people fled to India, and many of our teachers and writers were killed in the last days.", "On 16 December the war ended, and Bangladesh was free. Every 21 February we walk barefoot to the Shaheed Minar with flowers."],
            ),
        ),
        // Brazil and Amazonia (wave F). Zumbi, Dandara (as tradition remembers
        // her), André Rebouças, Luís Gama and the Dragão do Mar are real; the
        // potter, the gardener and the smith are original.
        "npc_history_marajoara_potter": (
            display_name: "Marajoara Potter",
            // An original potter of Marajó island, about 1000 CE, with a bowl painted in red, black and white, and a fine brush.
            manifest: "sprites/history_marajoara_potter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 156 cm.
            standing_height: Some(60.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "amazonia", "peaceful"],
            barks: (
                idle: ["Red, black, white. Always in that order? No.", "*she paints a fine band*", "The flood is coming. The pots are ready."],
                hall: ["We build our houses on mounds above the flood. Some mounds are as long as a village; your diggers count hundreds of them on Marajó.", "Our painted jars lasted a thousand years in the mounds. Your museums keep them now. Look closely: no two bands are the same."],
            ),
        ),
        "npc_history_dark_earth_gardener": (
            display_name: "Gardener of the Dark Earth",
            // An original Amazonian gardener, about 1000 CE, with a digging stick and a basket of charcoal and potsherds for terra preta.
            manifest: "sprites/history_dark_earth_gardener_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "amazonia", "peaceful"],
            barks: (
                idle: ["Charcoal, pottery, fish bones: the recipe for soil.", "*he crumbles black earth between his fingers*", "This forest? We planted half of it."],
                hall: ["The forest soil is poor. We burn slowly, we add our waste and broken pots, and the earth turns black and stays rich. Farmers dig our dark earth today, and sell it.", "Brazil nuts, cacao, palms, manioc: the forest near our towns is full of the trees we liked. Later Europeans saw a wilderness. It was a garden."],
            ),
        ),
        "npc_history_zumbi": (
            display_name: "Zumbi dos Palmares",
            // Zumbi (1655-1695), last leader of the Quilombo dos Palmares, with a spear at rest.
            manifest: "sprites/history_zumbi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(69.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "palmares", "peaceful"],
            barks: (
                idle: ["Palmares is free. Keep it free.", "*he looks out over the valley*", "We do not bargain with freedom."],
                hall: ["In 1678 Ganga Zumba made a peace with the governor: freedom for those born in Palmares, if the rest went back. I refused it. Freedom for some is not freedom. I led Palmares after him.", "They killed me on 20 November 1695. Brazil keeps that day now as Black Consciousness Day."],
            ),
        ),
        "npc_history_dandara": (
            display_name: "Dandara",
            // Dandara of Palmares (died 1694), remembered in tradition as a farmer and fighter, with a hoe on her shoulder.
            manifest: "sprites/history_dandara_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "palmares", "peaceful"],
            barks: (
                idle: ["Plant, then defend what you planted.", "*she shifts the hoe on her shoulder*", "Ask me about capoeira. Or don't."],
                hall: ["Little was written about me by the people who wrote things down. Palmares remembers me: I farmed, I fought, and with Zumbi I said no to the peace of 1678.", "The story goes that in 1694, when Palmares fell, I chose death over slavery. Remember the story, and ask who kept it."],
            ),
        ),
        "npc_history_palmares_smith": (
            display_name: "Smith of Palmares",
            // An original blacksmith of Palmares, about 1680, with a hammer and tongs holding a glowing hoe blade.
            manifest: "sprites/history_palmares_smith_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "palmares", "peaceful"],
            barks: (
                idle: ["Hot iron waits for nobody.", "*clang*", "A hoe today. Tomorrow, whatever Palmares needs."],
                hall: ["Many of us came from the lands of Kongo and Ndongo, where a smith is a respected person. In Palmares we make hoes, axes and blades from scrap and from ore.", "Palmares grows maize, beans, manioc, bananas and sugar cane. We trade with the farms below, when they will trade. Freedom needs tools."],
            ),
        ),
        "npc_history_andre_reboucas": (
            display_name: "André Rebouças",
            // André Rebouças (1838-1898), Black Brazilian engineer and abolitionist, with rolled engineering plans.
            manifest: "sprites/history_andre_reboucas_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "rio", "peaceful"],
            barks: (
                idle: ["Measure twice, build once.", "*he unrolls a plan of the docks*", "The law is signed. Now the land."],
                hall: ["I built docks and railways, and I taught engineering. I was one of the few Black men at the emperor's court, and I used my place there to argue for abolition.", "Freedom is not enough, I said: the freed need land, and schools. In 1889 the Republic came, and I went into exile with the emperor's family. I never came home."],
            ),
        ),
        "npc_history_luis_gama": (
            display_name: "Luís Gama",
            // Luís Gama (1830-1882), lawyer, poet and abolitionist of São Paulo, with a law book and his papers.
            manifest: "sprites/history_luis_gama_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "rio", "peaceful"],
            barks: (
                idle: ["The law is a weapon. I aim it carefully.", "*he leafs through the papers*", "Next case."],
                hall: ["I was born free in Bahia. When I was ten my father, a Portuguese nobleman, sold me into slavery to pay his debts.", "At seventeen I learned to read, proved that I had been born free, and became a lawyer without a degree. In court I won freedom for hundreds of enslaved people. I died in 1882, six years too soon."],
            ),
        ),
        "npc_history_dragao_do_mar": (
            display_name: "Dragão do Mar",
            // Francisco José do Nascimento (1839-1914), the Dragon of the Sea, jangadeiro of Fortaleza and leader of the strike of 1881, with a coil of rope.
            manifest: "sprites/history_dragao_do_mar_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "rio", "peaceful"],
            barks: (
                idle: ["The sea is free. So is everyone on it.", "*he coils the rope*", "No jangada in Fortaleza will carry them. Not one."],
                hall: ["In 1881 the slave dealers of Fortaleza wanted our jangadas to carry the enslaved out to the ships, to be sold to the south. We said: in the port of Ceará no more slaves are shipped. And none were.", "In 1884 Ceará freed all its enslaved people, four years before the rest of Brazil. They carried my jangada through the streets of Rio and called me the Dragon of the Sea."],
            ),
        ),
        // Japan after Heian (wave D3). Tokimune, Suenaga, Bashō, Hokusai, Ōi,
        // Fukuzawa, Tsuda Umeko and Kusumoto Ine are real; the tea keeper and
        // the fishmonger of Edo are original, drawn with the ninja village's
        // sheets of Ume and Kenji.
        "npc_history_hojo_tokimune": (
            display_name: "Hōjō Tokimune",
            // Hōjō Tokimune (1251-1284), regent of the Kamakura shogunate during both Mongol invasions, in hitatare and eboshi.
            manifest: "sprites/history_hojo_tokimune_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "kamakura", "peaceful"],
            barks: (
                idle: ["Another letter from the Great Khan? Put it with the others.", "*he studies a map of Kyushu*", "Build the wall higher."],
                hall: ["Kublai Khan's letter of 1268 called our emperor 'the king of a little country'. I was eighteen. The court wanted to answer politely. I did not answer at all.", "After 1274 we built a stone wall along Hakata Bay, twenty kilometres of it. In 1281 their fleet came back, and could not land. Then the typhoon came."],
            ),
        ),
        "npc_history_takezaki_suenaga": (
            display_name: "Takezaki Suenaga",
            // Takezaki Suenaga (1246-after 1314), a minor samurai of Higo who fought both Mongol invasions, in laced armour.
            manifest: "sprites/history_takezaki_suenaga_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "kamakura", "peaceful"],
            barks: (
                idle: ["I was first into the fight. Write that down.", "*he polishes his armour, again*", "Have you seen my scroll?"],
                hall: ["In 1274 I charged first, with five men. My horse was shot under me. No one in Kamakura had heard of me, so I rode there and asked for my reward in person. I got a horse and a piece of land.", "Then I paid painters to make a scroll of my deeds, so no one could forget them. It is the best picture of the Mongol wars that there is. Was it vanity? It was also history."],
            ),
        ),
        "npc_history_matsuo_basho": (
            display_name: "Matsuo Bashō",
            // Matsuo Bashō (1644-1694), the poet, as a travelling wanderer in a dark robe and straw hat, with a walking staff.
            manifest: "sprites/history_matsuo_basho_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "edo", "peaceful"],
            barks: (
                idle: ["Seventeen sounds. Not one more.", "*he looks at the pond for a long time*", "Every day is a journey, and the journey itself is home."],
                hall: ["In 1689 I left my house in Edo and walked north with my friend Sora: some 2,400 kilometres in 150 days. The book of it is The Narrow Road to the Deep North.", "My most famous poem is about a frog jumping into an old pond. People have argued about it for three hundred years. It is about a frog. And the sound of water."],
            ),
        ),
        "npc_history_hokusai": (
            display_name: "Katsushika Hokusai",
            // Katsushika Hokusai (1760-1849), painter and printmaker of Edo, as an old man in a plain dark kimono, with a brush.
            manifest: "sprites/history_hokusai_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 155 cm.
            standing_height: Some(60.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "edo", "peaceful"],
            barks: (
                idle: ["From the age of six I had a mania for drawing.", "*he draws without looking up*", "Not yet. Not good enough yet."],
                hall: ["I made the Thirty-six Views of Mount Fuji when I was past seventy. The wave is the one people know. They sold it for the price of a double bowl of noodles.", "I moved house 93 times; my daughter and I never cleaned. At 88 I said: if heaven gives me five more years, I will become a real painter. It did not."],
            ),
        ),
        "npc_history_katsushika_oi": (
            display_name: "Katsushika Ōi",
            // Katsushika Ōi (about 1800-after 1857), painter, Hokusai's daughter and assistant, in a plain kimono with a brush.
            manifest: "sprites/history_katsushika_oi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 150 cm.
            standing_height: Some(58.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "edo", "peaceful"],
            barks: (
                idle: ["My father calls me 'Oi!' That is my name, and also how he calls me.", "*she grinds the ink*", "Light, and the shadow beside it."],
                hall: ["I worked beside my father for twenty years. Some of the paintings with his name have my hand in them. He said my pictures of women were better than his.", "My own paintings are of lantern light at night: a courtesan writing under a lamp, a street in the dark. Few of them are left, so look well."],
            ),
        ),
        "npc_history_fukuzawa_yukichi": (
            display_name: "Fukuzawa Yukichi",
            // Fukuzawa Yukichi (1835-1901), writer, teacher and founder of Keiō, in kimono and hakama.
            manifest: "sprites/history_fukuzawa_yukichi_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "meiji", "peaceful"],
            barks: (
                idle: ["Learn, or be learned about.", "*he reads an English dictionary*", "Independence of the person, then of the country."],
                hall: ["I sailed to America in 1860 and to Europe in 1862, and came home and wrote about everything: banks, newspapers, elections, the steam engine. My books sold millions.", "'Heaven does not make one person above another, nor below.' I wrote that in 1872. I also wrote that Japan should leave Asia behind. Read all of me, not only the banknote."],
            ),
        ),
        "npc_history_tsuda_umeko": (
            display_name: "Tsuda Umeko",
            // Tsuda Umeko (1864-1929), educator, who went to the USA at six with the Iwakura Mission, in a dress of the 1880s.
            manifest: "sprites/history_tsuda_umeko_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 145 cm.
            standing_height: Some(56.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "meiji", "peaceful"],
            barks: (
                idle: ["Women can learn anything. Teach them.", "*she corrects an English essay*", "Again, please. More clearly."],
                hall: ["In 1871 the government sent five girls to America to learn. I was six, the youngest. When I came home at seventeen I had forgotten my Japanese, and Japan had no work for an educated woman.", "So I made some. In 1900 I founded a school of English for women in Tokyo. It is Tsuda University now. My face is on the 5,000 yen note since 2024."],
            ),
        ),
        "npc_history_kusumoto_ine": (
            display_name: "Kusumoto Ine",
            // Kusumoto Ine (1827-1903), Japan's first woman doctor of Western medicine, in kimono, with a doctor's bag.
            manifest: "sprites/history_kusumoto_ine_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 155 cm.
            standing_height: Some(60.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "meiji", "peaceful"],
            barks: (
                idle: ["Wash your hands.", "*she checks a pulse*", "Rest, and come back in three days."],
                hall: ["My father was Siebold, a German doctor at the Dutch trading post of Nagasaki; my mother was a woman of Nagasaki. He was sent away when I was two. I learned medicine from his students.", "I became a midwife and a doctor, which no Japanese woman had been. In 1873 I was called to the imperial court to deliver a child."],
            ),
        ),
        "npc_history_edo_tea_keeper": (
            display_name: "Tea Keeper of the Tōkaidō",
            // An original tea-house keeper on the Tōkaidō road at the edge of Edo, about 1830; drawn with Ume's sheet.
            manifest: "sprites/village_ume_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "edo", "peaceful"],
            barks: (
                idle: ["Tea, rice cakes, and a seat out of the sun.", "*she pours*", "Fifty-three stations to Kyoto. This is the first."],
                hall: ["Everyone on the Tōkaidō stops here: lords with a thousand men, pilgrims, merchants, poets. The lords must live every other year in Edo, so the road is never empty.", "Hiroshige stopped here to draw the road. Bashō stopped here to complain about his feet. The tea was good both times."],
            ),
        ),
        "npc_history_edo_fishmonger": (
            display_name: "Fishmonger of Nihonbashi",
            // An original fish seller at the market by Nihonbashi bridge, about 1830; drawn with Kenji's sheet.
            manifest: "sprites/village_kenji_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 171 cm.
            standing_height: Some(66.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "edo", "peaceful"],
            barks: (
                idle: ["Bonito! First bonito of the year!", "*he sloshes a bucket of water over the fish*", "Fresh this morning. Very fresh. Mostly."],
                hall: ["A million people live in Edo, and they all eat fish. The market by the bridge starts before dawn and is done by noon.", "The first bonito of the season sells for a fortune: people pawn their clothes to eat it before their neighbours. A saying of Edo: never let money spend the night with you."],
            ),
        ),
        // Central Africa (wave G). Afonso I, Antonio Manuel ne Vunda, Nzinga,
        // Kifunji, George Washington Williams, William Sheppard and Alice
        // Seeley Harris are real; the fisher, the carver, the weaver and the
        // rubber gatherer are original.
        "npc_history_katanda_fisher": (
            display_name: "Katanda Fisher",
            // An original fisher of the Semliki river, about 20,000 years ago, with a barbed bone harpoon.
            manifest: "sprites/history_katanda_fisher_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "ishango", "peaceful"],
            barks: (
                idle: ["The fish can hear you.", "*he checks the barbs on the harpoon*", "Mind the hippos. I mean it."],
                hall: ["Down this river at Katanda, people made barbed harpoons of bone perhaps 90,000 years ago. They said clever tools began in Europe, late. They were wrong.", "Catfish as long as your arm come up the Semliki in the rains. A good harpoon and a quiet foot: that is all you need."],
            ),
        ),
        "npc_history_ishango_carver": (
            display_name: "Ishango Carver",
            // An original carver of Ishango, about 20,000 years ago, with a notched bone handle and a stone burin.
            manifest: "sprites/history_ishango_carver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "ishango", "peaceful"],
            barks: (
                idle: ["Eleven. Thirteen. Seventeen. Nineteen.", "*scratch, scratch*", "Do not make me lose count."],
                hall: ["My bone has three columns of notches. One holds 11, 13, 17 and 19, the primes between ten and twenty. Arithmetic, or the moon, or a good grip? I am not telling.", "A Belgian dug it up in 1950 and it went to Brussels. It is still there. So are many things from the Congo."],
            ),
        ),
        "npc_history_raffia_weaver": (
            display_name: "Raffia Weaver",
            // An original raffia-cloth weaver of Kongo, about 1520 (in Kongo men wove the raffia), with a square of raffia velvet.
            manifest: "sprites/history_raffia_weaver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "kongo", "peaceful"],
            barks: (
                idle: ["Softer than you thought?", "*the loom clacks*", "A cloth this size buys a goat. Two, if you like the pattern."],
                hall: ["The Portuguese called our raffia cloth velvet, and their princes kept it in their treasure rooms. Some of it is still in Europe's museums.", "Cloth is our money, and so are the nzimbu shells from the island off Luanda. Only the king's people may gather those."],
            ),
        ),
        "npc_history_afonso_i": (
            display_name: "Afonso I of Kongo",
            // Afonso I Mvemba a Nzinga (about 1456-1542), king of Kongo from 1509, in royal raffia dress and cap.
            manifest: "sprites/history_afonso_i_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "kongo", "peaceful"],
            barks: (
                idle: ["Another letter to Lisbon.", "*he reads a page again, frowning*", "One king to another. As equals."],
                hall: ["In 1526 I wrote to the king of Portugal: each day the traders are taking our people, even the sons of our nobles. Send us teachers and doctors, I said, not slave ships.", "They did not stop. I made my officials check every sale, and the trade grew anyway. Dozens of our kings' letters survive. Read them."],
            ),
        ),
        "npc_history_ne_vunda": (
            display_name: "Antonio Manuel ne Vunda",
            // Antonio Manuel ne Vunda (died 1608), Kongo's ambassador to Rome, in Kongo and Portuguese court dress.
            manifest: "sprites/history_ne_vunda_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 174 cm.
            standing_height: Some(67.4),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "kongo", "peaceful"],
            barks: (
                idle: ["Is this the road to Rome?", "*he checks his letters of credence*", "Four years on the road. Pirates, twice."],
                hall: ["King Álvaro II sent me to Rome in 1604, to speak for Kongo without Portugal in between. I went by Brazil and Spain, and pirates robbed me on the way.", "I reached Rome in January 1608, sick, and died a few days later. They made a marble bust of me. It is still there; I never saw the city."],
            ),
        ),
        "npc_history_nzinga": (
            display_name: "Queen Nzinga",
            // Nzinga Mbande (about 1583-1663), queen of Ndongo and Matamba, in royal dress, with a bow.
            manifest: "sprites/history_nzinga_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "ndongo", "peaceful"],
            barks: (
                idle: ["Stand up straight.", "*she tests the bowstring*", "Nobody gives me a mat."],
                hall: ["In Luanda in 1622 the governor gave me a mat on the floor. One of my women knelt, and I sat on her back, eye to eye with him. I got my treaty.", "Portugal broke it, so I fought them for thirty years, with the Imbangala and then the Dutch. In 1657 they made peace with me. I died a queen."],
            ),
        ),
        "npc_history_funji": (
            display_name: "Kifunji",
            // Kifunji (died about 1647), Nzinga's sister, who spied for her from captivity in Luanda.
            manifest: "sprites/history_funji_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "ndongo", "peaceful"],
            barks: (
                idle: ["Speak quietly.", "*she folds a tiny letter very small*", "The walls have ears. So do I."],
                hall: ["The Portuguese caught me in 1646 and kept me in Luanda. They thought a prisoner was harmless. I sent my sister their plans, hidden in letters.", "They found the letters. The records say they drowned me in the Kwanza. Remember that a prisoner can still fight."],
            ),
        ),
        "npc_history_george_washington_williams": (
            display_name: "George Washington Williams",
            // George Washington Williams (1849-1891), soldier, minister, lawyer and historian, who exposed the Congo Free State in 1890.
            manifest: "sprites/history_george_washington_williams_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "congo_free_state", "peaceful"],
            barks: (
                idle: ["Write it down.", "*he writes, fast*", "The king promised schools. I found none."],
                hall: ["I fought in the Civil War at fourteen and wrote the first history of Black Americans. In 1890 I came to see the Congo for myself, and wrote King Leopold an open letter listing what I saw.", "To the American Secretary of State I called it 'crimes against humanity'. I died the next year, at forty-one. Others carried it on."],
            ),
        ),
        "npc_history_rubber_gatherer": (
            display_name: "Rubber Gatherer",
            // An original Congolese rubber gatherer of 1904, with an empty basket for wild rubber.
            manifest: "sprites/history_rubber_gatherer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "congo_free_state", "peaceful"],
            barks: (
                idle: ["The basket must be full by the new moon.", "*he looks at the empty basket*", "Further every week. The near vines are dead."],
                hall: ["Every village owes so many baskets of rubber, every two weeks. When the basket is short, the soldiers take hostages, and they burn, and they shoot.", "It is for tyres, they say: bicycles, and the new motor cars. Somebody across the sea is riding very smoothly."],
            ),
        ),
        "npc_history_william_sheppard": (
            display_name: "William Sheppard",
            // William Henry Sheppard (1865-1927), African-American missionary and explorer, in a white tropical suit.
            manifest: "sprites/history_william_sheppard_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 188 cm.
            standing_height: Some(72.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "congo_free_state", "peaceful"],
            barks: (
                idle: ["Mind the river.", "*he writes in a small notebook*", "Count them. Write it down. Send it."],
                hall: ["I learned the Kuba language and was the first outsider their king received. In 1899 I found the dead of a raid by the State's soldiers, counted them, and told the world.", "The rubber company sued me for libel in 1909. A Congolese court found me not guilty. The Kuba art I brought home is still at Hampton, in Virginia."],
            ),
        ),
        "npc_history_alice_seeley_harris": (
            display_name: "Alice Seeley Harris",
            // Alice Seeley Harris (1870-1970), English missionary photographer, with a box camera, 1904.
            manifest: "sprites/history_alice_seeley_harris_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "congo_free_state", "peaceful"],
            barks: (
                idle: ["Hold still.", "*click*", "People argue with letters. Not with photographs."],
                hall: ["I came to teach. I ended up taking photographs, because nobody in Europe believed the letters. In 1904 a man named Nsala came to our house with what the soldiers had done to his child.", "We showed the photographs as lantern slides in hundreds of halls. In 1908 the king had to give the Congo up. I lived to be a hundred."],
            ),
        ),
        // Australia, Aotearoa, Tonga and Samoa (wave L1). Tuʻitātui, Henry
        // Williams, Ana Hamu, Hōne Heke, Bennelong, Barangaroo and Pemulwuy are
        // real; the fisher, the ranger, the ngatu maker, the tufuga, the moa
        // hunter and the carver are original.
        "npc_history_mungo_fisher": (
            display_name: "Mungo Fisher",
            // An original fisher of the Willandra Lakes, about 40,000 years ago, with a net bag of mussels.
            manifest: "sprites/history_mungo_fisher_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 158 cm.
            standing_height: Some(61.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "lake_mungo", "peaceful"],
            barks: (
                idle: ["The lake is full this year.", "*she shakes out a net bag of mussels*", "Mind the fire. Mind the yabbies."],
                hall: ["Fish, mussels, yabbies, emu eggs in season. Our shell heaps by the fires are still here, forty thousand years on.", "One day the lake will dry and the dune will blow over our camps. We will still be here."],
            ),
        ),
        "npc_history_mungo_ranger": (
            display_name: "Mungo Ranger",
            // An original Mutthi Mutthi ranger of Mungo National Park today.
            manifest: "sprites/history_mungo_ranger_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "lake_mungo", "peaceful"],
            barks: (
                idle: ["Mind where you step.", "*she checks the footprints after the rain*", "Walk softly. You are a guest here."],
                hall: ["Mungo Lady was cremated about 40,000 years ago; Mungo Man was laid out in red ochre about 42,000 years ago. Among the oldest ritual burials known anywhere.", "Mungo Man was kept in Canberra for 43 years. In 2017 we brought him home in a hearse across the country, and people stood by the road."],
            ),
        ),
        "npc_history_tuitatui": (
            display_name: "Tuʻitātui",
            // Tuʻitātui, the eleventh Tuʻi Tonga (about 1200), who had the Haʻamonga ʻa Maui built.
            manifest: "sprites/history_tuitatui_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(69.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "tonga_samoa", "peaceful"],
            barks: (
                idle: ["Bow to the stone.", "*he looks along the lintel toward the sunrise*", "My canoes go where my word goes."],
                hall: ["Two uprights and a lintel of coral stone, more than thirty tonnes each. A gate, a calendar, or both? In 1967 a king of Tonga was out at dawn to check.", "No one ever ruled Tonga. We are still a kingdom."],
            ),
        ),
        "npc_history_ngatu_maker": (
            display_name: "Ngatu Maker",
            // An original Tongan woman who makes ngatu (bark cloth), with a wooden beater (ike).
            manifest: "sprites/history_ngatu_maker_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 163 cm.
            standing_height: Some(63.2),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "tonga_samoa", "peaceful"],
            barks: (
                idle: ["Thud, thud, thud.", "*she beats the bark thinner*", "Do not ask what the ngatu says. It holds all the gossip."],
                hall: ["We beat the inner bark of the paper mulberry thin and wide, glue it, and print it brown. A great ngatu is tens of metres long.", "A ngatu is wealth: you give it away at a wedding or a funeral, and everyone remembers."],
            ),
        ),
        "npc_history_tufuga_tatau": (
            display_name: "Tufuga Tā Tatau",
            // An original Samoan master of tatau, with a bone comb and a mallet.
            manifest: "sprites/history_tufuga_tatau_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "tonga_samoa", "peaceful"],
            barks: (
                idle: ["Sit. It will hurt.", "*tap, tap, tap*", "Do not cry out. Your family is watching."],
                hall: ["A man's peʻa goes from the waist to the knees, by hand, over days. The missionaries tried to stop it. They could not.", "English sailors took our word home: tatau. Now half the world has a tattoo and does not know whose word it is."],
            ),
        ),
        "npc_history_moa_hunter": (
            display_name: "Moa Hunter",
            // An original hunter of Aotearoa, about 1350, with a spear.
            manifest: "sprites/history_moa_hunter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "aotearoa", "peaceful"],
            barks: (
                idle: ["Shh. A moa.", "*he listens to the bush*", "Fewer every year."],
                hall: ["My grandfather's fires were full of moa bones. Mine have fewer. My grandchildren will have to ask what a moa was.", "Within about 150 years of our coming, all nine kinds of moa were gone, and then the eagle. Nobody meant it. That is why it is a warning."],
            ),
        ),
        "npc_history_pounamu_carver": (
            display_name: "Pounamu Carver",
            // An original carver of Aotearoa, about 1375, who grinds a pounamu (greenstone) adze.
            manifest: "sprites/history_pounamu_carver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "aotearoa", "peaceful"],
            barks: (
                idle: ["Grind, wet, grind, wet.", "*she holds the green blade up to the light*", "One more week."],
                hall: ["Pounamu comes from the rivers of the South Island. It is the toughest stone we know: weeks of grinding for one blade.", "A pounamu adze is handed down for generations. It has a name, and a story."],
            ),
        ),
        "npc_history_henry_williams": (
            display_name: "Henry Williams",
            // Henry Williams (1792-1867), missionary, who with his son Edward put the Treaty of Waitangi into Māori overnight on 4 February 1840.
            manifest: "sprites/history_henry_williams_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 173 cm.
            standing_height: Some(67.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "waitangi", "peaceful"],
            barks: (
                idle: ["I have not slept.", "*he crosses out a word, and writes it again*", "'Sovereignty' has no word in Māori."],
                hall: ["I wrote 'kāwanatanga', governorship, for sovereignty, and that the chiefs keep 'tino rangatiratanga', their full chieftainship. Was that the same thing? No.", "Almost all the chiefs signed the Māori text. New Zealand has argued about the difference ever since."],
            ),
        ),
        "npc_history_ana_hamu": (
            display_name: "Ana Hamu",
            // Ana Hamu, widow of the chief Te Koki, one of the few women who signed the Treaty of Waitangi, 6 February 1840.
            manifest: "sprites/history_ana_hamu_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "waitangi", "peaceful"],
            barks: (
                idle: ["Read the Māori text.", "*she reads the paper again, carefully*", "A chief is a chief."],
                hall: ["About a dozen women signed, out of more than five hundred names. Some women of rank were turned away by British officers.", "The paper in our language says we keep our chieftainship and our lands. Whether it was kept is another story."],
            ),
        ),
        "npc_history_hone_heke": (
            display_name: "Hōne Heke",
            // Hōne Heke Pōkai (about 1807-1850), Ngāpuhi chief, first to sign the Treaty, who cut down the British flagstaff at Kororāreka four times.
            manifest: "sprites/history_hone_heke_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 175 cm.
            standing_height: Some(67.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "waitangi", "peaceful"],
            barks: (
                idle: ["Mind the flagstaff. It falls over a lot.", "*he weighs his axe in his hand*", "Four times."],
                hall: ["I was the first chief to sign at Waitangi. Within a few years the flag on the hill said who was master. So in 1844 I cut it down.", "They put it up again. I cut it down again. The fourth time it was sheathed in iron and guarded, in March 1845. We cut it down anyway."],
            ),
        ),
        "npc_history_barangaroo": (
            display_name: "Barangaroo",
            // Barangaroo (died 1791), a Cammeraygal woman and fisher of the harbour, who refused the colony's ways.
            manifest: "sprites/history_barangaroo_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 160 cm.
            standing_height: Some(62.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "sydney_cove", "peaceful"],
            barks: (
                idle: ["Stay out of my way. I am fishing.", "*she re-ties a shell hook to a bark line*", "The fish are biting."],
                hall: ["I fish from my nawi with my daughters, with a little fire in the canoe to cook the catch. My hook is shell; my line is bark.", "My husband dines with their governor. I do not. I will not wear their clothes. Part of the harbour shore carries my name now. Good."],
            ),
        ),
        "npc_history_bennelong": (
            display_name: "Bennelong",
            // Woollarawarre Bennelong (about 1764-1813), of the Wangal, seized in 1789 to be the colony's go-between.
            manifest: "sprites/history_bennelong_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "sydney_cove", "peaceful"],
            barks: (
                idle: ["Good day to you.", "*he adjusts a coat that does not quite fit*", "I learned their manners. They did not learn mine."],
                hall: ["In 1789 the governor's men seized me and kept me in a chain to learn our language. I escaped. Later I came back, on my terms.", "The governor built me a hut on the point where the Opera House stands now. I sailed to England in 1792 and came home in 1795."],
            ),
        ),
        "npc_history_pemulwuy": (
            display_name: "Pemulwuy",
            // Pemulwuy (about 1750-1802), of the Bidjigal, who led the resistance to the colony for twelve years.
            manifest: "sprites/history_pemulwuy_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 178 cm.
            standing_height: Some(69.0),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "sydney_cove", "peaceful"],
            barks: (
                idle: ["I see you.", "*he watches the tree line*", "Remember whose land you walk on."],
                hall: ["The newcomers took our land for farms, so we fought them, from 1790. They shot me many times. They said I could not be killed. In 1802 they killed me.", "The governor sent my head to England. It has never been found. My son Tedbury fought on."],
            ),
        ),
        // Budj Bim (wave L1). The farmer and the weaver are original.
        "npc_history_kooyang_farmer": (
            display_name: "Kooyang Farmer",
            // An original Gunditjmara man of Budj Bim, who sets woven traps in the stone weirs for kooyang (eels).
            manifest: "sprites/history_kooyang_farmer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "budj_bim", "peaceful"],
            barks: (
                idle: ["The water is rising.", "*he settles the trap in the gap of the weir*", "Step on the stones, not in the channels."],
                hall: ["Our old people cut these channels in the lava for at least 6,600 years. Some hold eels in ponds for months. That is farming.", "Budj Bim erupted about 37,000 years ago. People were here to see it. We are still here."],
            ),
        ),
        "npc_history_basket_weaver": (
            display_name: "Basket Weaver",
            // An original Gunditjmara woman of Budj Bim, who plaits eel traps of sedge.
            manifest: "sprites/history_basket_weaver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 162 cm.
            standing_height: Some(62.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "budj_bim", "peaceful"],
            barks: (
                idle: ["Over, under, over, under.", "*she pulls the sedge tight*", "Hold this end for me."],
                hall: ["An eel trap has a neck the eel swims into and not out of. A good one lasts many seasons.", "The lake was drained for farms. In 2010 our people brought the water back. In 2019 the world listed it as heritage."],
            ),
        ),
        // Micronesia (wave L2a). Hurao, Isokelekel (of Pohnpei's histories),
        // Hammer DeRoburt and Juda Kessibuki are real; the others are original.
        "npc_history_latte_builder": (
            display_name: "Latte Builder",
            // An original CHamoru woman of Guåhan, about 1000 CE, who builds houses on latte stones.
            manifest: "sprites/history_latte_builder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 157 cm.
            standing_height: Some(60.8),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "marianas", "peaceful"],
            barks: (
                idle: ["Håfa adai.", "*she checks the capstone is level*", "Mind your head."],
                hall: ["Latte: a pillar and a cap shaped like half a coconut. We build the house on top, off the ground, in the sea wind.", "Our ancestors sailed here more than three thousand years ago, further over open sea than anyone had gone."],
            ),
        ),
        "npc_history_hurao": (
            display_name: "Hurao",
            // Hurao, a CHamoru chief of Guåhan who in 1671 called on his people to drive out the Spanish.
            manifest: "sprites/history_hurao_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 168 cm.
            standing_height: Some(65.1),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "marianas", "peaceful"],
            barks: (
                idle: ["Remember who was here first.", "*he looks out at the Spanish ship*", "Sit. Talk."],
                hall: ["We lived well before they came, and we could live without them. So we fought, for more than twenty years.", "War and sickness killed most of us. But the CHamoru are still here, and so is our language."],
            ),
        ),
        "npc_history_basalt_hauler": (
            display_name: "Basalt Hauler",
            // An original Pohnpeian man, about 1200, who hauls basalt columns to Nan Madol.
            manifest: "sprites/history_basalt_hauler_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nan_madol", "peaceful"],
            barks: (
                idle: ["Hup. Hup.", "*he shifts the column on his shoulder*", "Mind the canals."],
                hall: ["The rock cools into six-sided columns. We lay them crosswise, like a log cabin, and fill the middle with coral.", "The stories say two brothers flew the stones here by magic. I wish they would fly this one."],
            ),
        ),
        "npc_history_isokelekel": (
            display_name: "Isokelekel",
            // Isokelekel, the hero of Pohnpei's histories who ended the Saudeleur rule and became the first Nahnmwarki.
            manifest: "sprites/history_isokelekel_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 172 cm.
            standing_height: Some(66.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nan_madol", "peaceful"],
            barks: (
                idle: ["Kaselehlie.", "*he stands easy, spear upright*", "The Saudeleur are finished."],
                hall: ["The Saudeleur took every first catch and first fruit for themselves. Their rule ended here, in Nan Madol.", "I became the first Nahnmwarki. Pohnpei still has its Nahnmwarki today."],
            ),
        ),
        "npc_history_ri_meto": (
            display_name: "Ri-meto",
            // An original Marshallese navigator (ri-meto), with a stick chart of the swells.
            manifest: "sprites/history_ri_meto_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "marshalls", "peaceful"],
            barks: (
                idle: ["Close your eyes. Feel the swell.", "*he traces a curved stick with his finger*", "The east swell is strong today."],
                hall: ["Sticks for the swells, shells for the islands. Where the bent swells cross, the canoe rocks in its own way: an island is near.", "You learn the chart on land, and leave it at home. At sea you read the water with your body."],
            ),
        ),
        "npc_history_pandanus_weaver": (
            display_name: "Pandanus Weaver",
            // An original Marshallese woman who plaits pandanus mats, for sleeping and for sails.
            manifest: "sprites/history_pandanus_weaver_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 156 cm.
            standing_height: Some(60.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "marshalls", "peaceful"],
            barks: (
                idle: ["Iakwe.", "*strip, soften, plait*", "A mat for a sail, a mat for a wedding."],
                hall: ["The canoes of the Marshalls carry the mats of the women. A navigator is nothing without a good sail.", "A ring of sand around a lagoon, two metres above the sea. Land is everything here, because there is so little of it."],
            ),
        ),
        "npc_history_rai_owner": (
            display_name: "Rai Owner",
            // An original Yapese man, about 1900, the owner of a large rai (stone money).
            manifest: "sprites/history_rai_owner_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 167 cm.
            standing_height: Some(64.7),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "yap", "peaceful"],
            barks: (
                idle: ["Do not lean on my money.", "*he offers you betel nut*", "Everyone knows whose stone it is."],
                hall: ["When I buy something big, the stone does not move. The whole island just knows it belongs to someone else now.", "A small stone with a terrible voyage is worth more than a big one that came easily."],
            ),
        ),
        "npc_history_palau_quarrier": (
            display_name: "Palau Quarrier",
            // An original Yapese man, white with limestone dust from the quarries of Palau, with a shell adze.
            manifest: "sprites/history_palau_quarrier_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 169 cm.
            standing_height: Some(65.5),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "yap", "peaceful"],
            barks: (
                idle: ["*cough* Limestone dust.", "*he brushes off his arms*", "Half a year in Palau, carving."],
                hall: ["Months with shell adzes for one big stone, then 400 km of open sea on a raft behind a canoe.", "O'Keefe brought stones cut with iron tools on his ship. A stone with no hardship in it is worth less."],
            ),
        ),
        "npc_history_phosphate_digger": (
            display_name: "Phosphate Digger",
            // An original Chinese contract labourer on Nauru in the 1930s, with a shovel.
            manifest: "sprites/history_phosphate_digger_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm.
            standing_height: Some(63.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nauru", "peaceful"],
            barks: (
                idle: ["Dig, fill, carry. Again.", "*he leans on the shovel for a moment*", "Three years, then home."],
                hall: ["Phosphate is old bird droppings, turned to rock. Farmers in Australia and New Zealand spread it on their fields.", "Between the pinnacles there is nothing left. The Nauruans watched their island go away by ship."],
            ),
        ),
        "npc_history_hammer_deroburt": (
            display_name: "Hammer DeRoburt",
            // Hammer DeRoburt (1922-1992), head chief of Nauru, who led it to independence in 1968.
            manifest: "sprites/history_hammer_deroburt_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 170 cm.
            standing_height: Some(65.9),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "nauru", "peaceful"],
            barks: (
                idle: ["I have a court date.", "*he straightens a folder of papers*", "Nauruans decide for Nauru."],
                hall: ["In 1943 Japan sent 1,200 of us to Chuuk. Hundreds died. When we came home, I decided Nauru would be ours.", "Independence in 1968, the phosphate company in 1970, and in 1989 the International Court. Money does not grow coral back."],
            ),
        ),
        "npc_history_juda": (
            display_name: "Juda Kessibuki",
            // Juda Kessibuki, the leader of the people of Bikini in 1946.
            manifest: "sprites/history_juda_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 166 cm.
            standing_height: Some(64.3),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "bare_hands",
            tags: ["townsfolk", "history", "bikini", "peaceful"],
            barks: (
                idle: ["We are packing.", "*he turns his hat in his hands*", "Look after the island."],
                hall: ["A commodore asked us to leave for a while, so they could test a bomb for the good of mankind. We are 167 people. I said we would go.", "They told us it would be for a short time."],
            ),
        ),
        "npc_history_bikini_elder": (
            display_name: "Bikini Elder",
            // An original woman of Bikini in 1946, packing to leave.
            manifest: "sprites/history_bikini_elder_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 154 cm.
            standing_height: Some(59.7),
