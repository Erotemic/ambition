                tactics: (notice_s: 0.7, lurk_px: 40.0, waits_its_turn: true, footsies: Some((hold_px: 70.0, wait_s: 1.6))),
            )),
            max_health: Some(2),
            tags: ["enemy", "evil", "undead", "minion"],
            cues: (notice: Some("enemy.zombie.notice"), tell: Some("enemy.zombie_crawler.tell"), swing: Some("enemy.zombie_crawler.swing"), hit: Some("enemy.zombie.hit")),
        barks: (
            on_hit: ["*a wet hiss*", "Hhhk."],
            idle: ["*a scrape of nails on stone*", "Hhhh... re... port..."],
            hall: ["*it drags itself one arm's length nearer*", "Hhhh... still... on... duty..."],
        ),
        hall_dialogue_id: Some("hall_npc_evil_zombie_crawler"),
        ),
        // The Shock Warden: a short, wide trooper behind an electrified riot
        // shield, with an electric baton. Slow and hard to put down; after
        // each swing it stands open.
        "npc_shock_warden": (
            display_name: "Shock Warden",
            manifest: "sprites/shock_warden_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 165 cm, and broad.
            standing_height: Some(64.0),
            composition: None,
            default_action_set: "shock_warden_baton",
            locomotion: Some((run_speed: 130.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.7, amount: 1)),
            autonomous_profile: Some((
                template: MeleeBrute,
                aggro_radius: 640.0,
                attack_range: 50.0,
                patrol_effort: 0.3,
                chase_effort: 0.7,
                attack_cooldown_s: 0.6,
                shares_sightings: true,
                // The wall: slow and patient, it holds its ground just out of reach and
                // commits only now and then; it does not give ground, and it guards the
                // place you would come down to from a ledge. A strike its shield turns
                // aside it answers with a shove of the shield (`shock_warden.ron`)
                // while you are thrown back and locked out.
                tactics: (
                    notice_s: 0.6,
                    lurk_px: 140.0,
                    footsies: Some((hold_px: 95.0, wait_s: 1.3)),
                    counter: Some((after_s: 0.08, with: Special)),
                ),
            )),
            // His riot shield turns aside every strike from the front (`guards`,
            // Jon 2026-10-19). Over the top, a strike down on his head gets
            // through; so does one from behind, and one while his baton swing
            // has laid the shield on the floor. Three turned strikes in quick
            // succession, or one heavy one, break it, and he staggers open.
            guards: [
                (
                    part: shield,
                    inset_px: 4.0,
                    lowered_in: ["baton_attack", "attack_side", "recovery"],
                    deflect: (rebound_speed: 240.0, rebound_lift: 150.0, lockout_s: 0.5, hitstop_s: 0.06, push: 50.0),
                    breaks: Some((blocks: 3, within_s: 1.2, heavy: Some(4), stagger_s: 1.6)),
                ),
            ],
            max_health: Some(8),
            mass: Some(5.0),
            tags: ["enemy", "evil", "soldier", "armored"],
            cues: (notice: Some("enemy.shock_warden.notice"), tell: Some("enemy.shock_warden.tell"), swing: Some("enemy.shock_warden.swing"), hit: Some("enemy.shock_warden.hit")),
        barks: (
            on_hit: ["Hold the line!", "*the shield crackles*"],
            idle: ["Move along.", "This corridor is closed."],
            hall: ["Step back from the shield, citizen.", "Order is a wall. I am the wall."],
        ),
        hall_dialogue_id: Some("hall_npc_shock_warden"),
        ),
