// Ambition character catalog — provider-owned cast metadata, presentation,
// writing defaults, controller-profile references, and other catalog-shaped
// authoring data. It participates in character preparation, but it is NOT a
// second body-construction authority. Runtime bodies are constructed from the
// resolved `PreparedCharacterDefinition` produced from registered
// `CharacterDefinition` values plus any catalog/source fragments they consume.
//
// Schema and loading live in
// `crates/ambition_characters/src/actor/character_catalog/`.
// Current architecture: `docs/systems/actors-brains-and-character-content.md`.
// Authoring workflow: `docs/recipes/adding-a-character.md`.
//
// HOW TALL A PERSON IS (Jon, 2026-10-12). The robot is a SHORT character: he
// stands about 65% as tall as The Director. A `Standard` body with no
// `standing_height` is the robot's 48. A person states their own, at the
// scale where the robot's 48 is 124 cm: `standing_height` = cm x 48 / 124.
// The Director's 190 cm is 73.5, Jeff Hinter's 178 cm is 68.9, Ramen-nujan's
// 168 cm is 65. The row's comment gives the height meant, in centimetres. It
// is a cartoon: the heights are for people to differ by, not a record.
//
// A row that states how its body moves (`locomotion` or `locomotion_preset`) is
// a character this game builds. Its move table, if it has one, is its file under
// `movesets/`; every other fact of the character is its row.

(
    // Reusable autonomous-controller profiles, by name — the second of the
    // three authorities (D73 / the overnight campaign). Several characters name
    // one of these and keep their own bodies, which is what an enemy ARCHETYPE
    // could never express: `medium_striker` is a whole BODY worn by five
    // goblins, a lab raider and a skitter, so sharing their decision-making
    // meant sharing their health, reach and top speed too.
    //
    //  these author normalized EFFORT (a fraction of each body's own
    // `run_speed`), never px/s — §4.7's brain→body seam. A policy that authored
    // absolute speeds could not be shared by a mite and a giant.
    autonomous_profiles: {
        // The pirate crew's three shapes, two pirates each.
        "pirate_striker": (
            template: Smash,
            aggro_radius: 220.0,
            attack_range: 36.0,
            patrol_effort: 0.5,
            chase_effort: 1.0,
        ),
        "pirate_brute": (
            template: Smash,
            aggro_radius: 240.0,
            attack_range: 44.0,
            patrol_effort: 0.5,
            chase_effort: 1.0,
        ),
        "pirate_ranger": (
            template: Skirmisher,
            aggro_radius: 320.0,
            attack_range: 140.0,
            patrol_effort: 0.5,
            chase_effort: 1.0,
            // The telegraph (Jon 2026-10-30: "notice, space, telegraph, attack"): it plants and aims (its windup row) before it fires.
            ranged_volley: Some((windup_s: 0.45, firing_s: 0.2, recovery_s: 1.0)),
        ),
        // HOW AN AMBITION CHARACTER FIGHTS ONCE PROVOKED, when it names no
        // policy of its own: the provider's declared default
        // (`with_default_provoked_profile`), the numbers the engine constant
        // `default_provoked_policy()` held before it was deleted. A melee
        // policy on purpose: a provoked kernel guide or merchant fights like
        // the pirates, not as a rock-thrower.
        "provoked_combatant": (
            template: Smash,
            attack_cooldown_s: 0.34,
            aggro_radius: 460.0,
            attack_range: 150.0,
            patrol_effort: 0.6774,
            chase_effort: 1.0,
        ),
        // The goblin band's fighting style, lifted verbatim off the
        // `medium_striker` archetype's controller half: notice at 460px, commit
        // the swing at 150, poke with a thrown rock before closing, and dash to
        // shut a large gap. Nothing here says how much punishment the body takes
        // or how fast it can move — that is the character's half.
        "medium_striker": (
            template: Smash,
            // A swing, then 0.34s before this driver commits to another: the
            // pace the headless Smash arena already gives the same brain.
            attack_cooldown_s: 0.34,
            aggro_radius: 460.0,
            attack_range: 150.0,
            patrol_effort: 0.6176,
            chase_effort: 1.0,
            smash_sprint_to_close: true,
        ),
        //  A WANDERING SENTRY that notices late and never hurries. Not a
        // creature — a WAY OF PLAYING one, which is the whole point of a shared
        // policy: the same body on a patrol route and the same body holding a
        // doorway are two placements of one character, and the level decides.
        //
        //  effort is a FRACTION of whatever body wears it, so a fast creature
        // patrolling at 0.35 is still faster than a slow one at 1.0. That is why
        // a policy can be shared across bodies at all.
        //  THE CELLULAR AUTOMATON'S FIGHTING STYLE, published so the
        // creature can name it when PROVOKED (ledger D89). Lifted off the
        // `cellular_automaton_fighter` archetype's controller half: notice from
        // across the arena, commit the swing at 150, dash to shut a gap, and play
        // the duelist neutral game — footsies and spacing rather than
        // close-and-camp.
        //
        //  a provoked creature rebuilds its MIND, and this is the mind. The
        // PCA reached this policy through `hostile_brain_id_for_actor`, a matcher
        // that read its display name; a character that publishes its own policy
        // needs no matcher to recognise it.
        "cellular_duelist": (
            template: Smash,
            attack_cooldown_s: 0.34,
            aggro_radius: 540.0,
            attack_range: 150.0,
            patrol_effort: 0.5714,
            chase_effort: 1.0,
            smash_sprint_to_close: true,
            smash_duelist: true,
        ),
        "patroller": (
            template: Wanderer,
            aggro_radius: 140.0,
            attack_range: 40.0,
            patrol_effort: 0.35,
            chase_effort: 0.8,
        ),
        //  THE ROBOT'S OWN FIGHTING STYLE, lifted off the `player_robot`
        // archetype's controller half: notices across the room, commits the
        // swing close in, dashes to shut a gap, and plays the duelist neutral
        // game (footsies and spacing) rather than closing and camping.
        //
        //  nothing here says how much punishment the body takes or how fast it
        // can move — that is the character's half, and the whole reason the
        // eighty-line archetype row could not simply become a definition.
        "robot_duelist": (
            template: Smash,
            attack_cooldown_s: 0.34,
            aggro_radius: 560.0,
            attack_range: 60.0,
            patrol_effort: 0.55,
            chase_effort: 1.0,
            smash_sprint_to_close: true,
            smash_duelist: true,
        ),
        //  WHAT A COVE RAIDER BECOMES WHEN YOU HIT IT, lifted off the
        // `pirate_raider` archetype's controller half (2026-08-11, ledger D84).
        //
        //  a PROVOKED policy is still just a policy. Provocation used to
        // hand the body a different ARCHETYPE — new tuning, new HP pool, new
        // capabilities — because the archetype WAS the creature. A raider that
        // takes a swing is the same raider; only its mind changes.
        "pirate_boarder": (
            template: Smash,
            attack_cooldown_s: 0.34,
            aggro_radius: 460.0,
            attack_range: 140.0,
            patrol_effort: 0.6842,
            chase_effort: 1.0,
        ),
        //  THE HEAVY'S VERSION. A brute rather than a duelist, and it
        // notices only what comes to it — `aggro_radius: 0.0` is the row's own
        // number, with `provoke_forced_brute_min_aggro` doing the noticing on the
        // legacy path.
        "pirate_boarder_heavy": (
            template: MeleeBrute,
            aggro_radius: 500.0,
            attack_range: 90.0,
            patrol_effort: 0.5769,
            chase_effort: 1.0,
        ),
        //  KEEPS ITS DISTANCE AND SHOOTS, lifted off the
        // `ranged_skirmisher` archetype's controller half (2026-08-11): notices
        // across the room, opens fire from almost as far, and ambles rather than
        // charges. What it fires is the BODY's business — a raider's gun-sword
        // and a mage's bolt are the same policy with different weapons.
        "skirmisher": (
            template: Skirmisher,
            aggro_radius: 540.0,
            attack_range: 520.0,
            patrol_effort: 0.6,
            chase_effort: 1.0,
        ),
        //  HOLDS ITS GROUND. Notices a long way off and commits hard, but
        // barely drifts from where it was placed — a door guard rather than a
        // hunter. The counterpart to `patroller` on the one axis a level cares
        // about: does this one come looking for you, or wait.
        "door_guard": (
            template: Smash,
            attack_cooldown_s: 0.34,
            aggro_radius: 320.0,
            attack_range: 120.0,
            patrol_effort: 0.08,
            chase_effort: 1.0,
        ),
    },
    // Named gaits that rows share through `locomotion_preset`.
    locomotion_presets: {
        // The walk every humanoid who lives in the hall shares.
        "hall_walk": (run_speed: 210.0, move_style: Walk),
    },
    brain_presets: {
        "stand_still": StandStill,
        // Goes to places in its room by the room's surfaces, rests at each,
        // and goes to the player's side some of the time.
        "companion_dog_roam": Roam(
            speed: 54.0,
            trot_speed: 105.0,
            rest_min_s: 1.2,
            rest_max_s: 4.0,
            company: 0.25,
            stay_within: 520.0,
            playful: 0.2,
            notice_radius: 120.0,
        ),
        // A townsperson going about the town: walks to places in its room,
        // rests at each, and pays the player no mind.
        "townsfolk_roam": Roam(
            speed: 40.0,
            trot_speed: 64.0,
            rest_min_s: 2.0,
            rest_max_s: 6.0,
            company: 0.0,
            stay_within: 0.0,
            playful: 0.0,
            notice_radius: 0.0,
        ),
        // Goes only where it is sent (a visit, an errand) and stays there: the
        // brain of a character that lives an authored day (`npc_lives.ron`).
        "keeps_to_its_tasks": Roam(
            speed: 48.0,
            trot_speed: 80.0,
            rest_min_s: 1000000.0,
            rest_max_s: 1000000.0,
            company: 0.0,
            stay_within: 0.0,
            playful: 0.0,
            notice_radius: 0.0,
        ),
        "patrol_peaceful": Patrol(
            spawn_local_x: 0.0,
            radius: 64.0,
            speed: 28.0,
            aggressiveness: 0.0,
            aggro_radius: 80.0,
            attack_range: 0.0,
        ),
        "wanderer_puppy_slug": Wanderer(
            speed: 36.0,
            aggressiveness: 0.0,
        ),
        "melee_brute_striker": MeleeBrute(
            aggressiveness: 1.0,
            aggro_radius: 220.0,
            attack_range: 36.0,
            chase_speed: 110.0,
        ),
        "melee_brute_brute": MeleeBrute(
            aggressiveness: 1.0,
            aggro_radius: 240.0,
            attack_range: 44.0,
            chase_speed: 75.0,
        ),
        "skirmisher_ranger": Skirmisher(
            aggressiveness: 1.0,
            aggro_radius: 320.0,
            standoff_px: 140.0,
            strafe_speed: 85.0,
            fire_cooldown_s: 0.8,
        ),
        // Lively peaceful flyer (the cove parrot): flits between airborne perches
        // and ground spots, and drops down beside the player to be talked to.
        // Needs a `Floating` body_kind (gravity-free) to actually fly.
        // Aggressive flying melee archetype for the Perfect Cellular Automaton.
        // The body must be `Floating` so the Aerial brain's 2D velocity drives
        // the fly row instead of walking on the ground.
    },

    action_set_presets: {
        // The protagonist's own kit: a swipe, the Hadouken's bolt and a bubble
        // shield. How the bolt fires is the row's `ranged_execution`.
        "player_robot": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.0, active_s: 0.10, recover_s: 0.18, damage: 1, reach_px: 36.0)),
            ranged: Some(Bolt(speed: 600.0, damage: 1)),
            special: Some(Special("bubble_shield")),
        ),
        // Each creature's own swing, named for the one or two rows that wear it.
        "carl_swipe": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.30, active_s: 0.08, recover_s: 0.34, damage: 1, reach_px: 30.0)),
        ),
        // A half's snap: its mandibles are smaller and quicker.
        "dividing_mite_half_swipe": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.24, active_s: 0.08, recover_s: 0.30, damage: 1, reach_px: 24.0)),
        ),
        "dividing_mite_swipe": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.30, active_s: 0.10, recover_s: 0.34, damage: 1, reach_px: 30.0)),
        ),
        // It does not swing: in reach of its foe it plants, swells for the
        // fuse, and goes off. The blast is its death trait, so a mite killed
        // before the fuse ends goes off just the same.
        "exploding_mite_fuse": (
            move_style: Walk,
            melee: Some(Detonate(fuse_s: 0.9, reach_px: 40.0)),
        ),
        // A hammer is slow and it hurts.
        "brute_hammer": (
            move_style: WalkHeavy,
            melee: Some(Swipe(windup_s: 0.40, active_s: 0.12, recover_s: 0.42, damage: 2, reach_px: 44.0)),
        ),
        // The pirate crew's three shapes. A melee pirate's reach is its old
        // preset's `attack_range`.
        "pirate_cutlass": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.26, active_s: 0.09, recover_s: 0.30, damage: 1, reach_px: 36.0)),
        ),
        "pirate_heavy_cutlass": (
            move_style: WalkHeavy,
            melee: Some(Swipe(windup_s: 0.26, active_s: 0.09, recover_s: 0.30, damage: 2, reach_px: 44.0)),
        ),
        // The standoff shooter. Its fire cooldown lives on its policy.
        "pirate_bolt": (
            move_style: Walk,
            ranged: Some(Bolt(speed: 500.0, damage: 1)),
        ),
        "shark_bite": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.18, active_s: 0.10, recover_s: 0.30, damage: 2, reach_px: 42.0)),
        ),
        // The bolt the raiders' gun-swords fire.
        "raider_gun_sword": (
            move_style: Walk,
            ranged: Some(Bolt(speed: 500.0, damage: 2)),
        ),
        "heavy_raider_gun_sword": (
            move_style: WalkHeavy,
            ranged: Some(Bolt(speed: 500.0, damage: 3)),
        ),
        "parrot_bite": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.16, active_s: 0.10, recover_s: 0.28, damage: 1, reach_px: 48.0)),
        ),
        // The chicken's peck: quick and short.
        "chicken_peck": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.20, active_s: 0.08, recover_s: 0.30, damage: 1, reach_px: 30.0)),
        ),
        // The owl's talons: slower than the parrot's bite, and they hurt more.
        "owl_talons": (
            move_style: Float,
            melee: Some(Swipe(windup_s: 0.26, active_s: 0.10, recover_s: 0.40, damage: 2, reach_px: 52.0)),
        ),
        // The rest of the T-rex's flock. A tall bird kicks: the taller, the
        // longer its reach; the heavier, the slower and the harder.
        "kiwi_stab": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.18, active_s: 0.08, recover_s: 0.26, damage: 1, reach_px: 28.0)),
        ),
        "emu_kick": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.22, active_s: 0.08, recover_s: 0.34, damage: 1, reach_px: 44.0)),
        ),
        "ostrich_kick": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.28, active_s: 0.10, recover_s: 0.40, damage: 2, reach_px: 52.0)),
        ),
        "cassowary_kick": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.34, active_s: 0.10, recover_s: 0.46, damage: 3, reach_px: 46.0)),
        ),
        // The shoebill stands and stares for a long time, and then it does not.
        "shoebill_lunge": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.55, active_s: 0.10, recover_s: 0.60, damage: 3, reach_px: 54.0)),
        ),
        // The dinosaurs of the primeval trail. A small one bites fast and
        // weak; the dilophosaurus spits from a distance and bites what comes
        // close; a skull or a pair of horns is slow, and it hurts.
        "compsognathus_bite": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.14, active_s: 0.08, recover_s: 0.26, damage: 1, reach_px: 22.0)),
        ),
        "dilophosaurus_spit": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.26, active_s: 0.10, recover_s: 0.38, damage: 2, reach_px: 40.0)),
            ranged: Some(Rock(speed: 420.0, damage: 1)),
        ),
        // A charge (Jon 2026-10-30: "telegraph, attack" as Hollow Knight's
        // enemies do): it stands with its dome aimed and a foot scraping (its
        // windup row), then rushes head down with the strike live, and stands
        // dazed after: the opening.
        "pachycephalosaurus_butt": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.6, active_s: 0.35, recover_s: 0.8, damage: 3, reach_px: 46.0, step_px: 0.0, rush_px: 220.0)),
        ),
        // The gore charge: horns lowered and a forefoot pawing (its windup
        // row), then the charge, then a long stop to turn its bulk round.
        "triceratops_gore": (
            move_style: WalkHeavy,
            melee: Some(Lunge(windup_s: 0.75, active_s: 0.4, recover_s: 1.0, damage: 4, reach_px: 64.0, step_px: 0.0, rush_px: 260.0)),
        ),
        // The Art dimension (`docs/planning/game/art-dimension.md`). A doodle
        // scratches fast and weak; a wisp of ink spits from a distance; a
        // brush knight sweeps its brush across the ground in front of it, slow
        // to start and long in reach; a statue falls forward onto what is in
        // front of it.
        "doodle_imp_scratch": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.2, active_s: 0.08, recover_s: 0.3, damage: 1, reach_px: 26.0)),
        ),
        "ink_wisp_spit": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.2, active_s: 0.08, recover_s: 0.3, damage: 1, reach_px: 30.0)),
            ranged: Some(Rock(speed: 380.0, damage: 1)),
        ),
        "brush_knight_sweep": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.7, active_s: 0.25, recover_s: 0.8, damage: 3, reach_px: 92.0, step_px: 20.0, rush_px: 0.0)),
        ),
        "living_statue_slam": (
            move_style: WalkHeavy,
            melee: Some(Lunge(windup_s: 0.9, active_s: 0.3, recover_s: 1.2, damage: 4, reach_px: 104.0, step_px: 0.0, rush_px: 40.0)),
        ),
        // The Story Stacks (the fiction quarter of the Art dimension). A
        // bookworm rears back with its mouth open (its windup row) and chomps;
        // a red herring bends back into a curve and darts at you mouth first;
        // a paper tiger crouches with its tail lashing, then pounces a long
        // way, paws first, and needs a moment to stand up again.
        "bookworm_chomp": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.35, active_s: 0.1, recover_s: 0.4, damage: 1, reach_px: 28.0)),
        ),
        "red_herring_dart": (
            move_style: Float,
            melee: Some(Lunge(windup_s: 0.3, active_s: 0.2, recover_s: 0.5, damage: 1, reach_px: 30.0, step_px: 0.0, rush_px: 150.0)),
        ),
        "paper_tiger_pounce": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.6, active_s: 0.3, recover_s: 0.8, damage: 2, reach_px: 60.0, step_px: 0.0, rush_px: 200.0)),
        ),
        // The Amphitheatre (the performance quarter of the Art dimension). A
        // stagehand swings its sandbag over its head and down in front; a
        // critic keeps his distance and throws tomatoes, and swats with his
        // notepad when you come close; a mime leans on an invisible wall (its
        // windup row), pulls an invisible rope, then shoves you for real.
        "stagehand_sandbag": (
            move_style: Walk,
            melee: Some(Slam(windup_s: 0.35, active_s: 0.12, recover_s: 0.4, damage: 2, reach_px: 40.0)),
        ),
        "critic_tomato": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.25, active_s: 0.08, recover_s: 0.35, damage: 1, reach_px: 26.0)),
            ranged: Some(Rock(speed: 340.0, damage: 1)),
        ),
        "mime_shove": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.6, active_s: 0.2, recover_s: 0.6, damage: 2, reach_px: 36.0, step_px: 16.0, rush_px: 0.0)),
        ),
        // The Resonant Reach (the music quarter of the Art dimension). A
        // discord note dives in and claps its two heads together; a feedback
        // wail breathes in (its windup row) and shrieks a ring of sound from a
        // distance; a war drum lifts both mallets high and slams the ground in
        // front of it.
        "discord_note_clash": (
            move_style: Float,
            melee: Some(Lunge(windup_s: 0.30, active_s: 0.12, recover_s: 0.45, damage: 1, reach_px: 30.0, step_px: 0.0, rush_px: 150.0)),
        ),
        "feedback_wail_shriek": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.2, active_s: 0.08, recover_s: 0.3, damage: 1, reach_px: 30.0)),
            ranged: Some(Bolt(speed: 440.0, damage: 1)),
        ),
        "war_drum_slam": (
            move_style: WalkHeavy,
            melee: Some(Slam(windup_s: 0.8, active_s: 0.2, recover_s: 1.0, damage: 3, reach_px: 72.0)),
        ),
        // The Workshop Deeps. A clay golem lifts both fists over its head and
        // slams them onto the floor in front of it (its arms stretch to reach);
        // a loom spider rears, then darts in and stabs with its front needles;
        // a kiln sprite breathes in until its pot glows and spits a coal.
        "clay_golem_slam": (
            move_style: WalkHeavy,
            melee: Some(Lunge(windup_s: 0.85, active_s: 0.3, recover_s: 1.1, damage: 3, reach_px: 64.0, step_px: 0.0, rush_px: 30.0)),
        ),
        "loom_spider_stab": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.35, active_s: 0.12, recover_s: 0.45, damage: 1, reach_px: 30.0, step_px: 0.0, rush_px: 160.0)),
        ),
        "kiln_sprite_spit": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.2, active_s: 0.08, recover_s: 0.3, damage: 1, reach_px: 28.0)),
            ranged: Some(Rock(speed: 340.0, damage: 1)),
        ),
        // The Fertile Crescent (`targets/characters/locust_swarm.py`,
        // `aurochs.py`, `scorpion_man.py`). A locust swarm pulls itself into a
        // ball (its windup row) and streams at you face first; an aurochs
        // lowers its horns and paws the ground (its windup row), then charges
        // a long way and tosses its horns, and needs a long moment to turn its
        // bulk round; a scorpion man cocks his tail high and back (his windup
        // row) and stings over his head into the ground in front of him.
