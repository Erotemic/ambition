            max_health: Some(5),
            mass: Some(4.0),
            tags: ["enemy", "history", "south_asia", "seal"],
        barks: (
            on_hit: ["*a chip of steatite flies off*", "*clack!*"],
            provoked: ["*it lowers its one horn at you*"],
            idle: ["*a stiff stone snort*", "*it tries out its legs. It is new to legs.*", "*the signs on its side shift, as if to say something*"],
            hall: ["*thousands of seals show it, and the signs over it. Nobody can read them yet. It would tell you, but it cannot read them either.*", "*it was one inch tall for four thousand years. It is enjoying the size.*"],
        ),
        ),
