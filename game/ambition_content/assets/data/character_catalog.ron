        // ===== THE AMPHITHEATRE (the performance quarter of the Art
        // dimension): the people of the theatre, and the people who watch it.
        // The stagehand: crew in black with a headset and a sandbag. Fast and
        // low; the bag goes back over its shoulder (its windup row), then over
        // its head and down in front.
        "stagehand": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
