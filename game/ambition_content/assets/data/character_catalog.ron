        // distance and shoots (the `shoot` of a skirmisher): he draws the bow to
        // the ear first (his windup row). The arrow flies as an `Arrow` and
        // looks like one (`ranged_vfx`).
        "horse_archer": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
