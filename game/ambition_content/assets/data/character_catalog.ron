        // ===== Mathematician parodies (2026-07-20 sprite generators).
        // Runga + Cutta are one duo (they raid Oiler's Kernel together);
        // Genghis Can + Can't are the other. Yuclid and Hunny Horror are
        // Basement-tier bodies.
        "npc_carl_runga": (
            display_name: "Carl Runga",
            spritesheet: "sprites/carl_runga_spritesheet.png",
            manifest: "sprites/carl_runga_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["mathematician", "kernel_raider", "numerical_duelist", "slow_heavy"],
        barks: (
            on_hit: ["My step size was generous. Yours was not.", "Recompute. Recompute!", "That was within tolerance. Barely."],
            idle: ["Four evaluations per step. That is the price of being right.", "Oiler guessed. I sample."],
            hall: ["Oiler takes one step and calls it a trajectory. I take four and call it respect.", "My error shrinks like h to the fourth. His does not. That is the whole argument.", "The Kernel belongs to whoever integrates it best. That is not a threat, it is an estimate.", "I do not guess the slope. I sample it, four times, and average like a professional."],
        ),
        hall_dialogue_id: Some("hall_npc_carl_runga"),
        ),
        "npc_martin_cutta": (
            display_name: "Martin Cutta",
            spritesheet: "sprites/martin_cutta_spritesheet.png",
            manifest: "sprites/martin_cutta_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["mathematician", "kernel_raider", "numerical_duelist"],
        barks: (
            on_hit: ["Noted. Adjusting the midpoint.", "That is a stiff problem.", "Runga! Weights!"],
            idle: ["He is the name on the method. I am the reason it converges.", "Someone has to carry the coefficients."],
            hall: ["Runga does the shouting. I do the fourth-order correction.", "Two of us, four evaluations, one step. Do the arithmetic on that partnership.", "We are not stealing the Kernel. We are refining its ownership.", "History gave him top billing. History was rounding."],
        ),
        hall_dialogue_id: Some("hall_npc_martin_cutta"),
        ),
        "npc_anne_druid": (
            display_name: "Anne Druid",
            spritesheet: "sprites/anne_druid_spritesheet.png",
            manifest: "sprites/anne_druid_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "scientist", "science_communicator", "cosmic_druid", "golden_record_keeper", "peaceful"],
            fallback_dialogue: [
                "The record is not a time capsule. It is an introduction.",
                "Listen long enough and the universe stops sounding empty.",
                "Wonder without skepticism is fog.",
                "The map points home. If you can read a pulsar.",
                "We sent music, greetings, a heartbeat, and the sound of a kiss. Optimism is sometimes an engineering decision.",
                "A message for strangers begins with the hope that strangers can understand.",
                "Skepticism without wonder is a locked door.",
                "I do not know who finds it. That was never the point of sending it.",
            ],
        barks: (
            idle: ["The record is not a time capsule. It is an introduction.", "Listen long enough and the universe stops sounding empty."],
            hall: ["We sent music, greetings, a heartbeat, and the sound of a kiss. Optimism is sometimes an engineering decision.", "A message for strangers begins with the hope that strangers can understand.", "The map points home, but only if you already know how to read a pulsar.", "Wonder without skepticism is fog. Skepticism without wonder is a locked door."],
        ),
        hall_dialogue_id: Some("hall_npc_anne_druid"),
        ),
        "npc_richard_duckling": (
            display_name: "Richard Duckling",
            spritesheet: "sprites/richard_duckling_spritesheet.png",
            manifest: "sprites/richard_duckling_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "bird", "scientist", "science_communicator", "memeticist", "summoner", "peaceful"],
            fallback_dialogue: [
                "That criticism lacked peer review!",
                "An adverse selection event!",
                "I practically invented memes. Where are the ducks?",
                "No, that is a goose meme. Entirely different clade.",
                "I named the thing, you know. One might expect at least one excellent duck template by now.",
                "A meme is not merely an image with text. Unfortunately, most images with text have not heard this.",
                "I am applying artificial selection. Natural selection has had decades and produced nothing usable.",
                "The ducklings are not followers. They are independent replicators with suspiciously similar opinions.",
            ],
        barks: (
            on_hit: ["That criticism lacked peer review!", "An adverse selection event!"],
            idle: ["I practically invented memes. Where are the ducks?", "No, that is a goose meme. Entirely different clade.", "The cultural environment remains inexplicably duck-poor."],
            hall: ["I named the thing, you know. One might expect at least one excellent duck template by now.", "A meme is not merely an image with text. Unfortunately, most images with text have not heard this.", "I am applying artificial selection. Natural selection has had decades and produced nothing usable.", "The ducklings are not followers. They are independent replicators with suspiciously similar opinions."],
        ),
        hall_dialogue_id: Some("hall_npc_richard_duckling"),
        ),
        "npc_le_beast": (
            display_name: "Le Beast",
            spritesheet: "sprites/le_beast_spritesheet.png",
            manifest: "sprites/le_beast_spritesheet.ron",
            tier: MainHall,
            body_kind: Wide,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "peaceful",
            tags: ["story", "beast", "mathematician", "measure_theorist", "heavyweight", "zone_controller", "peaceful"],
        barks: (
            on_hit: ["A non-negligible impact!", "That had positive measure."],
            idle: ["A point? No nourishment at all.", "Bring me something measurable.", "I have an appetite for almost everywhere."],
            hall: ["You keep pointing at individual points. I keep telling you they have no weight by themselves.", "Cut the meal into pieces, rearrange it, plate it upside down. The amount remains the amount.", "Riemann invited only the well-behaved functions. I opened the dining hall.", "The sigma on my clasp is not decoration. It is the menu."],
        ),
        hall_dialogue_id: Some("hall_npc_le_beast"),
        ),
        "npc_hypatia_prime": (
            display_name: "Hypatia Prime",
            spritesheet: "sprites/hypatia_prime_spritesheet.png",
            manifest: "sprites/hypatia_prime_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "mathematician", "astronomer", "philosopher", "scholar_guardian", "mystery", "peaceful"],
        barks: (
            on_hit: ["Add that to the surviving testimony.", "An inelegant correction."],
            idle: ["The record is incomplete. That is not permission to stop reading.", "A copy of a copy can still preserve an angle.", "You expected certainty from fragments?"],
            hall: ["You are speaking to a reconstruction. Whether I am the first, the best, or merely the latest is another question.", "Most people remember the ending because endings travel easily. I am more interested in the work that did not survive.", "A missing book is not an empty book. It leaves citations, students, arguments, and strangely shaped absences.", "Mystery is not magic. Sometimes it is simply what remains after the documents do not."],
        ),
        hall_dialogue_id: Some("hall_npc_hypatia_prime"),
        ),
        "npc_marie_curry": (
            display_name: "Marie Curry",
            spritesheet: "sprites/marie_curry_spritesheet.png",
            manifest: "sprites/marie_curry_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["story", "combatant", "scientist_parody", "chemist", "chef", "caster", "mentor"],
            authoring_description: "Parodies: Marie Curie. A culinary-radiant parody of Marie Curie: the brilliant scientist reimagined as a dangerous curry alchemist whose cookware glows with suspiciously energetic spice. Visual inspiration: Marie Curie portraiture and late-19th-century scholar silhouettes. apron-over-dress chef-scientist hybrid costume. a glowing curry pot carried like lab equipment. green radiance cues kept stylized and playful rather than realistic or grim. Reference hooks: radioactivity and luminous materials. scientific rigor. kitchen alchemy. precise, understated intensity. Design notes: The joke should read instantly as Curie becomes Curry, but the character should still feel competent, prestigious, and formidable. Blend laboratory and kitchen language: apron, stirring spoon, potion pot, notebook-minded posture. She should feel dangerous because she knows exactly what she is doing, not because she is chaotic. The glow should imply radiant chemistry and experimental cooking at once.",
            gameplay_description: "Role: mid-range alchemist / area-control scientist. Combat identity: stirs volatile curry compounds before releasing them. controls space with splashes, fumes, or radiant puddles. reads as a smart caster rather than a brawler. Signature moves: Radium Roux: a glowing stir that charges her concoction. Curry Burst: a lob or toss of volatile sauce. Half-Life Simmer: a lingering hazard puddle or aura. Authoring notes: This sheet includes a stir attack and a toss animation that can back future spell or projectile mechanics. A later expansion would benefit from a dedicated throw, splash impact, and maybe a 'measure sample' or note-taking pose. Dialog should feel calm, exacting, and a little dry, even while the food chemistry becomes absurd.",
            fallback_dialogue: [
                "Careful, it is still reactive.",
                "Let it simmer.",
                "A measured dose.",
                "Observe the glow.",
                "That mixture was unstable anyway.",
                "The spice is luminous today.",
                "Precision matters in both science and cooking.",
                "People panic around invisible forces. I prefer to study them.",
                "A good experiment and a good recipe both deserve patience.",
                "The hazard is usually not the substance. It is the carelessness.",
            ],
            hall_dialogue_id: Some("hall_npc_marie_curry"),
        ),
        "npc_joseph_furrier": (
            display_name: "Joseph Furrier",
            spritesheet: "sprites/joseph_furrier_spritesheet.png",
            manifest: "sprites/joseph_furrier_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["story", "humanoid", "mathematician", "blanket_wrapped", "harmonic_caster", "playable_candidate"],
            fallback_dialogue: [
                "Everything decomposes. Be patient.",
                "That was a single frequency. Rude.",
                "Heat always finds the edges.",
                "I am cold. This is not a metaphor.",
                "Any shape at all, given enough simple waves. It sounds like a trick until you check it.",
                "I wrapped myself in blankets and studied how warmth leaves a room. The two facts are related.",
                "A sharp corner costs infinitely many terms. Corners usually do.",
                "People hear a chord. I hear the sum.",
            ],
            authoring_description: "Joseph Furrier is a transformative parody of French mathematician and physicist Joseph Fourier. The oversized blanket is inspired by the commonly repeated biographical anecdote that Fourier habitually kept himself heavily wrapped for warmth; Ambition exaggerates that private eccentricity into his permanent bundled silhouette. The name's furrier pun is expressed through the blanket's thick trim rather than by turning Fourier into an animal. Stair shapes are deliberately limited to the step_function and spectral_descent gameplay actions: they are a game-facing homage to stepwise/discrete approximation and platforming, not another claim about Fourier's life. The spectral lining, separated color bands, wave attacks, and low-pass defensive posture draw on Fourier analysis, frequency decomposition, and filtering. The overall tone is dark, cold, and eccentric, but affectionate rather than horrific.",
            hall_dialogue_id: Some("hall_npc_joseph_furrier"),
        ),
        "npc_admiral_grass_hopper": (
            display_name: "Admiral Grass Hopper",
            spritesheet: "sprites/admiral_grass_hopper_spritesheet.png",
            manifest: "sprites/admiral_grass_hopper_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["story", "combatant", "scientist_parody", "insectoid", "naval_officer", "computer_science", "mentor", "hopper"],
            authoring_description: "Parodies: Rear Admiral Grace Hopper. A grasshopper admiral who literalizes the Hopper name while keeping Grace Hopper's naval-computing legacy at the center. Visual inspiration: Grace Hopper portraiture and U.S. Navy officer presentation. storybook grasshopper silhouettes with long hind legs and antennae. a compact metroidvania-friendly side profile rather than a realistic insect. gold-trimmed admiral coat, cap badge, and a command baton that can also read as a debugging pointer. Reference hooks: COBOL / compiler pioneer. debugging lore and the famous moth anecdote. naval command presence. fast hopping movement and crisp lecture-energy dialog. Design notes: Keep the character likable and readable first, then let the entomology sell the pun. The coat, epaulettes, and hat should do most of the 'admiral' work; the abdomen, antennae, and hind legs should do most of the 'grasshopper' work. The baton can double as a compiler pointer, classroom stick, or melee flourish. The tone should celebrate Grace Hopper rather than mocking her: this is a tribute-parody character.",
            gameplay_description: "Role: mobile support-skirmisher / brilliant officer. Combat identity: quick side-hops and sharp baton strikes. commanding bark-based support fantasy. can read as a mentor NPC, miniboss, or playable light fighter. Signature moves: Bug Report: a precise baton jab or slash that 'flags' an enemy. Compiler Directive: a command gesture that could buff allies or alter battlefield behavior. Debug Hop: a springy reposition with exaggerated grasshopper leg compression. Authoring notes: This sheet only includes a general-purpose slash, not a full projectile or support kit yet. Future expansion should probably add a pronounced hop / leap attack row and a dedicated command-point emote. Because Grace Hopper is a foundational computing figure, dialog should lean clever, direct, and impatient with sloppy thinking.",
            fallback_dialogue: [
                "Debug it at the source!",
                "Hop to it!",
                "Compiler says no!",
                "Mind your logic!",
                "That bug is now documented!",
                "Order from disorder!",
                "I prefer clear thinking, clean systems, and decisive action.",
                "A bug ignored is a bug promoted.",
                "You can waste time arguing with reality, or you can measure it and move.",
                "The trick is to make complex work look disciplined.",
            ],
            hall_dialogue_id: Some("hall_npc_admiral_grass_hopper"),
        ),
        "npc_python_goras": (
            display_name: "Python Goras",
            spritesheet: "sprites/python_goras_spritesheet.png",
            manifest: "sprites/python_goras_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "mathematician", "philosopher", "snake_companion", "geometry_mage", "playable_candidate"],
            fallback_dialogue: [
                "Observe the hypotenuse.",
                "All things are number!",
                "Mind the angle.",
                "The serpent agrees.",
                "You stand at the wrong vertex.",
                //  restored 2026-08-06, not written today: these four are
                // `python_goras.py`'s `FALLBACK_DIALOGUE_LINES`, which the
                // splice read as nothing because it spells the key
                // `fallback_lines` and `character_notes.fallback_pool` knew
                // three other spellings. His five barks came through, so the row
                // looked finished.
                "I seek the hidden ratios beneath ordinary things.",
                "Most people remember the triangle. Fewer remember the cult.",
                "The python is not symbolic. He simply chose to stay.",
                "Harmony, number, and a clean right angle can solve more than people think.",
            ],
            hall_dialogue_id: Some("hall_npc_python_goras"),
        ),
        "npc_leib_knives": (
            display_name: "Gottfried Leib-Knives",
            spritesheet: "sprites/leib_knives_spritesheet.png",
            manifest: "sprites/leib_knives_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["human", "mathematician", "polymath", "courtly_duelist", "dual_blades", "playable_candidate"],
            fallback_dialogue: [
                "An infinitesimal cut still counts.",
                "You have mistaken notation for weakness.",
                "That was neither necessary nor sufficient.",
                "Very well. Let us differentiate.",
                "I prefer notation that reveals the operation instead of concealing it. A symbol should do useful work.",
                "GNU Ton and I reached similar techniques by different roads. Posterity then paved the roads with arguments.",
                "A derivative tells you how quickly the present is becoming the future. In a duel, that is practical information.",
                "An integral gathers countless small changes into one result. Do not stand inside the result.",
            ],
            hall_dialogue_id: Some("hall_npc_leib_knives"),
        ),
        "npc_georg_canter": (
            display_name: "Georg Canter",
            spritesheet: "sprites/georg_canter_spritesheet.png",
            manifest: "sprites/georg_canter_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["centaur", "mathematician", "set_theorist", "transfinite", "lancer", "playable_candidate"],
            fallback_dialogue: [
                "Some infinities are roomier.",
                "You cannot list us all. I have checked.",
                "Count again. Slower.",
                "There is always one more.",
                "I showed the line holds more than the counting numbers, and was told this was indecent.",
                "Between any two of your objections there is another objection. That is the shape of the problem.",
                "The set of things you have not tried is strictly larger than the set of things you have.",
                "A diagonal is a very quiet kind of proof.",
            ],
            hall_dialogue_id: Some("hall_npc_georg_canter"),
        ),
        "npc_paul_diracula": (
            display_name: "Paul Diracula",
            spritesheet: "sprites/paul_diracula_spritesheet.png",
            manifest: "sprites/paul_diracula_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["story", "humanoid", "scientist", "mathematician", "physicist", "vampire_parody", "precision_duelist", "playable_candidate"],
            fallback_dialogue: [
                "I vant to annihilate your positron.",
                "The equation demanded a mirror. I merely opened it.",
                "Antimatter, darling. Not undeath.",
                "Symmetry. Always symmetry.",
                "The mathematics predicted a partner nobody had seen. I trusted the mathematics.",
                "Beauty in an equation is not decoration. It is usually a load-bearing wall.",
                "Every particle has a reflection waiting to cancel it. I find that romantic.",
                "I speak rarely. When the algebra is correct there is not much left to add.",
            ],
            hall_dialogue_id: Some("hall_npc_paul_diracula"),
        ),
        "player_robot_v2": (
            // The SAME tuning the `player` row carried when this art was the
            // protagonist. `frame_sample_inset` decides which pixels count as
            // body when the bbox is sampled, so it moves the COLLISION box, not
            // just the drawing -- dropping it re-bodied the duellist.
            sprite_tuning: Some((collision_scale: 1.35, frame_sample_inset: 1)),
            display_name: "Player Robot v2",
            spritesheet: "sprites/player_robot_v2_spritesheet.png",
            manifest: "sprites/player_robot_v2_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "robot_duelist_kit",
            tags: ["robot", "player", "former_self", "playable_candidate"],
            authoring_description: "The player robot as it shipped before the SVG rig replaced it. Preserved as a CHARACTER rather than as history: Ambition wants old versions of yourself to be things you can meet, talk to, and fight, so this keeps its own id, its own sheet, and its own pedestal instead of living in a git object. `robot` is v0, the original. There is no v1 -- that is a joke, not a gap.",
            gameplay_description: "Mechanically the protagonist minus everything learned since: the same procedural body and the same generic swipe kit, with none of the current kit's blade presentation. The obvious use is a mirror fight -- a former build that moves the way you used to.",
            fallback_dialogue: [
                "I was the build that worked.",
                "You kept the antenna. I noticed.",
                "Deprecated is not the same as wrong.",
                "I still remember the jump arc.",
                "They rebuilt me from a vector file. I am not sure that counts as continuity.",
                "Version zero is downstairs telling everyone he invented the patch note.",
                "There is no v1. Ask someone else why.",
                "Every version of you thinks it is the last one.",
            ],
        barks: (
            hall: ["I was the build that worked.", "There is no v1. Ask someone else why.", "You kept the antenna. I noticed."],
            on_hit: ["I remember this part.", "You learned that from me."],
            provoked: ["Then let us see what you kept."],
        ),
        hall_dialogue_id: Some("hall_player_robot_v2"),
        ),
        "pointed_polygon": (
            display_name: "Pointed Polygon",
            spritesheet: "sprites/pointed_polygon_spritesheet.png",
            manifest: "sprites/pointed_polygon_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  this said `"combatant"`, which is not a brain preset and never
            // was — it is a TRAIT name (see the `traits:` list in any
            // `*_actor.ron`), and the pack validator refuses it by name:
            // "names brain preset `combatant`, which this pack does not define".
            // `melee_brute_striker` is what every other MainHall melee fighter
            // takes (both vikings, both ninjas, the pirate admiral, Carl Runga,
            // Martin Cutta — twelve rows), which is the conventional answer for a
            // sword fighter's autonomous policy when nobody is driving it.
            //  RESTORED 2026-08-20, third time: a working copy of this file cut
            // before the fix reverts it, and `cargo check` cannot see a value
            // parsed out of RON — only the pack validator says so, and when it
            // does it takes 44 tests down with it.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "polygonal", "sword_fighter", "animation_reference", "playable_candidate", "svg_rigged"],
            authoring_description: "A deliberately anonymous faceted humanoid inspired by the idea of a Fighting Polygon Team. This first archetype carries a simple polygon sword and exists both as a real Smash fighter and as a safe reference rig: new humanoid characters can begin from its conservative poses before adding bespoke anatomy, costume, or personality. The character is an original 2D polygon fighter rather than a copy of any specific Smash combatant.",
            gameplay_description: "A medium-weight fundamentals sword fighter with conventional spacing, recovery, defense, grabs, pummels, and all four throws. Its move silhouettes are intentionally simple and legible so the same clips can serve as animation references for future humanoid rigs.",
            fallback_dialogue: [
                "Start with the silhouette.",
                "Reference stance.",
                "Every complicated fighter begins as a few good angles.",
            ],
            barks: (
                idle: ["POSE ACCEPTED.", "EDGE ALIGNED."],
                on_hit: ["FACET LOST.", "REBUILDING POSE."],
                provoked: ["REFERENCE COMBAT."],
            ),
            hall_dialogue_id: None,
        ),
        "pugnacious_polygon": (
            display_name: "Pugnacious Polygon",
            spritesheet: "sprites/pugnacious_polygon_spritesheet.png",
            manifest: "sprites/pugnacious_polygon_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            // The sword archetype's preset, for the same reason and by the same
            // rule — see its row above. A brawler is a MainHall melee fighter.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "polygonal", "brawler", "animation_reference", "playable_candidate", "svg_rigged"],
            authoring_description: "The unarmed Fighting Polygon reference archetype: a broad-shouldered 2D humanoid assembled from editable polygon facets with oversized fists and no integral held item. It shares the sword archetype's safe pose vocabulary so animators can compare armed and unarmed versions of the same humanoid skeleton before adding bespoke anatomy or personality.",
            gameplay_description: "A close-range fundamentals brawler with punches, kicks, uppercuts, a shoulder rush, defensive movement, grabs, pummels, and all four throws. Its simple silhouettes are intentionally useful as baseline poses for future humanoid rigs.",
            fallback_dialogue: [
                "STANCE SET.",
                "Contact pose.",
                "Build the silhouette before the flourish.",
            ],
            barks: (
                idle: ["FACETS FORWARD.", "GUARD READY."],
                on_hit: ["RECOMPUTING STANCE.", "FACET SHIFT."],
                provoked: ["REFERENCE BRAWL."],
            ),
            hall_dialogue_id: None,
        ),
        "projectile_polygon": (
            display_name: "Projectile Polygon",
            spritesheet: "sprites/projectile_polygon_spritesheet.png",
            manifest: "sprites/projectile_polygon_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "skirmisher_ranger",
            default_action_set: "ranger_arrow",
            tags: ["bestial", "polygonal", "projectile_fighter", "animation_reference", "playable_candidate", "svg_rigged"],
            authoring_description: "The ranged member of the Fighting Polygon reference trio is now a non-humanoid beast biped: a faceted T-rex-like body with heavy hind legs, a balancing tail, and a head-mounted cannon. Teal facets and a simple visor slit keep the design readable while giving LLMs and animators a generic non-humanoid reference for future beast fighters.",
            gameplay_description: "A medium-weight ranged fundamentals fighter. Neutral special fires a fast facet-colored bolt from the head-mounted cannon; the rest of the repertoire stays conventional so the character remains useful as the projectile-oriented bestial animation reference.",
            fallback_dialogue: [
                "VECTOR READY.",
                "Trajectory solved.",
                "Emit from the centerline.",
            ],
            barks: (
                idle: ["VECTOR READY.", "AIM FACET LOCKED."],
                on_hit: ["TRAJECTORY LOST.", "RECALCULATING."],
                provoked: ["PROJECTILE TEST."],
            ),
            hall_dialogue_id: None,
        ),
        // THE TWO EASTER EGGS, and they are deliberately not advertised anywhere
        // else: no hall dialogue, no quest, no encounter table. They are on the
        // smash grid because that is where a hidden fighter is FOUND, and
        // nothing in the game depends on either being selected.
        "author": (
            display_name: "The Author",
            spritesheet: "sprites/author_spritesheet.png",
            manifest: "sprites/author_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            // The sword archetype's preset, by the same rule its row states: an
            // armed MainHall melee fighter takes what every other one takes.
            // What he is armed WITH is a pen, which is a fact about the art and
            // the joke, not about his autonomous policy.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "pen_fighter", "easter_egg", "playable_candidate", "svg_rigged"],
            authoring_description: "The person writing the game, standing in it: red hair, beard, glasses, work shirt and jeans, levelling an oversized red-and-brass fountain pen at everything. He follows the Pointed Polygon sword template exactly -- one rigid prop on the hand bone, occupying the blade's axis and length -- so the shared humanoid swing library retargets onto him without a pose being re-authored. He is meant to be found, not announced.",
            gameplay_description: "A medium-weight fundamentals fighter with sword spacing, delivered by a pen. His swings leave ink rather than steel-light; the timings are the sword archetype's, because his identity is who he is and what he holds rather than how he swings.",
            fallback_dialogue: [
                "I did write you, you know.",
                "This is not the scene I planned.",
                "Mightier. Demonstrably.",
            ],
            barks: (
                idle: ["Draft one.", "Still editing."],
                on_hit: ["Noted.", "That is going in."],
                provoked: ["Fine. Revisions."],
            ),
            hall_dialogue_id: None,
        ),
        "officer": (
            display_name: "The Officer",
            spritesheet: "sprites/officer_spritesheet.png",
            manifest: "sprites/officer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            // The brawler archetype's preset, for the reason the Pugnacious
            // Polygon's row gives: an unarmed MainHall melee fighter is still a
            // MainHall melee fighter.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "brawler", "easter_egg", "playable_candidate", "svg_rigged"],
            authoring_description: "A broad, plainly drawn law officer in a dark t-shirt, work jeans, boots and a grey campaign hat -- out of uniform from the neck down and entirely in character from the neck up. He follows the Pugnacious Polygon brawler template for every normal: no held props, and swings read by what they do to the AIR rather than by a blade catching light. The one exception is his sidearm, which is drawn on his own sheet -- a duty holster on his back and a service pistol his shoot clip puts in his fist -- not a held prop.",
            gameplay_description: "A medium-weight close-range fundamentals brawler with one ranged answer. Tilts throw a pale whoosh and smashes open a re-entry plume that leads with its tip, so an unarmed hitbox stays as legible as an armed one. His side special is the draw: he plants, clears the holster and fires one round down the side he was pointed, which is his only way to touch someone he cannot reach. The rest of the timings are the brawler archetype's.",
            fallback_dialogue: [
                "I'm not here for you. Yet.",
                "Everybody's a civilian until they aren't.",
                "Do this the easy way. Please.",
            ],
            barks: (
                idle: ["That's far enough.", "Hands where I can see them."],
                on_hit: ["Cute.", "Last warning."],
                provoked: ["You're going to want to sit down."],
            ),
            hall_dialogue_id: None,
        ),
        "medic": (
            display_name: "The Medic",
            spritesheet: "sprites/medic_spritesheet.png",
            manifest: "sprites/medic_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            // The brawler archetype's preset, for the reason the Officer's row
            // gives: an unarmed MainHall melee fighter is still a MainHall
            // melee fighter. ⚠ `patrol_peaceful` would read better for a medic
            // and would be a BALANCE decision nobody has made; she borrows the
            // archetype's brain for as long as she borrows its table.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "brawler", "support", "easter_egg", "playable_candidate", "svg_rigged"],
            authoring_description: "A field paramedic off duty: black fitted top, black leggings, trainers, a high ponytail. Hand-drawn and rigged by program. Her whole vocabulary is the PALM -- heel strikes, lifts, compressions -- because a medic's trained motion is push, lift, carry, and never close the fist; anything heavy she does with both hands. Her swings read clinical: a cold white-cyan trace for tilts and a defibrillator discharge for smashes.",
            gameplay_description: "A light, fast two-handed brawler on the Pugnacious Polygon's timings, retimed shorter. Low raw KO power, long combo strings, and every heavy commitment is a TWO-HANDED one -- which is what makes her smashes slow and her tilts quick. She is the only fighter here who can PUT SOMETHING BACK: her neutral special spends a slice of her own margin for tempo and her down special kneels and repays it. Those rules are not written yet; she borrows the archetype's specials until they are.",
            fallback_dialogue: [
                "I don't fight people. I move them.",
                "Whatever you did to your shoulder, that wasn't me.",
                "Sit. Breathe. We'll get to it.",
            ],
            barks: (
                idle: ["Stay down. I'm not asking.", "Look at me. Can you hear me?"],
                on_hit: ["I've got you.", "You're going to be fine. Probably."],
                provoked: ["Don't make me carry you."],
            ),
            hall_dialogue_id: None,
        ),
        "actor": (
            display_name: "The Actor",
            spritesheet: "sprites/actor_spritesheet.png",
            manifest: "sprites/actor_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            // The sword archetype's preset, for the reason the Author's row
            // gives -- she is that archetype, carrying nothing.
            default_brain: "melee_brute_striker",
            default_action_set: "striker_swipe",
            tags: ["humanoid", "duellist", "performer", "easter_egg", "playable_candidate", "svg_rigged"],
            authoring_description: "A working performer between calls: an oversized grey cardigan over a dark tank, flared trousers, worn boots, an auburn updo coming down at the edges. Hand-drawn and rigged by program. Long unbroken lines, three greys and one auburn, and the far side of her drawn one step back in tone -- baked into opaque fills, never alpha, because every rig part rasterizes to its own layer.",
            gameplay_description: "A committed mid-range duellist on the Pointed Polygon's timings, held longer. Her forward smash is THE DUEL SCENE: a fencer's lunge with a blade of stage light conjured for exactly the frames the role calls for it, authored as the swing's own axis extended past her hand -- so the blade a player sees is the blade that hits them. A thin volume over a long reach, on purpose. Outside those frames her hands are empty and short, and everything she throws is held long enough to be punished.",
            fallback_dialogue: [
                "I'm not playing anyone right now. It's disconcerting, isn't it.",
                "Everyone's in costume. Most of them just don't know it.",
                "Give me a moment. I have to decide who I am.",
            ],
            barks: (
                idle: ["From the top.", "That was your cue."],
                on_hit: ["Louder. The back row paid too.", "I can do this all night. I have."],
                provoked: ["You are stepping on my line."],
            ),
            hall_dialogue_id: None,
        ),
        "special_patent_clerk": (
            display_name: "Patent Clerk",
            spritesheet: "sprites/patent_clerk_spritesheet.png",
            manifest: "sprites/patent_clerk_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "striker_swipe",
            tags: ["special_character", "humanoid", "patent_clerk", "reference_frame_controller", "classification_fighter", "playable_candidate", "svg_rigged"],
            authoring_description: "Patent Clerk is a coy parody of Albert Einstein, designed around his patent-office period, iconic unruly hair, moustache, relativity thought experiments, clock synchronization, reference frames, and mass-energy equivalence. The public character never confirms the identity: recognition is carried by silhouette, mechanics, and restrained bureaucratic dialogue. The combat classifications and administrative stamps are deliberate game inventions rather than biographical claims.",
            gameplay_description: "A high-mastery heavyweight controller who classifies bodies as MASS, ENERGY, MOVING, or AT REST; manipulates relative velocity and local reference frames; and turns careful observation into unusually strong parries and finishers. His recovery uses an accelerating elevator frame, his stage control uses synchronized clocks, and his super resolves several quiet office observations into one inevitable conversion.",
            fallback_dialogue: [
                "Your application has several interesting assumptions.",
                "Please remain in your chosen frame.",
                "The distinction is useful—for now.",
                "Your timing was local.",
                "Approved.",
                "No, I am only a clerk.",
                "A clock is reliable until you ask where it has been.",
                "Common sense is often a local regulation.",
                "You may call yourself stationary. Courtesy permits it.",
                "The office prefers inventions. I find assumptions more interesting.",
                "There are many patent clerks.",
                "Not required in this field.",
            ],
        barks: (
            idle: ["Stamped. Provisionally.", "You are moving. The furniture disagrees, and was not consulted."],
            hall: ["A pedestal is a very strong claim about being at rest.", "Everyone here has filed as stationary. Remarkably, they are all correct.", "Please do not lean on the exhibit. It is load-bearing in the legal sense.", "Your file is mostly assumptions. Well organised, though."],
        ),
        hall_dialogue_id: Some("hall_special_patent_clerk"),
        ),
        "npc_carl_stargan": (
            display_name: "Carl Stargan",
            spritesheet: "sprites/carl_stargan_spritesheet.png",
            manifest: "sprites/carl_stargan_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "",
            //  2026-08-16: he authors a sixteen-move repertoire
            // (`carl_stargan_moveset`). An ability and a repertoire are
            // different questions — *may this body attack* versus *what the
            // attack is* — and a `peaceful` row answered the first one NO, so
            // the table could never reach a fighter.
            default_action_set: "striker_swipe",
            tags: ["story", "science_communicator", "cosmic_storyteller", "skeptic", "peaceful"],
        barks: (
            idle: ["Billions and billions of rooms, and only one of them has you in it.", "Look up. The ceiling is a temporary opinion."],
            hall: ["Billions and billions of pedestals, and you chose to inspect mine. I am flattered.", "That pale blue dot on the horizon holds everyone you have ever respawned as.", "Extraordinary platforming claims require extraordinary evidence.", "You are made of starstuff. Mostly the part that falls."],
        ),
        hall_dialogue_id: Some("hall_npc_carl_stargan"),
        ),
        "npc_data_lovelace": (
            display_name: "Data Lovelace",
            spritesheet: "sprites/data_lovelace_spritesheet.png",
            manifest: "sprites/data_lovelace_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,  // renderer calls this silhouette "Slim"; gameplay body class is Standard
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["robot", "automaton", "computing", "victorian", "peaceful"],
        barks: (
            idle: ["The engine weaves algebra as the loom weaves flowers.", "Someone must imagine what the machine is for."],
            hall: ["They built the engine. I wrote what it would do with itself.", "The engine weaves algebraic patterns as the loom weaves flowers. I merely supplied the cards.", "My notes ran longer than the paper they annotated. I regret nothing.", "I am not the calculating part. I am the part that imagined a use."],
        ),
        hall_dialogue_id: Some("hall_npc_data_lovelace"),
        ),
        "npc_neil_ongras_turfson": (
            display_name: "Neil onGras Turfson",
            spritesheet: "sprites/neil_ongras_turfson_spritesheet.png",
            manifest: "sprites/neil_ongras_turfson_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "scientist", "cosmic_naturalist", "touch_grass", "peaceful"],
        barks: (
            idle: ["Well, actually, that trajectory is wrong.", "The universe owes you no coyote time."],
            hall: ["Actually, the physics of that jump is wrong, and I will be explaining why for the remainder of the room.", "The universe is under no obligation to make your platforming feel good.", "Have you considered going outside? I am contractually required to ask.", "Well, actually, the grass is also made of stars. Touch it anyway."],
        ),
        hall_dialogue_id: Some("hall_npc_neil_ongras_turfson"),
        ),
        "npc_paradox_barber": (
            display_name: "The Paradox Barber",
            spritesheet: "sprites/paradox_barber_spritesheet.png",
            manifest: "sprites/paradox_barber_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,  // renderer calls this silhouette "Slim"; gameplay body class is Standard
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "barber", "paradox", "logic", "peaceful"],
        barks: (
            idle: ["Do not ask about my face.", "The appointment book contains itself. This is the problem."],
            hall: ["I shave every man who does not shave himself. Do not ask about my face.", "Take a seat. Do not take a seat. Both are consistent with my schedule.", "The set of my customers is not a set. Management has been informed.", "I have been mid-shave since I opened. That is not a metaphor."],
        ),
        hall_dialogue_id: Some("hall_npc_paradox_barber"),
        ),
        "npc_mami_marzakhani": (
            display_name: "Mami Marzakhani",
            spritesheet: "sprites/mami_marzakhani_spritesheet.png",
            manifest: "sprites/mami_marzakhani_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "mathematician", "geometer", "boundary_walker", "peaceful"],
        barks: (
            idle: ["A shortest path is a question about which surface you are standing on.", "Give me floor space and a very large sheet of paper."],
            hall: ["A curve is not a shortest path until you say which surface it lives on.", "I count the closed geodesics. There are more than you would like and fewer than you fear.", "I do my best work lying on the floor around a very large sheet of paper.", "The surface is not the obstacle. The surface is the argument."],
        ),
        hall_dialogue_id: Some("hall_npc_mami_marzakhani"),
        ),
        "npc_genghis_can": (
            display_name: "Genghis Can",
            spritesheet: "sprites/genghis_can_spritesheet.png",
            manifest: "sprites/genghis_can_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "warlord", "nomad_parody", "paired_character"],
        barks: (
            idle: ["Yes. Next question.", "The horizon is a to-do list."],
            hall: ["Can I take this hall? I can. That was never in question.", "My brother asks whether. I ask how many.", "Everything from here to that wall. Then a short rest. Then the wall.", "Doubt is just a slower way of arriving."],
        ),
        hall_dialogue_id: Some("hall_npc_genghis_can"),
        ),
        "npc_genghis_cant": (
            display_name: "Genghis Can't",
            spritesheet: "sprites/genghis_cant_spritesheet.png",
            manifest: "sprites/genghis_cant_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["story", "warlord", "nomad_parody", "paired_character"],
        barks: (
            idle: ["I have a horde. I also have reservations.", "Let me check the map again."],
            hall: ["Could I conquer this? Probably. Should I? That is the part that keeps me up.", "My brother says yes before he checks. I check first. We arrive at the same place, later.", "I have a horde. I also have reservations.", "They named him for what he does. They named me for what I consider."],
        ),
        hall_dialogue_id: Some("hall_npc_genghis_cant"),
        ),
        "npc_yuclid": (
            display_name: "Yuclid",
            spritesheet: "sprites/yuclid_spritesheet.png",
            manifest: "sprites/yuclid_spritesheet.ron",
            tier: Basement,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["boss", "story", "mathematician", "geometer", "anti_portal", "lecture_duelist"],
        barks: (
            on_hit: ["That was not a proof.", "You have skipped a step. Again.", "Irregular. Unacceptable."],
            idle: ["There is no royal road to geometry.", "Between any two points, one line. One."],
            hall: ["A portal is a confession that you could not find the path.", "There is no royal road to geometry. There is certainly no orange one.", "Between any two points, one straight line. Not two doors.", "You did not arrive. You were placed. Prove the difference."],
        ),
        hall_dialogue_id: Some("hall_npc_yuclid"),
        ),
        "npc_hunny_horror_boss": (
            display_name: "Hunny Horror",
            spritesheet: "sprites/hunny_horror_boss_spritesheet.png",
            manifest: "sprites/hunny_horror_boss_spritesheet.ron",
            tier: Basement,
            body_kind: Wide,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["boss", "bear", "horror", "honey", "monster"],
        barks: (
            on_hit: ["Bother.", "The pot is empty.", "I only wanted a little."],
            idle: ["Rumbly. Always rumbly.", "The pot is empty. The pot is always empty."],
            hall: ["I only wanted a little. There was never a little.", "The pot is empty. The pot has always been empty.", "Bother.", "They put me on a pedestal because the honey ran out down there."],
        ),
        hall_dialogue_id: Some("hall_npc_hunny_horror_boss"),
        ),
    },
)
