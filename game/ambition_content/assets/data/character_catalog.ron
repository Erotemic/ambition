            melee: Some(Lunge(windup_s: 0.5, active_s: 0.3, recover_s: 0.6, damage: 1, reach_px: 44.0, step_px: 0.0, rush_px: 220.0)),
        ),

        // The Bad Apple's chomp: it rears back with its maw wide (its windup
        // row), then rolls at you jaws first, and sits a beat after, dizzy. Its
        // `attack_side` row is drawn to these times (`BAD_CHOMP_S` in the
        // sprite tools' `_apple_enemy_family.py`): change them together.
        "bad_apple_chomp": (
            move_style: Walk,
            melee: Some(Lunge(windup_s: 0.45, active_s: 0.25, recover_s: 0.6, damage: 1, reach_px: 30.0, step_px: 0.0, rush_px: 140.0)),
        ),
        // The haunted floors of Hylbert's Hotel (Jon, 2026-10-31: spectral
        // enemies with attacks and hitboxes). Each attack's times match its
        // sheet's `attack_side` row (`targets/characters/<id>.py`); its reach
        // is its hitbox in front of it. Change them together.
        // The Eigenghost lances along its eigenvector: it squeezes across
        // (frames 0-3, 70 ms), its arm springs out (4-5), and it eases back.
        "eigenghost_lance": (
            move_style: Float,
            melee: Some(Swipe(windup_s: 0.28, active_s: 0.14, recover_s: 0.42, damage: 1, reach_px: 46.0)),
        ),
        // The Spectral Perturbation's core lunge: its ring tilts and shards
        // draw in (0-4, 60 ms), it darts, committed (5-8), and hangs splayed
        // and open after (9-13): the punish window.
        "spectral_perturbation_lunge": (
            move_style: Float,
            melee: Some(Lunge(windup_s: 0.30, active_s: 0.24, recover_s: 0.50, damage: 1, reach_px: 40.0, step_px: 0.0, rush_px: 190.0)),
        ),
        // The Decomposing Specter's spectral slash: it coils and raises its
        // claw (0-3), holds the tell (4-6), sweeps a wide crescent (7-10),
        // and slumps open (11-15).
        "decomposing_specter_slash": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.42, active_s: 0.24, recover_s: 0.45, damage: 2, reach_px: 58.0)),
        ),
        // The Shift Operator's shove: she raises and turns her key (0-3, 70
        // ms), shoves a wave of chevrons one room along (4-6), and leans out,
        // open, after (7-9).
        "shift_operator_shove": (
            move_style: Float,
            melee: Some(Swipe(windup_s: 0.28, active_s: 0.21, recover_s: 0.40, damage: 1, reach_px: 62.0)),
        ),
        // The Quantum Die's spooky action at a distance: its entangled twin
        // forms ahead and the thread draws taut (0-4, 65 ms), it collapses
        // into its twin, blinking across the gap (5-7), and sits decohered
        // after (8-11). The rush is the twin's distance.
        "quantum_die_collapse": (
            move_style: Float,
            melee: Some(Lunge(windup_s: 0.33, active_s: 0.2, recover_s: 0.5, damage: 1, reach_px: 34.0, step_px: 0.0, rush_px: 110.0)),
        ),
        // The Dealer's Hand's toss: it cups and shakes a die (0-5, 65 ms),
        // flings its fingers open (6-8), and holds open after (9-11). The
        // throw stands in as a lobbed rock until gameplay composes the hand
        // with the Quantum Die it throws (`quantum_die`, spawned at the
        // release).
        "dealers_hand_toss": (
            move_style: Float,
            melee: None,
            ranged: Some(Rock(speed: 340.0, damage: 1)),
        ),
        // The Gravity Apple's charge: its orbits flare, then it drops on you.
        "gravity_apple_charge": (
            move_style: Float,
            melee: Some(Bite(windup_s: 0.3, active_s: 0.12, recover_s: 0.4, damage: 1, reach_px: 40.0)),
