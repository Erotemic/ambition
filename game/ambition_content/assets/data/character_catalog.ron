            barks: (
                idle: ["EYES FRONT.", "Left. Left. Left, right, left."],
                hall: ["I have drilled generals. Not this one. Nobody drills this one.", "Standing still is a skill. Most people only think they have it."],
            ),
        ),
        "npc_tower_dorsey": (
            display_name: "Private Dorsey",
