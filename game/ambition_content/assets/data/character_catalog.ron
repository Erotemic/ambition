            locomotion: Some((run_speed: 170.0, move_style: Walk)),
            contact_damage: Some((strength: 0.70, amount: 1)),
            named_autonomous_profile: Some("medium_striker"),
            max_health: Some(5),
            tags: ["enemy", "base"],
        barks: (
