            special: None,
        ),
    },

    characters: {
        // ===== Base characters (player, robot, goblin, sandbag). The
        // player slot is special-cased by the runtime (Brain::Player);
        // its catalog entry exists only to keep the sprite registry
        // and catalog symmetrical so Phase 6 can delete the registry.
        "npc_companion_dog": (
            display_name: "Companion Dog",
            manifest: "sprites/companion_dog_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(64.0),
            composition: None,
            default_brain: "companion_dog_roam",
            default_action_set: "peaceful",
            // It stands by its centre of gravity (`balance`): a long body with
            // its centre over a ledge's end or a hole goes off it.
            locomotion: Some((run_speed: 120.0, move_style: Walk, baseline_free_flight: Some(false), balance: Some(()))),
            // It walks and hops.
            abilities: Some([Walk, Jump]),
            max_health: Some(4),
            tags: ["animal", "dog", "quadruped", "companion", "peaceful"],
            fallback_dialogue: ["Woof!", "The dog wags its tail."],
            barks: (
                idle: ["Woof!", "Arf!"],
                hall: ["Woof!", "The dog wags its tail."],
            ),
            hall_dialogue_id: Some("hall_npc_companion_dog"),
            // The dog's conversation offers a pet (`<<pet>>`); this row makes it pettable.
            // It is petted on the nose: 28 ahead of the point its head turns
            // about (at its ear) and 9 below it, where its muzzle rests when
            // it lies down to be petted. The robot's pet row holds its hand
            // at that height.
            petting: Some((sound: Some("npc.dog.woof"), contact_offset: (28.0, 9.0))),
        ),
        // A house dog, from a photograph of a dog of Jon's (2026-10-13). It is
        // drawn on the companion dog's rig, with its brain, its body and its
        // pet, and it roams a test room off the basement. `standing_height`
        // is the height of the whole drawing, ears included, so it is not how
        // tall the dog is at the shoulder: Honey is the smallest (35 lb): short legs and a stout body.
        "npc_dog_honey": (
            display_name: "Honey",
