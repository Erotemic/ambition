            tags: ["enemy", "history", "east_asia", "bronze"],
        barks: (
            on_hit: ["*CLANG*", "*verdigris flakes off it*"],
            provoked: ["*its eyes swivel round to you. Only its eyes.*"],
            idle: ["*it stares*", "*it stares harder*", "*a faint smell of hot metal*"],
            hall: ["*it was cast on the side of a cauldron, to stare at whoever ate from it. Three thousand years on, it is still staring. It is very good at it.*", "*scholars argue about what it means. It has heard every argument. It is not telling.*"],
        ),
        ),
