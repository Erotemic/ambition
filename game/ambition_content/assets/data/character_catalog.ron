            max_health: Some(3),
            tags: ["enemy", "evil", "undead", "minion"],
            cues: (notice: Some("enemy.zombie.notice"), tell: Some("enemy.zombie.tell"), swing: Some("enemy.zombie.swing"), hit: Some("enemy.zombie.hit")),
        barks: (
            on_hit: ["*a wet grunt*", "Hhhrk."],
            idle: ["*a long, wet groan*", "Hhhrrr... or... ders..."],
            hall: ["*teeth click*", "Hhhh... papers... please..."],
        ),
        hall_dialogue_id: Some("hall_npc_evil_zombie"),
        ),
        // The Crawling Conscript: a Risen Conscript with no legs, who drags
        // himself along the floor on his arms (Jon, 2026-10-30). He lies still
        // until you are close, rears back on one arm (a long tell) and lunges
        // along the floor to grab and bite; after it he lies flat, open.
        "npc_evil_zombie_crawler": (
            display_name: "Crawling Conscript",
            manifest: "sprites/evil_zombie_crawler_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // Low and wide: his body as he lies (45 px of his sheet), at the
