        "sandbag": (
            sprite_tuning: Some((collision_scale: 1.38, frame_sample_inset: 1)),
            display_name: "Sandbag",
            manifest: "sprites/sandbag_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). The row's `autonomous_profile`
            // below outranks this field everywhere it is read, so naming
            // `stand_still` was the same policy stated twice.
            //  safe for THIS preset specifically: `stand_still` holds no speeds
            // and no `aggressiveness`, so nothing came across with it. A preset
            // that carries a RELATIONSHIP (the `aggressiveness: 0.0` on
            // `parrot_lively`, which cost four attempts to understand) has to
            // move that to the placements first.
            default_action_set: "sandbag_punch",
            // THE PRACTICE TARGET: a body that exists to be hit. No aggro, no strike
            // back, not saved, not given a path, which is what `practice_target` says in
            // one word. Its respawn belongs to the placement (ADR 0022). The immortal
            // dummy is a different creature (`sandbag_infinite`), because never dying is
            // a character trait.
            practice_target: true,
            // It never walks anywhere, because StandStill drives it, but it states a
            // speed and a gait like every body.
            locomotion: Some((run_speed: 155.0, move_style: Walk)),
            autonomous_profile: Some((
                template: StandStill,
                // It notices nobody and swings at nobody.
                patrol_effort: 0.6774,
                chase_effort: 1.0,
            )),
            max_health: Some(6),
            tags: ["training"],
        barks: (
            on_hit: ["..."],
            hall: ["Hit me. Don't hit me. The sandbag abides either way.", "Ten thousand blows and one compliment. I remember the compliment."],
        ),
        hall_dialogue_id: Some("hall_sandbag"),
        ),
        //  THE IMMORTAL DUMMY IS A DIFFERENT CREATURE (D77). It shares the
        // sandbag's sheet and its stance and differs in the one fact that
        // matters to a combat-feel lab: it cannot be destroyed. `never_dies` is
        // a CHARACTER trait (`CharacterDeathTraits`), not a placement one, so
        // "the same sandbag, made invincible here" is not expressible — and
        // pretending it is would put a mortality policy on a spawn point.
        "sandbag_infinite": (
            sprite_tuning: Some((collision_scale: 1.38, frame_sample_inset: 1)),
            display_name: "Infinite Sandbag",
            manifest: "sprites/sandbag_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            //  NAMES NO PRESET (2026-08-12, D81). Its DEFINITION authors an
            // autonomous `BrainProfile`, which outranks this field everywhere it
            // is read — so naming `stand_still` was the same policy stated twice.
            //  safe for THIS preset specifically: `stand_still` holds no speeds
            // and no `aggressiveness`, so nothing came across with it. A preset
            // that carries a RELATIONSHIP (the `aggressiveness: 0.0` on
            // `parrot_lively`, which cost four attempts to understand) has to
            // move that to the placements first.
            default_action_set: "sandbag_punch",
            // THE IMMORTAL TRAINING DUMMY. Never dying is a character trait, so this is
            // a separate creature and not a flag on the sandbag. It states no contact
            // damage: a character says "none" by not speaking.
            practice_target: true,
            death_traits: Some((never_dies: true)),
            locomotion: Some((run_speed: 155.0, move_style: Walk)),
            autonomous_profile: Some((
                template: StandStill,
                // It notices nobody and swings at nobody.
                patrol_effort: 0.6774,
                chase_effort: 1.0,
            )),
            max_health: Some(9999),
            tags: ["training"],
        barks: (
            on_hit: ["...", "Again."],
            hall: ["My colleague over there has six hit points. I have nine thousand nine hundred and ninety-nine, and I have never used one.", "Every fighter in this hall learned something on me. None of them learned my name."],
        ),
        hall_dialogue_id: Some("hall_sandbag_infinite"),
        ),


        // ===== Faction leaders (hub NPCs).
        "npc_general": (
            sprite_tuning: Some((collision_scale: 1.15, frame_sample_inset: 2)),
            display_name: "General",
            manifest: "sprites/absurd_general_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // 180 cm.
            standing_height: Some(69.7),
            composition: None,
            default_brain: "patrol_peaceful",
            default_action_set: "bare_hands",
            tags: ["hub", "faction_leader"],
        barks: (
            on_hit: ["Soldier, explain yourself.", "That is insubordination.", "Court-martial posture engaged."],
            provoked: ["Weapons free!"],
            hall: ["At ease. You couldn't manage anything else near me.", "Everything's a defensive position if you're paranoid enough. I am."],
        ),
        hall_dialogue_id: Some("hall_npc_general"),
        ),
        //  THE GOBLIN BRUTE — Jon's 2026-08-13 casting of `large_brute`,
        // the goblin lab's heavy: "author a distinct Goblin Brute character …
        // a separate reusable character identity rather than a generic archetype
        // row or an alias for an existing named goblin."
        //
        //  its sprite generator already existed and was never wired in.
        // `configs/review/goblin_brute_hammer.yaml` has `target: goblin` with its
        // own name, seed, `archetype: brute` and `variant: bruiser_heavy` — which
        // is exactly the shape he asked for: "it may initially use the same broad
        // goblin visual design/template, scaled/designed as a bigger brute …
        // however, its sprite must have a SEPARATE Python sprite generator/target,
        // even if that generator initially shares helpers or visual vocabulary
        // with the ordinary goblin." The sheet is generated and on disk; all that
        // was missing was this row.
        //
        //  `body_kind: Wide` and the heavier collision scale come from the
        // generator config's own `body_kind: Wide` / `mass_class: Heavy`, so the
        // body the game builds and the body the artist drew agree by derivation
        // rather than by two people typing the same word.
        "npc_goblin_brute": (
            sprite_tuning: Some((collision_scale: 2.1, frame_sample_inset: 1)),
            display_name: "Goblin Brute",
            manifest: "sprites/goblin_brute_hammer_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // Bigger than a goblin (Jon, 2026-10-18: "the size of the goblin heavy
            // should be larger than the normal goblin, currently they are the
            // same size"). His drawing is 1.32x the goblin's; standing heights
            // compare idle silhouettes, and his idle stands 1.24x the goblin's
            // (the goblin's ears are tall, the heavy hunches): 48 x 1.24.
            standing_height: Some(59.7),
            composition: None,
            default_action_set: "brute_hammer",
            // THE BODY of a separate creature, not an alias for a named goblin. Its
            // numbers keep the old `large_brute` waves (exact balance is tunable later).
            // The `melee_brute_brute` chase speed, slower than the goblin band's 170, is
            // what makes a brute read as one.
            locomotion: Some((run_speed: 75.0, move_style: WalkHeavy)),
            // Heavier than the goblin's 0.70: walking into a brute costs more.
            contact_damage: Some((strength: 0.85, amount: 1)),
            // Its own numbers, stated here. The goblin band names a shared policy
            // because several creatures point at it; an indirection earns itself when
            // it has adopters.
            autonomous_profile: Some((
                template: Smash,
                aggro_radius: 240.0,
                attack_range: 44.0,
                patrol_effort: 0.5,
                chase_effort: 1.0,
            )),
            max_health: Some(8),
            tags: ["enemy", "goblin", "heavy"],
        barks: (
            on_hit: ["Rrrgh!", "Little thing hits back!", "Brute not done!"],
            provoked: ["BRUTE SMASH!"],
            hall: ["Brute carry hammer. Hammer carry brute. Is friendship.", "Small goblins talk. Brute does."],
        ),
        hall_dialogue_id: Some("hall_npc_goblin_brute"),
        ),
        // The other goblin heavy (Jon, 2026-10-18: "keep all of these"): a
        // bare-knuckle bruiser with a stone club, the brute's body and kit.
        "npc_goblin_bruiser": (
            sprite_tuning: Some((collision_scale: 2.1, frame_sample_inset: 1)),
            display_name: "Goblin Bruiser",
            manifest: "sprites/goblin_bruiser_club_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // His idle stands 1.18x the goblin's: 48 x 1.18.
            standing_height: Some(56.8),
            composition: None,
            default_action_set: "brute_hammer",
            locomotion: Some((run_speed: 75.0, move_style: WalkHeavy)),
            contact_damage: Some((strength: 0.85, amount: 1)),
            autonomous_profile: Some((
                template: Smash,
                aggro_radius: 240.0,
                attack_range: 44.0,
                patrol_effort: 0.5,
                chase_effort: 1.0,
            )),
            max_health: Some(8),
            tags: ["enemy", "goblin", "heavy"],
        barks: (
            on_hit: ["Hrrk!", "Bruiser felt that. A little.", "Do it again. Bruiser dares."],
            provoked: ["Bruiser's turn!"],
            hall: ["Club is a rock on a stick. Bruiser improved the stick.", "Brute has hammer. Bruiser has hands. And rock."],
        ),
        ),
        "npc_goblin_cantina_chieftain": (
            sprite_tuning: Some((collision_scale: 1.16, frame_sample_inset: 1)),
            display_name: "Fretjaw, Cantina Chieftain",
            manifest: "sprites/goblin_cantina_chieftain_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // His drawing is 1.08x the goblin's (the cantina host, Jon 2026-10-18);
