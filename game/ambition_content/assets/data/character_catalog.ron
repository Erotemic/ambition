        ),
        //  THE ROBOT'S OWN KIT, lifted off the `player_robot` archetype
        // row's combat half (2026-08-11, ledger D83): the snappy player-like
        // strike and the signature projectile. The row's numbers verbatim — a
        // migration that retuned on the way would be two changes wearing one
        // commit.
        "robot_duelist_kit": (
            move_style: Walk,
            melee: Some(Swipe(
                windup_s: 0.16,
                active_s: 0.06,
                recover_s: 0.20,
                damage: 1,
                reach_px: 34.0,
            )),
            ranged: Some(Rock(speed: 360.0, damage: 1)),
            special: None,
        ),
        "brute_lunge": (
            move_style: WalkHeavy,
            melee: Some(Lunge(
                windup_s: 0.45,
                active_s: 0.12,
                recover_s: 0.45,
                damage: 2,
                reach_px: 40.0,
                step_px: 18.0,
            )),
            ranged: None,
            special: None,
        ),
        // The Officer's sidearm. His gun is drawn on his own sheet, so the shot
        // leaves his hand (`Hand`), not his midriff, and looks like a bullet (its
        // art is registered in `crate::projectiles`). The half-plane aim is Jon's
        // rule and belongs to the weapon: the player picks a side and the gun
        // picks the angle in it, out to 280 (a service pistol reaches a spacing
        // exchange, not the stage). The move's own recovery is the cadence, so
        // the weapon has no recharge: a recharge would refuse a shot the move was
        // already accepted to fire. He has no swing of his own.
        // The Iron Trooper's chain gun (the held item `evil_chain_gun`): fast
        // rounds from the gun at his hip, a short refire, and a butt-first
        // smash with it when you are close.
        "evil_chain_gun": (
            move_style: WalkHeavy,
            melee: Some(Swipe(windup_s: 0.34, active_s: 0.10, recover_s: 0.40, damage: 2, reach_px: 46.0)),
            ranged: Some(Weapon((
                style: Pistol,
                speed: 620.0,
                damage: 3,
                visual: Some("pistol_round"),
                refire_s: 0.18,
                // Burst direction is a committed lane, not a homing stream.
                aim_assist: None,
                discharge: Some((muzzle: Hand(ahead: 40.0))),
            ))),
        ),
        // The Risen Conscript's lunge and bite: slow to start, so the first
        // enemy of the castle is read before it lands, and slow to recover, so
        // a miss is a free hit.
        "evil_zombie_bite": (
            move_style: WalkHeavy,
            melee: Some(Lunge(windup_s: 0.62, active_s: 0.12, recover_s: 0.75, damage: 1, reach_px: 34.0, step_px: 22.0)),
        ),
        // The Crawling Conscript's lunge along the floor: a long tell (he rears
        // back on one arm), a short grab, and a long time flat on his face after
        // it, when he is open.
        "evil_crawler_lunge": (
            move_style: WalkHeavy,
            melee: Some(Lunge(windup_s: 0.8, active_s: 0.14, recover_s: 1.1, damage: 1, reach_px: 40.0, step_px: 30.0)),
        ),
        // The Fascist Swordsman's sabre thrust: a short windup (the point drawn
        // back to his hip), a long reach, and a quick return to guard.
        "fascist_sabre_thrust": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.26, active_s: 0.10, recover_s: 0.32, damage: 1, reach_px: 60.0)),
        ),
        // The Fascist Clubman's overhead: the club up high for a long time, down
        // hard for two hearts, and a long recovery bent over it.
        "fascist_club_overhead": (
            move_style: WalkHeavy,
            melee: Some(Slam(windup_s: 0.72, active_s: 0.14, recover_s: 0.95, damage: 2, reach_px: 46.0)),
        ),
        // The Shock Warden's baton: a raised swing it shows you, two hearts if
        // it lands, and a long recovery behind the shield (its `recovery` row).
        "shock_warden_baton": (
            move_style: WalkHeavy,
            melee: Some(Swipe(windup_s: 0.5, active_s: 0.12, recover_s: 0.85, damage: 2, reach_px: 50.0)),
        ),
        // The Searchlight Crawler's strike: the lamp flares and the front legs
        // stab.
        "searchlight_crawler_strike": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.4, active_s: 0.1, recover_s: 0.45, damage: 1, reach_px: 40.0)),
        ),
        // The Attack Hound's bite: quick, and it reaches with the lunge.
        "evil_hound_bite": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.18, active_s: 0.10, recover_s: 0.30, damage: 1, reach_px: 52.0)),
        ),
        // The Spectral Wolf's bite. Its windup is its fade in (`fade_in`, 6 x
        // 60 ms) and its recovery its fade out (`fade_out`, 6 x 70 ms): it is
        // solid, and hittable, from the start of the one to the end of the other.
        "spectral_wolf_bite": (
            move_style: Walk,
            melee: Some(Bite(windup_s: 0.36, active_s: 0.10, recover_s: 0.42, damage: 1, reach_px: 56.0)),
        ),
        "officer_sidearm": (
            move_style: Walk,
            ranged: Some(Weapon((
                style: Pistol,
                speed: 560.0,
                damage: 7,
                visual: Some("pistol_round"),
                refire_s: 0.0,
                aim_assist: Some((max_angle_rad: 1.5707963267948966, max_range: 280.0)),
                discharge: Some((muzzle: Hand(ahead: 10.0))),
            ))),
        ),
        // The Projectile Polygon's head-mounted cannon. The charge shot is the
        // character: a full hold is worth about three and a half taps, flies half
        // again as fast and is more than twice the size, and its five looks are
        // the sheet's five tiers. The flight is stated so the size has something
        // to scale. The shot leaves the cannon, forward of and above the body
        // origin, as a fraction of body height.
        "polygon_cannon": (
            move_style: Walk,
            ranged: Some(Weapon((
                style: Bolt,
                speed: 540.0,
                damage: 4,
                flight: Some((
                    gravity: 0.0,
                    bounces: 0,
                    bounce_on_world_contact: false,
                    max_lifetime: 2.4,
                    half_extent: (10.0, 8.0),
                    boomerang_return_s: None,
                )),
                charge: Some((
                    damage_mult: 3.5,
                    speed_mult: 1.5,
                    size_mult: 2.4,
                    visuals: [
                        "polygon_charge_shot_tier1",
                        "polygon_charge_shot_tier2",
                        "polygon_charge_shot_tier3",
                        "polygon_charge_shot_tier4",
                        "polygon_charge_shot_tier5",
                    ],
                )),
                discharge: Some((muzzle: Offset(x: 0.22, y: -0.34))),
            ))),
        ),
        // The void projectile polygon's cannon: the polygon's, at Ambition's
        // damage, drawn black and white. A tap deals 1 health and a full hold
        // 3, a smash attack's.
        "void_polygon_cannon": (
            move_style: Walk,
            ranged: Some(Weapon((
                style: Bolt,
                speed: 540.0,
                damage: 1,
                flight: Some((
                    gravity: 0.0,
                    bounces: 0,
                    bounce_on_world_contact: false,
                    max_lifetime: 2.4,
                    half_extent: (10.0, 8.0),
                    boomerang_return_s: None,
                )),
                charge: Some((
                    damage_mult: 3.0,
                    speed_mult: 1.5,
                    size_mult: 2.4,
                    visuals: [
                        "void_polygon_charge_shot_tier1",
                        "void_polygon_charge_shot_tier2",
                        "void_polygon_charge_shot_tier3",
                        "void_polygon_charge_shot_tier4",
                        "void_polygon_charge_shot_tier5",
                    ],
                )),
                discharge: Some((muzzle: Offset(x: 0.22, y: -0.34))),
            ))),
        ),
        // The cellular automatons' swipe and their glider. The glider (a Conway
        // spaceship, the zoning tool) is the ranged action, not the side-B: the
        // `glider_launch` special displaces it instead of spawning a second one.
        // No special here: the moveset binds `special -> cellular_pulse`, and a
        // special here would take the slot the shield uses.
        // The PCA's own: the automatons' swipe, and his charge blast (Jon,
        // 2026-10-18: Mewtwo's Shadow Ball). The neutral special
        // `pca_shadow_ball` holds the charge and fires this. A tap is 3% and a
        // nudge; a full hold (Ultimate's 133 frames, the move's 2.2 s) is
        // 25%, flies 1.6 times as fast, is three times the size and launches
        // five times as hard, a kill at about Mewtwo's percent. Each tier's
        // look is a Life oscillator in a membrane.
        "pca_life_cannon": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.24, active_s: 0.08, recover_s: 0.30, damage: 1, reach_px: 30.0)),
            ranged: Some(Weapon((
                style: Bolt,
                speed: 420.0,
                damage: 3,
                flight: Some((
                    gravity: 0.0,
                    bounces: 0,
                    bounce_on_world_contact: false,
                    max_lifetime: 2.2,
                    half_extent: (8.0, 8.0),
                    boomerang_return_s: None,
                )),
                charge: Some((
                    damage_mult: 8.33,
                    launch_mult: 5.0,
                    speed_mult: 1.6,
                    size_mult: 3.0,
                    visuals: [
                        "pca_charge_shot_tier1",
                        "pca_charge_shot_tier2",
                        "pca_charge_shot_tier3",
                        "pca_charge_shot_tier4",
                        "pca_charge_shot_tier5",
                    ],
                )),
                launch: Some((base: 30.0, growth: 0.76)),
                // From the chest, in front of the body, as Shadow Ball leaves
                // Mewtwo's hands. Its brain (the Smash template) fires level,
                // so the shot keeps the muzzle's height: from the crown
                // (y -0.5) every shot passed 20 px over a standing 48 px
                // player.
                discharge: Some((muzzle: Offset(x: 0.3, y: -0.15))),
            ))),
        ),
        "automaton_swipe_and_glider": (
            move_style: Walk,
            melee: Some(Swipe(windup_s: 0.24, active_s: 0.08, recover_s: 0.30, damage: 1, reach_px: 30.0)),
            ranged: Some(Rock(speed: 300.0, damage: 1)),
