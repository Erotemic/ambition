                hall: ["The wreckers' lantern says HARBOUR. Mine says ROCKS. A captain can only believe one of us.", "Keep it burning and tell the truth. That's the whole job."],
            ),
        ),
        "npc_port_brine": (
            display_name: "Nell Brine",
            // A beachcomber on the Wreckers' Reef's shore.
