        barks: (
            idle: ["I dreamt the formulae; I merely wrote them down.", "The partitions grow faster than anyone expects."],
            hall: ["I dreamt the answer. Proof can have it after breakfast.", "1729 has two doors and excellent secrets.", "The noodles were infinite. The bowl was not.", "You owe me an egg."],
        ),
        hall_dialogue_id: Some("hall_npc_ramen_nujan"),
        ),
        "npc_pipi_tau": (
