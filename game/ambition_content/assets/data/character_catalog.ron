        // ===== Stochastic Parrot. ONE character, two factions: a friendly
        // cove bird (NpcSpawn -> this catalog row -> `patrol_peaceful`) and the
        // aggressive sky raiders (EnemySpawn name="Stochastic Parrot" -> the
        // `sky_parrot` enemy archetype, sprite bound by display-name match).
        // Both share this sprite + body via the actor unification.
        "stochastic_parrot": (
            sprite_tuning: Some((collision_scale: 1.0, frame_sample_inset: 1)),
            display_name: "Stochastic Parrot",
            // v2, the SVG-rigged scarlet macaw (renderer f0ada62), with the same
            // twelve rows as the v1 sheet it replaces.
            manifest: "sprites/stochastic_parrot_v2_spritesheet.ron",
            tier: MainHall,
            // Floating = gravity-free, so the lively Aerial brain flies it.
            body_kind: Floating,
            composition: None,
            //  THE FIRST CHARACTER TO NAME NO BRAIN PRESET (2026-08-12,
            // D81), on the fifth attempt. Four blockers, each a different fact
            // hiding behind one field:
            //
            //   1. the policy numbers were dead weight — the DEFINITION's
            //      `BrainProfile { Aerial, aggro 620, attack_range 60 }` wins.
            //   2. `aggressiveness: 0.0` looked like the cove parrot's
            //      peacefulness. It is not: that is its `NpcSpawn` PLACEMENT.
            //   3. `default_brain` CARRIED THE NAMESPACE. An entry states its
            //      `provider` now, so it does not have to.
            //   4. and there were TWO qualification sites, not one — the catalog's
            //      validator and `resolve_initial_brain`. Teaching only the first
            //      looked exactly like a half-assembled catalog until a test
            //      asked the assembled entry directly and found it perfectly fine.
            //
            //  this bird's policy is its definition's and its hostility is its
            // placement's. `parrot_lively` was a third copy of both, with
            // different numbers, deciding neither.
            default_action_set: "parrot_bite",
            // THE BODY. A bird states its own flight: `body_kind: Floating` is a
            // footprint fact and is not locomotion authority.
            locomotion: Some((run_speed: 240.0, move_style: Float, baseline_free_flight: Some(true))),
            contact_damage: Some((strength: 0.55, amount: 1)),
            // It stalks to an altitude above its target, dives, pecks on contact and
            // peels off to recover. A stochastic parrot repeats what it hears and
            // squawks what it sees, so it relays sightings with the crew it flies with.
            // ⚠ Its `default_brain` still names `parrot_lively`, whose numbers (aggro
            // 120, range 0) disagree with this policy. This policy wins, so the preset
            // is dead weight; it stays only because `default_brain` is required.
            autonomous_profile: Some((
                template: Aerial,
                aggro_radius: 620.0,
                attack_range: 60.0,
                shares_sightings: true,
                // The tell before its dive (Jon 2026-10-30: "telegraph, attack"): it hangs and squawks, then dives.
                tactics: (dive_tell_s: 0.35, notice_s: 0.3),
            )),
            max_health: Some(3),
            tags: ["pirate", "bird", "npc"],
            cues: (notice: Some("enemy.parrot.notice"), tell: Some("enemy.parrot.tell"), swing: Some("enemy.flyer.attack_dive"), hit: Some("enemy.bird.hit")),
            // SCAFFOLD exemplar. idle migrated from features::npcs (the
            // "parrot_cove" legacy pool, now keyed by catalog id).
            barks: (
                idle: [
                    "Awk! Polly wants a corpus.",
                    "Squawk! Next token... 'cracker'. High confidence.",
                    "I contain multitudes. Mostly other people's.",
                    "Pieces of prior! Pieces of prior!",
                    "Awk! I'm not parroting, I'm GENERALIZING. ...mostly.",
                    "Temperature's high today. Feeling creative. Brawk!",
                    "Attention is all you need! And crackers.",
                ],
                hall: ["Awk! Predicting your next word... 'cracker'. Usually right!", "I contain multitudes. Statistically averaged multitudes. Brawk!"],
            ),
            hall_dialogue_id: Some("hall_stochastic_parrot"),
        ),

        // ===== Perfect Cellular Automaton.
        // Python-authored Fable-extension skeletal target. VFX such as energy
        // or slash arcs are intentionally not baked into the sprite sheet.
        "perfect_cellular_automaton": (
            sprite_tuning: Some((collision_scale: 1.12, frame_sample_inset: 1)),
            display_name: "Perfect Cellular Automaton",
            manifest: "sprites/perfect_cellular_automaton_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            // Its MEASURED height, authored 2026-08-28 so the FRAME stops deciding
            // it. `Floating` has no default, so this row rode
            // `ldtk_box x collision_scale / FRAME_H` — and a frame is publishing
            // padding, not a claim about how tall anybody is. Widening the frame to
            // clear D129's 53 clipped frames shrank the body 67.8 -> 54.8 with no
            // art change, which is the whole reason this number is written down now.
            standing_height: Some(67.8),
            composition: None,
            default_action_set: "pca_life_cannon",
            // Its strikes draw its own sheet (`perfect_cellular_automaton_strike_fx`), not the stand-in wedge.
            attack_vfx: Some("perfect_cellular_automaton_strike_fx"),
            // A grounded fighter that can fly: it fights on the ground and flies
            // only to cross a long gap, so it states `baseline_free_flight: false`
            // beside the `Flight` grant.
            locomotion: Some((run_speed: 168.0, move_style: Walk, baseline_free_flight: Some(false))),
            contact_damage: Some((strength: 0.75, amount: 1)),
            // The run-and-jump floor, and the four capabilities a possessing
            // player inherits (blink, flight, shield, dash). Nothing specific to a
            // platform fighter: no double jump, fast fall, dodge or ledge grab.
            abilities: Some([RunJump, Interact, Reset, Attack, Blink, Flight, Shield, Dash]),
            autonomous_profile: Some((
                template: Smash,
                aggro_radius: 540.0,
                attack_range: 150.0,
                patrol_effort: 0.5714,
                chase_effort: 1.0,
                smash_sprint_to_close: true,
                // Footsies and spacing rather than close-and-camp.
                smash_duelist: true,
            )),
            // The duel arena's fighters carry a `grudge_against`: they are
            // provoked, not spawned hostile, and a provoked creature takes this
            // policy.
            provoked_profile: Some("cellular_duelist"),
            // Jon: "PCA needs to shoot a glider." The shot is a functional rock
            // that looks like the Conway glider.
            ranged_vfx: Some("glider"),
            max_health: Some(60),
            tags: ["aerial", "enemy", "custom", "cellular"],
        barks: (
            on_hit: ["Iteration interrupted.", "State diverged from optimal.", "Rule violated. Adapting.", "Error. Correcting."],
            provoked: ["Initializing conflict state."],
            hall: ["One rule. No exceptions. Observe the inevitability.", "I have run this moment to its end. You are predictable, charmingly so."],
        ),
        hall_dialogue_id: Some("hall_perfect_cellular_automaton"),
        ),
        "imperfect_cellular_automaton": (
            sprite_tuning: Some((collision_scale: 1.12, frame_sample_inset: 1)),
            display_name: "Imperfect Cellular Automaton",
            manifest: "sprites/imperfect_cellular_automaton_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            // Its MEASURED height under the ONE spawn box every level places it
            // with, authored 2026-08-28 (D129). This row had no default, so its
            // size came out of `ldtk_box x collision_scale / FRAME_H` — a level
            // rectangle and the sheet's publishing padding, neither of which is a
            // claim about how tall anybody is. Same output today; the point is
            // that changing it is now one number.
            standing_height: Some(50.0),
            composition: None,
            // The same body as the perfect automaton, under its own name and art:
            // see that row for why each fact is what it is.
            default_action_set: "automaton_swipe_and_glider",
            locomotion: Some((run_speed: 168.0, move_style: Walk, baseline_free_flight: Some(false))),
            contact_damage: Some((strength: 0.75, amount: 1)),
            abilities: Some([RunJump, Interact, Reset, Attack, Blink, Flight, Shield, Dash]),
            autonomous_profile: Some((
                template: Smash,
                aggro_radius: 540.0,
                attack_range: 150.0,
                patrol_effort: 0.5714,
                chase_effort: 1.0,
                smash_sprint_to_close: true,
                smash_duelist: true,
            )),
            provoked_profile: Some("cellular_duelist"),
            ranged_vfx: Some("glider"),
            max_health: Some(60),
            tags: ["aerial", "enemy", "custom", "cellular"],
        barks: (
            on_hit: ["Er — glitch — GAHH!", "That wasn't in the rule set!", "Malfunction cascade!", "Rulebase corrupted!"],
            provoked: ["All states hostile!"],
            hall: ["I followed the rule. Mostly. The 'mostly' is where I get interesting.", "Perfection repeats. I, gloriously, drift."],
        ),
        hall_dialogue_id: Some("hall_imperfect_cellular_automaton"),
        ),

