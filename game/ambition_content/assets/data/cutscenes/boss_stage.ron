// The final boss's cutscenes (`docs/planning/game/final-boss.md`), schema
// `cutscene_library` (see `intro.ron` for the beats).
//
// The Boss does not talk to the player. He talks to his agent.
[
    // The main stage's `entry_cutscene`: the lights come up, and he gives
    // his agent its task.
    (
        id: "boss_vibe_kill",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Banner(
                text: "THE BOSSOFTHEGAME — FINAL TOUR",
                seconds: 1.6,
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "Okay. Full Stack. Listen carefully.",
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "Kill the player. Make it right. Make no mistakes.",
            ),
            Dialogue(
                speaker_character_id: "npc_full_stack",
                text: "Great question! Here is a five-step plan to kill the player:",
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "No plan. Just do it. I'm going to walk away for a few minutes.",
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "When I come back the player should be dead. Do not ask me for input.",
            ),
            SetFlag(
                id: "boss_vibe_kill_seen",
                on: true,
            ),
        ],
        seen_flag: Some("boss_vibe_kill_seen"),
    ),
    (
        id: "boss_leaves_the_stage",
        roles: [("boss", Placement("boss_stage.bossofthegame"))],
        beats: [
            Command(line: "actor.pose @boss death hold"),
            CameraTrack(roles: ["boss"], seconds: 0.18),
            Command(line: "actor.push @boss 1100 70"),
            Wait(seconds: 1.0),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "...Okay. That was a good one.",
            ),
            Command(line: "actor.pose @boss getup hold"),
            Wait(seconds: 0.56),
            Command(line: "actor.release @boss"),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "I'm taking five. Full Stack, leave the lights on.",
            ),
            Command(line: "actor.leave_through @boss boss_stage_green_door keeps_to_its_tasks"),
            WaitFor(condition: "actor.gone @boss", seconds_at_most: 24.0),
            CameraRelease(seconds: 0.8),
        ],
        seen_flag: None,
    ),
    (
        id: "boss_early_access",
        beats: [
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "The bossofthegame is the bossofthegame until the day he dies…",
            ),
            Wait(seconds: 0.55),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "…or retires. I said I was taking five.",
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "You reached the end of Early Early Access. The game's still unfinished. We're still working on what comes next.",
            ),
            Dialogue(
                speaker_character_id: "npc_bossofthegame",
                text: "You can keep exploring. Full Stack, where did we put the rest of the game?",
            ),
            Banner(text: "END OF EARLY EARLY ACCESS", seconds: 2.4),
        ],
        seen_flag: Some("boss_early_access_seen"),
    ),
]
