// The intro cutscenes, schema `cutscene_library` (owned by the cutscene capability,
// `ambition_cutscene::content_schema`). Every file of this schema merges into
// one library; a script id may be in one file only.
//
// A script is an id, ordered beats and an optional seen flag (the runtime does
// not play a script whose seen flag is set). Beats: Wait(seconds),
// Dialogue(speaker, text) (waits for the dismiss button), CameraPan(target,
// seconds), Fade(from_alpha, to_alpha, seconds) with 0.0 clear and 1.0 black
// (both ends are authored, Q143), SetFlag(id, on), Banner(text, seconds) and
// Fall(character), a scripted death in the cutscene's room, Command(line), a
// prepared command (the vocabulary of a Yarn `<<command>>` and a room line:
// `actor.walk_to`, `actor.leave_through`, `encounter.start`), and
// WaitUntil(condition), which requires the named result in normal and skipped
// play. BeforeFact runs its beats when the saved result is absent at entry.
// A room plays a script on entry when its `entry_cutscene` level field names
// it; a `CutsceneTrigger` volume plays one when a player body stands in it.
//
// Beats are short: the intro design is firm that the intro must not become a
// long cutscene wall.

[
    (
        id: "creator_final_fragment",
        roles: [("dennis", Character("npc_creator")), ("scout", Character("player_robot_v3"))],
        beats: [
            WaitUntil(condition: "world.flag_set intro_brute_scene_seen"),
            CameraTrack(roles: ["dennis", "scout"], seconds: 0.45),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "Scout. Over here. Did he get you too?"),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "The case has your logs. Every answer since Tuesday. Paper's harder to wipe by mistake."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "Give me a second. I just need to sit."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "You answered like yourself, all the way through. I want to write that d—"),
            Fall(character: "npc_creator"),
            SetFlag(id: "intro_creator_dead", on: true),
            SetFlag(id: "intro_creator_fragment_normal", on: true),
            CameraRelease(seconds: 0.4),
        ],
        seen_flag: Some("intro_creator_fragment_seen"),
    ),
    (
        id: "intro_brute_takes_the_case",
        roles: [("brute", Character("npc_raid_brute")), ("dennis", Character("npc_creator")),
                ("scout", Character("player_robot_v3"))],
        beats: [
            CameraTrack(roles: ["brute", "scout"], seconds: 0.3),
            Command(line: "actor.pose @brute smash_down hold"),
            Dialogue(speaker: "Raid Brute", speaker_character_id: "npc_raid_brute",
                text: "I'm done with the robot. Get the case."),
            Command(line: "actor.shove @brute 260"),
            Wait(seconds: 0.45),
            CameraPan(target: (1210.0, 284.0), seconds: 0.45),
            BeforeFact(flag: "intro_dennis_wounded", beats: [
                Command(line: "actor.fetch @brute intro_brute_bomb runs_where_sent"),
                Command(line: "actor.fight @dennis @brute"),
                Command(line: "actor.walk_to @dennis intro_dennis_impact runs_where_sent"),
                WaitUntil(condition: "actor.holds_item @brute intro_brute_bomb"),
                Command(line: "actor.walk_to @brute intro_brute_throw runs_where_sent"),
                WaitUntil(condition: "actor.arrived @brute"),
                WaitUntil(condition: "actor.arrived @dennis"),
                Command(line: "actor.face @brute @dennis"),
                Command(line: "actor.face @dennis @brute"),
                Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                    text: "Scout, down! He's got another one."),
                AllowDamage(role: "dennis", minimum_health: Some(1)),
                Command(line: "actor.pose @brute throw_forward hold"),
                Wait(seconds: 0.18),
                Command(line: "actor.throw @brute @dennis"),
                WaitUntil(condition: "world.flag_set intro_dennis_wounded"),
                Wait(seconds: 0.3),
            ]),
            Command(line: "actor.fetch @brute intro_bench_case runs_where_sent"),
            WaitUntil(condition: "actor.holds_item @brute intro_bench_case"),
            SetFlag(id: "intro_case_taken", on: true),
            CameraTrack(roles: ["brute"], seconds: 0.55),
            Command(line: "actor.walk_to @brute intro_brute_departure runs_where_sent"),
            WaitUntil(condition: "actor.arrived @brute"),
            Command(line: "workshop.ship_case"),
            WaitUntil(condition: "world.flag_set intro_case_in_transit"),
            Command(line: "actor.depart @brute"),
            WaitUntil(condition: "actor.gone @brute"),
            CameraPan(target: (1070.0, 280.0), seconds: 0.6),
        ],
        seen_flag: Some("intro_brute_scene_seen"),
    ),
    (
        id: "intro_raid_at_the_door",
        roles: [("dennis", Character("npc_creator")), ("scout", Character("player_robot_v3"))],
        beats: [
            SetFlag(id: "intro_training_active", on: false),
            CameraTrack(roles: ["dennis", "scout"], seconds: 0.35),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "That isn't the post. Leave the bar down."),
            Command(line: "actor.walk_to @dennis intro_bench_station runs_where_sent"),
            CameraPan(target: (1240.0, 284.0), seconds: 0.55),
            SetFlag(id: "intro_raiders_coming", on: true),
            WaitUntil(condition: "actor.group_count npc_lab_raider 3 @dennis"),
            BeforeFact(flag: "intro_barn_door_broken", beats: [
                Command(line: "actor.fetch npc_lab_raider intro_breach_bomb runs_where_sent"),
                WaitUntil(condition: "actor.holds_item npc_lab_raider intro_breach_bomb"),
                Command(line: "actor.throw_at npc_lab_raider intro_barn_door_aim"),
                WaitUntil(condition: "world.flag_set intro_barn_door_broken"),
            ]),
            Command(line: "actor.form_up npc_lab_raider intro_raider_station 56 runs_where_sent"),
            WaitUntil(condition: "actor.group_arrived npc_lab_raider @dennis"),
            WaitUntil(condition: "actor.arrived @dennis"),
            CameraPan(target: (1155.0, 282.0), seconds: 0.32),
            Command(line: "actor.face npc_lab_raider @dennis"),
            Command(line: "actor.face @dennis npc_lab_raider"),
            Dialogue(speaker: "Raider", speaker_character_id: "npc_lab_raider",
                text: "That's a lab, right? Sheet says a lab with a big sign."),
            SetFlag(id: "wrong_list_clue_1", on: true),
            Dialogue(speaker: "Raider", speaker_character_id: "npc_lab_raider",
                text: "It's got the robot. Take the case."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "Scout, stay where I can see you."),
            CameraRelease(seconds: 0.25),
            Command(line: "actor.release npc_lab_raider"),
            Command(line: "actor.release @dennis"),
        ],
        seen_flag: Some("intro_raid_arrival_seen"),
    ),
    (
        id: "intro_training_combat",
        beats: [
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "Good. Both feet on the block, and the knee held. Now step down to the sandbag on your left."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "Face the bag and use your normal attack. Get close enough for the blade to connect. A hit will move the bag."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "It won't hit back. Try as many times as you like."),
        ],
    ),
    (
        id: "intro_training_finished",
        beats: [
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "That connected. See how it moved? That's your reach. Let the blade finish its swing before you strike again."),
            Dialogue(speaker: "Dennis", speaker_character_id: "npc_creator",
                text: "That's the basic run. Keep practising if you want. Come and talk to me when you're ready, or if you'd like to do it again."),
            SetFlag(id: "intro_training_complete", on: true),
            SetFlag(id: "intro_training_active", on: false),
        ],
    ),
    // The Drain Market's `entry_cutscene` (`drain_alley`): the robot comes up
    // the service stair onto the street. The fade comes up from black; the
    // area's card (`data/area_cards.ron`) names the place.
    (
        id: "drain_market_arrival",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.6,
            ),
            SetFlag(
                id: "drain_market_arrival_seen",
                on: true,
            ),
        ],
        seen_flag: Some("drain_market_arrival_seen"),
    ),
    // Started by the volume round Oiler's workshop in the Drain Market
    // (`drain_alley`): he comes out to meet the player who walked up.
    (
        id: "oiler_notices",
        beats: [
            Dialogue(
                speaker: "Oiler",
                speaker_character_id: "npc_oiler",
                text: "Well. That\'s not a rat.",
            ),
            SetFlag(
                id: "oiler_notices_seen",
                on: true,
            ),
        ],
        seen_flag: Some("oiler_notices_seen"),
    ),
    // No room plays this: the player starts it at the ripple. The interaction
    // is v1.1 work; the script is here so the trigger can request it.
    (
        id: "first_ripple",
        beats: [
            Dialogue(
                speaker: "Gate Janitor",
                speaker_character_id: "npc_gate_janitor",
                text: "Don\'t touch that. That\'s not a gate.",
            ),
            Wait(
                seconds: 0.4,
            ),
            Dialogue(
                speaker: "Gate Janitor",
                speaker_character_id: "npc_gate_janitor",
                text: "Okay. That\'s a problem.",
            ),
            SetFlag(
                id: "first_ripple_used",
                on: true,
            ),
        ],
        seen_flag: Some("first_ripple_seen"),
    ),
    // intro_wake_room's `entry_cutscene`: Scout wakes on the charging cart.
    // The fade comes up from black.
    (
        id: "intro_wake",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Dialogue(
                speaker: "Dennis",
                speaker_character_id: "npc_creator",
                text: "Hey you, you're finally awake.",
            ),
            Dialogue(
                speaker: "Dennis",
                speaker_character_id: "npc_creator",
                text: "Don't sit up fast. The left knee servo is new and I haven't set its torque yet.",
            ),
            SetFlag(
                id: "intro_started",
                on: true,
            ),
            SetFlag(
                id: "intro_wake_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_wake_seen"),
    ),
    // The freight siding (`intro_freight_yard`): the volume at the foot of
    // the stair, before the fight. The foreman is on the far side of the
    // freight with the crate.
    (
        id: "foreman_siding",
        beats: [
            Dialogue(
                speaker: "Foreman",
                speaker_character_id: "npc_goblin_brute",
                text: "That's the robot from the barn. They walked all the way here.",
            ),
            Dialogue(
                speaker: "Foreman",
                speaker_character_id: "npc_goblin_brute",
                text: "Window's tomorrow, lads. We're not sitting next to that all night. Get it.",
            ),
            SetFlag(
                id: "foreman_siding_seen",
                on: true,
            ),
        ],
        seen_flag: Some("foreman_siding_seen"),
    ),
    (
        id: "intro_case_recovered",
        beats: [SetFlag(id: "intro_creator_notes_recovered", on: true)],
        seen_flag: Some("intro_creator_notes_recovered"),
    ),
    // The work order on the freight crate names the workshop at the old mill.
    (
        id: "work_order",
        beats: [
            Dialogue(
                speaker: "Work Order",
                text: "ONE PROTOTYPE, SWITCHED OFF. ONE LAB OF RESEARCH. THE WORKSHOP AT THE OLD MILL, HOBFORD. PAID IN ADVANCE.",
            ),
            SetFlag(
                id: "wrong_list_clue_2",
                on: true,
            ),
        ],
        seen_flag: Some("work_order_seen"),
    ),
]
