// The intro cutscenes, schema `cutscene_library` (owned by the cutscene capability,
// `ambition_cutscene::content_schema`). Every file of this schema merges into
// one library; a script id may be in one file only.
//
// A script is an id, ordered beats and an optional seen flag (the runtime does
// not play a script whose seen flag is set). Beats: Wait(seconds),
// Dialogue(speaker, text) (waits for the dismiss button), CameraPan(target,
// seconds), Fade(from_alpha, to_alpha, seconds) with 0.0 clear and 1.0 black
// (both ends are authored, Q143), SetFlag(id, on), Banner(text, seconds) and
// Fall(character), a scripted death in the cutscene's room. A skip still
// applies the flags and falls it passes over.
// A room plays a script on entry when its `entry_cutscene` level field names
// it; a `CutsceneTrigger` volume plays one when a player body stands in it.
//
// Beats are short: the intro design is firm that the intro must not become a
// long cutscene wall.

[
    // The creator's last words, at the volume by the corridor's far end: the
    // robot reaches the way out, and the raid takes him there. If he fell in
    // the fight already, these are the words he had left. The fast and
    // impossible variants are in `intro.yarn` for a later pass.
    (
        id: "creator_final_fragment",
        beats: [
            Dialogue(
                speaker: "Creator",
                text: "Go. Up the shaft. They came for you, not for me.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "I made you to ask a question. Find out what it—",
            ),
            Fall(
                character: "npc_creator",
            ),
            SetFlag(
                id: "intro_creator_dead",
                on: true,
            ),
            SetFlag(
                id: "intro_creator_fragment_normal",
                on: true,
            ),
        ],
        seen_flag: Some("intro_creator_fragment_seen"),
    ),
    // drain_alley's `entry_cutscene`. The fade comes up from black.
    (
        id: "drain_market_arrival",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.6,
            ),
            Banner(
                text: "Drain Market — STAFF ONLY",
                seconds: 1.2,
            ),
            SetFlag(
                id: "drain_market_arrival_seen",
                on: true,
            ),
        ],
        seen_flag: Some("drain_market_arrival_seen"),
    ),
    // Started by the volume around Oiler's post in drain_alley: he has come
    // to meet the player who walked up, and this is what he says.
    (
        id: "oiler_notices",
        beats: [
            Dialogue(
                speaker: "Oiler",
                text: "Well. That\'s not a rat. You came out of the bad pipe.",
            ),
            SetFlag(
                id: "oiler_notices_seen",
                on: true,
            ),
        ],
        seen_flag: Some("oiler_notices_seen"),
    ),
    // No room plays this: the player starts it at the ripple. The interaction
    // is v1.1 work; the script is here so the trigger can request it.
    (
        id: "first_ripple",
        beats: [
            Dialogue(
                speaker: "Gate Janitor",
                text: "Don\'t touch that. That\'s not a gate.",
            ),
            Wait(
                seconds: 0.4,
            ),
            Dialogue(
                speaker: "Gate Janitor",
                text: "Okay. That\'s a problem.",
            ),
            SetFlag(
                id: "first_ripple_used",
                on: true,
            ),
        ],
        seen_flag: Some("first_ripple_seen"),
    ),
    // Started by the volume at the head of the corridor (`CutsceneTrigger` in
    // intro_raid_corridor, one room with the lab), so the creator who woke the
    // robot is there for it. Goblins, hired for the robot and the research.
    // The room holds the fight while it plays; after it, the room is
    // `dangerous`, so the creator rallies to the robot's fight.
    (
        id: "intro_raid",
        beats: [
            Banner(
                text: "// PERIMETER BREACH",
                seconds: 1.2,
            ),
            Dialogue(
                speaker: "Salvage Lead",
                text: "One prototype, one lab of research, paid in advance. Bag it all.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Paid by whom? Nobody knows this lab is here.",
            ),
            Dialogue(
                speaker: "Lab Raider",
                text: "Somebody does. The manifest said it'd be switched off.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Then they wrote the wrong list. Stay by me. We go through them.",
            ),
            SetFlag(
                id: "intro_raid_started",
                on: true,
            ),
            SetFlag(
                id: "wrong_list_clue_1",
                on: true,
            ),
            SetFlag(
                id: "intro_raid_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_raid_seen"),
    ),
    // intro_wake_room's `entry_cutscene`. The fade comes up from black.
    (
        id: "intro_wake",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Banner(
                text: "// boot",
                seconds: 1.0,
            ),
            Dialogue(
                speaker: "Creator",
                text: "Hey you, you\'re finally awake.",
            ),
            SetFlag(
                id: "intro_started",
                on: true,
            ),
            SetFlag(
                id: "intro_wake_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_wake_seen"),
    ),
]
