// The intro cutscenes, schema `cutscene_library` (owned by the cutscene capability,
// `ambition_cutscene::content_schema`). Every file of this schema merges into
// one library; a script id may be in one file only.
//
// A script is an id, ordered beats and an optional seen flag (the runtime does
// not play a script whose seen flag is set). Beats: Wait(seconds),
// Dialogue(speaker, text) (waits for the dismiss button), CameraPan(target,
// seconds), Fade(from_alpha, to_alpha, seconds) with 0.0 clear and 1.0 black
// (both ends are authored, Q143), SetFlag(id, on), Banner(text, seconds) and
// Fall(character), a scripted death in the cutscene's room. A skip still
// applies the flags and falls it passes over.
// A room plays a script on entry when its `entry_cutscene` level field names
// it; a `CutsceneTrigger` volume plays one when a player body stands in it.
//
// Beats are short: the intro design is firm that the intro must not become a
// long cutscene wall.

[
    // The creator's last words, at the volume in the doorway of the bay door
    // (`intro_wake_room`). The door stands until the raid is beaten, so the
    // fight is over and the creator, who keeps beside the robot, is near. He
    // was hurt in the fight. If he fell in it already, these are the words he
    // had left (Q173: he always dies here).
    (
        id: "creator_final_fragment",
        beats: [
            Dialogue(
                speaker: "Creator",
                text: "That's all of them. Good. No, leave me. I need to sit a minute.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Go up the stair. They took my notebooks. Don't let them take you.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "I made you to ask a question. Find out what it—",
            ),
            Fall(
                character: "npc_creator",
            ),
            SetFlag(
                id: "intro_creator_dead",
                on: true,
            ),
            SetFlag(
                id: "intro_creator_fragment_normal",
                on: true,
            ),
        ],
        seen_flag: Some("intro_creator_fragment_seen"),
    ),
    // The Drain Market's `entry_cutscene` (`drain_alley`): the robot comes up
    // the service stair onto the street. The fade comes up from black; the
    // area's card (`data/area_cards.ron`) names the place.
    (
        id: "drain_market_arrival",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.6,
            ),
            SetFlag(
                id: "drain_market_arrival_seen",
                on: true,
            ),
        ],
        seen_flag: Some("drain_market_arrival_seen"),
    ),
    // Started by the volume round Oiler's workshop in the Drain Market
    // (`drain_alley`): he comes out to meet the player who walked up.
    (
        id: "oiler_notices",
        beats: [
            Dialogue(
                speaker: "Oiler",
                text: "Well. That\'s not a rat.",
            ),
            SetFlag(
                id: "oiler_notices_seen",
                on: true,
            ),
        ],
        seen_flag: Some("oiler_notices_seen"),
    ),
    // No room plays this: the player starts it at the ripple. The interaction
    // is v1.1 work; the script is here so the trigger can request it.
    (
        id: "first_ripple",
        beats: [
            Dialogue(
                speaker: "Gate Janitor",
                text: "Don\'t touch that. That\'s not a gate.",
            ),
            Wait(
                seconds: 0.4,
            ),
            Dialogue(
                speaker: "Gate Janitor",
                text: "Okay. That\'s a problem.",
            ),
            SetFlag(
                id: "first_ripple_used",
                on: true,
            ),
        ],
        seen_flag: Some("first_ripple_seen"),
    ),
    // Started by the volume where the lab opens on the loading bay
    // (`intro_wake_room`), so the creator who woke the robot is there for it.
    // The goblins were hired for the robot and the research; their foreman
    // has already gone up the stair with the notebooks. The room holds the
    // fight while it plays; the room is `dangerous`, so the creator fights
    // beside the robot.
    (
        id: "intro_raid",
        beats: [
            Banner(
                text: "// PERIMETER BREACH",
                seconds: 1.2,
            ),
            Dialogue(
                speaker: "Lab Raider",
                text: "There it is. The order said one prototype, switched off. That one's walking.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "What order? Nobody knows this lab is here.",
            ),
            Dialogue(
                speaker: "Lab Raider",
                text: "Somebody does. Paid in advance. The boss already took your notebooks up the stairs.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Stay by me. Hit them before they hit you.",
            ),
            SetFlag(
                id: "intro_raid_started",
                on: true,
            ),
            SetFlag(
                id: "wrong_list_clue_1",
                on: true,
            ),
            SetFlag(
                id: "intro_raid_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_raid_seen"),
    ),
    // intro_wake_room's `entry_cutscene`. The fade comes up from black.
    (
        id: "intro_wake",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Banner(
                text: "// boot",
                seconds: 1.0,
            ),
            Dialogue(
                speaker: "Creator",
                text: "Hey you, you\'re finally awake.",
            ),
            SetFlag(
                id: "intro_started",
                on: true,
            ),
            SetFlag(
                id: "intro_wake_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_wake_seen"),
    ),
    // The freight yard (`intro_freight_yard`): the volume past its west gate.
    // The goblins' foreman has the crate; the fight follows.
    (
        id: "salvage_lead_yard",
        beats: [
            Dialogue(
                speaker: "Salvage Lead",
                text: "Well, look who walked here on its own. Saves us carrying it.",
            ),
            Dialogue(
                speaker: "Salvage Lead",
                text: "The crate goes through the gate at six. You go in the crate. Lads!",
            ),
            SetFlag(
                id: "salvage_lead_yard_seen",
                on: true,
            ),
        ],
        seen_flag: Some("salvage_lead_yard_seen"),
    ),
    // The crate behind the yard's inner gate, which opens when the fight is
    // won. The work order on the crate names an address; the stair door of the
    // lab names another (`14 CULVERT LANE`). The last page stays unread.
    (
        id: "creator_notebooks",
        beats: [
            Dialogue(
                speaker: "Work Order",
                text: "ONE PROTOTYPE, SWITCHED OFF. ONE LAB OF RESEARCH. 14 CULVERT ROW. PAID IN ADVANCE.",
            ),
            Dialogue(
                speaker: "Notebook",
                text: "The creator's notebooks are under the order. The last page starts: THE QUESTION I WANT IT TO ASK IS",
            ),
            Dialogue(
                speaker: "Notebook",
                text: "The rest of the page is torn off.",
            ),
            SetFlag(
                id: "intro_creator_notes_recovered",
                on: true,
            ),
            SetFlag(
                id: "wrong_list_clue_2",
                on: true,
            ),
        ],
        seen_flag: Some("creator_notebooks_seen"),
    ),
]
