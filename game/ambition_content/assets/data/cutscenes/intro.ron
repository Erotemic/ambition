// The intro cutscenes, schema `cutscene_library` (owned by the cutscene capability,
// `ambition_cutscene::content_schema`). Every file of this schema merges into
// one library; a script id may be in one file only.
//
// A script is an id, ordered beats and an optional seen flag (the runtime does
// not play a script whose seen flag is set). Beats: Wait(seconds),
// Dialogue(speaker, text) (waits for the dismiss button), CameraPan(target,
// seconds), Fade(from_alpha, to_alpha, seconds) with 0.0 clear and 1.0 black
// (both ends are authored, Q143), SetFlag(id, on), Banner(text, seconds) and
// Fall(character), a scripted death in the cutscene's room, Command(line), a
// prepared command (the vocabulary of a Yarn `<<command>>` and a room line:
// `actor.walk_to`, `actor.leave_through`, `encounter.start`), and
// WaitFor(condition, seconds_at_most), which holds until the condition line is
// true or for its longest hold. A skip still applies the flags, falls and
// commands it passes over. `starts_when: Some("<condition line>")` plays a
// script, for the whole world, on the first tick its condition holds (it needs
// a seen flag). A command or condition line the engine does not publish is
// reported when the library loads.
// A room plays a script on entry when its `entry_cutscene` level field names
// it; a `CutsceneTrigger` volume plays one when a player body stands in it.
//
// Beats are short: the intro design is firm that the intro must not become a
// long cutscene wall.

[
    // The workshop's trigger waits for the raid to end. The camera returns
    // to the bench before the Creator speaks. He falls after his last line.
    (
        id: "creator_final_fragment",
        beats: [
            CameraPan(target: (1060.0, 280.0), seconds: 0.5),
            // The yard gate opens, if the raider with the case did not open it
            // on his way out (his two mates fell together).
            SetFlag(
                id: "intro_case_taken",
                on: true,
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "Scout. Over here. Are you damaged?",
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "Good. They took the case off the bench. Your logs are in it. Every answer since Tuesday.",
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "I have to sit down for a minute.",
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "You answered like yourself, all the way through. I want to write that d—",
            ),
            Fall(
                character: "npc_creator",
            ),
            SetFlag(
                id: "intro_creator_dead",
                on: true,
            ),
            SetFlag(
                id: "intro_creator_fragment_normal",
                on: true,
            ),
        ],
        seen_flag: Some("intro_creator_fragment_seen"),
    ),
    // The raid's last raider, when the other two have fallen, grabs the case off the bench and
    // runs through the barn door and yard gate with it in his hand (`actor.hold`: the case is
    // his, not a world object, so it goes out of the world with him; the crate at the siding
    // is where the story finds it again). The camera stays on the
    // workshop while the Creator points and speaks. His release at the end
    // restores his normal pose before his last words.
    (
        id: "intro_raider_runs_with_the_case",
        starts_when: Some("actor.fallen_is npc_lab_raider 2"),
        beats: [
            SetFlag(
                id: "intro_case_taken",
                on: true,
            ),
            Command(
                line: "actor.hold npc_lab_raider creator_case",
            ),
            Command(
                line: "actor.leave_through npc_lab_raider workshop_to_lane runs_where_sent",
            ),
            Command(
                line: "actor.face npc_creator npc_lab_raider",
            ),
            Command(
                line: "actor.pose npc_creator gesture hold",
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "The case! He's got the case!",
            ),
            WaitFor(
                condition: "actor.gone npc_lab_raider",
                seconds_at_most: 6.0,
            ),
            Command(
                line: "actor.release npc_creator",
            ),
        ],
        seen_flag: Some("intro_case_run_seen"),
    ),
    // The door or a completed conversation starts this scene. The raiders
    // wait at the doorway until the last line is dismissed.
    (
        id: "intro_raid_at_the_door",
        beats: [
            SetFlag(id: "intro_training_active", on: false),
            Command(line: "actor.walk_to npc_creator intro_bench_station keeps_to_its_tasks"),
            WaitFor(condition: "actor.arrived npc_creator", seconds_at_most: 8.0),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Someone's at the door. Were you expecting anyone?"),
            SetFlag(id: "intro_raiders_coming", on: true),
            WaitFor(condition: "actor.count_is npc_lab_raider 3", seconds_at_most: 3.0),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Hold on. Let me lift the bar."),
            SetFlag(id: "intro_barn_door_broken", on: true),
            Wait(seconds: 0.2),
            Command(line: "actor.form_up npc_lab_raider intro_raider_station 160 keeps_to_its_tasks"),
            WaitFor(condition: "actor.arrived npc_lab_raider", seconds_at_most: 8.0),
            Command(line: "actor.face npc_lab_raider npc_creator"),
            Command(line: "actor.face npc_creator npc_lab_raider"),
            Dialogue(speaker: "Raider", speaker_character_id: "npc_lab_raider",
                text: "The case on the bench. Hand it over."),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Those are my notes. Who sent you?"),
            Dialogue(speaker: "Raider", speaker_character_id: "npc_lab_raider",
                text: "Sheet says a lab with a big sign. This the right place?"),
            SetFlag(id: "wrong_list_clue_1", on: true),
            Dialogue(speaker: "Raider", speaker_character_id: "npc_lab_raider",
                text: "It's got the robot. Take the case."),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Scout. Stay behind me."),
            Command(line: "actor.release npc_creator"),
            Command(line: "actor.release npc_lab_raider"),
        ],
        seen_flag: Some("intro_raiders_coming"),
    ),
    (
        id: "intro_training_combat",
        beats: [
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Good. Both feet on the block, and the knee held. Now step down to the sandbag on your left."),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "Face the bag and use your normal attack. Get close enough for the blade to connect. A hit will move the bag."),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "It won't hit back. Try as many times as you like."),
        ],
    ),
    (
        id: "intro_training_finished",
        beats: [
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "That connected. See how it moved? That's your reach. Let the blade finish its swing before you strike again."),
            Dialogue(speaker: "Creator", speaker_character_id: "npc_creator",
                text: "That's the basic run. Keep practising if you want. Come and talk to me when you're ready, or if you'd like to do it again."),
            SetFlag(id: "intro_training_complete", on: true),
            SetFlag(id: "intro_training_active", on: false),
        ],
    ),
    // The Drain Market's `entry_cutscene` (`drain_alley`): the robot comes up
    // the service stair onto the street. The fade comes up from black; the
    // area's card (`data/area_cards.ron`) names the place.
    (
        id: "drain_market_arrival",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.6,
            ),
            SetFlag(
                id: "drain_market_arrival_seen",
                on: true,
            ),
        ],
        seen_flag: Some("drain_market_arrival_seen"),
    ),
    // Started by the volume round Oiler's workshop in the Drain Market
    // (`drain_alley`): he comes out to meet the player who walked up.
    (
        id: "oiler_notices",
        beats: [
            Dialogue(
                speaker: "Oiler",
                speaker_character_id: "npc_oiler",
                text: "Well. That\'s not a rat.",
            ),
            SetFlag(
                id: "oiler_notices_seen",
                on: true,
            ),
        ],
        seen_flag: Some("oiler_notices_seen"),
    ),
    // No room plays this: the player starts it at the ripple. The interaction
    // is v1.1 work; the script is here so the trigger can request it.
    (
        id: "first_ripple",
        beats: [
            Dialogue(
                speaker: "Gate Janitor",
                speaker_character_id: "npc_gate_janitor",
                text: "Don\'t touch that. That\'s not a gate.",
            ),
            Wait(
                seconds: 0.4,
            ),
            Dialogue(
                speaker: "Gate Janitor",
                speaker_character_id: "npc_gate_janitor",
                text: "Okay. That\'s a problem.",
            ),
            SetFlag(
                id: "first_ripple_used",
                on: true,
            ),
        ],
        seen_flag: Some("first_ripple_seen"),
    ),
    // intro_wake_room's `entry_cutscene`: Scout wakes on the charging cart.
    // The fade comes up from black.
    (
        id: "intro_wake",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "Hey you, you're finally awake.",
            ),
            Dialogue(
                speaker: "Creator",
                speaker_character_id: "npc_creator",
                text: "Don't sit up fast. The left knee servo is new and I haven't set its torque yet.",
            ),
            SetFlag(
                id: "intro_started",
                on: true,
            ),
            SetFlag(
                id: "intro_wake_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_wake_seen"),
    ),
    // The freight siding (`intro_freight_yard`): the volume at the foot of
    // the stair, before the fight. The foreman is on the far side of the
    // freight with the crate.
    (
        id: "foreman_siding",
        beats: [
            Dialogue(
                speaker: "Foreman",
                text: "That's the robot from the barn. It walked here.",
            ),
            Dialogue(
                speaker: "Foreman",
                text: "Window's tomorrow, lads. We're not sitting next to that all night. Get it.",
            ),
            SetFlag(
                id: "foreman_siding_seen",
                on: true,
            ),
        ],
        seen_flag: Some("foreman_siding_seen"),
    ),
    // The goblins' crate at the siding (`intro_freight_yard`): the volume in
    // front of it. The work order is pasted on its lid; the address on it is
    // not the Creator's barn.
    (
        id: "work_order",
        beats: [
            Dialogue(
                speaker: "Work Order",
                text: "ONE PROTOTYPE, SWITCHED OFF. ONE LAB OF RESEARCH. THE WORKSHOP AT THE OLD MILL, HOBFORD. PAID IN ADVANCE.",
            ),
            SetFlag(
                id: "wrong_list_clue_2",
                on: true,
            ),
        ],
        seen_flag: Some("work_order_seen"),
    ),
]
