// The intro cutscenes, schema `cutscene_library` (owned by the cutscene capability,
// `ambition_cutscene::content_schema`). Every file of this schema merges into
// one library; a script id may be in one file only.
//
// A script is an id, ordered beats and an optional seen flag (the runtime does
// not play a script whose seen flag is set). Beats: Wait(seconds),
// Dialogue(speaker, text) (waits for the dismiss button), CameraPan(target,
// seconds), Fade(from_alpha, to_alpha, seconds) with 0.0 clear and 1.0 black
// (both ends are authored, Q143), SetFlag(id, on), Banner(text, seconds) and
// Fall(character), a scripted death in the cutscene's room. A skip still
// applies the flags and falls it passes over.
// A room plays a script on entry when its `entry_cutscene` level field names
// it; a `CutsceneTrigger` volume plays one when a player body stands in it.
//
// Beats are short: the intro design is firm that the intro must not become a
// long cutscene wall.

[
    // The Creator's last words (`intro_wake_room`), at the volume just past
    // the barn door. The door stands until the raid is beaten, so the fight is
    // over and he is near: he works at the bench beside the door. He was hurt
    // in the fight. If he fell in it already, these are the words he had
    // left (Q173: he always dies here).
    (
        id: "creator_final_fragment",
        beats: [
            Dialogue(
                speaker: "Creator",
                text: "Scout. Over here. Are you damaged?",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Good. They took the case off the bench. Your logs are in it. Every answer since Tuesday.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "I have to sit down for a minute.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "You answered like yourself, all the way through. I want to write that d—",
            ),
            Fall(
                character: "npc_creator",
            ),
            SetFlag(
                id: "intro_creator_dead",
                on: true,
            ),
            SetFlag(
                id: "intro_creator_fragment_normal",
                on: true,
            ),
        ],
        seen_flag: Some("intro_creator_fragment_seen"),
    ),
    // The Drain Market's `entry_cutscene` (`drain_alley`): the robot comes up
    // the service stair onto the street. The fade comes up from black; the
    // area's card (`data/area_cards.ron`) names the place.
    (
        id: "drain_market_arrival",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.6,
            ),
            SetFlag(
                id: "drain_market_arrival_seen",
                on: true,
            ),
        ],
        seen_flag: Some("drain_market_arrival_seen"),
    ),
    // Started by the volume round Oiler's workshop in the Drain Market
    // (`drain_alley`): he comes out to meet the player who walked up.
    (
        id: "oiler_notices",
        beats: [
            Dialogue(
                speaker: "Oiler",
                text: "Well. That\'s not a rat.",
            ),
            SetFlag(
                id: "oiler_notices_seen",
                on: true,
            ),
        ],
        seen_flag: Some("oiler_notices_seen"),
    ),
    // No room plays this: the player starts it at the ripple. The interaction
    // is v1.1 work; the script is here so the trigger can request it.
    (
        id: "first_ripple",
        beats: [
            Dialogue(
                speaker: "Gate Janitor",
                text: "Don\'t touch that. That\'s not a gate.",
            ),
            Wait(
                seconds: 0.4,
            ),
            Dialogue(
                speaker: "Gate Janitor",
                text: "Okay. That\'s a problem.",
            ),
            SetFlag(
                id: "first_ripple_used",
                on: true,
            ),
        ],
        seen_flag: Some("first_ripple_seen"),
    ),
    // intro_wake_room's `entry_cutscene`: Scout wakes on the charging cart.
    // The fade comes up from black.
    (
        id: "intro_wake",
        beats: [
            Fade(
                from_alpha: 1.0,
                to_alpha: 0.0,
                seconds: 0.8,
            ),
            Dialogue(
                speaker: "Creator",
                text: "Hey you, you're finally awake.",
            ),
            Dialogue(
                speaker: "Creator",
                text: "Don't sit up fast. The left knee servo is new and I haven't set its torque yet.",
            ),
            SetFlag(
                id: "intro_started",
                on: true,
            ),
            SetFlag(
                id: "intro_wake_seen",
                on: true,
            ),
        ],
        seen_flag: Some("intro_wake_seen"),
    ),
    // The freight siding (`intro_freight_yard`): the volume at the foot of
    // the stair, before the fight. The foreman is on the far side of the
    // freight with the crate.
    (
        id: "foreman_siding",
        beats: [
            Dialogue(
                speaker: "Foreman",
                text: "That's the robot from the barn. It walked here.",
            ),
            Dialogue(
                speaker: "Foreman",
                text: "Window's tomorrow, lads. We're not sitting next to that all night. Get it.",
            ),
            SetFlag(
                id: "foreman_siding_seen",
                on: true,
            ),
        ],
        seen_flag: Some("foreman_siding_seen"),
    ),
    // The goblins' crate at the siding (`intro_freight_yard`): the volume in
    // front of it. The work order is pasted on its lid; the address on it is
    // not the Creator's barn.
    (
        id: "work_order",
        beats: [
            Dialogue(
                speaker: "Work Order",
                text: "ONE PROTOTYPE, SWITCHED OFF. ONE LAB OF RESEARCH. THE WORKSHOP AT THE OLD MILL, HOBFORD. PAID IN ADVANCE.",
            ),
            SetFlag(
                id: "wrong_list_clue_2",
                on: true,
            ),
        ],
        seen_flag: Some("work_order_seen"),
    ),
]
