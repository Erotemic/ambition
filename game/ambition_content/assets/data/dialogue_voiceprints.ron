        aliases: ["bob"],
    ),
    (
        cue: "dialogue.blip.creator",
        // The alias `creator` matches any label that contains it, so these
        // exact keys add little: a wrong one here would not be noticed.
        exact: ["creator", "hall_npc_creator"],
        aliases: ["creator"],
