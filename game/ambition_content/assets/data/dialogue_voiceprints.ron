// Ambition's cast voiceprints (schema `dialogue_voiceprints`, owned by the
// audio capability): the dialogue blip each speaker label or dialogue id
// resolves to. Exact keys are checked first, then aliases, in row order: the
// first row whose alias a label contains wins. Admission refuses a key that
// two cues claim, and an exact key that hides another cue's alias. An edit
// here is played at the next start (and on a content reload), with no Rust
// build.
[
    (
        cue: "dialogue.blip.alice",
        exact: ["alice", "hall_npc_alice"],
        aliases: ["alice"],
    ),
    (
        cue: "dialogue.blip.architect",
        exact: ["architect", "architect_npc", "hall_architect"],
        aliases: ["architect"],
