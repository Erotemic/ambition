// Authored wave timeline for the goblin mob-lab encounter — content data,
// installed into the engine's `EncounterWaveBook` holder by
// `ambition_content::install_encounter_waves`. The engine's encounter loader
// reads this by trigger id; any encounter NOT in this book falls back to one
// wave assembled from its LDtk `EnemySpawn` markers. Keys are encounter trigger
// ids; values are the ordered waves (active-area-local coords; arena floor
// y≈608, doorway x=480–704, so wave mobs sit deeper at x≈1180/1500).
//
// A mob answers three questions with three fields, and until 2026-08-09 it had
// only two: `character` is WHO it is (a `character_catalog.ron` id, resolved to
// sheet / body geometry / barks), `kind` is HOW IT THINKS (a
// `character_archetypes.ron` size-and-role row), and the wave director mints
// WHICH instance at spawn. Without `character` the spawner had nowhere to put
// the first, so every mob here wore its own instance id as a costume, no sheet
// resolved, and the whole encounter drew unclaimed-body placeholders.
//
//  `character` is checked at COMPILE time against the pack's cast — a
// misspelling is an unresolved reference, not a magenta box discovered by
// walking into the room.
{
    "goblin_encounter": [
        (
            label: "wave 1 — flank the doorway",
            mobs: [
                (kind: "medium_striker", character: Some("goblin"), spawn: (1180.0, 580.0), size: (22.0, 38.0), delay: 0.0),
                (kind: "medium_striker", character: Some("goblin"), spawn: (1500.0, 580.0), size: (22.0, 38.0), delay: 0.0),
            ],
        ),
        (
            label: "wave 2 — goblins + heavy",
            mobs: [
                (kind: "medium_striker", character: Some("goblin"), spawn: (1180.0, 580.0), size: (22.0, 38.0), delay: 0.0),
                (kind: "medium_striker", character: Some("goblin"), spawn: (1500.0, 580.0), size: (22.0, 38.0), delay: 0.70),
                // ⛔⛔ THIS ROW USED TO SAY `character: None` — DELIBERATELY, and
                // its premise expired. The note read: "No catalog row is the
                // goblin lab's heavy… the brute keeps drawing the placeholder
                // until somebody makes it — visible debt beats a body borrowing
                // someone else's art." ⇒ SOMEBODY MADE IT. `npc_goblin_brute` is
                // a catalog row with its own art
                // (`goblin_brute_hammer_spritesheet`) and an authored module that
                // states its locomotion. The casting decision the note was
                // waiting for has been taken.
                //
                // ⚠ AND THE DEBT STOPPED BEING VISIBLE AND BECAME A CRASH. The
                // note assumed a placeholder fallback; AC6 later removed that
                // fallback because it "WAS A LIE", so a wave naming no character
                // now REFUSES. Two correct changes, made apart, whose collision
                // is a panic in the goblin fight — reported by Jon 2026-09-06.
                (kind: "npc_goblin_brute", character: Some("npc_goblin_brute"), spawn: (1340.0, 562.0), size: (32.0, 56.0), delay: 2.60),
            ],
        ),
        (
            label: "wave 3 — heavy duo",
            mobs: [
                (kind: "npc_goblin_brute", character: Some("npc_goblin_brute"), spawn: (1180.0, 562.0), size: (32.0, 56.0), delay: 0.0),
                (kind: "npc_goblin_brute", character: Some("npc_goblin_brute"), spawn: (1500.0, 562.0), size: (32.0, 56.0), delay: 0.0),
            ],
        ),
    ],
    // Level 1's raid (`intro_wake_room`, the workshop; floor y=352). The
    // Creator's conversation starts it (`encounter.start` in
    // `creator_intro__questions`); its trigger is in the roof, where no body
    // walks, so it cannot start again. The raiders come in at the barn door
    // beside his bench (x 1320), inside earshot (128 px) of the conversation
    // they break (`creator_intro__interrupted`). The barn door stands until
    // this is cleared (`encounter.cleared intro_workshop_raid`).
    "intro_workshop_raid": [
        (
            label: "in through the barn door",
            mobs: [
                (kind: "medium_striker", character: Some("npc_lab_raider"), spawn: (1290.0, 324.0), size: (22.0, 38.0), delay: 0.0),
                (kind: "medium_striker", character: Some("npc_lab_raider"), spawn: (1306.0, 324.0), size: (22.0, 38.0), delay: 0.0),
                (kind: "medium_striker", character: Some("npc_lab_raider"), spawn: (1170.0, 276.0), size: (22.0, 38.0), delay: 0.0),
            ],
        ),
    ],
    // Level 1's freight siding (`intro_freight_yard`; floor y=512): the
    // goblins wait there for the freight window. The foreman is a brute: a
    // slow hammer that goes through a hit once committed, so strike him early
    // or after. The platform bell keeps the fight won.
    "intro_freight_yard_fight": [
        (
            label: "wave 1 — the crew",
            mobs: [
