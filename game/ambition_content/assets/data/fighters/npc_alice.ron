        // attack_dash: 6/14/38
        "alice_dash_attack": (hit_s: 0.1, last_s: 0.2333, total_s: 0.6333, swing: Some("swing.light")),
        // smash_forward: 15/18/46
        "brute_force": (hit_s: 0.25, last_s: 0.3, total_s: 0.7667, swing: Some("swing.heavy")),
