// ALICE'S PLATFORM-FIGHTER FACET: what Alice is on a Smash stage,
// where that differs from Smash's default fighter.
(
    character: "npc_alice",
    // Jon, 2026-10-18: Alice does not mirror Mario. Emmy is the Zelda, so
    // Alice is shaped like Palutena.
    // Shaped like Ultimate's Palutena at 0.60 strength: each number is Smash's
    // default fighter's, scaled by how that fighter differs from Ultimate's
    // roster median (`scripts/smash_fighter_shape.py "Palutena" --strength 0.6`).
    knockback_weight: Some(0.94),
    body: Some((
        max_run_speed: Some(353.7),
        initial_dash_speed: Some(358.5),
        run_accel: Some(391.2),
        ground_friction: Some(684.6),
        max_air_speed: Some(208.8),
        air_accel: Some(1111.4),
        gravity: Some(1357.6),
        max_fall_speed: Some(304.2),
        fast_fall_speed: Some(494.3),
        jump_speed: Some(558.3),
        double_jump_speed: Some(555.0),
        dodge_roll_speed: Some(368.6),
    )),
)
