// BOB'S PLATFORM-FIGHTER FACET: what Bob is on a Smash stage,
// where that differs from Smash's default fighter.
(
    character: "npc_bob",
    // Jon, 2026-10-18: Bob is closer to Steve.
    // Shaped like Ultimate's Steve at 0.60 strength: each number is Smash's
    // default fighter's, scaled by how that fighter differs from Ultimate's
    // roster median (`scripts/smash_fighter_shape.py "Steve" --strength 0.6`).
    knockback_weight: Some(0.95),
    body: Some((
        max_run_speed: Some(285.1),
        initial_dash_speed: Some(292.6),
        run_accel: Some(366.3),
        ground_friction: Some(641.1),
        max_air_speed: Some(190.7),
        air_accel: Some(674.3),
        gravity: Some(982.5),
        max_fall_speed: Some(288.6),
        fast_fall_speed: Some(469.0),
        jump_speed: Some(376.1),
        double_jump_speed: Some(410.4),
        dodge_roll_speed: Some(382.0),
    )),

    // SMASH-STAGE MOVE CLOCKS: first strike, last strike, total and landing
    // lag, in seconds, and the swing cue. Written by
    // `scripts/smash_retime.py` from an archetype template; the moveset keeps
    // the home game's pace. Frames at 60 Hz are in the trailing comment.
    move_timing: {
        // attack: 3/5/17
        "tap_test": (hit_s: 0.05, last_s: 0.0833, total_s: 0.2833, swing: Some("swing.light")),
        // attack_forward: 5/8/29
        "wrench_swing": (hit_s: 0.0833, last_s: 0.1333, total_s: 0.4833, swing: Some("swing.light")),
        // attack_up: 5/11/23
        "pressure_release": (hit_s: 0.0833, last_s: 0.1833, total_s: 0.3833, swing: Some("swing.light")),
        // attack_down: 5/7/25
        "shim": (hit_s: 0.0833, last_s: 0.1167, total_s: 0.4167, swing: Some("swing.light")),
        // attack_dash: 6/14/38
        "bob_dash_attack": (hit_s: 0.1, last_s: 0.2333, total_s: 0.6333, swing: Some("swing.light")),
        // smash_forward: 15/18/46
        "rivet_smash": (hit_s: 0.25, last_s: 0.3, total_s: 0.7667, swing: Some("swing.heavy")),
        // smash_up: 9/14/39
        "derrick_lift": (hit_s: 0.15, last_s: 0.2333, total_s: 0.65, swing: Some("swing.heavy")),
        // smash_down: 5/12/43
        "ground_anchor": (hit_s: 0.0833, last_s: 0.2, total_s: 0.7167, swing: Some("swing.heavy")),
        // attack_air: 3/24/42 L6
        "loose_bearing": (hit_s: 0.05, last_s: 0.4, total_s: 0.7, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_forward: 12/15/48 L14
        "swing_arm": (hit_s: 0.2, last_s: 0.25, total_s: 0.8, landing_lag_s: Some(0.2333), swing: Some("swing.aerial")),
        // attack_air_back: 6/12/33 L6
        "counterweight": (hit_s: 0.1, last_s: 0.2, total_s: 0.55, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_up: 4/8/32 L6
        "jack_stand": (hit_s: 0.0667, last_s: 0.1333, total_s: 0.5333, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_down: 5/16/44 L12
        "pile_driver": (hit_s: 0.0833, last_s: 0.2667, total_s: 0.7333, landing_lag_s: Some(0.2), swing: Some("swing.aerial")),
        // grab: 6/7/34
        "bob_grab": (hit_s: 0.1, last_s: 0.1167, total_s: 0.5667),
        // grab_dash: 9/10/42
        "bob_grab_dash": (hit_s: 0.15, last_s: 0.1667, total_s: 0.7),
    },
    // SMASH-STAGE BASE KNOCKBACK: the factor each move's base launch is
    // scaled by here, so a tilt or an aerial at 0% stuns past its own
    // swing. Written by `scripts/smash_retime.py`.
    move_knockback: {
        "wrench_swing": 1.6,
        "shim": 1.6,
        "bob_dash_attack": 1.5,
        "loose_bearing": 1.5,
        "swing_arm": 1.5,
        "counterweight": 1.3,
        "jack_stand": 1.3,
        "pile_driver": 1.4,
    },
)
