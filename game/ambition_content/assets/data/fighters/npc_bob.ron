        run_accel: Some(368.6),
        ground_friction: Some(645.1),
        max_air_speed: Some(178.5),
        air_accel: Some(860.0),
        gravity: Some(1088.2),
        max_fall_speed: Some(276.2),
        fast_fall_speed: Some(448.9),
        jump_speed: Some(531.3),
        double_jump_speed: Some(518.2),
        dodge_roll_speed: Some(388.4),
    )),
)
