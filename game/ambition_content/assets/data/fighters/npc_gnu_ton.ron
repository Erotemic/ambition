// GNU-TON'S PLATFORM-FIGHTER FACET: what the scholar is on a Smash stage, where
// that differs from what his moveset says.
//
// His moveset (`data/movesets/gnu_ton.ron`) is authored for the Smash stage, so
// its damage is percent already and no move is named here. (His boss fight is
// the game that changes the numbers: `bosses/gnu_ton/duel.rs` makes hearts of
// them.)
//
// He is a small man with a quill and a book: a light fighter. A hit launches
// him further than it launches the reference body.
(
    character: "npc_gnu_ton",
    knockback_weight: Some(0.86),
    // Moves like a light fencer: quick feet, a long dash, a floaty jump.
    // Shaped like Ultimate's Marth at 0.60 strength: each number is Smash's
    // default fighter's, scaled by how that fighter differs from Ultimate's
    // roster median (`scripts/smash_fighter_shape.py "Marth" --strength 0.6`).
    body: Some((
        max_run_speed: Some(342.0),
        initial_dash_speed: Some(381.3),
        run_accel: Some(408.7),
        ground_friction: Some(715.2),
        max_air_speed: Some(217.6),
        air_accel: Some(894.0),
        gravity: Some(1024.0),
        max_fall_speed: Some(307.7),
        fast_fall_speed: Some(500.0),
        jump_speed: Some(475.6),
        double_jump_speed: Some(472.8),
        dodge_roll_speed: Some(402.3),
    )),

    // SMASH-STAGE MOVE CLOCKS: first strike, last strike, total and landing
    // lag, in seconds, and the swing cue. Written by
    // `scripts/smash_retime.py` from an archetype template; the moveset keeps
    // the home game's pace. Frames at 60 Hz are in the trailing comment.
    move_timing: {
        // attack: 2/4/15
        "jab": (hit_s: 0.0333, last_s: 0.0667, total_s: 0.25, swing: Some("swing.light")),
        // attack_forward: 5/8/24
        "tilt_forward": (hit_s: 0.0833, last_s: 0.1333, total_s: 0.4, swing: Some("swing.light")),
        // attack_up: 4/9/21
        "tilt_up": (hit_s: 0.0667, last_s: 0.15, total_s: 0.35, swing: Some("swing.light")),
        // attack_down: 5/7/22
        "tilt_down": (hit_s: 0.0833, last_s: 0.1167, total_s: 0.3667, swing: Some("swing.light")),
        // attack_dash: 5/12/34
        "gnu_ton_dash_attack": (hit_s: 0.0833, last_s: 0.2, total_s: 0.5667, swing: Some("swing.light")),
        // smash_forward: 13/16/42
        "smash_forward": (hit_s: 0.2167, last_s: 0.2667, total_s: 0.7, swing: Some("swing.heavy")),
        // smash_up: 8/13/36
        "smash_up": (hit_s: 0.1333, last_s: 0.2167, total_s: 0.6, swing: Some("swing.heavy")),
        // smash_down: 6/11/40
        "smash_down": (hit_s: 0.1, last_s: 0.1833, total_s: 0.6667, swing: Some("swing.heavy")),
        // attack_air: 3/22/38 L5
        "air_neutral": (hit_s: 0.05, last_s: 0.3667, total_s: 0.6333, landing_lag_s: Some(0.0833), swing: Some("swing.aerial")),
        // attack_air_forward: 8/11/40 L9
        "air_forward": (hit_s: 0.1333, last_s: 0.1833, total_s: 0.6667, landing_lag_s: Some(0.15), swing: Some("swing.aerial")),
        // attack_air_back: 6/10/30 L6
        "air_back": (hit_s: 0.1, last_s: 0.1667, total_s: 0.5, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_up: 4/8/28 L5
        "air_up": (hit_s: 0.0667, last_s: 0.1333, total_s: 0.4667, landing_lag_s: Some(0.0833), swing: Some("swing.aerial")),
        // attack_air_down: 6/14/40 L10
        "air_down": (hit_s: 0.1, last_s: 0.2333, total_s: 0.6667, landing_lag_s: Some(0.1667), swing: Some("swing.aerial")),
        // grab: 6/7/32
        "gnu_ton_grab": (hit_s: 0.1, last_s: 0.1167, total_s: 0.5333),
        // grab_dash: 9/10/40
        "gnu_ton_grab_dash": (hit_s: 0.15, last_s: 0.1667, total_s: 0.6667),
    },
    // SMASH-STAGE BASE KNOCKBACK: the factor each move's base launch is
    // scaled by here, so a tilt or an aerial at 0% stuns past its own
    // swing. Written by `scripts/smash_retime.py`.
    move_knockback: {
        "tilt_forward": 1.6,
        "tilt_down": 1.6,
        "gnu_ton_dash_attack": 1.5,
        "air_neutral": 1.5,
        "air_forward": 1.5,
        "air_back": 1.3,
        "air_up": 1.3,
        "air_down": 1.4,
    },
