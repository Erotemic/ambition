// ROBOT V3'S PLATFORM-FIGHTER FACET: what the robot is on a Smash stage, where
// that differs from what its moveset says.
//
// The moveset (`data/movesets/player_robot.ron`) is the robot's HOME game,
// Ambition, where damage is health: a tilt deals 1 and a smash attack deals 3
// or 4. On a Smash stage damage is percent, and those numbers are too small by
// far. Each move's frames and hitboxes are in the moveset, for both games.
//
// Two things have a second meaning on a Smash stage, and are stated here:
//
// - The DAMAGE of a move (`move_damage`).
// - Which move a button plays (`verbs`). At home the robot swings as the
//   knight of Hollow Knight does: a swing roots no one, the jab and the
//   forward attack are one 1-2 string, and the same swing is in the air. A
//   platform fighter is not that: its jab and its tilts root it, it has a
//   dash attack, and each aerial is a move of its own with landing lag. So
//   the fighter's buttons name the fighter's moves. They are in the same
//   moveset file; the home verbs do not name them.
//
// A Smash match reads this because it declares
// `MoveDamageSource::SmashFighterFacet` (`apply_smash_match_rules`). Ambition
// never reads it.
//
// Each list has one value for each volume of the move that deals damage. A
// move that is not named here keeps its moveset damage on a Smash stage too.
// Preparation refuses a move id the moveset does not have and a list of the
// wrong length (`PreparedCharacterDefinition::unresolved_references`).
(
    character: "player_robot_v3",
    verbs: {
        "attack": "jab",
        "attack_forward": "tilt_forward",
        "attack_up": "tilt_up",
        "attack_down": "tilt_down",
        "attack_dash": "player_robot_dash_attack",
        "attack_air": "air_neutral",
        "attack_air_forward": "air_forward",
        "attack_air_back": "air_back",
        "attack_air_up": "air_up",
        "attack_air_down": "air_down",
    },
    move_damage: {
        // The jab is fast, safe and plain.
        "jab": [3],
        "tilt_forward": [6],
        "tilt_up": [5],
        "tilt_down": [4],
        // The smash attacks: a full charge multiplies these by the move's
        // `charge_mult`.
        "smash_forward": [15],
        "smash_up": [14],
        "smash_down": [12],
        "air_neutral": [6],
        "air_forward": [9],
        "air_back": [11],
        "air_up": [7],
        // The spike.
        "air_down": [10],
        "player_robot_dash_attack": [8],
        "rocket_dash": [10],
        "stabilizer_slam": [9],
        "stabilizer_dive": [9],
    },

    // SMASH-STAGE MOVE CLOCKS: first strike, last strike, total and landing
    // lag, in seconds, and the swing cue. Written by
    // `scripts/smash_retime.py` from an archetype template; the moveset keeps
    // the home game's pace. Frames at 60 Hz are in the trailing comment.
    move_timing: {
        // attack: 3/5/17
        "jab": (hit_s: 0.05, last_s: 0.0833, total_s: 0.2833, swing: Some("swing.light")),
        // attack_forward: 5/8/29
        "tilt_forward": (hit_s: 0.0833, last_s: 0.1333, total_s: 0.4833, swing: Some("swing.light")),
        // attack_up: 5/11/23
        "tilt_up": (hit_s: 0.0833, last_s: 0.1833, total_s: 0.3833, swing: Some("swing.light")),
        // attack_down: 5/7/25
        "tilt_down": (hit_s: 0.0833, last_s: 0.1167, total_s: 0.4167, swing: Some("swing.light")),
        // attack_dash: 6/14/38
        "player_robot_dash_attack": (hit_s: 0.1, last_s: 0.2333, total_s: 0.6333, swing: Some("swing.light")),
        // smash_forward: 15/18/46
        "smash_forward": (hit_s: 0.25, last_s: 0.3, total_s: 0.7667, swing: Some("swing.heavy")),
        // smash_up: 9/14/39
        "smash_up": (hit_s: 0.15, last_s: 0.2333, total_s: 0.65, swing: Some("swing.heavy")),
        // smash_down: 5/12/43
        "smash_down": (hit_s: 0.0833, last_s: 0.2, total_s: 0.7167, swing: Some("swing.heavy")),
        // attack_air: 3/24/42 L6
        "air_neutral": (hit_s: 0.05, last_s: 0.4, total_s: 0.7, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_forward: 12/15/48 L14
        "air_forward": (hit_s: 0.2, last_s: 0.25, total_s: 0.8, landing_lag_s: Some(0.2333), swing: Some("swing.aerial")),
        // attack_air_back: 6/12/33 L6
        "air_back": (hit_s: 0.1, last_s: 0.2, total_s: 0.55, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_up: 4/8/32 L6
        "air_up": (hit_s: 0.0667, last_s: 0.1333, total_s: 0.5333, landing_lag_s: Some(0.1), swing: Some("swing.aerial")),
        // attack_air_down: 5/16/44 L12
        "air_down": (hit_s: 0.0833, last_s: 0.2667, total_s: 0.7333, landing_lag_s: Some(0.2), swing: Some("swing.aerial")),
        // grab: 6/7/34
        "robot_grab": (hit_s: 0.1, last_s: 0.1167, total_s: 0.5667),
        // grab_dash: 9/10/42
        "robot_grab_dash": (hit_s: 0.15, last_s: 0.1667, total_s: 0.7),
    },
    // SMASH-STAGE BASE KNOCKBACK: the factor each move's base launch is
    // scaled by here, so a tilt or an aerial at 0% stuns past its own
    // swing. Written by `scripts/smash_retime.py`.
    move_knockback: {
        "tilt_forward": 1.6,
        "tilt_down": 1.6,
        "player_robot_dash_attack": 1.5,
        "air_neutral": 1.5,
        "air_forward": 1.5,
        "air_back": 1.3,
        "air_up": 1.3,
        "air_down": 1.4,
    },
)
