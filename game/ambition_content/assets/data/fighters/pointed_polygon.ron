        // attack_dash: 12/15/42
        "pointed_polygon_dash_attack": (hit_s: 0.2, last_s: 0.25, total_s: 0.7, swing: Some("swing.light")),
        // smash_forward: 10/13/47
        "polygon_smash_forward": (hit_s: 0.1667, last_s: 0.2167, total_s: 0.7833, swing: Some("swing.heavy")),
        // smash_up: 13/16/50
        "polygon_smash_up": (hit_s: 0.2167, last_s: 0.2667, total_s: 0.8333, swing: Some("swing.heavy")),
        // smash_down: 6/20/60
        "polygon_smash_down": (hit_s: 0.1, last_s: 0.3333, total_s: 1.0, swing: Some("swing.heavy")),
        // attack_air: 6/18/46 L7
        "polygon_air_neutral": (hit_s: 0.1, last_s: 0.3, total_s: 0.7667, landing_lag_s: Some(0.1167), swing: Some("swing.aerial")),
        // attack_air_forward: 6/9/34 L9
        "polygon_air_forward": (hit_s: 0.1, last_s: 0.15, total_s: 0.5667, landing_lag_s: Some(0.15), swing: Some("swing.aerial")),
        // attack_air_back: 7/10/44 L11
        "polygon_air_back": (hit_s: 0.1167, last_s: 0.1667, total_s: 0.7333, landing_lag_s: Some(0.1833), swing: Some("swing.aerial")),
