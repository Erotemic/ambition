        "polygon_jab": (hit_s: 0.0833, last_s: 0.1, total_s: 0.3667, swing: Some("swing.light")),
        // attack_forward: 8/10/32
        "polygon_tilt_forward": (hit_s: 0.1333, last_s: 0.1667, total_s: 0.5333, swing: Some("swing.light")),
