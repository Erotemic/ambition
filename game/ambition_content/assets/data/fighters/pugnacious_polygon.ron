    body: Some((
        max_run_speed: Some(400.2),
        initial_dash_speed: Some(352.7),
        run_accel: Some(389.0),
        ground_friction: Some(680.7),
        max_air_speed: Some(235.0),
        air_accel: Some(860.0),
