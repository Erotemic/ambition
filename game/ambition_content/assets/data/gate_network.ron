// Ambition's gate network (schema `gate_network`, owned by the world
// capability): the ring's inscription, the gate facilities, and each
// ring with the loading zone a traveller goes through. The rules are in
// `docs/planning/game/gate-network.md`; the engine's rules are
// `ambition_platformer2d_world::rooms::gate_network`.
//
// - An address reaches one ring. Every ring has an address. An
//   address is written as a word; a dial enters its chevrons, which the word
//   spells by the inscription's rule (the k-th L of a word is the k-th Λ).
// - No faction refuses a dial: a dial fails only when no ring answers, a
//   ring is down or busy, or the far ring is in the same facility.
// - A ring never dials a ring in its own facility. Two facilities of one
//   dimension can dial each other (the Science dimension's gravity trail and
//   orbital station are far apart).
// - A status reads only authored facts (a switch, a flag), never chance.
// - A `posted` address is written on the ring's terminal, so every
//   destination has a way home that needs no knowledge. Every terminal
//   posts LEGAL, the Gate Authority's capital (Q185, 2026-11-26), and the
//   capital's terminal posts TESTING, the sandbox hub: home is at most
//   two dials away.
// - A ring whose room is not built yet is `Offline` with a reason; it is
//   never "unknown".
//
// Each ring's zone is a gate portal too (`gate_portals.ron`, `Dialed`), and a
// `Switch` with action `GateTerminal` and the ring's `terminal` id dials it.
// `the_gate_network_names_what_the_world_files_hold` holds each online ring to
// the world files. An edit here is played at the next start, and a content
// reload restates it, with no Rust build.
(
    idle_timeout_secs: 30,
    // The ring's inscription, ΛΕΓΑΛΛΥ ΔΙΣΤΙΝΧΤ, as the letters it spells: one
    // letter per chevron, fifteen chevrons, each its own glyph.
    inscription: "LEGALLYDISTINCT",
    // Which addresses a traveller knows before learning any. `All`: every
    // address is listed from the start, as a development game starts with
    // everything unlocked (Jon, 2026-10-24). `Discovered` (the release rule):
    // only what a dial, a sign, a person or a document taught. Knowledge only
    // lists; a dial never reads it.
    start_known: All,
    facilities: [
        (id: "home_gate_station", name: "Home Gate Station", dimension: "home"),
        // The old gate stack under the hub: its own facility, so the public
        // gate can dial its rings.
        (id: "home_gate_stack", name: "Home Gate Stack", dimension: "home"),
        (id: "military_gate_annex", name: "Military Gate Annex", dimension: "home"),
        // Level 1's ring, in the clearing above Hobford: the hill country was
        // joined to the network last year (`docs/planning/game/level-1.md`).
        (id: "hobford_ring", name: "Hobford Gate", dimension: "hobford"),
        (id: "math_town_gate_hall", name: "Math Town Gate Hall", dimension: "math"),
        (id: "primeval_trailhead_ring", name: "Primeval Trailhead Ring", dimension: "jungle"),
        (id: "primeval_rookery_ring", name: "Rookery Survey Ring", dimension: "jungle"),
        // The Jungle's local arches (WORLD-LAYERS JL-2): each its own
        // facility, so one arch can reach another.
        (id: "primeval_trailhead_arch", name: "Trailhead Arch", dimension: "jungle"),
        (id: "primeval_treetops_arch", name: "Treetops Arch", dimension: "jungle"),
        (id: "primeval_canopy_arch", name: "Canopy Arch", dimension: "jungle"),
        (id: "primeval_tar_pits_arch", name: "Tar Pits Arch", dimension: "jungle"),
        (id: "godwin_forest_ring", name: "Godwin Forest Ring", dimension: "evil"),
        (id: "gravity_trail_ring", name: "Gravity Trail Ring", dimension: "science"),
        (id: "gravity_trail_survey_ring", name: "Trail Survey Ring", dimension: "science"),
        (id: "orbital_station_dock", name: "Orbital Station Gate Dock", dimension: "science"),
        (id: "eureka_gate_court", name: "Eureka Gate Court", dimension: "science"),
        (id: "pirate_port_plaza", name: "Pirate Port Gate Plaza", dimension: "pvn"),
        (id: "ninja_village_shrine", name: "Ninja Village Gate Shrine", dimension: "pvn"),
        (id: "noodle_village_square", name: "Brothlehem Gate Square", dimension: "noodle"),
        (id: "starlight_gate_garden", name: "Starlight Gate Garden", dimension: "magical"),
        // Magical's local arches (WORLD-LAYERS MG-2): each its own facility,
        // so one arch can reach another.
        (id: "starlight_heights_arch", name: "Starlight Heights Arch", dimension: "magical"),
        (id: "void_keep_arch", name: "Void Keep Arch", dimension: "magical"),
        (id: "void_heart_arch", name: "Void Heart Arch", dimension: "magical"),
        (id: "art_painters_plaza", name: "Painter's Plaza Ring", dimension: "art"),
        (id: "history_cradle", name: "Cradle Ring", dimension: "history"),
        // Haiti's ring, its own facility so it can dial the Cradle.
        (id: "history_ayiti", name: "Ayiti Ring", dimension: "history"),
        // The final boss's dimension (`docs/planning/game/final-boss.md`).
        (id: "boss_lobby_ring", name: "Final Tour Lobby Ring", dimension: "boss"),
        // The Frontier's spaceport town (`docs/planning/game/leadensaddle.md`).
        (id: "dry_dock_pad", name: "Dry Dock Pad Three", dimension: "frontier"),
        // The Frontier's auxiliary terminal at Halfway Siding, on the gulch
        // rim west of Dry Dock (`techno-western-frontier-first-slice.md`).
        (id: "halfway_siding", name: "Halfway Siding Auxiliary Terminal", dimension: "frontier"),
        // The Business dimension's city, Capital
        // (`docs/planning/game/business-dimension.md`).
        (id: "founders_plaza", name: "Founders' Plaza Gate", dimension: "business"),
        // The Neural dimension's bridge between its two halves
        // (`docs/planning/game/neural-dimension.md`).
        (id: "neural_callosum", name: "Callosum Gate", dimension: "neural"),
        // The Gate Authority's capital, the Central Hub: the Concourse
        // (`docs/planning/game/central-hub-dimension.md`).
        (id: "authority_concourse", name: "Concourse Gate", dimension: "authority"),
        // The Unfinished dimension's gate, in the Staging Area
        // (`docs/planning/game/unfinished-dimension.md`).
        (id: "unfinished_staging", name: "Staging Gate", dimension: "unfinished"),
        // The Automaton dimension's gate, in the Works
        // (`docs/planning/game/automaton-dimension.md`).
        (id: "automaton_works", name: "Works Gate", dimension: "automaton"),
    ],
    rings: [
        // ── Home ──────────────────────────────────────────────────────────
        (
            zone: "hub_public_gate_zone",
            name: "Central Hub public gate",
            facility: "home_gate_station",
            room: "central_hub_complex",
            // The developer sandbox's own address; LEGAL is the capital's.
            address: Some("TESTING"),
            terminal: Some("hub_public_terminal"),
            posted: ["LEGAL"],
            note: "Public ring. Organic travellers: expect nausea for an hour.",
        ),
        // Ring 1 of the gate stack: the intro's gate. Its old switch is its
        // power. Not an important ring: its address is random glyphs.
        (
            zone: "intro_portal_zone",
            name: "Gate stack, ring 1",
            facility: "home_gate_stack",
            room: "gate_stack_lower",
            glyphs: Some([2, 7, 0, 12, 9, 10]),
            terminal: Some("ring1_terminal"),
            status: PoweredBy(
                switch: "intro_portal_switch",
                reason: "Ring 1 has no power. Toggle the gate power beside it.",
            ),
            posted: ["LEGAL"],
            note: "The first ring. The stack was built around it.",
        ),
        // Ring 7 of the gate stack is the old Math line, posted on its
        // terminal. It draws power through the breaker beside it. Its address
        // is random glyphs.
        (
            zone: "math_gate_home_zone",
            name: "Gate stack, ring 7",
            facility: "home_gate_stack",
            room: "gate_stack_lower",
            glyphs: Some([6, 10, 2, 2, 14, 14]),
            terminal: Some("ring7_terminal"),
            status: PoweredBy(
                switch: "math_gate_switch",
                reason: "Ring 7 has no power. Throw the breaker beside it.",
            ),
            posted: ["TANGENT"],
            note: "Maintenance ring. Decades in service; the bearings sing.",
        ),
        // The military's own ring, in the annex behind the General's
        // checkpoint (`docs/planning/game/gate-network.md`).
        (
            zone: "military_gate_zone",
            name: "Military Gate Annex",
            facility: "military_gate_annex",
            room: "military_gate_annex",
            address: Some("SENTINEL"),
            terminal: Some("military_gate_terminal"),
            posted: ["LEGAL"],
            note: "Priority band. Unauthorized use is logged.",
        ),
        // ── Hobford (level 1) ─────────────────────────────────────────────
        // The old stone gate in the clearing, with new steel on it. It stands
        // behind the gate office's barrier, which its lever lifts.
        (
            zone: "hobford_gate_zone",
            name: "Hobford Gate",
            facility: "hobford_ring",
            room: "intro_gate_clearing",
            address: Some("TILLAGE"),
            terminal: Some("hobford_gate_terminal"),
            posted: ["LEGAL"],
            note: "Freight window daily at noon. Persons by appointment.",
        ),
        // ── Math ──────────────────────────────────────────────────────────
        (
            zone: "math_gate_return_zone",
            name: "Math Town gate hall",
            facility: "math_town_gate_hall",
            room: "math_gate_hall",
            address: Some("TANGENT"),
            terminal: Some("math_gate_terminal"),
            posted: ["LEGAL"],
            note: "The town pays for the ring's power by the hour.",
        ),
        // ── Jungle (the primeval trail) ───────────────────────────────────
        (
            zone: "primeval_trailhead_gate",
            name: "Primeval trailhead",
            facility: "primeval_trailhead_ring",
            room: "primeval_trailhead",
            address: Some("GENESIS"),
            terminal: Some("primeval_gate_terminal"),
            posted: ["LEGAL"],
            note: "Field ring. Keep the hatch shut: the birds nest in it.",
        ),
        // A short hidden address: an old survey ring at the rookery, part way
        // up the trail. It only receives; the trail leads back down.
        (
            zone: "primeval_rookery_gate",
            name: "Rookery survey ring",
            facility: "primeval_rookery_ring",
            room: "primeval_rookery",
            address: Some("NEST"),
            hidden: true,
            terminal: Some("rookery_gate_terminal"),
            posted: ["LEGAL", "GENESIS"],
            note: "A survey ring. The birds roost on its dialer.",
        ),
        // The Jungle's arches: portals, a chain along the trail. Each reaches
        // 6400, not the default 8000, so each link is plainly in reach and
        // each skip plainly out of it: the trailhead's arch is about 2400
        // from the treetops' and 8100 from the canopy's; the treetops' 5700
        // from the canopy's and 8700 from the tar pits'; the canopy's 3100
        // from the tar pits'. Each posts the way back down the chain.
        (
            zone: "primeval_trailhead_arch",
            name: "Trailhead arch",
            facility: "primeval_trailhead_arch",
            room: "primeval_trailhead",
            address: Some("GIANTS"),
            terminal: Some("primeval_trailhead_arch_terminal"),
            note: "Trail arch. Whatever built it was tall; the rangers only keep it swept.",
            kind: Portal,
            reach: Some(6400),
        ),
        (
            zone: "primeval_treetops_arch",
            name: "Treetops arch",
            facility: "primeval_treetops_arch",
            room: "primeval_treetops",
            address: Some("TALLEST"),
            terminal: Some("primeval_treetops_arch_terminal"),
            posted: ["GIANTS"],
            note: "Branch arch. Step out slowly; the branch is narrower than the arch.",
            kind: Portal,
            reach: Some(6400),
        ),
        (
            zone: "primeval_canopy_arch",
            name: "Canopy arch",
            facility: "primeval_canopy_arch",
            room: "primeval_canopy",
            address: Some("LIANAS"),
            terminal: Some("primeval_canopy_arch_terminal"),
            posted: ["TALLEST"],
            note: "Canopy arch. The vines grew through it before anyone dialed it.",
            kind: Portal,
            reach: Some(6400),
        ),
        (
            zone: "primeval_tar_pits_arch",
            name: "Dig camp arch",
            facility: "primeval_tar_pits_arch",
            room: "primeval_tar_pits",
            address: Some("DIGSITE"),
            terminal: Some("primeval_tar_pits_arch_terminal"),
            posted: ["LIANAS"],
            note: "The dig found it. Do not label it as a find.",
            kind: Portal,
            reach: Some(6400),
        ),
        // ── Evil (Castle Godwin) ──────────────────────────────────────────
        (
            zone: "evil_gate_return_zone",
            name: "Godwin forest",
            facility: "godwin_forest_ring",
            room: "evil_gate_forest",
            address: Some("CITADEL"),
            terminal: Some("evil_gate_terminal"),
            posted: ["LEGAL"],
            note: "Outer ring, out of the castle's sight. Go home if you hear boots.",
        ),
        // ── Science (GNU-ton's gravity trail and the orbital station) ─────
        (
            zone: "orchard_gate",
            name: "Gravity trail, the orchard",
            facility: "gravity_trail_ring",
            room: "gnu_ton_orchard",
            address: Some("ASCENT"),
            terminal: Some("orchard_gate_terminal"),
            posted: ["LEGAL"],
            note: "Low gravity at the ring. Step out slowly.",
        ),
        // The military's survey ring at the far end of the gravity trail: a
        // short way to GNU-ton for a traveller who knows its address.
        (
            zone: "trail_survey_gate",
            name: "Trail survey ring",
            facility: "gravity_trail_survey_ring",
            room: "gnu_ton_works_approach",
            address: Some("TESLA"),
            hidden: true,
            terminal: Some("trail_survey_gate_terminal"),
            posted: ["LEGAL", "ASCENT"],
            note: "A survey ring on the tower by GNU-ton's door.",
        ),
        (
            zone: "orbital_station_gate_arrival",
            name: "Orbital station gate dock",
            facility: "orbital_station_dock",
            room: "orbital_station_gate_dock",
            address: Some("GALACTIC"),
            terminal: Some("orbital_station_gate_terminal"),
            posted: ["LEGAL"],
            note: "Docking ring. Freight has right of way.",
        ),
        // ── Science (Eureka, the institute town under the station) ───────
        (
            zone: "eureka_gate_arrival",
            name: "Eureka gate court",
            facility: "eureka_gate_court",
            room: "eureka_gate_court",
            address: Some("SCIENCE"),
            terminal: Some("eureka_gate_terminal"),
            posted: ["LEGAL"],
            note: "Institute ring. Calibrated weekly, argued about daily.",
        ),
        // ── Water (the pirate port) ───────────────────────────────────────
        (
            zone: "pirate_port_gate_arrival",
            name: "Pirate port gate plaza",
            facility: "pirate_port_plaza",
            room: "pirate_port_gate_plaza",
            address: Some("SAILING"),
            terminal: Some("pirate_port_gate_terminal"),
            posted: ["LEGAL"],
            note: "Port ring. Salt in the bearings again.",
        ),
        // ── Forest (the ninja village) ────────────────────────────────────
        (
            zone: "ninja_village_gate_arrival",
            name: "Ninja village gate shrine",
            facility: "ninja_village_shrine",
            room: "ninja_village_gate_shrine",
            address: Some("SILENT"),
            terminal: Some("ninja_village_gate_terminal"),
            posted: ["LEGAL"],
            note: "Shrine ring. Bow to the keeper; the keeper keeps the log.",
        ),
        // ── Noodle (the Noodly Temple) ────────────────────────────────────
        // The Noodle dimension's ring, in the square of Brothlehem, the
        // village under the temple's hill: the hub of the dimension. The
        // temple is up the Pilgrims' Way, and the soda volcano is east.
        (
            zone: "noodle_village_gate",
            name: "Brothlehem gate square",
            facility: "noodle_village_square",
            room: "noodle_village_square",
            address: Some("ALDENTE"),
            terminal: Some("noodle_village_gate_terminal"),
            posted: ["LEGAL"],
            note: "Pilgrims' ring. The pilgrims keep it clean; the sauce does not.",
        ),
        // ── Magical (Mary-O's dimension) ─────────────────────────────────
        (
            zone: "magical_gate_zone",
            name: "Starlight gate garden",
            facility: "starlight_gate_garden",
            room: "magical_gate_garden",
            address: Some("DESTINY"),
            terminal: Some("magical_gate_terminal"),
            posted: ["LEGAL"],
            note: "Garden ring. The hills are round on purpose; please do not roll down them.",
        ),
        // Magical's arches: portals, which reach only Magical's own arches
        // and only within their reach. The heights' arch reaches the keep's;
        // the keep's reaches both; the heart is too far from the heights, so
        // that trip is two hops. An arch lists what it reaches once its
        // address is learned (an arch is attuned by opening its terminal);
        // the keep's posts the way back to town and the heart's the way out.
        (
            zone: "magical_heights_arch",
            name: "Starlight Heights arch",
            facility: "starlight_heights_arch",
            room: "magical_starlight_heights",
            address: Some("STEADY"),
            terminal: Some("magical_heights_arch_terminal"),
            note: "Cloud arch. Mind the gap on the way out.",
            kind: Portal,
        ),
        (
            zone: "magical_keep_arch",
            name: "Void Keep arch",
            facility: "void_keep_arch",
            room: "magical_void_keep",
            address: Some("CASTLE"),
            terminal: Some("magical_keep_arch_terminal"),
            posted: ["STEADY"],
            note: "The castle's arch. The void left it working; it likes visitors.",
            kind: Portal,
        ),
        (
            zone: "magical_heart_arch",
            name: "Void Heart arch",
            facility: "void_heart_arch",
            room: "magical_void_heart",
            address: Some("CANDLE"),
            terminal: Some("magical_heart_arch_terminal"),
            posted: ["CASTLE"],
            note: "The arch at the bottom of the void. Shh.",
            kind: Portal,
        ),
        // ── Art (the Painter's Plaza) ────────────────────────────────────
        // The plaza's ring, on its easel: the way to the Art dimension. The
        // people of the dimension hate the gates the most; the Curator keeps
        // this one open.
        (
            zone: "art_plaza_gate",
            name: "Painter's Plaza",
            facility: "art_painters_plaza",
            room: "art_painters_plaza",
            address: Some("EASEL"),
            terminal: Some("art_gate_terminal"),
            posted: ["LEGAL"],
            note: "Plaza ring. Do not touch the frame; it is wet.",
        ),
        // ── History (the Fertile Crescent) ───────────────────────────────
        // The Cradle's ring, in the Great Rift Valley: the way to the History
        // dimension, a grid of the ages (east) and the regions (floors).
        // Clio keeps the gate.
        (
            zone: "history_cradle_gate",
            name: "Cradle Gate",
            facility: "history_cradle",
            room: "history_cradle",
            address: Some("DYNASTIC"),
            terminal: Some("history_gate_terminal"),
            posted: ["LEGAL"],
            note: "Cradle ring. Older than everyone; please wipe your feet.",
        ),
        // Haiti's ring, at the east end of the room: the way back from the
        // far side of the Atlantic. The Door of No Return in the fort on the
        // Gold Coast goes one way, to Haiti; this ring dials home.
        (
            zone: "history_ayiti_gate",
            name: "Ayiti Gate",
            facility: "history_ayiti",
            room: "history_haitian_revolution",
            address: Some("ANTILLES"),
            terminal: Some("history_ayiti_terminal"),
            posted: ["LEGAL", "DYNASTIC"],
            note: "Ayiti ring. Land of mountains; the ring is at the foot of them.",
        ),
        // ── Boss (the final tour) ────────────────────────────────────────
        // The lobby of the bossofthegame's stage: one door from the final
        // boss. Hidden, so a whole game can pass without the reveal
        // (`docs/planning/game/final-boss.md`).
        (
            zone: "boss_lobby_gate",
            name: "Final tour lobby",
            facility: "boss_lobby_ring",
            room: "boss_lobby",
            address: Some("LEGACY"),
            hidden: true,
            terminal: Some("boss_lobby_gate_terminal"),
            posted: ["LEGAL"],
            note: "Lobby ring. Backstage passes are not valid here.",
        ),
        // ── Frontier (the Leaden Saddle) ─────────────────────────────────
        // Pad Three of Dry Dock, the spaceport town under the Marshal's
        // whistle (`docs/planning/game/leadensaddle.md`).
        (
            zone: "frontier_pad_gate",
            name: "Dry Dock, Pad Three",
            facility: "dry_dock_pad",
            room: "frontier_landing_pad",
            address: Some("LEADENSADDLE"),
            terminal: Some("frontier_gate_terminal"),
            posted: ["LEGAL"],
            note: "Pad Three ring. The toll is payable to the Marshal.",
        ),
        // The auxiliary gate of Halfway Siding, beside the rail halt. It
        // posts the way home and the way to the Frontier's main pads.
        (
            zone: "frontier_siding_gate",
            name: "Halfway Siding",
            facility: "halfway_siding",
            room: "frontier_siding_station",
            address: Some("SIDING"),
            terminal: Some("frontier_siding_terminal"),
            posted: ["LEGAL", "LEADENSADDLE"],
            note: "Auxiliary gate. Rest at the inn before travelling on.",
        ),
        // ── Business (Capital) ───────────────────────────────────────────
        // Founders' Plaza, by the Founder's fountain
        // (`docs/planning/game/business-dimension.md`).
        (
            zone: "business_plaza_gate",
            name: "Capital, Founders' Plaza",
            facility: "founders_plaza",
            room: "business_founders_plaza",
            address: Some("DEALINGS"),
            terminal: Some("business_gate_terminal"),
            posted: ["LEGAL"],
            note: "Plaza gate. Directions beyond this point are licensed.",
        ),
        // ── Neural (the Cortex and the Weights) ─────────────────────────
        // The Callosum, the bridge between the living half and the built
        // half (`docs/planning/game/neural-dimension.md`).
        (
            zone: "neural_callosum_gate",
            name: "The Callosum",
            facility: "neural_callosum",
            room: "neural_callosum",
            address: Some("LATENT"),
            terminal: Some("neural_gate_terminal"),
            posted: ["LEGAL"],
            note: "Bridge gate. Living half west, built half east.",
        ),
        // The Gate Authority's capital: the arrival ring of the Concourse
        // (`docs/planning/game/central-hub-dimension.md`). Home stays the
        // sandbox hub's LEGAL (Q185).
        (
            zone: "authority_concourse_gate",
            name: "The Concourse",
            facility: "authority_concourse",
            room: "authority_concourse",
            // The one address everyone is given (Q185).
            address: Some("LEGAL"),
            terminal: Some("authority_gate_terminal"),
            posted: ["TESTING"],
            note: "The Authority's own ring. Declare any sentience in your luggage.",
        ),
        // The Unfinished dimension: the ring the agents set up first, in the
        // Staging Area (`docs/planning/game/unfinished-dimension.md`).
        (
            zone: "unfinished_staging_gate",
            name: "The Staging Area",
            facility: "unfinished_staging",
            room: "unfinished_staging",
            address: Some("INSTALLING"),
            terminal: Some("unfinished_gate_terminal"),
            posted: ["LEGAL"],
            note: "Site gate. Hard hats past this point.",
        ),
        // The Automaton dimension: the ring in the Works, the clockwork
        // town (`docs/planning/game/automaton-dimension.md`).
        (
            zone: "automaton_works_gate",
            name: "The Works",
            facility: "automaton_works",
            room: "automaton_works",
            address: Some("CELLS"),
            terminal: Some("automaton_gate_terminal"),
            posted: ["LEGAL"],
            note: "Wound daily. Mind the gears.",
        ),
    ],
)
