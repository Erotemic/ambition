// The gate portals of Ambition's rooms (schema `gate_portals`, owned by the
// world capability), by the loading zone each one holds. A portal lets a
// body through its zone only while it is on. Its command boots it and shuts
// it down: a save switch (`Switch(id)`), or the gate network (`Dialed`), for
// a ring of `gate_network.ron` that a terminal dials. The visuals find its portal and ring props by these names, across
// rooms, so each portal has its own props.
//
// The admission check refuses an empty name and a prop that two portals
// name. `each_gate_portal_names_what_a_world_file_holds` holds each name to
// the world files. An edit here is played at the next start, and a content
// reload restates these rows, with no Rust build.
{
    // The intro's gate, at the end of the intro.
    "intro_portal_zone": (
        command: Dialed,
        portal_sprite_name: "Interdimensional Gate Portal",
        ring_sprite_name: "Interdimensional Gate Ring",
    ),
    // The rings of the gate network (`gate_network.ron`): a link that a
    // terminal dials opens them. The central hub's public gate:
    "hub_public_gate_zone": (
        command: Dialed,
        portal_sprite_name: "Public Gate (Hub) Portal",
        ring_sprite_name: "Public Gate (Hub) Ring",
    ),
    // Ring 7 of the Home gate station (`gate_stack_lower`), the Math line.
    "math_gate_home_zone": (
        command: Dialed,
        portal_sprite_name: "Math Gate Portal (Home)",
        ring_sprite_name: "Math Gate Ring (Home)",
    ),
    // The ring of the Math town's gate hall.
    "math_gate_return_zone": (
        command: Dialed,
        portal_sprite_name: "Math Gate Portal (Math)",
        ring_sprite_name: "Math Gate Ring (Math)",
    ),
    // The ring in the forest by Castle Godwin.
    "evil_gate_return_zone": (
        command: Dialed,
        portal_sprite_name: "Evil Gate (Evil) Portal",
        ring_sprite_name: "Evil Gate (Evil) Ring",
    ),
    // The trailhead of the primeval trail.
    "primeval_trailhead_gate": (
        command: Dialed,
        portal_sprite_name: "Primeval Gate (Trailhead) Portal",
        ring_sprite_name: "Primeval Gate (Trailhead) Ring",
    ),
    // The old survey ring at the rookery (receive only).
    "primeval_rookery_gate": (
        command: Dialed,
        portal_sprite_name: "Rookery Survey Gate Portal",
        ring_sprite_name: "Rookery Survey Gate Ring",
    ),
    // The gravity trail's orchard, in the Science dimension.
    "orchard_gate": (
        command: Dialed,
        portal_sprite_name: "Gravity Trail Gate Portal",
        ring_sprite_name: "Gravity Trail Gate Ring",
    ),
    // The orbital station's gate dock.
    "orbital_station_gate_arrival": (
        command: Dialed,
        portal_sprite_name: "Orbital Gate (Dock) Portal",
        ring_sprite_name: "Orbital Gate (Dock) Ring",
    ),
    // The pirate port's gate plaza.
    "pirate_port_gate_arrival": (
        command: Dialed,
        portal_sprite_name: "Port Gate (Plaza) Portal",
        ring_sprite_name: "Port Gate (Plaza) Ring",
    ),
    // The ninja village's gate shrine.
    "ninja_village_gate_arrival": (
        command: Dialed,
        portal_sprite_name: "Village Gate (Shrine) Portal",
        ring_sprite_name: "Village Gate (Shrine) Ring",
    ),
    // The Noodly Temple's narthex.
    "noodly_narthex_gate": (
        command: Dialed,
        portal_sprite_name: "Noodly Gate (Narthex) Portal",
        ring_sprite_name: "Noodly Gate (Narthex) Ring",
    ),
    // The military gate annex, off the General's tower (SENTINEL).
    "military_gate_zone": (
        command: Dialed,
        portal_sprite_name: "Military Gate (Annex) Portal",
        ring_sprite_name: "Military Gate (Annex) Ring",
    ),
    // The military survey ring on the gravity trail's last tower (TESLA,
    // receive only).
    "trail_survey_gate": (
        command: Dialed,
        portal_sprite_name: "Trail Survey Gate Portal",
        ring_sprite_name: "Trail Survey Gate Ring",
    ),
}
