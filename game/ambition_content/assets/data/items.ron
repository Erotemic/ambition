        held_item_id: None,
        dialog_id: "portalgun",
        icon: Some("sprites/props/portal_gun_blue.png"),
    ),
    (
        display_name: "Javelin",
        description: "A throwing spear. Using it throws it.",
        category: Held,
        held_item_id: Some("javelin"),
        dialog_id: "javelin",
        icon: Some("sprites/props/javelin.png"),
    ),
    (
        display_name: "Gun-Sword",
        description: "A laser sword with a gun on it that shoots swords. Fires aimed bolts.",
        category: Held,
        held_item_id: Some("gun_sword"),
        dialog_id: "gunsword",
        icon: Some("sprites/props/gunsword.png"),
    ),
    (
        display_name: "Puppy-Slug Gun",
        description: "Fires friendly puppy slugs that harry your enemies. (planned)",
        category: Held,
        held_item_id: Some("puppy_slug_gun"),
        dialog_id: "puppysluggun",
        icon: Some("sprites/props/gauntlet_puppy_slug_gun.png"),
    ),
    (
        display_name: "Bomb",
        description: "A thrown explosive. A hard throw sets it off where it strikes; a soft one bounces and goes off on its fuse.",
        category: Held,
        held_item_id: Some("bomb"),
        dialog_id: "bomb",
        icon: Some("sprites/props/gauntlet_bomb.png"),
        // Each throw of an equipped bomb takes one from the bag, and the hand
