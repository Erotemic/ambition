// Item CATALOG: the 6 x 4 inventory grid (schema `item_catalog`).
//
// Top-level shape: `[ItemMeta]` in grid order (row-major, slot index =
// row*6 + col). The index is the binding to the `Item` variant, so a row is a
// SLOT: to empty one, keep the row. `dialog_id` is the stable lowercase id
// that saves and scripts use (`inventory_has("portalgun")`).
//
// A body equips an item in one of two ways:
//
// * `Held`: the item goes in the hand. `held_item_id` names the HeldItem.
// * `Ability`: the body wears the `wears` row. Rows that name the same
//   `exclusive_slot` are mutually exclusive: to equip one replaces the
//   other. A row that changes nothing (no grant, no modifier) is the body's
//   OWN action on that slot: it is in effect while no other row holds the
//   slot. An ability with no `wears` row is a placeholder. Nothing equips
//   it, and the demo does not unlock it.
//
// `stack` is the most of an item that the bag holds. A row with no `stack`
// is unique (1). A stack above 1 shows its count in the menu.
//
// The demo unlocks every ability that has a row, and gives a few consumables
// and a stock of bombs (`OwnedItems::starter`).
[
    // ---- Row 1: combat abilities. Projectile, then stance. ----
    (
        display_name: "Fireball",
        description: "Hold to charge a bolt of fire, release to throw it.",
        category: Ability,
        held_item_id: None,
        dialog_id: "fireball",
        // The robot's own projectile.
        wears: Some((id: "fireball", exclusive_slot: Some("projectile"))),
        icon: Some("sprites/props/gauntlet_fireball.png"),
    ),
    (
        display_name: "Eye Laser",
        description: "Hold to fire a wide laser from your whole visor. Spends mana while it burns.",
        category: Ability,
        held_item_id: None,
        dialog_id: "eyelaser",
        wears: Some((
            id: "eye_laser",
            exclusive_slot: Some("projectile"),
            grants: [
                Technique((
                    id: ("eye_laser"),
                    slot: Projectile,
                    display_name: Some("Eye Laser"),
                    gate: Technique("eye_laser"),
                )),
            ],
        )),
        icon: Some("sprites/props/gauntlet_beam.png"),
    ),
    (
        display_name: "Lightning",
        description: "A projectile of lightning. Not yet found.",
        category: Ability,
        held_item_id: None,
        dialog_id: "lightning",
    ),
    (
        display_name: "Sword Stance",
        description: "Fight with the blade.",
        category: Ability,
        held_item_id: None,
        dialog_id: "swordstance",
        // The robot's own attack.
        wears: Some((id: "sword_stance", exclusive_slot: Some("stance"))),
    ),
    (
        display_name: "Axe Stance",
        description: "Fight with heavy cleaving swings. Not yet found.",
        category: Ability,
        held_item_id: None,
        dialog_id: "axestance",
    ),
    (
        display_name: "Whip Stance",
        description: "Fight at long reach with a whip. Not yet found.",
        category: Ability,
        held_item_id: None,
        dialog_id: "whipstance",
    ),
    // ---- Row 2: movement abilities (blink, then dash), then the movement gauntlets. ----
    (
        display_name: "Precision Blink",
        description: "Teleport a short distance in the direction you aim.",
        category: Ability,
        held_item_id: None,
        dialog_id: "precisionblink",
        // The robot's own blink.
        wears: Some((id: "precision_blink", exclusive_slot: Some("blink"))),
        icon: Some("sprites/props/gauntlet_blink.png"),
    ),
    (
        display_name: "Contextual Blink",
        description: "Blink behind a nearby enemy. Not yet found.",
        category: Ability,
        held_item_id: None,
        dialog_id: "contextualblink",
    ),
    (
        display_name: "Dash",
        description: "A quick burst along the ground or through the air.",
        category: Ability,
        held_item_id: None,
        dialog_id: "dash",
        // The robot's own dash.
        wears: Some((id: "dash", exclusive_slot: Some("burst"))),
    ),
    (
        display_name: "Dash II",
        description: "Another way to dash. Not yet found.",
        category: Ability,
        held_item_id: None,
        dialog_id: "dashtwo",
    ),
    (
        display_name: "Grapple Hook",
        description: "Pull yourself toward anchor points. (planned)",
        category: Held,
        held_item_id: Some("grapple"),
        dialog_id: "grapple",
        icon: Some("sprites/props/gauntlet_grapple.png"),
    ),
    (
        display_name: "Mark / Recall",
        description: "Drop marks and recall to them — travel and combat tool. (planned)",
        category: Held,
        held_item_id: Some("mark_recall"),
        dialog_id: "markrecall",
        icon: Some("sprites/props/gauntlet_mark_recall.png"),
    ),
    // ---- Row 3: held weapons and tools. ----
    (
        display_name: "Portal Gun",
        description: "Fire a linked blue/orange portal pair. Carries momentum.",
