// Item CATALOG: the 6 x 4 inventory grid (schema `item_catalog`).
//
// Top-level shape: `[ItemMeta]` in grid order (row-major, slot index =
// row*6 + col). The index is the binding to the `Item` variant, so a row is a
// SLOT: to empty one, keep the row. `dialog_id` is the stable lowercase id
// that saves and scripts use (`inventory_has("portalgun")`).
//
// A body equips an item in one of two ways:
//
// * `Held`: the item goes in the hand. `held_item_id` names the HeldItem.
// * `Ability`: the body wears the `wears` row. Rows that name the same
//   `exclusive_slot` are mutually exclusive: to equip one replaces the
//   other. A row that changes nothing (no grant, no modifier) is the body's
//   OWN action on that slot: it is in effect while no other row holds the
//   slot. An ability with no `wears` row is a placeholder. Nothing equips
//   it, and the demo does not unlock it.
//
// `stack` is the most of an item that the bag holds. A row with no `stack`
// is unique (1). A stack above 1 shows its count in the menu.
//
// The demo unlocks every ability that has a row, and gives a few consumables
// and a stock of bombs (`OwnedItems::starter`).
[
    // ---- Row 1: combat abilities. Projectile, then stance. ----
    (
        display_name: "Fireball",
        description: "Hold to charge a bolt of fire, release to throw it.",
        category: Ability,
        held_item_id: None,
        dialog_id: "fireball",
        // The robot's own projectile.
        wears: Some((id: "fireball", exclusive_slot: Some("projectile"))),
        icon: Some("sprites/props/gauntlet_fireball.png"),
    ),
    (
        display_name: "Eye Laser",
        description: "Hold to fire a wide laser from your whole visor. Spends mana while it burns.",
        category: Ability,
        held_item_id: None,
        dialog_id: "eyelaser",
        wears: Some((
            id: "eye_laser",
            exclusive_slot: Some("projectile"),
            grants: [
                Technique((
                    id: ("eye_laser"),
                    slot: Projectile,
                    display_name: Some("Eye Laser"),
                    gate: Technique("eye_laser"),
                )),
            ],
        )),
        icon: Some("sprites/props/gauntlet_beam.png"),
    ),
    (
        display_name: "Lightning",
        description: "Hold out your hand and lightning crackles from it in a short cone. Hold to keep it crackling; it spends mana while it does.",
        category: Ability,
        held_item_id: None,
        dialog_id: "lightning",
        wears: Some((
            id: "lightning",
            exclusive_slot: Some("projectile"),
            grants: [Technique((
                id: ("lightning"), slot: Projectile,
                display_name: Some("Lightning"), gate: Technique("lightning"),
            ))],
        )),
    ),
    // The three combat stances share the slot `stance`: wearing one takes it
    // from the others. Each rebinds the whole home hit kit (attacks, air
    // attacks, smashes) to moves of the robot's own table
    // (`data/movesets/player_robot.ron`); specials, grabs and the taunt stay.
    // Every stance has a pogo on its down-air. docs/planning/game/combat-stances.md
    (
        display_name: "Stance I",
        description: "Edge: the knight's 1-2. Short, safe swings that root no one, and a straight pogo.",
        category: Ability,
        held_item_id: None,
        dialog_id: "swordstance",
        // The robot's own attack.
        wears: Some((id: "sword_stance", exclusive_slot: Some("stance"))),
    ),
    (
        display_name: "Stance II",
        description: "Lunge: thrusts that carry you forward, a whirl in the air, and a diving pogo.",
        category: Ability,
        held_item_id: None,
        dialog_id: "lungestance",
        wears: Some((
            id: "lunge_stance",
            exclusive_slot: Some("stance"),
            rebinds: {
                "attack": "lunge_thrust",
                "attack_forward": "lunge_thrust",
                "attack_up": "lunge_corkscrew",
                "attack_down": "lunge_slide",
                "attack_air": "lunge_whirl",
                "attack_air_forward": "lunge_air_thrust",
                "attack_air_back": "lunge_back_kick",
                "attack_air_up": "lunge_corkscrew",
                "attack_air_down": "lunge_plunge",
                "smash_forward": "lunge_smash_forward",
                "smash_up": "lunge_smash_up",
                "smash_down": "lunge_smash_down",
            },
        )),
    ),
    (
        display_name: "Stance III",
        description: "Crescent: wide arcs that hit hardest at the tip, a three-step string, and a sweeping pogo.",
        category: Ability,
        held_item_id: None,
        dialog_id: "crescentstance",
        wears: Some((
            id: "crescent_stance",
            exclusive_slot: Some("stance"),
            rebinds: {
                "attack": "crescent_arc",
                "attack_forward": "crescent_arc",
                "attack_up": "crescent_overhead",
                "attack_down": "crescent_low",
                "attack_air": "crescent_air",
                "attack_air_forward": "crescent_air",
                "attack_air_back": "crescent_air_back",
                "attack_air_up": "crescent_air_up",
                "attack_air_down": "crescent_pogo",
                "smash_forward": "crescent_smash_forward",
                "smash_up": "crescent_smash_up",
                "smash_down": "crescent_smash_down",
            },
        )),
    ),
    // ---- Row 2: movement abilities (blink, then the three dashes), then a movement gauntlet. ----
    (
        display_name: "Precision Blink",
        description: "Teleport a short distance in the direction you aim.",
        category: Ability,
        held_item_id: None,
        dialog_id: "precisionblink",
        // Level 1: the quick directional blink, without the aimed one.
        // Level 2: the aimed blink, at full speed (no time slow).
        // Level 3: the robot's whole blink (aimed, under the aim's time slow).
        wears: Some((id: "precision_blink", exclusive_slot: Some("blink"), withholds: ["precision_blink"])),
        levels: [
            (id: "precision_blink_2", exclusive_slot: Some("blink"), withholds: ["blink_slow"]),
            (id: "precision_blink_3", exclusive_slot: Some("blink")),
        ],
        stack: 3,
        icon: Some("sprites/props/gauntlet_blink.png"),
    ),
    (
        display_name: "Contextual Blink",
        description: "Blink behind the nearest enemy, facing it. With no enemy near, a short blink the way you aim.",
        category: Ability,
        held_item_id: None,
        dialog_id: "contextualblink",
        // The Blink slot is the `contextual_blink` module's technique.
        // Level 1: an enemy that is near. Level 2: one further away.
        // Level 3: a double tap slows the world while held; aim picks the enemy.
        wears: Some((
            id: "contextual_blink",
            exclusive_slot: Some("blink"),
            grants: [Technique((
                id: ("contextual_blink"), slot: Blink,
                display_name: Some("Contextual Blink"), gate: Technique("contextual_blink"),
            ))],
        )),
        levels: [
            (
                id: "contextual_blink_2",
                exclusive_slot: Some("blink"),
                grants: [Technique((
                    id: ("contextual_blink_2"), slot: Blink,
                    display_name: Some("Contextual Blink"), gate: Technique("contextual_blink_2"),
                ))],
            ),
            (
                id: "contextual_blink_3",
                exclusive_slot: Some("blink"),
                grants: [Technique((
                    id: ("contextual_blink_3"), slot: Blink,
                    display_name: Some("Contextual Blink"), gate: Technique("contextual_blink_3"),
                ))],
            ),
        ],
        stack: 3,
    ),
    (
        display_name: "Dash",
        description: "A quick burst along the ground or through the air.",
        category: Ability,
        held_item_id: None,
        dialog_id: "dash",
        // The robot's own dash.
        wears: Some((id: "dash", exclusive_slot: Some("burst"))),
    ),
    (
        display_name: "Dash II",
        description: "A surge: it starts faster and keeps its speed. Jump out of it to carry the speed into the air. The burst dashes on the ground too.",
        category: Ability,
        held_item_id: None,
        dialog_id: "dashtwo",
        // The surge style of the robot's dash. A body with a dash style
        // answers the burst with its dash on the ground too, not the dodge.
        wears: Some((id: "dash_2", exclusive_slot: Some("burst"), lends: ["surge_dash"])),
    ),
    (
        display_name: "Dash III",
        description: "A phase: a short, very fast dash that nothing can hit, stopping at a run. The burst dashes on the ground too.",
        category: Ability,
        held_item_id: None,
        dialog_id: "dashthree",
        // The phase style of the robot's dash (see Dash II).
        wears: Some((id: "dash_3", exclusive_slot: Some("burst"), lends: ["phase_dash"])),
    ),
    (
        display_name: "Mark / Recall",
        description: "Drop marks and recall to them — travel and combat tool. (planned)",
        category: Held,
        held_item_id: Some("mark_recall"),
        dialog_id: "markrecall",
        icon: Some("sprites/props/gauntlet_mark_recall.png"),
    ),
    // ---- Row 3: held weapons and tools. ----
    (
        display_name: "Portal Gun",
        description: "Fire a linked blue/orange portal pair. Carries momentum.",
        category: Held,
        held_item_id: Some("portal_gun"),
        dialog_id: "portalgun",
        icon: Some("sprites/props/portal_gun_blue.png"),
    ),
    // The Grapple Hook, a held tool. (The Javelin was here, removed 2026-11-10;
    // the hook moved here from the movement row on 2026-11-26 for Dash III.)
    (
        display_name: "Grapple Hook",
        description: "Pull yourself toward anchor points. (planned)",
        category: Held,
        held_item_id: Some("grapple"),
        dialog_id: "grapple",
        icon: Some("sprites/props/gauntlet_grapple.png"),
    ),
    (
        display_name: "Gun-Sword",
        description: "A laser sword with a gun on it that shoots swords. Fires aimed bolts.",
        category: Held,
        held_item_id: Some("gun_sword"),
        dialog_id: "gunsword",
        icon: Some("sprites/props/gunsword.png"),
    ),
    (
        display_name: "Puppy-Slug Gun",
        description: "Fires friendly puppy slugs that harry your enemies. (planned)",
        category: Held,
        held_item_id: Some("puppy_slug_gun"),
        dialog_id: "puppysluggun",
        icon: Some("sprites/props/gauntlet_puppy_slug_gun.png"),
    ),
    (
        display_name: "Bomb",
        description: "A thrown explosive. A hard throw sets it off where it strikes; a soft one bounces and goes off on its fuse.",
        category: Held,
        held_item_id: Some("bomb"),
        dialog_id: "bomb",
        icon: Some("sprites/props/gauntlet_bomb.png"),
        // Each throw of an equipped bomb takes one from the bag, and the hand
        // takes the next one until the bag has none.
        stack: 9,
    ),
    // An empty slot (the Axe was here; removed 2026-10-30).
    (
        display_name: "Empty",
        description: "",
        category: Reserved,
        held_item_id: None,
        dialog_id: "empty1",
    ),
    // ---- Row 4: consumables, then key items. A key item is not equipment:
    // the grid draws its cell blank, and the QUEST page lists it. ----
    (
        display_name: "Health Cell",
        description: "Restores health.",
        category: Consumable,
        held_item_id: None,
        dialog_id: "healthcell",
        stack: 99,
    ),
    (
        display_name: "Mana Cell",
        description: "Restores mana.",
        category: Consumable,
        held_item_id: None,
        dialog_id: "manacell",
        stack: 99,
    ),
    (
        display_name: "Spare Battery",
        description: "A spare battery. It does nothing yet.",
        // A key item: it does nothing when used, so it is not equipment.
        // The QUEST page shows it, not the equipment grid.
        category: KeyItem,
        held_item_id: None,
        dialog_id: "sparebattery",
        stack: 99,
    ),
    // A key item whose worth is seeing: while it is in the bag, the game
    // widens the players' light in a dark room. (The Sealed Note's slot.)
    (
        display_name: "Lantern",
        description: "A smuggler's lantern from the salt run, still with oil in it. It lights the dark a long way round you.",
        category: KeyItem,
        held_item_id: None,
        dialog_id: "lantern",
    ),
    (
        display_name: "Field Survey",
        description: "Bob\'s survey sheet of Hobford woods, in pencil. It marks the paths people walk, not the ones on the official map.",
        category: KeyItem,
        held_item_id: None,
        dialog_id: "fieldsurvey",
    ),
    // An empty slot (the Map Fragment was here; removed 2026-10-30).
    (
        display_name: "Empty",
        description: "",
        category: Reserved,
        held_item_id: None,
        dialog_id: "empty2",
    ),
