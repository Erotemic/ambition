    // An empty slot (the Axe was here; removed 2026-10-30).
    (
        display_name: "Empty",
        description: "",
        category: Reserved,
        held_item_id: None,
        dialog_id: "empty1",
    ),
    // ---- Row 4: consumables, then key items. ----
    (
        display_name: "Health Cell",
        description: "Restores health.",
        category: Consumable,
        held_item_id: None,
        dialog_id: "healthcell",
        stack: 99,
    ),
    (
        display_name: "Mana Cell",
        description: "Restores mana.",
        category: Consumable,
        held_item_id: None,
        dialog_id: "manacell",
        stack: 99,
    ),
    (
        display_name: "Spare Battery",
        description: "Reserved ability charge. Does nothing yet.",
        category: Consumable,
        held_item_id: None,
        dialog_id: "sparebattery",
        stack: 99,
