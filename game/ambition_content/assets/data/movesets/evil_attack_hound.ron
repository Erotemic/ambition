// The source of the Attack Hound's running attack. The game loads this file
// through the content pack (`assets/pack.ron`); edit it here.
//
// DESIGN NOTES
//
// Jon (2026-10-30): enemies that "notice, space, telegraph, attack" as Hollow
// Knight's do. The hound bites standing (`evil_hound_bite`); coming in at a
// run (it runs fast) it LUNGES: it drops into a crouch (0.35 s, its `windup`
// row), springs low and long at the foe jaws first (0.35 s, about 180 px),
// and skids to a stop open (0.6 s). The art is its `attack_side` row.
(
    schema_version: 1,
    entities: [
        (
            id: "npc_evil_attack_hound",
            contracts: (
                body: None,
                hurtboxes: None,
                presentation: None,
                moveset: Some((
                    verbs: {
                        "attack_dash": "hound_lunge",
                    },
                    moves: [
                        (
                            id: "hound_lunge",
                            display_name: Some("Lunge"),
                            clip: (
                                clip: "attack_side",
                                fallbacks: [
                                    "slash",
                                    "idle",
                                ],
                            ),
                            duration_s: 1.3,
                            windows: [
                                (
                                    start_s: 0.0,
                                    end_s: 0.35,
                                    tag: Startup,
                                    volumes: [],
                                    motion_scale: 1.0,
                                    sustain_effect: None,
                                ),
                                (
                                    start_s: 0.35,
                                    end_s: 0.7,
                                    tag: Active,
                                    volumes: [
                                        (
                                            // The jaws, out in front.
                                            shape: Rect(
                                                offset: (24.0, -2.0),
                                                half_extents: (18.0, 20.0),
                                            ),
                                            damage: 2,
                                            knockback: 220.0,
                                            knockback_growth: None,
                                            launch_dir: Some((1.0, -0.3)),
                                            reaction: None,
                                            on_hit: None,
                                            vfx: None,
                                            hit_sfx: None,
                                        ),
                                    ],
                                    motion_scale: 1.0,
                                    sustain_effect: None,
                                ),
                                (
                                    start_s: 0.7,
                                    end_s: 1.3,
                                    tag: Recovery,
                                    volumes: [],
                                    motion_scale: 0.0,
                                    sustain_effect: None,
                                ),
                            ],
                            events: [
                                // It drops into its crouch: the telegraph is
                                // read standing, not sliding in on its run.
                                (at_s: 0.0, kind: Impulse(local: (0.0, 0.0), mode: Set)),
                                (at_s: 0.0, kind: HoldVelocity(seconds: 0.35)),
                                // The spring: low and long, about 180 px.
                                (at_s: 0.35, kind: Impulse(local: (520.0, -220.0), mode: Set)),
                                (at_s: 0.35, kind: HoldVelocity(seconds: 0.35)),
                            ],
                            gates: (
                                grounded: Some(true),
                                recovery: r#None,
                                forbidden_while_held: false,
                                roots_steering: true,
                                recovery_route: None,
                                costs: [],
                                when_refused: None,
                            ),
                            start_impulse: None,
                            charge_mult: 1.0,
                            move_charge: None,
                            charge_gesture: Smash,
                            repeat: None,
                            landing_lag_s: None,
                            autocancel_after_s: None,
                            sprite_spin_hz: None,
                            equips: None,
                            flow: None,
                        ),
                    ],
                )),
            ),
        ),
    ],
)
