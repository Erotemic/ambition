// The source of the Failed Prototype's running attack. The game loads this file
// through the content pack (`assets/pack.ron`); edit it here.
//
// DESIGN NOTES
//
// Jon (2026-10-30): enemies that "notice, space, telegraph, attack" as Hollow
// Knight's do. The prototype (a stitched wolf-man) swipes standing
// (`striker_swipe`); coming in at a run it LURCHES: it rears back on its
// haunches with both claws out (0.4 s, its `windup` row), throws itself at
// the foe in a clumsy leap (0.4 s, about 170 px), and sprawls, open (0.7 s).
// The art is its `attack_side` row.
(
    schema_version: 1,
    entities: [
        (
            id: "npc_evil_failed_prototype",
            contracts: (
                body: None,
                hurtboxes: None,
                presentation: None,
                moveset: Some((
                    verbs: {
                        "attack_dash": "prototype_lurch",
                    },
                    moves: [
                        (
                            id: "prototype_lurch",
                            display_name: Some("Lurch"),
                            clip: (
                                clip: "attack_side",
                                fallbacks: [
                                    "slash",
                                    "idle",
                                ],
                            ),
                            duration_s: 1.5,
                            windows: [
                                (
                                    start_s: 0.0,
                                    end_s: 0.4,
                                    tag: Startup,
                                    volumes: [],
                                    motion_scale: 1.0,
                                    sustain_effect: None,
                                ),
                                (
                                    start_s: 0.4,
                                    end_s: 0.8,
                                    tag: Active,
                                    volumes: [
                                        (
                                            // Both claws, out in front.
                                            shape: Rect(
                                                offset: (24.0, -2.0),
                                                half_extents: (18.0, 20.0),
                                            ),
                                            damage: 2,
                                            knockback: 220.0,
                                            knockback_growth: None,
                                            launch_dir: Some((1.0, -0.3)),
                                            reaction: None,
                                            on_hit: None,
                                            vfx: None,
                                            hit_sfx: None,
                                        ),
                                    ],
                                    motion_scale: 1.0,
                                    sustain_effect: None,
                                ),
                                (
                                    start_s: 0.8,
                                    end_s: 1.5,
                                    tag: Recovery,
                                    volumes: [],
                                    motion_scale: 0.0,
                                    sustain_effect: None,
                                ),
                            ],
                            events: [
                                // It rears back: the telegraph is read standing,
                                // not sliding in on its run.
                                (at_s: 0.0, kind: Impulse(local: (0.0, 0.0), mode: Set)),
                                (at_s: 0.0, kind: HoldVelocity(seconds: 0.4)),
                                // The lurch: a clumsy leap, about 170 px.
                                (at_s: 0.4, kind: Impulse(local: (420.0, -300.0), mode: Set)),
                                (at_s: 0.4, kind: HoldVelocity(seconds: 0.4)),
                            ],
                            gates: (
                                grounded: Some(true),
                                recovery: r#None,
                                forbidden_while_held: false,
                                roots_steering: true,
                                recovery_route: None,
                                costs: [],
                                when_refused: None,
                            ),
                            start_impulse: None,
                            charge_mult: 1.0,
                            move_charge: None,
                            charge_gesture: Smash,
                            repeat: None,
                            landing_lag_s: None,
                            autocancel_after_s: None,
                            sprite_spin_hz: None,
                            equips: None,
                            flow: None,
                        ),
                    ],
                )),
            ),
        ),
    ],
)
