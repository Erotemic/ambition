// The source of the moves of `void_projectile_polygon`: the Projectile
// Polygon's table under its own name (`borrows`), so tuning the archetype
// tunes this fighter too.
//
// It is an enemy of Ambition's rooms, and Ambition is its home game: there
// damage is health, a tilt or an aerial deals 1 and a smash attack deals 3
// (`room_rules.ron`). The archetype's numbers are Smash percent, so `damage`
// states this fighter's own for every move that deals damage, by its own move
// id: each damaging volume, then each effect that states a damage (a throw, a
// pummel, a mine), then the shot it fires. The rule: a fifth of the
// archetype's percent, rounded, and at least 1. The frames, the reach and the
// knockback are the archetype's.
(
    schema_version: 1,
    entities: [
        (
            id: "void_projectile_polygon",
            contracts: (
                borrows: Some((
                    archetype: "projectile_polygon",
                    prefixes: [
                        "polygon_projectile",
                        "projectile_polygon",
                        "polygon",
                    ],
                    damage: {
                        "void_projectile_polygon_jab": [1],
                        "void_projectile_polygon_tilt_forward": [1],
                        "void_projectile_polygon_tilt_up": [1],
                        "void_projectile_polygon_tilt_down": [1],
                        "void_projectile_polygon_dash_attack": [2],
                        "void_projectile_polygon_smash_forward": [3],
                        "void_projectile_polygon_smash_up": [3],
                        // The stomp, then the mine it leaves.
                        "void_projectile_polygon_smash_down": [3, 2],
                        "void_projectile_polygon_air_neutral": [1],
                        "void_projectile_polygon_air_forward": [2],
                        "void_projectile_polygon_air_back": [2],
                        "void_projectile_polygon_air_up": [2],
                        "void_projectile_polygon_air_down": [2],
                        "void_projectile_polygon_recoil_lift": [2],
                        "void_projectile_polygon_downward_vector": [2],
                        // The shot: its cannon's tap, which a full charge triples.
                        "void_projectile_polygon_charge_shot": [1],
                        // The thrown tail.
                        "void_projectile_polygon_ponytail_boomerang": [1],
                        // The bomb's blast.
                        "void_projectile_polygon_lay_bomb": [2],
                        // The grab: the pummel, then each throw.
                        "void_projectile_polygon_pummel": [1],
                        "void_projectile_polygon_throw_forward": [2],
                        "void_projectile_polygon_throw_back": [2],
                        "void_projectile_polygon_throw_up": [2],
                        "void_projectile_polygon_throw_down": [1],
                    },
                )),
            ),
        ),
    ],
)
