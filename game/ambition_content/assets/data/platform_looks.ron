// How a moving platform drawn as a prop sheet is laid on its platform (schema
// `platform_looks`, owned by the sprite capability), by the platform's
// `visual` kind. The numbers are frame pixels of the full-size sheet:
// `frame_px` is the frame, `span_px` the part of its width the platform's
// width covers (left, right), and `top_px` the row of its top surface.
// `row` is the row the sheet loops; `front_row` a row drawn in front of each
// body; `sheet` the sheet when it is not the kind's own; `faces_right`
// (default true) the way the art faces. The compiler refuses a span or a top
// outside the frame. An edit here is drawn after a content reload, with no
// Rust build.
{
    // The Art dimension's palette lifts: the top of the palette IS the
    // platform (`targets/props/art_props.py`: `PALETTE_FRAME`,
    // `PALETTE_SPAN`, `PALETTE_TOP`).
    "art_palette_lift": (row: "idle", frame_px: (192.0, 64.0), span_px: (16.0, 176.0), top_px: 20.0),
    // The art dimension's brush seesaw and crayon rail: the top of the brush,
    // and of the crayon, is the platform (`targets/props/art_studio_props.py`:
    // `SEESAW_*`, `CRAYON_*`).
    "art_brush_seesaw": (row: "idle", frame_px: (384.0, 64.0), span_px: (16.0, 368.0), top_px: 22.0),
    "art_crayon_rail": (row: "idle", frame_px: (320.0, 64.0), span_px: (16.0, 304.0), top_px: 18.0),
    // The History dimension's felucca: the top of its deck IS the platform;
    // the sail rises over it (`targets/props/history_nile_props.py`:
    // `FELUCCA_FRAME`, `FELUCCA_SPAN`, `FELUCCA_TOP`).
    "history_felucca": (row: "idle", frame_px: (320.0, 192.0), span_px: (16.0, 304.0), top_px: 150.0),
    // The Silk Road's camel caravan: the top of the roll of carpet across the
    // two camels' packs is the platform (`targets/props/history_silk_props.py`:
    // `CARAVAN_FRAME`, `CARAVAN_SPAN`, `CARAVAN_TOP`). Its `idle` row walks
    // the camels; the carpet stays level.
    "history_camel_caravan": (row: "idle", frame_px: (320.0, 192.0), span_px: (16.0, 304.0), top_px: 70.0),
    // The History dimension's dhow on the Monsoon Coast: the top of its deck
    // IS the platform; its lateen sail rises over the deck
    // (`targets/props/history_monsoon_props.py`: `DHOW_FRAME`, `DHOW_SPAN`,
    // `DHOW_TOP`).
    "history_dhow": (row: "idle", frame_px: (320.0, 192.0), span_px: (16.0, 304.0), top_px: 150.0),
    // The History dimension's ship's boom and rail wagon: the top of the
    // furled sail on the boom, and the bed of the wagon, is the platform
    // (`targets/props/history_sail_props.py`: `BOOM_*`;
    // `targets/props/history_industrial_props.py`: `WAGON_*`). The boom turns
    // on its middle, as the brush seesaw does.
    "history_ship_boom": (row: "idle", frame_px: (384.0, 64.0), span_px: (16.0, 368.0), top_px: 22.0),
    "history_rail_wagon": (row: "idle", frame_px: (320.0, 96.0), span_px: (16.0, 304.0), top_px: 30.0),
    // The History dimension's reed boat (second pass): the top of its deck of
    // bound reed bundles IS the platform; the curled prow and stern rise over
    // it (`targets/props/history_africa_props.py`: `REED_BOAT_FRAME`,
    // `REED_BOAT_SPAN`, `REED_BOAT_TOP`).
    "history_reed_boat": (row: "idle", frame_px: (320.0, 192.0), span_px: (16.0, 304.0), top_px: 150.0),
    // The History dimension's longship: the top of its deck IS the platform;
    // the striped sail rises over it (`targets/props/history_europe_props.py`:
    // `LONGSHIP_FRAME`, `LONGSHIP_SPAN`, `LONGSHIP_TOP`).
    "history_longship": (row: "idle", frame_px: (384.0, 192.0), span_px: (16.0, 368.0), top_px: 150.0),
    // The History dimension's bamboo raft: the top of its deck is the
    // platform (`targets/props/history_americas_oceania_props.py`: `RAFT_*`).
    "history_bamboo_raft": (row: "idle", frame_px: (320.0, 96.0), span_px: (16.0, 304.0), top_px: 40.0),
    // The History dimension's dugout canoe (third pass): the top of its sides
    // IS the platform; its blunt bow and stern rise a little over it
    // (`targets/props/history_americas_east_props.py`: `CANOE_FRAME`,
    // `CANOE_SPAN`, `CANOE_TOP`).
    "history_dugout_canoe": (row: "idle", frame_px: (384.0, 128.0), span_px: (16.0, 368.0), top_px: 72.0),
    // The History dimension's outrigger canoe and voyaging canoe (third
    // pass): the top of the outrigger's gunwale, and of the deck between the
    // two hulls of the voyaging canoe, IS the platform; the crab-claw sails
    // rise over them (`targets/props/history_oceania_east_props.py`:
    // `OUTRIGGER_*`, `VOYAGING_*`).
    "history_outrigger_canoe": (row: "idle", frame_px: (384.0, 192.0), span_px: (16.0, 368.0), top_px: 140.0),
    "history_voyaging_canoe": (row: "idle", frame_px: (448.0, 256.0), span_px: (16.0, 432.0), top_px: 196.0),
    // The jong of Srivijaya (wave C2): the top of its plank deck IS the
    // platform; the matting sails and the thatched deckhouse rise over it
    // (`targets/props/history_southeast_asia_props.py`: `JONG_SPAN`, `JONG_TOP`).
    "history_jong": (row: "idle", frame_px: (448.0, 224.0), span_px: (24.0, 424.0), top_px: 132.0),
    // The walking moai: the top of its red pukao is the platform
    // (`WALKING_*`). Its `idle` row rocks the moai from side to side on its
    // ropes; the pukao stays level.
    "history_walking_moai": (row: "idle", frame_px: (192.0, 384.0), span_px: (56.0, 136.0), top_px: 36.0),
    // Native marble tiles form the haunted wing's floors and ledges.
    "hylbert_floor_strip": (row: "idle", frame_px: (128.0, 32.0), span_px: (0.0, 128.0), top_px: 0.0),
    // The orbital station's spoke tram: its floor IS the platform. The
    // numbers are the art module's (`targets/props/orbital_station.py`:
    // `TRAM_FLOOR_SPAN`, `TRAM_FLOOR_Y`, `MARGIN` 6, `PX` 2).
    "orbital_tram": (row: "idle", frame_px: (472.0, 248.0), span_px: (44.0, 428.0), top_px: 188.0),
    // The Eureka tether's car: its floor is the platform. Px 2 of the art's
    // `CAR_FRAME` (-24, -150)..(152, 40) and `CAR_SPAN` 0..128 at y 0
    // (`targets/props/eureka_tether_props.py`).
    "eureka_tether_car": (row: "idle", frame_px: (352.0, 380.0), span_px: (48.0, 304.0), top_px: 300.0),
    // The Mockingbird's burning shark: the platform is its back, behind the
    // saddle (`burning_flying_shark_spritesheet.ron`: body box 9..194, back
    // at row 60), from the tail fin to the head.
    "burning_flying_shark": (row: "idle", frame_px: (217.0, 125.0), span_px: (40.0, 176.0), top_px: 60.0),
    // The intro's cart: its bed IS the platform. The numbers are the art
    // module's (`targets/props/intro_cart.py`: `FRAME_SIZE`, `BED_SPAN_PX`,
    // `BED_TOP_PX`). Its near rail (`front`) is drawn in front of each body,
    // so a body on the bed is in the cart.
    "intro_cart": (
        row: "idle",
        frame_px: (960.0, 312.0),
        span_px: (108.0, 636.0),
        top_px: 126.0,
        front_row: Some("front"),
    ),
    // The first step of the cart's ramp: the row `ramp` of the cart's sheet
    // (`RAMP_STEP_SPAN_PX`, `RAMP_STEP_TOP_PX`). It starts where the bed
    // ends, one step under it; the other steps have no picture.
    "intro_cart_ramp": (
        sheet: Some("intro_cart"),
        row: "ramp",
        frame_px: (960.0, 312.0),
        span_px: (636.0, 657.0),
        top_px: 138.0,
    ),
}
