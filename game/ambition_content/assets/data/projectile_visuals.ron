        debug_tint: (0.38, 0.84, 0.99, 1.0),
        label: "polygon_charge_shot_tier5",
        expiry_vfx: None,
    ),
    // The Hunny Horror's red balloon: he rises on it, lets go, and it floats
    // on to pop on the ceiling. From its sheet, which keeps the picture's
    // shape (an `Image` is drawn square).
    "red_balloon": (
        source: Sheet(
            target: "red_balloon",
            animation: "idle",
            animate: false,
        ),
        size: FixedWidth(56.0),
        rotation: GravityUpright,
        debug_tint: (0.84, 0.12, 0.16, 1.0),
        label: "red_balloon",
        expiry_vfx: None,
    ),
    // The dilophosaurus's spit: a glob of venom, with drops behind it.
    "spit": (
        source: Sheet(
            target: "shot_kit",
            animation: "spit",
            animate: true,
        ),
        size: BodyWidth(
            scale: 2.05,
        ),
        rotation: VelocityAligned,
        debug_tint: (0.62, 0.84, 0.2, 1.0),
        label: "spit",
        expiry_vfx: Some((
            fx: "classic_burst",
            scale: 0.4,
        )),
    ),
    // The thrown rock of the plain ranged styles: it tumbles in its row and is
    // not turned to its flight.
    "thrown_rock": (
        source: Sheet(
            target: "shot_kit",
            animation: "rock",
            animate: true,
        ),
        size: BodyWidth(
            scale: 1.45,
        ),
        rotation: FlipToTravel,
        debug_tint: (0.55, 0.5, 0.45, 1.0),
        label: "rock",
        expiry_vfx: None,
    ),
    // The Tyrant King's falling rock: a chunk of his arena's ceiling, shaken
    // loose by a stomp, a landing or a crash. Upright: it falls, it does not
    // fly.
    "trex_rock": (
        source: Image(
            path: "sprites/trex_rock.png",
        ),
        size: Body(
            min: 10.0,
            scale: 1.2,
        ),
        rotation: GravityUpright,
        debug_tint: (0.5, 0.44, 0.4, 1.0),
