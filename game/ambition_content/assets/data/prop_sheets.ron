// The prop sheets this game draws (schema `prop_sheets`, owned by the sprite
// capability), by the `kind` a room's prop names. A row draws the sheet
// record `sheet` (default: the record of its kind) from that record's page,
// with the rest of the art. `scale` multiplies the prop's box to give the
// size it is drawn at (default 1.0); `frame_sample_inset` trims that many
// pixels from each frame's edges (default 0); `packed: true` draws it from
// the shared sprite pack first, at the quality tier of the game. A prop whose
// kind has no row is not drawn from a sheet. An edit here is drawn at the next
// start or content reload, with no Rust build.
{
    // The Noodly Temple's keys, one for each sauce. A key is drawn a little
    // larger than its box, as a pickup is.
    "temple_key_marinara": (scale: 1.4),
    "temple_key_pesto": (scale: 1.4),
    "temple_key_parmesan": (scale: 1.4),
    "temple_key_colander": (scale: 1.4),
    // The doors that the keys open. A door fills the box of its wall.
    "temple_gate_marinara": (),
    "temple_gate_pesto": (),
    "temple_gate_parmesan": (),
    "temple_gate_colander": (),
    // The doors that no key opens: the grille of a fight, the gates of the
    // cistern (by the number of the wheel; `_shut` is a gate its wheel
    // shuts) and the seal of a bell.
    "temple_gate_iron": (),
    "temple_gate_wheel_1": (),
    "temple_gate_wheel_2": (),
    "temple_gate_wheel_3": (),
    "temple_gate_wheel_1_shut": (),
    "temple_gate_bell": (),
    // The Math town. The cradle is the stand a gate ring sits in: a plinth
    // with stairs at each end (walked on zero-speed one-way platforms the
    // room places) and two pylons that hold the ring. The house fronts
    // (`targets/props/math_town_facades.py`) are decoration; a balcony or roof
    // a body can stand on is a one-way platform the room places where the
    // art draws it.
    "gate_cradle": (),
    "math_house_rose": (),
    "math_house_dome": (),
    "math_house_tower": (),
    "math_house_shop": (),
    "math_house_arcade": (),
    "math_house_gable": (),
    "math_house_flat": (),
    "math_observatory": (),
    // The terraces (`targets/props/math_town_terraces.py`): the aqueduct's
    // spans (its deck is a still platform the room places), the stair (a
    // still platform under each tread), the passage under the first terrace,
    // homes in the rock, and trees.
    "math_aqueduct_span_street": (),
    "math_aqueduct_span_t1": (),
    "math_aqueduct_span_t2": (),
    "math_switchback_stair": (),
    "math_tunnel_bay": (),
    "math_tunnel_mouth": (),
    "math_tunnel_gate": (),
    "math_cliff_home_wide": (),
    "math_cliff_home_narrow": (),
    "math_cypress": (),
    "math_olive": (),
    // Inside the town's houses (`targets/props/math_town_interiors.py`): the
    // cafe, the Surveyor's Office, the Observatory. All are decoration; where
    // the art draws a top to stand on, the room places a still platform.
    "math_cafe_counter": (),
    "math_cafe_menu": (),
    "math_cafe_table": (),
    "math_cafe_shelf": (),
    "math_cafe_window": (),
    "math_cafe_lamps": (),
    "math_office_map": (),
    "math_office_drafting": (),
    "math_office_cabinet": (),
    "math_office_theodolite": (),
    "math_office_gallery": (),
    "math_obs_dome": (),
    "math_obs_telescope": (),
    "math_obs_platform": (),
    "math_obs_chart": (),
    "math_obs_desk": (),
    // The orbital station of the Science dimension: its ships, its freight
    // and the fittings of its decks. The quarantine gate and the spur hatch
    // are the looks of two lock walls, and fill their walls' boxes.
    "orbital_hauler": (),
    "orbital_shuttle": (),
    "orbital_freight_stack": (),
    "orbital_consignment": (),
    "orbital_conveyor": (),
    "orbital_customs_desk": (),
    "orbital_manifest_board": (),
    "orbital_quarantine_gate": (),
    "orbital_spur_hatch": (),
    "orbital_bunks": (),
    "orbital_galley": (),
    "orbital_hydroponics": (),
    "orbital_machinery": (),
    "orbital_bench": (),
    // The spoke's tram car: the sheet of a moving platform (`platform_looks.ron`).
    "orbital_tram": (),
    // Castle Godwin of the Evil dimension (`targets/props/castle_godwin.py`):
    // the front of the castle (the room's door is put over its doorway), the
    // sign at the road, and the thorns at its foot. All are decoration.
    "castle_godwin_entrance": (),
    "castle_godwin_sign": (),
    "evil_thorn_bush": (),
    // The dressing of Castle Godwin's rooms
    // (`targets/props/castle_godwin_dressing.py`), all decoration: the guard
    // post, posters (a wanted robot and the regime's three), a searchlight,
    // a bunk bed (its mattresses are where the barracks' one-way bunks are),
    // lockers, a mess table, the rally podium; in the lab Tesla coils and
    // specimen vats (both play their `idle` rows) and the operating table;
    // and Wolfenstein's iron throne.
    "castle_guard_post": (),
    "castle_wanted_poster": (),
    "castle_propaganda_poster_a": (),
    "castle_propaganda_poster_b": (),
    "castle_propaganda_poster_c": (),
    "castle_searchlight": (),
    "castle_bunk_bed": (),
    "castle_locker_row": (),
    "castle_mess_table": (),
    "castle_rally_podium": (),
    "castle_tesla_coil": (),
    "castle_specimen_vat": (),
    "castle_operating_table": (),
    "castle_iron_throne": (),
    // The old drain under Castle Godwin: its cracked wall and the cracked
    // floor over its mouth (`LockWall` looks: each fills its wall's box), and
    // the breach left when either is broken through.
    "castle_cracked_wall": (),
    "castle_cracked_floor": (),
    "castle_cracked_niche": (),
    "castle_drain_breach": (),
    // Primeval's palm.
    "coconut_palm": (),
    // The mockingbird's shark, which is also a moving platform.
    "burning_flying_shark": (),
    // The intro rooms. The cart of the wake room is drawn from the shared
    // sprite pack first (`packed`), at the quality tier of the game. A row's
    // `sheet` names its record where the record is not its kind: the creator
    // lab's props are records of one sheet.
    "intro_cart": (frame_sample_inset: 2, packed: true),
    "lab_genesis_vat": (sheet: Some("genesis_vat"), frame_sample_inset: 2),
    "lab_neural_console": (sheet: Some("neural_console"), frame_sample_inset: 2),
    "lab_power_core": (sheet: Some("power_core"), frame_sample_inset: 2),
    "lab_repair_cradle": (sheet: Some("repair_cradle"), frame_sample_inset: 2),
    "lab_resonance_coil": (sheet: Some("resonance_coil"), frame_sample_inset: 2),
    // The cut-rope arena.
    "cut_rope_rope": (frame_sample_inset: 2),
    "cut_rope_anvil": (frame_sample_inset: 2),
    "cut_rope_piano": (frame_sample_inset: 2),
    // The interdimensional gate: its ring and its portal surface.
    // The fittings of a gate of the gate network: the dialer beside each
    // ring, its power, the traffic board, the bags for organic travellers.
    "gate_dialer": (),
    "gate_power_cabinet": (),
    "gate_traffic_board": (),
    "gate_transit_bags": (),
    "gate_ring": (sheet: Some("interdimensional_gate_ring"), frame_sample_inset: 2),
    "gate_portal": (sheet: Some("interdimensional_gate_portal"), frame_sample_inset: 2),
    // A ring's glyphs ablaze, one frame per chevron, laid over the ring as
    // they are dialed (`gate_portal_visuals::sync_ring_lit_glyphs`).
    "gate_glyphs": (sheet: Some("interdimensional_gate_glyphs"), frame_sample_inset: 2),
    // The Pirate Port's scenery (`targets/props/pirate_port_props.py`): each
    // piece is drawn in its room's coordinates, over the room's walk lines.
    // The clerk's page is the pickup of the port's problem: drawn a little
    // larger than its box, as a pickup is.
    "port_harbour_house": (),
    "port_freight_booth": (),
    "port_lamp_post": (),
    "port_waterfront_west": (),
    "port_waterfront_middle": (),
    "port_tavern_front": (),
    "port_waterfront_stair": (),
    "port_chandler_stall": (),
    "port_chandlery": (),
    "port_net_loft": (),
    "port_tavern_room": (),
    "port_warehouse": (),
    "port_gantry": (),
    "port_brig": (),
    "port_dock_clutter": (),
    "port_manifest_page": (scale: 1.4),
    // The General's tower inside, one floor each (`targets/props/
    // military_tower_props.py`): drawn in the room's coordinates, deck to deck.
    "tower_parade_deck": (),
    "tower_barracks": (),
    "tower_armory": (),
    "tower_signals": (),
    "tower_war_room": (),
    // The Ninja Village's scenery (`targets/props/ninja_village_props.py`).
    "village_shrine_stair": (),
    "village_torii": (),
    "village_shrine_hall": (),
    "village_shrine_small_things": (),
    "village_house_baker": (),
    "village_house_weaver": (),
    "village_tea_house": (),
    "village_dojo_front": (),
    "village_storehouse": (),
    "village_notice_board": (),
    "village_watch_house": (),
    "village_cedar_0": (),
    "village_cedar_1": (),
    "village_cedar_2": (),
    "village_cedar_3": (),
    "village_cedar_4": (),
    "village_cedar_5": (),
    "village_cedar_6": (),
    "village_clan_gatehouse": (),
    "village_dojo_entry": (),
    "village_dojo_exam": (),
    // Eureka: the Patent Office and the observatory, outside and in.
    "eureka_patent_front": (),
    "eureka_observatory_front": (),
    "eureka_patent_room": (),
    "eureka_observatory_room": (),
    "eureka_lab_room": (),
    // The Pirate Cove (PvN).
    "cove_cave": (),
    "cove_ledges": (),
    "cove_doorways": (),
    "cove_dressing": (),
    // Zeno's Aqueduct (Math, out of town).
    "math_zeno_aqueduct": (),
    "math_zeno_reservoir": (),
    // The jungle: the Tyrant King's hall.
    "primeval_tyrant_hall_room": (),
    // Hylbert's Hotel (Math).
    "math_hotel_entrance": (),
    "math_hotel_lobby_room": (),
    "math_hotel_corridor_room": (),
    // The Evil dimension's forest road.
    "evil_forest_roadside": (),
}
