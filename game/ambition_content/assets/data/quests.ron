// Ambition's quests, schema `quest_book` (owned by the quest capability,
// `ambition_persistence::quest::content_schema`).
//
// Each quest is an id (the save and the registry key it verbatim), a title and
// a summary for the quest log, ordered steps, and `auto_start` (the quest
// starts when the registry starts). A step advances on one event:
// NpcTalked, ItemCollected, BossDefeated, EncounterCleared, FlagSet or
// RoomEntered, each with the id it must match. An NPC conversation sets the
// flag `npc_<dialogue id>_talked`.
//
// `reward` (optional) is what the quest pays when it completes: a banner and
// items by their `dialog_id` in `items.ron`. The payout is taken back if the
// quest stops being complete, and the save flag `<id>_reward_granted` pays it
// once.
//
// The compiler refuses a quest with no steps, two quests with one id, a
// condition with an empty id, and a reward item that `items.ron` does not
// have. Content validation checks the boss, encounter
// and room ids against the shipped worlds.
[
    // A tutorial: talk to a hub NPC, clear the goblin encounter, defeat the prototype boss.
    (
        id: "first_steps",
        title: "First Steps",
        summary: "Find your bearings as a new instance.",
        steps: [
            (
                description: "Speak with someone in the hub.",
                condition: FlagSet("met_any_hub_npc"),
            ),
            (
                description: "Clear the goblin encounter.",
                condition: EncounterCleared("goblin_encounter"),
            ),
            (
                description: "Defeat the clockwork warden.",
                condition: BossDefeated("clockwork_warden"),
            ),
        ],
        auto_start: true,
    ),
    // Proves the world remembers a switch the player toggled.
    (
        id: "test_switch_quest",
        title: "Test the Memory",
        summary: "Verify that the world remembers what you do.",
        steps: [
            (
                description: "Toggle the persistence test switch.",
                condition: FlagSet("test_switch_toggled"),
            ),
        ],
        auto_start: true,
    ),
    // The quest lab proof: a RoomEntered quest. It advances when the player enters
    // quest_lab and completes when they walk back to the basement.
    (
        id: "quest_lab_visit",
        title: "Visit the Quest Lab",
        summary: "Walk into the quest lab and back to verify quest progression.",
        steps: [
            (
                description: "Enter the quest lab from the basement door.",
                condition: RoomEntered("quest_lab"),
            ),
            (
                description: "Return to the basement.",
                condition: RoomEntered("central_hub_complex"),
            ),
        ],
        auto_start: true,
    ),
    // The cove's hoard was stolen by a mockingbird. The step order is the minimum
    // sequence: the chest exists only when the bird is dead, so returning it to
    // the admiral cannot come first. Talking to the admiral first does not match
    // step 0, and the quest stays where it is.
    (
        id: "pirate_treasure",
        title: "The Plundered Hoard",
        summary: "A mockingbird looted the pirate cove. Bring the chest back.",
        steps: [
            (
                description: "Hunt the mockingbird and reclaim the chest.",
                condition: BossDefeated("mockingbird"),
            ),
            (
                description: "Return the treasure to the pirate admiral.",
                condition: FlagSet("npc_pirate_admiral_talked"),
            ),
        ],
        auto_start: true,
        // The admiral pays out the hoard.
        reward: Some((
            banner: "TREASURE RETURNED — Admiral pays out the hoard",
            items: [
                (item: "healthcell", count: 3),
                (item: "sparebattery", count: 2),
                (item: "manacell", count: 1),
            ],
        )),
    ),
    // The orbital station of the Science dimension (gate address GALACTIC):
    // consignment 0447. Customs holds a crate from the Math town whose count
    // is "aleph-null"; Georg Canter signs a finite one; customs clears it
    // (the freight lane's gates open, and the hatch of the damaged spur);
    // then home to the hub. The flags are set in `orbital.yarn` and
    // `math.yarn`.
    (
        id: "orbital_consignment",
        title: "Consignment 0447",
        summary: "Station customs holds a crate of survey lenses whose manifest counts them as infinite.",
        steps: [
            (
                description: "Ask Officer Okafor at the station's customs desk about crate 0447.",
                condition: FlagSet("orbital_consignment_query"),
            ),
            (
                description: "Get a finite count signed at the Surveyor's Office in the Math town.",
                condition: FlagSet("orbital_manifest_signed"),
            ),
            (
                description: "Bring the signed count back to Officer Okafor.",
                condition: FlagSet("orbital_consignment_cleared"),
            ),
            (
                description: "Go home to the hub.",
                condition: RoomEntered("central_hub_complex"),
            ),
        ],
        auto_start: true,
        reward: Some((
            banner: "CONSIGNMENT 0447 CLEARED — the Remainder pays its freight fee",
            items: [
                (item: "sparebattery", count: 1),
                (item: "healthcell", count: 2),
            ],
        )),
    ),
    // Level 1 (`docs/planning/game/level-1.md`): Alice and Bob are mid-traverse
    // under the Drain Market. Alice's talk sets the first flag, Bob's hand-over
    // the second; the third is the notebooks in the freight yard.
    (
        id: "intro_cartography_route",
        title: "A Message for Bob",
        summary: "Alice is surveying the hills above Hobford. Bob, the other surveyor, is camped in the woods on the goblins' trail and does not know they are here.",
        steps: [
            (
                description: "Say you'll take Alice's message.",
                condition: FlagSet("alice_route_note_carried"),
            ),
            (
                description: "Tell Bob, in the woods past Hobford, to move his camp.",
                condition: FlagSet("bob_field_survey_received"),
            ),
            (
                description: "Tell Alice that Bob is moving.",
                condition: FlagSet("alice_heard_bob_moved"),
            ),
        ],
        auto_start: true,
    ),
    // Level 1: the case the goblins took from the Creator's bench. It is in
    // their crate at the freight siding.
    (
        id: "intro_creator_case",
        title: "The Creator's Case",
        summary: "The goblins took the Creator's case off his bench. Scout's logs are in it.",
        steps: [
            (
                description: "Get the case back from the goblins.",
                condition: FlagSet("intro_creator_notes_recovered"),
            ),
        ],
        auto_start: true,
    ),
    // Intro v1: the first system boss clear, a separate quest so the boss kill is
    // its own durable record (the first_system_boss room reuses clockwork_warden).
    (
        id: "intro_first_system_boss",
        title: "Capstone: First System",
        summary: "Reach the system boss at the end of the gate stack and clear it.",
        steps: [
            (
                description: "Defeat the system boss (clockwork_warden brain).",
                condition: BossDefeated("clockwork_warden"),
            ),
        ],
        auto_start: true,
    ),
    // The Pirate Port (gate address SAILING): the wind took a page of the dock
    // clerk's freight log to the crow's nest of the brig. Pick it up there
    // (the PickupSpawn's flag) and hand it back to Ines (her talk sets the
    // second flag).
    (
        id: "pirate_port_lost_manifest",
        title: "Page Eleven",
        summary: "The wind took a page of the Pirate Port's freight log to the brig's crow's nest.",
        steps: [
            (
                description: "Find the page in the crow's nest of the brig at the docks.",
                condition: FlagSet("pirate_port_manifest_found"),
            ),
            (
                description: "Give the page back to Ines, the dock clerk.",
                condition: FlagSet("pirate_port_manifest_returned"),
            ),
        ],
        auto_start: true,
        reward: Some((
            banner: "PAGE ELEVEN RETURNED — Ines pays from the clerk's tin",
            items: [
                (item: "manacell", count: 2),
                (item: "healthcell", count: 1),
            ],
        )),
    ),
    // The Ninja Village (gate address SILENT): the dojo's rank exam. Clear
    // the exam floor (the dummies, then the examiner), then report to the
    // teacher (his talk sets the flag).
    (
        id: "ninja_village_rank_exam",
        title: "The Rank Exam",
        summary: "The village dojo tests every applicant. The form does not say the applicant must be a person.",
        steps: [
            (
                description: "Pass the rank exam on the village dojo's exam floor.",
                condition: EncounterCleared("ninja_village.rank_exam"),
            ),
            (
                description: "Report to Sensei Hayashi.",
                condition: FlagSet("ninja_village_rank_awarded"),
            ),
        ],
        auto_start: true,
        reward: Some((
            banner: "RANK AWARDED — stamped, counter-stamped and filed",
            items: [
                (item: "manacell", count: 2),
                (item: "healthcell", count: 1),
            ],
        )),
    ),
]
