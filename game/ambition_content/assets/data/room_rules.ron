// The rules of Ambition's own rooms (schema `room_rules`).
// An absent field declares no rule, and the engine's answer applies.
(
    // A death holds for its beat, then the level goes back when no
    // participant remains (Jon, 2026-11-12: "We need there to be presentation
    // of the players death"). Long enough for the death row and the rescue's
    // effect to read; Mary-O's beat is the length of her death music.
    replay_level_after_death_s: Some(1.0),
    // The rescue (Q174's default: "You're too valuable to be destroyed"): the
    // body is taken away in a dissolve of code where it fell, and assembles
    // where it comes back.
    death_look: Some((departure: "digital_departure", arrival: "digital_arrival")),
    // A participant that falls while a partner plays waits this long before
    // it comes back, so a partner who falls in that time makes a full-party
    // wipe (COOP-RECOVERY). Alone, it comes back at once.
    recovery_wait_s: Some(2.0),
    // Damage here is health: ordinary tilts and aerials deal 1, and a smash
    // attack deals 3. A hit of 3 or more lands heavy.
    heavy_hit_damage: Some(3),
    // A move's landing lag is written for a platform fighter, where a missed
    // aerial costs its owner (the robot's down air owes 0.28 s). In Ambition a
    // body that lands moves again at once (Jon, 2026-10-12: "landing lag should
    // be significantly lowered"). A quarter leaves the down air 0.07 s.
    landing_lag_share: Some(0.25),
    // How near an observer must be for a roaming hostile to keep thinking.
    // Derived from the controlled body's fastest repeated traversal (blink),
    // not its run speed, with about 2.4 s of lead. It is a rule of observer
    // motion: do not tune it down to make dormancy occur in today's room sizes.
    hostile_wake_radius: Some(2560.0),
    // A dead body stays where it fell, on the last frame of its death row
    // (Jon, 2026-10-18: "bodies persist by default unless they explicitly
    // don't"). A body that is taken away by its own death states `Vanish`.
    corpses: Some(Stay),
    // A hit answers (Jon, 2026-11-12: "We need hits to feel more responsive").
    // The engine's freeze is a share of a platform fighter's (calibrated on 11
    // damage), so every Ambition hit (1 to 3) got its floor, 0.036 s, and no
    // shake. Here an ordinary hit holds both bodies 0.075 s and a heavy one
    // (3) 0.105 s, which also shakes the view a little; and a body that lands
    // a melee hit in the air is pushed back from it.
    hit_feel: Some((
        hitlag: Some(Affine(base_s: 0.06, per_damage_s: 0.015, max_s: 0.15)),
        attacker_recoil: 110.0,
    )),
    // A kill lands: the world holds still a twelfth of a second past the
    // blow, and the screen shakes a little (Jon, 2026-10-18: playing through
    // a level was not satisfying).
    kill_beat: Some((freeze_s: 0.083, shake_px: 4.0)),
    // The robot's fireball flies as Mario's does (Jon, 2026-10-24: "The
    // fireball should feel like a mario fireball in terms of how it
    // bounces"). Super Mario Bros.' numbers, at 60 frames a second, scaled by
    // 1.5 (big Mario is 32 px tall, the robot 48): forward 4 px a frame, down
    // 3 px a frame from the hand, gravity 0.3125 px a frame squared, and each
    // hop off the floor at 3 px a frame. So it falls to the floor 30 to 40 px
    // out and hops 22 px high (its top 40 px up), under the head of a body the
    // robot's height, for 1.2 s: about 430 px. A wall, the ninth floor or the
    // end of its time puts it out.
    fireball: Some((
        speed: 360.0,
        launch_drop: 270.0,
        gravity: 1688.0,
        hop_speed: 270.0,
        bounces: 8,
        lifetime_s: 1.2,
    )),
)
