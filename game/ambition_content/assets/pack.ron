// Ambition's own content pack.
//
// The manifest is the pack's EXPLICIT source list — not a directory glob.
// A glob would make the pack's contents depend on filesystem enumeration order
// and on whatever a tool happened to leave in the tree, which is the opposite
// of a fingerprint that means something. Adding content is one line here, and
// that line is also where the file's schema is declared, so a content file
// never has to carry a header and its existing shape survives migration
// unchanged.
//
// Validate without rebuilding Rust (the content CLI, with Ambition's own
// schemas beside the engine's):
//
//     cargo run -p ambition_content_schemas --bin ambition_content_check -- \
//         game/ambition_content/assets
//
// The binary is built ONCE. After that, editing any file listed below and
// re-running it costs milliseconds — that is the whole point, and
// `validating_a_character_edit_does_not_rebuild_rust` in
// crates/ambition_content_cli/tests/ is what keeps it true.
(
    id: "ambition",
    version: "0.1.0",
    // Every identity this pack mints is `ambition:<schema>/<name>`. A third
    // party's cast can define its own `goblin` without colliding.
    namespace: "ambition",
    // Capabilities the content cannot work without, beyond the ones its
    // schemas' owners bring. Empty is honest today: the only migrated family is
    // the character catalog, whose owner (`characters`) is implied by the
    // schema. This grows as families migrate.
    requires: [],
    sources: [
        (path: "data/character_catalog.ron", schema: "character_catalog", version: 1),
        (path: "data/items.ron", schema: "item_catalog", version: 1),
        (path: "data/quests.ron", schema: "quest_book", version: 1),
        // Several files, one library: the schema merges them in this order.
        (path: "data/cutscenes/sandbox.ron", schema: "cutscene_library", version: 1),
        (path: "data/cutscenes/intro.ron", schema: "cutscene_library", version: 1),
        // ⭐⭐ EVERY MOVE TABLE THIS PROVIDER AUTHORS IS CONTENT, NOT CODE
        // (fast-iteration I2, step 5). No `authored/*.rs` and no robot lineage
        // code compiles a moveset into the host any more;
        // `character_catalog::authored_intrinsics` takes each one from the pack.
        // These files are the source: edit them.
        //
        // ⛔ THE FILE IS NAMED FOR THE TABLE AND KEYED BY THE CHARACTER, and
        // those are often not the same string: `alice.ron` carries the entity
        // `npc_alice`, and `player_robot.ron` carries TWO. The entity ids in
        // each document are the mapping. A fighter drawn on an archetype's rig
        // `borrows` the archetype's table (`director.ron`).
        (path: "data/movesets/alice.ron", schema: "moveset", version: 1),
        (path: "data/movesets/bob.ron", schema: "moveset", version: 1),
        (path: "data/movesets/carl_stargan.ron", schema: "moveset", version: 1),
        (path: "data/movesets/cellular_automaton.ron", schema: "moveset", version: 1),
        (path: "data/movesets/director.ron", schema: "moveset", version: 1),
        (path: "data/movesets/emmy_noether.ron", schema: "moveset", version: 1),
        (path: "data/movesets/gnu_ton.ron", schema: "moveset", version: 1),
        (path: "data/movesets/goblin.ron", schema: "moveset", version: 1),
        (path: "data/movesets/imperfect_cellular_automaton.ron", schema: "moveset", version: 1),
        (path: "data/movesets/medic.ron", schema: "moveset", version: 1),
        (path: "data/movesets/ninja_shadow_oni_leader.ron", schema: "moveset", version: 1),
        (path: "data/movesets/officer.ron", schema: "moveset", version: 1),
        (path: "data/movesets/oiler.ron", schema: "moveset", version: 1),
        (path: "data/movesets/patent_clerk.ron", schema: "moveset", version: 1),
        (path: "data/movesets/performer.ron", schema: "moveset", version: 1),
        (path: "data/movesets/pirate_admiral.ron", schema: "moveset", version: 1),
        (path: "data/movesets/player_robot.ron", schema: "moveset", version: 1),
        (path: "data/movesets/pointed_polygon.ron", schema: "moveset", version: 1),
        (path: "data/movesets/projectile_polygon.ron", schema: "moveset", version: 1),
        (path: "data/movesets/pugnacious_polygon.ron", schema: "moveset", version: 1),
        (path: "data/movesets/ramen_nujan.ron", schema: "moveset", version: 1),
        // A character's platform-fighter facet: what it is on a Smash stage where
        // that differs from its moves here. The robot's is its damage in percent.
        (path: "data/fighters/player_robot_v3.ron", schema: "smash_fighter", version: 1),
        (path: "data/fighters/npc_gnu_ton.ron", schema: "smash_fighter", version: 1),
        (path: "data/fighters/npc_ramen_nujan.ron", schema: "smash_fighter", version: 1),
        (path: "data/encounters/goblin_encounter.ron", schema: "encounter_waves", version: 1),
        // The rules of Ambition's own rooms: the death replay, which hits land
        // heavy, and how much landing lag a move charges.
        (path: "data/room_rules.ron", schema: "room_rules", version: 1),
        // The voice each speaker of the cast speaks with.
        (path: "data/dialogue_voiceprints.ron", schema: "dialogue_voiceprints", version: 1),
        // The look of each named projectile.
        (path: "data/projectile_visuals.ron", schema: "projectile_visuals", version: 1),
        // The gestures the player fire system asks for by id.
        (path: "data/motion_techniques.ron", schema: "motion_techniques", version: 1),
        // The prop sheets its rooms name.
        (path: "data/prop_sheets.ron", schema: "prop_sheets", version: 1),
        // How a platform drawn as a prop sheet is laid on its platform.
        (path: "data/platform_looks.ron", schema: "platform_looks", version: 1),
        // Its worlds: the room play starts in, and each world file.
        (path: "data/worlds.ron", schema: "world_manifest", version: 1),
        // The gate portals its rooms hold, by loading zone.
        (path: "data/gate_portals.ron", schema: "gate_portals", version: 1),
        // The dialogue: one Yarn file per zone. A file added here is in the
        // next start's Yarn project, with no Rust build; an edit to a file
        // reaches a running game (`content_watch::yarn`).
        (path: "dialogue/sandbox/intro.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/kernel.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/factions.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/cove.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/dojo.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/symmetry.yarn", schema: "yarn_dialogue", version: 1),
        (path: "dialogue/sandbox/hall.yarn", schema: "yarn_dialogue", version: 1),
        // How each held item is drawn on the ground and in the hand.
        (path: "data/held_item_art.ron", schema: "held_item_art", version: 1),
        // How an item is drawn over the hand of the body that wields it.
        (path: "data/wielded_item_art.ron", schema: "wielded_item_art", version: 1),
        // Ambition's own tuning: the idle bark cadence, the GNU-ton duel.
        (path: "data/ambition_rules.ron", schema: "ambition_rules", version: 1),
        // Save flags that set other save flags: the intro route's consequences.
        (path: "data/flag_chains.ron", schema: "flag_chains", version: 1),
        // Nine difficulty rungs.  authored since 2026-07 and read by NOTHING until
        // this line: the engine floor (`for_level`) was consulted instead, so every
        // rung scored moves with the level-9 weight set.
        (path: "data/fighter_brain_ladder.ron", schema: "fighter_brain_ladder", version: 1),
        // Nine difficulty rungs.  authored since 2026-07 and read by NOTHING until
        // this line: the engine floor (`for_level`) was consulted instead, so every
        // rung scored moves with the level-9 weight set.
        (path: "data/boss_profiles.ron", schema: "boss_profiles", version: 1),
        (path: "data/boss_encounters/clockwork_warden.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/mockingbird.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/gnu_ton_rider.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/smirking_behemoth_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/flying_spaghetti_monster_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/trex_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/mode_collapse_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/hunny_horror_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/overflow_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_encounters/wolfenstein_boss.ron", schema: "boss_encounter", version: 1),
        (path: "data/boss_seeds.ron", schema: "boss_seed_library", version: 1),
        (path: "data/boss_validator_bands.ron", schema: "boss_validator_bands", version: 1),
        (path: "audio/music_registry.ron", schema: "music_registry", version: 1),
        (path: "audio/sfx_registry.ron", schema: "sfx_registry", version: 1),
        (path: "audio/music_cues.ron", schema: "music_cue_catalog", version: 1),
    ],
)
