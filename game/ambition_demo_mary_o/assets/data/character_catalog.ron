// The Mary-O demo's cast. Every demo installs its own roster; the engine ships
// none (ADR 0017).
//
// The demo registers every row here as a character with one call
// (`pack::PACK.cast(..)`), so a character is a row here, an optional move file
// and their lines in `pack.ron`.
(
    // Mary-O Classic: the one movement feel all three of her forms wear.
    //
    // Values are the classic 16 px / 60 Hz movement tables converted to this
    // demo's 32 px tile scale. Neutral air keeps momentum. The jump law selects
    // one of four launch speeds from body-local side speed, then uses weak
    // gravity while the button is held and she rises, and full gravity after
    // release or near the apex. `coyote_time` and `jump_buffer` stay zero on
    // purpose. Ground coast and reversal are polished, not converted: the
    // direct friction conversion took about 0.76 seconds and 3.6 tiles to stop
    // from full speed, which read as too much sliding. `ground_reverse_accel`
    // is an estimated skid rate, not a sourced classic constant. All
    // directions use the resolved gravity frame.
    //
    // One preset, because re-wearing a form re-reads its feel: a copy per
    // form that drifted would change her jump when she grows.
    axis_tuning_presets: {
        "classic": (
            horizontal_law: Momentum((
                ground_reverse_accel: 1500.0,
                ground_coast_decel: 393.75,
                air_reverse_accel: 900.0,
                air_coast_decel: 0.0,
            )),
            jump_law: PhasedGravity((
                speed_thresholds: (120.0, 187.5, 210.0),
                launch_offsets: (-30.0, -15.0, 0.0, 30.0),
                held_rise_gravity_scale: 0.2,
                released_rise_gravity_scale: 1.0,
                fall_gravity_scale: 1.0,
                held_phase_min_upward_speed: 240.0,
            )),
            gravity: 2250.0,
            air_jumps: 0,
            jump_speed: 450.0,
            max_run_speed: 300.0,
            run_accel: 393.75,
            air_accel: 393.75,
            max_fall_speed: 480.0,
            coyote_time: 0.0,
            jump_buffer: 0.0,
        ),
        // Eternal Cosmic Mary-O: the feel of `classic`, faster, with a jump
        // for each press in the air, so a line of jumps is a flight. She
        // comes down slowly: her wings hold the air.
        "cosmic": (
            horizontal_law: Momentum((
                ground_reverse_accel: 3200.0,
                ground_coast_decel: 1400.0,
                air_reverse_accel: 2400.0,
                air_coast_decel: 700.0,
            )),
            jump_law: PhasedGravity((
                speed_thresholds: (120.0, 187.5, 210.0),
                launch_offsets: (-30.0, -15.0, 0.0, 30.0),
                held_rise_gravity_scale: 0.2,
                released_rise_gravity_scale: 1.0,
                fall_gravity_scale: 1.0,
                held_phase_min_upward_speed: 240.0,
            )),
            gravity: 2250.0,
            air_jumps: 255,
            jump_speed: 520.0,
            max_run_speed: 620.0,
            run_accel: 1400.0,
            air_accel: 1400.0,
            max_fall_speed: 300.0,
            coyote_time: 0.0,
            jump_buffer: 0.0,
        ),
    },
    brain_presets: { "stand_still": StandStill },
    action_set_presets: {
        "peaceful": (
            move_style: Walk,
            melee: None,
            ranged: None,
            special: None,
        ),
        // The coconut of the Laden Swallow. It has gravity and almost no
        // launch speed, so a shot that is fired down is a thing that is let
        // go. The weapon's recharge and its two live shots are the limit on
        // how many fall; `swallow.rs` says when and which way.
        "coconut_drop": (
            move_style: Float,
            melee: None,
            ranged: Some(Weapon((
                style: Rock,
                speed: 30.0,
                damage: 1,
                flight: Some((
                    gravity: 760.0,
                    bounces: 0,
                    bounce_on_world_contact: false,
                    max_lifetime: 4.0,
                    half_extent: (9.0, 9.0),
                    boomerang_return_s: None,
                )),
                visual: Some("mary_o_coconut"),
                refire_s: 1.0,
                discharge: Some((muzzle: BodyOrigin, recoil: 0.0)),
                max_live: Some(2),
            ))),
            special: None,
        ),
        // The orb of the Void Lizard: a slow ball that goes along the bridge
        // with no fall. `void_lizard.rs` says when and which way.
        "void_orb": (
            move_style: Walk,
            melee: None,
            ranged: Some(Weapon((
                style: Bolt,
                speed: 170.0,
                damage: 1,
                flight: Some((
                    gravity: 0.0,
                    bounces: 0,
                    bounce_on_world_contact: false,
                    max_lifetime: 3.5,
                    half_extent: (12.0, 12.0),
                    boomerang_return_s: None,
                )),
                visual: Some("mary_o_void_orb"),
                // A volley is three orbs, 34 ticks apart.
                refire_s: 0.4,
                discharge: Some((muzzle: Offset(x: 0.5, y: -0.05), recoil: 0.0)),
                max_live: Some(5),
            ))),
            special: None,
        ),
    },
    characters: {
        "mary_o": (
            display_name: "Mary-O",
            manifest: "sprites/mary_o_v2_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // THE ART IS THE BODY, at one scale for all three forms: the scale
            // that makes her small idle body one tile (32) tall. The forms
            // differ in size because their art differs. A height per form would
            // state the ratio a second time, and a scale per form would make
            // her wider when she grows, so a grow would wedge her in a gap she
            // fit.
            standing_height: Some(32.0),
            posed_body: Some(OwnHeight),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            // Mary-O Classic is only the run and jump floor. Wall jump and
            // ground pound are later, independent abilities; the wall bundle
            // and the generic fast fall must not leak into the core movement
            // oracle.
            abilities: Some([RunJump]),
            axis_tuning_preset: Some("classic"),
            // The classic contract: whatever you are wearing absorbs the hit
            // (beacon -> wand -> nothing), and once there is no armor left the
            // next one is fatal. One pool on every form, so growing changes
            // what a hit COSTS and never how much punishment the body
            // underneath can take.
            max_health: Some(1),
            tags: ["player"],
            barks: (
                hall: ["I solve masonry disputes from below.", "One jump. No second opinions, no insurance.", "Every pipe is hiding something."],
            ),
            fallback_dialogue: [
                "Jump, land, repeat. It's honest work.",
                "The bricks owe me nothing and I break them anyway.",
                "Every pipe goes somewhere. That's the deal.",
            ],
            hall_dialogue_id: Some("hall_mary_o"),
        ),
        // The grown form. Its kit is the kit of `mary_o` (the same grants, the
        // same feel, the same peaceful action set), so growing changes only
        // her look and size, never her moveset.
        "mary_o_tall": (
            display_name: "Mary-O (Tall)",
            manifest: "sprites/mary_o_v2_tall_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            posed_body: Some(SameAs("mary_o")),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            // Its strikes draw its own sheet (`mary_o_strike_fx`), not the stand-in wedge.
            attack_vfx: Some("mary_o_strike_fx"),
            abilities: Some([RunJump]),
            axis_tuning_preset: Some("classic"),
            max_health: Some(1),
            tags: ["player"],
            barks: (
                hall: ["One power-up; every ceiling gets an opinion.", "Ask the doorframes whether taller is better.", "I shrink after one professional-grade mistake."],
            ),
            fallback_dialogue: [
                "One mushroom. That's the whole story.",
                "Taller, yes. Braver, unclear.",
                "I can see the top of the flagpole from here.",
            ],
            form_of: Some("mary_o"),
        ),
        // The cinder beacon (fire flower) form: a second power-up above the
        // wand. Its own sheet (the white-and-red palette with a fireball pose)
        // at the grown form's size, so the grown-to-fire change moves only her
        // look and her spark loadout. The fireball comes from WEARING the
        // beacon (`MaryOSpark`), not from this row, so the kit is the grown
        // form's kit.
        "mary_o_fire": (
            display_name: "Mary-O (Fire)",
            manifest: "sprites/mary_o_v2_fire_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            posed_body: Some(SameAs("mary_o")),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            abilities: Some([RunJump]),
            axis_tuning_preset: Some("classic"),
            max_health: Some(1),
            tags: ["player"],
            barks: (
                hall: ["One beacon, and every ceiling gets a warm answer.", "I throw solutions now — mind the sparks.", "Fireproof opinions, freshly lit."],
            ),
            fallback_dialogue: [
                "The beacon does the talking now.",
                "Warm opinions, thrown at speed.",
                "Everything flammable, please step back.",
            ],
            form_of: Some("mary_o"),
        ),
        // Eternal Cosmic Mary-O: her ultimate form (`cosmic.rs`). The row
        // states what the form is. She is not hurt and she harms what she
        // touches, each press of jump in the air is a jump, and she is
        // faster. Her sheet is published at half the pixels to the unit of
        // her other sheets, so the row states her height: the height of her
        // grown forms.
        "mary_o_cosmic": (
            display_name: "Eternal Cosmic Mary-O",
            manifest: "sprites/mary_o_v2_cosmic_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            standing_height: Some(64.0),
            posed_body: Some(OwnHeight),
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            // A session that starts in the form has the jump in the air from
            // this row. A body that puts the form on later has it from
            // `cosmic::lend_the_jump_in_the_air`: to wear a row does not
            // change the verbs of a body.
            abilities: Some([RunJump, AirJump]),
            axis_tuning_preset: Some("cosmic"),
            max_health: Some(1),
            empowered: [Untouchable, HarmsOnContact],
            tags: ["player", "transformation"],
            barks: (
                hall: ["The night sky is a dress, if you ask it well.", "I have a star for a hat and no ceiling.", "The void can keep its grey. I brought every colour."],
            ),
            fallback_dialogue: [
                "Each jump is a wing beat now.",
                "The star came down when I called.",
                "Nothing here can take my colours.",
            ],
            form_of: Some("mary_o"),
        ),
        // The shelled walker (the Koopa of this game). Its sheet carries the
        // shell rows (retreat, boxed_idle, peek, emerge) that the in-place
        // shell drives.
        "solid_snake": (
            display_name: "Solid Snake",
            manifest: "sprites/solid_snake_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // Two times as WIDE as Mary-O (Jon, 2026-10-08: at her width the
            // snake was too small to see). Width is the dimension a corridor
            // cares about. Derived from her row, so it moves when she does.
            posed_body: Some(TimesAsWideAs(2.0, "mary_o")),
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["enemy"],
            locomotion: Some((run_speed: 46.0, move_style: Walk)),
            // Its whole offense is the body it walks into you with. The shell
            // withdraws the contact while shelled (`ContactThreatWithdrawn`),
            // never this authored value.
            contact_damage: Some((strength: 0.5, amount: 1)),
            // It walks its line at full speed and reverses at walls; it notices
            // nobody.
            autonomous_profile: Some((template: Wanderer, patrol_effort: 1.0)),
            max_health: Some(1),
            fallback_dialogue: [
                "The shell is load-bearing. Please stop.",
                "I was told there would be a corridor.",
                "Kick me and I become somebody else's problem.",
            ],
        ),
        // The plain stompable walker. AI Slop also stands in Ambition's Hall of
        // Characters as a frozen display NPC (`npc_ai_slop`): the same
        // character in a different mode, and two rows until the two share one
        // entry. The display strings differ so the assembled catalog's
        // display-name uniqueness holds when the demo is hosted.
        "ai_slop": (
            display_name: "AI Slop",
            manifest: "sprites/ai_slop_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // Width is what the level sees: a slop patrols a corridor. Its
            // height follows from the art. The width was 28 until 2026-10-08
            // (Jon: the enemies were too small), and the rooms were authored
            // against 28.
            //
            // 35 is the same picture as 56 was. The box of the sheet was the
            // heap with the skirt of its puddle (161 px); it is the heap where
            // it is high (101 px) from 2026-10-12, when Jon said that the box
            // went past what he could see. 56 * 101 / 161 = 35.
            posed_body: Some(Width(35.0)),
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["enemy"],
            locomotion: Some((run_speed: 42.0, move_style: Walk)),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: Wanderer, patrol_effort: 1.0)),
            max_health: Some(1),
            fallback_dialogue: [
                "I walk left. It is a complete philosophy.",
                "Statistically, one of us is about to be stomped.",
                "I was trained on a thousand walkers and became the average one.",
            ],
        ),
        // The plant in a pipe: a snake that wears leaves. It stands still; its
        // rule (`plant.rs`) moves it up out of its pipe and down again. No
        // rule makes its head safe, so a stomp on it is a hit.
        "snake_plant": (
            display_name: "Snake Plant",
            manifest: "sprites/snake_plant_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            // It fits in the mouth of a pipe, which is three tiles wide.
            posed_body: Some(Width(44.0)),
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["enemy"],
            locomotion: Some((run_speed: 0.0, move_style: Walk)),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: StandStill)),
            max_health: Some(1),
            fallback_dialogue: [
                "I am a plant. Plants do not bite. Come closer.",
                "The leaves are real. I grew them myself.",
                "Photosynthesis is slow. Lunch is faster.",
            ],
        ),
        // The bird that stays over the player and lets coconuts go. The
        // African swallow of Ambition's catalog is another row with the same
        // sheet: this one carries. It is the flyer the planes are (no attack
        // range, so it flies to a place over the body it sees and never
        // dives); `swallow.rs` asks for the drop.
        "laden_swallow": (
            display_name: "Laden Swallow",
            manifest: "sprites/african_swallow_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            composition: None,
            posed_body: Some(Width(54.0)),
            default_action_set: "coconut_drop",
            tags: ["enemy", "flying", "bird"],
            locomotion: Some((run_speed: 170.0, move_style: Float, baseline_free_flight: Some(true))),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: Aerial, patrol_effort: 1.0, chase_effort: 1.0)),
            max_health: Some(1),
            fallback_dialogue: [
                "I grip it by the husk.",
                "It is not a question of where I got it.",
                "Mind your head.",
            ],
        ),
        // The enemy that no stomp can hurt: a small star of the void that goes
        // along the ground on its points. It is the walker the AI Slop is, and
        // no rule makes its top safe (`void_star.rs`).
        "void_star": (
            display_name: "Void Star",
            manifest: "sprites/void_star_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            posed_body: Some(Width(46.0)),
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["enemy"],
            locomotion: Some((run_speed: 42.0, move_style: Walk)),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: Wanderer, patrol_effort: 1.0)),
            max_health: Some(1),
            fallback_dialogue: [
                "I point at nothing. I am what it points at.",
                "There was a star here. I am where it was.",
                "You may not take my address.",
            ],
        ),
        // The boss of the castle: a lizard made of the void (a working title).
        // It is the walker the AI Slop is, large, with the health of five
        // sparks; `void_lizard.rs` asks for its orb and its hop. It stays on its
        // bridge because the level puts a post at each end.
        "void_lizard": (
            display_name: "Void Lizard",
            manifest: "sprites/void_lizard_spritesheet.ron",
            tier: MainHall,
            body_kind: Wide,
            posed_body: Some(Width(92.0)),
            default_brain: "stand_still",
            default_action_set: "void_orb",
            tags: ["enemy", "boss"],
            locomotion: Some((run_speed: 40.0, move_style: Walk)),
            contact_damage: Some((strength: 0.6, amount: 1)),
            autonomous_profile: Some((template: Wanderer, patrol_effort: 1.0)),
            max_health: Some(20),
            fallback_dialogue: [
                "I am what is left when the light goes out.",
                "There were stars here. I ate them.",
                "This bridge goes nowhere. So do you.",
            ],
        ),
        // The one the void held in the castle. He waits past the bridge and
        // thanks her (`castle_end.rs`). He wears the sheet of the player robot
        // of Ambition; his name is his own, because a catalog that is put
        // together from many games refuses two rows with one name.
        //
        // He has no line of his own here. A line of `fallback_dialogue` is
        // said in a bubble when she is near, and she is near him, on the
        // bridge, before she saves him (Jon, 2026-10-12: he thanked her
        // "before she actually saves the robot"). His thanks is the line of
        // the cutscene at the end of the castle.
        "mary_o_robot": (
            display_name: "Rescued Robot",
            manifest: "sprites/player_robot_v3_spritesheet.ron",
            tier: MainHall,
            body_kind: Standard,
            composition: None,
            default_brain: "stand_still",
            default_action_set: "peaceful",
            tags: ["npc"],
            // What it says to a body that talks to it BEFORE the switch: it is
            // not saved yet, so it does not say its thanks (the end of the
            // castle says those). Every character must have a line
            // (`every_character_says_something`).
            fallback_dialogue: [
                "The switch! It is past the big one, at the end of the bridge.",
                "I can not go while that thing is on the bridge.",
            ],
        ),
        // The two flying swarms. Their Hall pedestals and dialogue stay in
        // Ambition's world files and resolve by id from the merged catalog in
        // hosted builds. Free flight is a body capability, so it travels with
        // the row: a body that cannot see it falls out of the sky.
        //
        // Zero aggro and attack radii keep the aerial brain roaming instead of
        // diving, at full effort.
        "npc_snakes_on_a_cartesian_plane": (
            display_name: "Snakes on a Cartesian Plane",
            manifest: "sprites/snakes_on_a_cartesian_plane_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            composition: None,
            default_action_set: "peaceful",
            tags: ["enemy", "flying", "snake_swarm", "cartesian_plane", "math_pun"],
            locomotion: Some((run_speed: 38.0, move_style: Float, baseline_free_flight: Some(true))),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: Aerial, patrol_effort: 1.0, chase_effort: 1.0)),
            max_health: Some(2),
            fallback_dialogue: [
                "We have coordinates for your location.",
                "Stay on the positive side.",
                "Our domain is all real snakes.",
            ],
            barks: (
                hall: ["We have coordinates for your location.", "Stay on the positive side.", "Our domain is all real snakes."],
            ),
            hall_dialogue_id: Some("hall_npc_snakes_on_a_cartesian_plane"),
        ),
        "npc_snakes_on_a_paper_plane": (
            display_name: "Snakes on a Paper Plane",
            manifest: "sprites/snakes_on_a_paper_plane_spritesheet.ron",
            tier: MainHall,
            body_kind: Floating,
            composition: None,
            default_action_set: "peaceful",
            tags: ["enemy", "flying", "snake_swarm", "paper_airplane", "plane_pun"],
            locomotion: Some((run_speed: 58.0, move_style: Float, baseline_free_flight: Some(true))),
            contact_damage: Some((strength: 0.5, amount: 1)),
            autonomous_profile: Some((template: Aerial, patrol_effort: 1.0, chase_effort: 1.0)),
            max_health: Some(1),
            fallback_dialogue: [
                "This flight is hiss-class only.",
                "Please keep your scales inside the aircraft.",
                "We folded under pressure.",
            ],
            barks: (
                hall: ["This flight is hiss-class only.", "Please keep your scales inside the aircraft.", "We folded under pressure."],
            ),
            hall_dialogue_id: Some("hall_npc_snakes_on_a_paper_plane"),
        ),
    },
)
