// MARY-O'S PLATFORM-FIGHTER FACET: what Mary-O is on a Smash stage, where
// that differs from Smash's default fighter.
(
    character: "mary_o_tall",
    // Jon, 2026-10-18: Mary-O is the fighter most like Mario, and echoes
    // Ultimate's Mario very closely, except that her down special is not
    // FLUDD. Mario is her template, taken whole.
    // Shaped like Ultimate's Mario: each number is Smash's
    // default fighter's, scaled by how that fighter differs from Ultimate's
    // roster median (`scripts/smash_fighter_shape.py "Mario"`).
    knockback_weight: Some(0.98),
    body: Some((
        max_run_speed: Some(323.7),
        initial_dash_speed: Some(350.0),
        run_accel: Some(370.9),
        ground_friction: Some(649.1),
        max_air_speed: Some(247.4),
        air_accel: Some(917.3),
        gravity: Some(1099.5),
        max_fall_speed: Some(290.6),
        fast_fall_speed: Some(474.7),
        jump_speed: Some(514.0),
        double_jump_speed: Some(508.9),
        dodge_roll_speed: Some(388.5),
    )),
)
