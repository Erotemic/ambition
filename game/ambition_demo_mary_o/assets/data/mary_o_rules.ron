// The Mary-O demo's tuning (schema `mary_o_rules`, owned by the demo: these
// are this game's rules, and no engine capability reads them). An edit here
// is played at the next start, with no Rust build.
(
    // The snake plant in its pipe.
    snake_plant: (
        // One cycle: up, out, down, hidden.
        cycle_ticks: 330,
        // To come all the way up, and to go all the way down.
        travel_ticks: 36,
        // All the way out.
        out_ticks: 108,
        // A player this near the side of the pipe (px) keeps a hidden plant
        // hidden.
        shy_reach: 40.0,
        // Below this part of its height out of the pipe, the plant hurts
        // nobody: a body that stands on the pipe, or rides down it, does not
        // touch the plant.
        harmless_below: 0.12,
    ),
    // A body's trip through a pipe.
    pipe: (
        // Sinking into the near pipe, and rising out of the far one. Half a
        // second each way: slow enough to read as a slide and not a snap,
        // short enough that a player who takes the pipe often never waits.
        swallow_seconds: 0.5,
        emerge_seconds: 0.5,
        // Stepping across the mouth to the pipe's centre line before the
        // slide. Short: it is a step, and a body on the line skips it.
        center_seconds: 0.14,
        // How far along the tube's axis the body travels in each phase. Two
        // tiles is the pipe's own height, so the body is fully swallowed at
        // the moment of the crossing and nothing pops.
        travel_tiles: 2.0,
    ),
    // The stomped snake and its shell.
    // A stomp on any of her enemies (the snake, the AI Slop, the Laden
    // Swallow), so a bounce off each feels the same.
    stomp: (
        // The vertical tolerance (px) for feet on an enemy's head; at most
        // half the enemy's height counts.
        band: 16.0,
        // Upward speed off a stomped enemy: a lively hop, a touch less than a
        // full jump, so a stomp reads as a bounce and not a jump.
        bounce_speed: 430.0,
        // The low, tan dust where an enemy is stomped: a snake as it goes
        // into its shell, an AI Slop or a Laden Swallow as it is squashed.
        dust: (count: 12, speed: 130.0, color: (0.80, 0.68, 0.48, 1.0), kind: "dust"),
    ),
    shell: (
        // Faster than a snake walks, so a kicked shell runs a line of them
        // down instead of trailing behind.
        slide_speed: 300.0,
        // To another enemy it runs down: lethal, so a kicked shell clears the
        // trash mobs in its way through the shared hit pipeline.
        enemy_damage: 99,
        // To the player on a side hit: an ordinary contact hit (the shared
        // i-frames keep it from hitting again every frame it overlaps).
        player_damage: 1,
        // A freshly kicked shell cannot hurt the player: the kick starts it
        // inside the kicker. It still mows down enemies during the grace.
        kick_grace_seconds: 0.25,
        // Pulling into the shell (the `retreat` row) before it is kickable.
        retreat_seconds: 0.35,
        // Boxed and kickable before it peeks back out: generous, so a kick
        // almost always lands in it.
        boxed_seconds: 4.0,
        // Peeking (the `peek` row): a wary look before it commits.
        peek_seconds: 0.5,
        // Climbing back out (the `emerge` row) before it walks again.
        emerge_seconds: 0.45,
    ),
    // How long the star's power lasts.
    star_seconds: 10.0,
    // One coin, like the coins in the vault (`currency:1` in the level file).
    coins_per_block: 1,
    // Ticks from one plank of a breaking bridge to the next.
    plank_ticks: 7,
    // Walking is 60% of her run speed. Her catalog row owns the absolute cap;
    // this is only the walk-to-run ratio.
    walk_throttle: 0.6,
    // A step up a rung asks the world to run at this rate while her change
    // plays: a moment to savour. A step down asks for nothing: she was just
    // hit, and a slow world would take her recovery away.
    step_up_clock_scale: 0.6,
    // The beats of the cosmic form.
    cosmic: (
        // The last frame of her way out stays this long before she is the
        // form she comes back to; the beat is this much longer than the row.
        leave_hold_seconds: 0.2,
        // The beat of the form she comes back to: short, and with no clip (a
        // clip of that form is the clip of a hit, and she was not hit).
        arrive_beat_seconds: 0.2,
        // The longest hit stop her own body takes in the form: the stop of a
        // flight is her own, and this is the stop the form shortens.
        hit_stop_max_seconds: 0.02,
    ),
    // The end of a castle.
    castle_end: (
        // How fast the switch goes down under her, in world px per second.
        press_speed: 150.0,
        // Seconds from one row of the gate to the next while it opens.
        gate_step_seconds: 0.14,
        // She stops this far from him, in world px.
        stand_before_him: 76.0,
        // How fast she comes down from the switch to the floor, in world px
        // per second.
        step_down_speed: 240.0,
        // The score of a castle.
        switch_score: 5000,
        // How fast the lava takes a boss down, in world px per second.
        sink_speed: 46.0,
        // Ticks from one splash of the lava about a boss to the next.
        splash_ticks: 7,
        // A boss is dead when its top is this far under the top of the lava.
        sunk_under: 6.0,
        // With no lava under it, a boss is dead this far under the floor.
        fallen_under: 96.0,
        // A boss that is alive this long after its bridge is gone did not
        // fall (a post held it). The void takes it where it is.
        boss_fall_limit_seconds: 4.0,
        // The seconds of each beat that ends on time. The bridge, the boss's
        // fall and her walk end on a fact of the world.
        beats: (
            pressed: 0.6,
            charges: 1.1,
            aftermath: 1.0,
            gate_opens: 1.0,
            // The thanks are the rescue line and this much more.
            thanks_after_line: 0.9,
            // The level waits, so the player has the time of the victory.
            victory: 2.0,
        ),
    ),
    // The level around a run.
    level: (
        // The level clock starts here and counts down.
        starting_time: 400.0,
        // Lives Mary-O starts a run with.
        starting_lives: 3,
        // How long the title card ("WORLD 1-1    MARY-O x3") stays before
        // play reads as normal.
        intro_card_seconds: 2.0,
        // How long the flag tally stays on screen before the level loops.
        // The next level is the same level: the flagpole restarts 1-1.
        cycle_dwell_seconds: 2.0,
        // How far (tiles) over the top of a level its sky zone is, to the
        // bottom of the zone. A view ends at the top of the level, so she
        // must fly this far out of view to find it: a player who gets the fly
        // ability does not always find it (Jon, 2026-10-12).
        sky_zone_rise_tiles: 5.0,
    ),
    // How the power-ups move once they are out of their block.
    power_ups: (
        // The wand is slower than she walks, so a player who wants it can
        // always catch it.
        wand_speed: 55.0,
        // The quasar is faster and gives back most of what it lands with:
        // it bounds away from her like a superstar.
        quasar_speed: 105.0,
        quasar_restitution: 0.86,
        // Each pickup's half size (px), from its art: the box she touches to
        // take it, and how far it rises to rest on its block.
        wand_half: (12.0, 15.5),
        beacon_half: (12.0, 18.0),
        quasar_half: (13.0, 13.0),
        // How long (s) a pickup takes to climb out of the block that gave it.
        // Long enough to see it come; short enough that a player who bonked
        // the block from below is not left waiting under it. 0 pops it out.
        rise_seconds: 0.4,
    ),
    // The flag at the end of a level.
    flag: (
        // How fast the body slides down the pole, world px per second.
        slide_speed: 220.0,
        // How far right the body walks off, in world px, before the tally.
        walk_off_px: 96.0,
        // Walking-off speed, world px per second.
        walk_off_speed: 90.0,
        // The classic ladder, by the grab's height on the pole: five bands,
        // the top worth an order of magnitude more than the bottom. Exactly
        // five, so the list is written in parentheses.
        score_bands: (
            (at: 0.9, score: 5000),
            (at: 0.7, score: 2000),
            (at: 0.5, score: 800),
            (at: 0.25, score: 400),
            (at: 0.0, score: 100),
        ),
    ),
    // The bursts of what she breaks and what dies in the castle. A speed is
    // px per second; a colour is (red, green, blue, alpha), each 0 to 1; a
    // kind is spark, dust, shard, heart or streak.
    effects: (
        // A brick shatters into brick-red shards; a plank of the bridge into
        // fewer, with a small explosion.
        brick_break: (count: 14, speed: 155.0, color: (0.72, 0.35, 0.22, 1.0), kind: "shard"),
        plank_break: (count: 8, speed: 155.0, color: (0.72, 0.35, 0.22, 1.0), kind: "shard"),
        plank_explosion_scale: 0.75,
        // A body that sinks in the lava throws it up as it goes; the boss
        // dies in one large splash and an explosion.
        lava_splash: (count: 10, speed: 190.0, color: (1.0, 0.52, 0.14, 1.0), kind: "shard"),
        boss_death: (count: 30, speed: 300.0, color: (1.0, 0.6, 0.18, 1.0), kind: "shard"),
        boss_death_explosion_scale: 1.6,
        // As the boss charges, fireworks go off over the bridge: across this
        // share of its length, in a band this tall (px).
        bridge_fireworks: (count: 9, across_share: 0.85, height_px: 34.0),
    ),
    // The words over a pipe to another level: the plum of the dark stone of
    // her castle, with a white edge, so they read on the pale sky (Jon,
    // 2026-10-12: white words could not be seen there). The edge is copies
    // of the words this far to each side; at 2.0 the edge was most of each
    // letter and the words read white (measured in a window, 2026-10-12).
    pipe_signs: (
        size_px: 24.0,
        rise_px: 38.0,
        edge_px: 1.25,
        ink: (0.22, 0.11, 0.32),
        edge: (1.0, 1.0, 1.0),
    ),
)
