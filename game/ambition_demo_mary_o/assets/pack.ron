// The Mary-O demo's own content pack: what its characters are, stated as
// data. The manifest is the pack's explicit source list, not a directory
// glob, so its contents do not depend on filesystem order. A line added here
// is played at the next start, with no Rust build.
//
// `mary_o_rules` is the demo's own schema (`src/rules.rs`), which the generic
// content CLI does not link. Validate this tree, or a copy of it, with the
// demo's check binary (the content CLI with the demo's schemas):
//
//     cargo run -p ambition_demo_mary_o --features content_check \
//         --bin mary_o_content_check -- game/ambition_demo_mary_o/assets
(
    id: "ambition_demo_mary_o",
    version: "0.1.0",
    // Every identity this pack mints is `mary_o_demo:<schema>/<name>`.
    namespace: "mary_o_demo",
    requires: [],
    sources: [
        // The cast: every row is a character the demo registers.
        (path: "data/character_catalog.ron", schema: "character_catalog", version: 1),
        (path: "data/movesets/mary_o.ron", schema: "moveset", version: 1),
        // Her music and SFX: what her session may play, and how each synth
        // cue sounds.
        (path: "audio/music_registry.ron", schema: "music_registry", version: 1),
        (path: "audio/sfx_registry.ron", schema: "sfx_registry", version: 1),
        // The rules of her rooms: the death replay, sized by her death music.
        (path: "data/room_rules.ron", schema: "room_rules", version: 1),
        // Its tuning: the spark, the plant, the pipe, the shell, the star.
        (path: "data/mary_o_rules.ron", schema: "mary_o_rules", version: 1),
        // The sheets of her level's construction: pipes, pole, lift, lava.
        (path: "data/prop_sheets.ron", schema: "prop_sheets", version: 1),
        // Her shots' looks: the spark, the coconut, the void orb.
        (path: "data/projectile_visuals.ron", schema: "projectile_visuals", version: 1),
    ],
)
