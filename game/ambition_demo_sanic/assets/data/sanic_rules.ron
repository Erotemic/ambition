// The Sanic demo's tuning (schema `sanic_rules`, owned by the demo: these are
// this game's rules, and no engine capability reads them). An edit here is
// played at the next start, with no Rust build.
(
    ring_monitor: (
        // Rings a ring monitor holds.
        rings: 10,
    ),
    // How long the speed shoes last (sim seconds) and what they multiply.
    speed_shoes: (
        seconds: 8.0,
        top_speed_factor: 1.4,
        accel_factor: 1.5,
    ),
    // Ring loss: what makes a ring worth anything.
    ring_loss: (
        // How long (s) a hit keeps Sanic from the next one. This raises the
        // running window and never replaces it: a hazard respawn arms a
        // longer one that must not be cut short.
        invulnerable_seconds: 2.0,
        // How many of the rings he carried scatter; the rest are gone. A cap
        // keeps a big purse from becoming a shower, and some loss makes
        // recovery matter.
        max_scattered: 12,
        // Outward launch speed (px/s): an explosion to chase, not a spill at
        // his feet.
        burst_speed: 900.0,
        // Rings in one shell of the burst. Past this the next shell launches
        // slower, so a big purse bursts as an outer ring and an inner one,
        // not one circle that is too dense.
        rings_per_shell: 6,
        // The speed of each shell inside the first: the classic halving,
        // softened so that the inner shell still clears the body.
        inner_shell_scale: 0.55,
        // Downward pull (px/s^2) that arcs a ring back down. With the launch
        // speed, this sizes the scatter: an arc about three tiles high and a
        // dozen wide, on the same screen.
        gravity: 1400.0,
        // The fraction of speed a loose ring sheds per second in the air.
        // Without drag a horizontal ring does not slow until it hits the
        // floor, and the outer rings leave the level.
        air_drag: 0.9,
        // The fraction of speed a ring keeps when it bounces off geometry.
        restitution: 0.55,
        // How long (s) a scattered ring cannot be collected. It still bursts
        // and bounces; the hit costs something even while he stands in the
        // spray.
        lock_seconds: 0.6,
        // How long (s) a scattered ring exists: short enough that a big spray
        // is never fully recoverable.
        life_seconds: 4.2,
        // A scattered ring's square side (px). The rings the levels place are
        // this size too (their author scripts write it), so a ring keeps its
        // size when it is dropped.
        ring_size: 18.0,
    ),
    act: (
        // How long the results card holds before the act restarts.
        clear_dwell: 4.0,
        // A time bonus makes going fast pay; without it a safer, slower route
        // always wins. Par is 30 s against a clean run of about 6 s (see the
        // act-completion proof), so the bonus spreads across real finishing
        // times.
        par_seconds: 30.0,
        time_bonus_per_second: 100,
        // Each ring he finishes holding. Sized against the time bonus: a clean
        // run banks about 2400 from time, and a full purse is worth about the
        // same, so the two pull against each other at a comparable size.
        ring_bonus: 100,
        // How long the name of an act is on the screen when the act begins.
        title_seconds: 2.5,
        // How far before each course's right edge its goal line sits, in px.
        // A longer act needs no second number.
        goal_from_end: 400.0,
        // After the goal the course brakes him: this share of his speed goes
        // each second. He crosses at about 1100 px/s with 400 px left; 9 stops
        // him in about 120 px (4 coasted about 370 px).
        outro_brake_per_second: 9.0,
        // How tall the goal post stands, in world units. Sanic is 48.
        goal_post_height: 84.0,
    ),
    badnik: (
        // Upward speed off a stomped badnik: a lively bounce, less than a full
        // jump.
        bounce_speed: 460.0,
    ),
    stomp: (
        // How near (px) the feet of a falling Sanic must be to the top of a
        // badnik or a monitor for the touch to be a landing on it. One rule
        // for both: a jump that breaks a monitor also squashes a badnik.
        band: 16.0,
    ),
    // The acts, in their order (the first is Act 1), and the name each title
    // card shows. Which act follows which is the levels' `next_room`.
    acts: [
        (room: "sanic_speedway", title: "SKYBRIDGE SPEEDWAY"),
        (room: "sanic_highway", title: "COVE HIGHWAY"),
        (room: "sanic_darkness", title: "ECLIPSE CIRCUIT"),
    ],
    // The spin dash: crouch, tap the attack to rev, let go to launch, roll
    // until he slows.
    spin_dash: (
        // Charge added per rev tap. One tap clears the launch floor; three
        // reach full.
        rev_per_tap: 0.4,
        // Charge bled off per second while crouched. Holding forever must not
        // guarantee a full launch: the rev is a rhythm, not a timer.
        decay_per_s: 0.55,
        // Launch speed (px/s) at a full charge. A full rev outruns the top
        // speed cap (the launch writes the surface speed, which the kernel
        // allows above the cap), so a spin dash clears the loop: a radius-180
        // loop under 2250 gravity needs about 1300 px/s at the bottom, plus a
        // margin for drag before the loop.
        launch_speed: 1600.0,
        // Below this charge a crouch release is only standing up.
        min_launch_charge: 0.3,
        // The side (px) of the balled-up body box. Sanic stands 24 wide.
        ball_side: 24.0,
        // The roll ends when his speed falls below this (px/s): he stands up
        // when he stops, not when a timer says so.
        exit_speed: 90.0,
        // How far down (0 to 1) the stick must be to read as a crouch.
        crouch_threshold: 0.5,
        // How long (s) an armed rev survives a lost ride contact: block seams
        // and ramp lips lose it for a tick.
        contact_grace_s: 0.12,
        // The charges at which the rev sound climbs to its second and third
        // tier. With 0.4 a tap, the three taps (0.4, 0.8, 1.0) each sound a
        // tier.
        rev_tiers: (0.5, 0.85),
    ),
    super_form: (
        // The beat he holds when he becomes super: shorter and lighter than
        // Mary-O's, so it does not stop a run. Wall-clock seconds, and the
        // clock scale it asks for while it runs.
        beat_seconds: 0.35,
        beat_clock_scale: 0.5,
    ),
    // His look in motion. A puff row is how often (sim seconds), how many
    // particles, how fast (px per second) and their colour (RGBA, 0 to 1).
    effects: (
        // Gold motes on a ring around the super form, stepped by the golden
        // angle so they spread evenly; lifted so they stay at the torso.
        super_sparkle: (
            puffs: (period_s: 0.14, count: 2, speed: 26.0, color: (1.0, 0.9, 0.4, 1.0)),
            radius_px: 15.0,
            rise_px: 8.0,
        ),
        // A pale puff while he runs; a denser, quicker spray when he skids.
        run_dust: (period_s: 0.07, count: 1, speed: 46.0, color: (0.95, 0.97, 1.0, 0.55)),
        skid_dust: (period_s: 0.04, count: 3, speed: 120.0, color: (0.93, 0.90, 0.80, 0.90)),
        // The bursts of what he breaks. A speed is px per second; a kind is
        // spark, dust, shard, heart or streak. A squashed badnik puffs brown
        // dust and throws a few bright sparks over it: a pop, not only a puff.
        // A broken monitor or wall throws shards.
        badnik_squash: [
            (count: 12, speed: 150.0, color: (0.85, 0.62, 0.35, 1.0), kind: "dust"),
            (count: 8, speed: 260.0, color: (1.0, 0.94, 0.62, 1.0), kind: "spark"),
        ],
        monitor_break: (count: 16, speed: 170.0, color: (0.55, 0.75, 0.95, 1.0), kind: "shard"),
        wall_break: (count: 24, speed: 220.0, color: (0.45, 0.62, 0.70, 1.0), kind: "shard"),
        act_clear: (count: 40, speed: 320.0, color: (1.0, 0.92, 0.35, 1.0), kind: "dust"),
        // The gold sparkle where a hit scatters the rings. It leaves at the
        // rings' own speed (`ring_loss.burst_speed`).
        ring_loss: (count: 24, color: (1.0, 0.86, 0.28, 1.0), kind: "dust"),
    ),
)
