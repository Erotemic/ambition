// The Sanic demo's own content pack: what its characters are and the rules
// it plays by, stated as data. The manifest is the pack's explicit source
// list, not a directory glob, so its contents do not depend on filesystem
// order. A line added here is played at the next start, with no Rust build.
//
// `sanic_rules` is the demo's own schema (`src/rules.rs`), which the generic
// content CLI does not link. Validate this tree, or a copy of it, with the
// demo's check binary (the content CLI with the demo's schemas):
//
//     cargo run -p ambition_demo_sanic --features content_check \
//         --bin sanic_content_check -- game/ambition_demo_sanic/assets
(
    id: "ambition_demo_sanic",
    version: "0.1.0",
    // Every identity this pack mints is `sanic_demo:<schema>/<name>`.
    namespace: "sanic_demo",
    libraries: ["../../ambition_content_library/library.json"],
    requires: [],
    sources: [
        // The cast: every row is a character the demo registers.
        (path: "data/character_catalog.ron", schema: "character_catalog", version: 1),
        (path: "data/movesets/sanic.ron", schema: "moveset", version: 1),
        // What the session may play, and how each synth cue sounds.
        (path: "audio/music_registry.ron", schema: "music_registry", version: 1),
        (path: "audio/sfx_registry.ron", schema: "sfx_registry", version: 1),
        // The rules of her rooms: the death replay.
        (path: "data/room_rules.ron", schema: "room_rules", version: 1),
        // Its tuning: the monitors, the ring scatter, the act's score, the
        // badnik.
        (path: "data/sanic_rules.ron", schema: "sanic_rules", version: 1),
        // The prop sheets: the ring, the monitors' boxes, the goal post.
        (path: "data/prop_sheets.ron", schema: "prop_sheets", version: 1),
        // The lines he shows: the HUD labels, the act cards, the signs, his
        // launcher row.
        (path: "data/sanic_text.ron", schema: "sanic_text", version: 1),
    ],
)
