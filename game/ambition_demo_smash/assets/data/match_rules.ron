// The rules of Smash's matches (schema `match_rules`): the stocks, the
// clocks, the percent pool, the fighter body, the ability floor and ceiling,
// and fighter contact. `apply_smash_match_rules` writes them on every roster;
// the damage table, the Limit and the item spawns stay with the game. An edit
// here is played at the next start, with no Rust build.
(
    // Three is the smallest count where the middle of a match differs from its
    // start and its end. The select screen's choice writes over it.
    stocks: Some(3),
    // How long the stage waits before putting a knocked-out fighter back.
    // With zero, the KO cue played over a fighter already back, and the camera
    // jumped to a body that appeared far away. One second is the genre's
    // pause.
    stock_respawn_seconds: 1.0,
    // What 100% means: the denominator of `damage_percent()`. The match
    // declares it, not the characters, so crossover characters are measured
    // against this ruleset and not their home games.
    health_pool: Some(100),
    // The match opens on a countdown: 3, 2, 1, go.
    opens_suspended: true,
    // Ticks, because the release compares against the sim clock. A developer
    // speed-up that stays (Q91): the full three seconds is 180; this is a
    // tenth of it. `MatchRules::beats()` still counts three.
    opening_countdown_ticks: 18,
    // Eight minutes at 60 Hz, as in Ultimate's default stock match, so a match
    // between two passive fighters still ends.
    time_limit_ticks: 28800,
    // Every fighter gets the floor, keeps what of its own kit the ceiling
    // permits, and brings nothing else. The gap between the two is one verb
    // and the wall pair: Robot v3 keeps its pogo because it authors pogo, and a
    // fighter that authors the wall jump and cling keeps them. `fly`, `blink`
    // and `dash` stay out of both: they are the exploration kit. Granting
    // `grab` does not invent a grab: the action scheme also needs an authored
    // `"grab"` move.
    abilities: Some((
        granted: (
            move_horizontal: true,
            jump: true,
            variable_jump: true,
            double_jump: true,
            fast_fall: true,
            wall_jump: false,
            wall_cling: false,
            wall_climb: false,
            dash: false,
            double_dash: false,
            fly: false,
            fly_toggle: false,
            blink: false,
            precision_blink: false,
            blink_through_soft_walls: false,
            blink_through_hard_walls: false,
            attack: true,
            pogo: false,
            directional_primary: true,
            directional_special: false,
            rebound: false,
            reset: false,
            ledge_grab: true,
            swim: false,
            glide: false,
            dodge: true,
            shield: true,
            grab: true,
            interact: false,
            // Every fighter ducks (crouch cancel, ducking a jab); a crawler
            // declares its own `crouch_speed_frac`.
            crouch: true,
            climb: false,
            morph: false,
        ),
        permitted: (
            move_horizontal: true,
            jump: true,
            variable_jump: true,
            double_jump: true,
            fast_fall: true,
            wall_jump: true,
            wall_cling: true,
            wall_climb: false,
            dash: false,
            double_dash: false,
            fly: false,
            fly_toggle: false,
            blink: false,
            precision_blink: false,
            blink_through_soft_walls: false,
            blink_through_hard_walls: false,
            attack: true,
            pogo: true,
            directional_primary: true,
            directional_special: false,
            rebound: false,
            reset: false,
            ledge_grab: true,
            swim: false,
            glide: false,
            dodge: true,
            shield: true,
            grab: true,
            interact: false,
            crouch: true,
            climb: false,
            morph: false,
        ),
    )),
    // The fighter body: what the match writes over each fighter's own
    // movement. Melee recoil off, jump squat and the floor game on.
    body: Some((
        slash_recoil: 0.0,
        // 3 frames.
        jump_squat_time: 0.05,
        // The air dodges, two of them as in Ultimate (Mario's frames,
        // docs/related-work/smash-ultimate-fighter-reference.md):
        //
        //   neutral      protected 27, endlag 25 (52 in all), the body keeps its
        //                own arc; landing in it costs 10
        //   directional  protected 19 and weightless, travelling 63 px along
        //                the stick as its push runs down to nothing, then 68 of
        //                endlag (87 in all, the sideways dodge); landing in it
        //                costs 15 (Ultimate 11-19)
        //
        // No move can start until a dodge's endlag or landing lag is over.
        air_dodge_time: 0.45,
        air_dodge_speed: 400.0,
        air_dodge_endlag: 0.41666667,
        directional_air_dodge_time: 0.31666667,
        directional_air_dodge_endlag: 1.1333333,
        air_dodge_landing_lag: 0.16666667,
        directional_air_dodge_landing_lag: 0.25,
        // The roll ends at rest and leaves the fighter punishable: 14 frames,
        // so travel (`base_body`'s 15) and recovery total 29, Ultimate's
        // forward roll (Mario 29, median 29).
        dodge_roll_endlag: 0.23333333,
        // Dodge staling: each recent evade removes a quarter of the
        // invulnerable window, floored at a third, forgiven one per 1.2 s.
        // It reduces the i-frames, not the distance.
        dodge_stale_step: 0.25,
        dodge_stale_floor: 0.34,
        dodge_stale_recovery: 1.2,
        // A kill-power hit cannot be teched. Keep this well above the tumble
        // threshold (250 px/s) so ordinary launches keep their tech.
        untechable_launch_speed: 1400.0,
        // An evade can cancel into an attack only in its last four frames.
        evade_cancel_tail: 0.06666667,
        // A launch this fast tumbles. Ultimate tumbles at about a third of the
        // launch that kills; this stage kills sideways at about 750, and at
        // 500 no tilt tumbled by 150%. Measured over the roster at 250: the
        // forward and up tilts tumble from 60% (Ultimate 19-34), the neutral
        // air from 60%, the forward air and dash attack from 20%, smashes
        // from 0%; a jab from 140%.
        tumble_speed: 250.0,
        // Spot dodge: 15 frames protected (Ultimate's 3-17), then 8 of
        // recovery: 23 in all, between Ultimate's cancel (20) and its end
        // (25). The engine default is 0.0, so an exploration body keeps the
        // roll.
        spot_dodge_time: 0.25,
        spot_dodge_endlag: 0.13333333,
        // A launch slows at Ultimate's 0.051 units/frame² (551 px/s² on this
        // stage) along the run axis, whoever's air friction it is, until it is
        // down to the fighter's own air speed.
        launch_decay: 551.0,
        // Smash 4 opens the parry window on the press, Ultimate on the
        // release. The stage chooses; `OnRelease` is fully live (guarded by
        // `the_parry_window_opens_where_the_ruleset_says_it_does`).
        parry_timing: OnRelease,
        // SDI, 1 px per hitlag tick: shift out of the next hit while frozen.
        // Was 3 under a 2-6 frame freeze; the affine hitlag law runs 8-19
        // frames, so the per-hit total stays about where it was.
        sdi_step: 1.0,
        // ASDI: one nudge per hit, paid when the freeze lifts. It gives a
        // defender something against multihits, where `sdi_step` gives little.
        asdi_step: 6.0,
        // A jab is a few hundred px/s and a smash is thousands, so this
        // separates a poke on a downed opponent from a launch.
        jab_lock_speed: 320.0,
        // Three pins, then the floor game resets: a combo route, not an
        // infinite.
        jab_lock_limit: 3,
        // A guard that survives about six seconds held, refills in about
        // eight, and costs a point of integrity per point blocked.
        shield: (
            max_health: 50.0,
            drain_per_second: 8.0,
            regen_per_second: 6.0,
            damage_scale: 1.0,
            break_stun_time: 2.0,
            stun_per_damage: 0.012,
            pushback_per_damage: 6.0,
            min_coverage: 0.45,
            // A third of a half-height: a spent guard tilted down still covers
            // the feet a poke was reaching for.
            tilt_range: 0.34,
            // Guard + down on a soft platform drops through, in every title.
            platform_drop: true,
            // A guard is a launching platform in this genre, and these five
            // are what it launches.
            out_of_shield: Some((jump: true, burst: true, grab: true, up_attack: true, up_special: true)),
            // No airborne shield, the genre's rule in every title: the same
            // press in the air is the air dodge.
            air_guard: false,
            // 11 frames, Ultimate's shield drop: an out-of-shield option is
            // fast, and letting go is not.
            drop_lag: 0.18333334,
        ),
        // Crouching stops the fighter, as in every Smash for characters
        // without a crawl. A fighter with a crawl declares its own.
        crouch_speed_frac: 0.0,
        // Initial dash: the first 10 frames of a ground move, where a
        // direction change is free (dash-dance, foxtrot re-tap). Ultimate's
        // median (docs/related-work/smash-ultimate-fighter-reference.md); its
        // speed is the fighter's (`base_body` below).
        initial_dash_time: 0.16666667,
        // A push past 0.8 dashes; under it the fighter walks. Before, any push
        // past the 0.5 deadzone was a full-speed dash, so nobody could walk
        // up to a poke (feel audit 2026-10-29). The keyboard Walk cap is 0.5.
        dash_deflection: 0.8,
        // No grace off a ledge: the ledge grab is the genre's grace.
        coyote_time: 0.0,
        // Reversing out of a run costs frames. 3 frames is what the proving
        // ground tolerates: at 7, `smash_it` lost two premise guards because
        // the CPU matchup became one-sided. The value is a feel call for Jon.
        turnaround_time: 0.05,
        // The air facing lock, the genre's rule: a fighter keeps the facing it
        // jumped with, so a back air is a back air.
        holds_facing_in_air: true,
        // A quarter of the footprint past a ledge puts the fighter on the
        // brink. Published only: collision does not change.
        teeter_margin: 0.25,
        footstool: (
            rise_speed: 330.0,
            press_speed: 220.0,
            flinch_time: 0.12,
            air_tumble_time: 0.4,
            stomper_invuln: 0.06666667,
            band: 14.0,
        ),
    )),
    // The default fighter: the body every fighter plays on unless its own
    // `smash_fighter` facet states differences (layered over this) or its
    // catalog row brings a whole feel of its own (Mary-O's). A patch over the
    // engine's body. Ultimate's middle, put on this stage's scale: 160 units
    // across 480 px is 3 px a unit, so u/frame x 180 is px/s and u/frame² x
    // 10800 is px/s² (docs/related-work/smash-ultimate-fighter-reference.md).
    // `fighter_motion` measures what a fighter actually does on it.
    base_body: Some((
        // Run 1.75 u/f (median 1.71, Mario 1.76); the first step bursts at
        // 1.92 (median 1.91), 1.10 x the run, as the roster's median ratio.
        max_run_speed: Some(315.0),
        initial_dash_speed: Some(345.0),
        // Walk 1.155 u/f (Mario; median 1.11): a stick under the dash
        // threshold walks up to this, a gait slower than the run.
        walk_speed: Some(208.0),
        // Traction 0.102 u/f² (Mario 0.102, median 0.11): a stopped run
        // skids about 45 px. The responsive law brakes a let-go stick with
        // BOTH numbers (it approaches zero at `run_accel`, then applies
        // friction), so the traction is their sum: 400 + 700 = 1100.
        run_accel: Some(400.0),
        ground_friction: Some(700.0),
        // Air speed 1.19 u/f, air acceleration 0.08 (Mario 1.208, 0.08), and
        // air friction 0.015 (Mario's): a drift carries until steered out of.
        max_air_speed: Some(215.0),
        air_accel: Some(860.0),
        air_stop_assist: Some(160.0),
        // Gravity 0.106 u/f² and fall speed 1.72 u/f, both inside the
        // roster's p10-p90. Chosen with the jump below so the full hop is
        // 35 u high and lands in about 54 frames (median 33 u, 50 frames),
        // and the short hop is 16.7 u in about 35 frames (median 16.3, 37).
        gravity: Some(1150.0),
        max_fall_speed: Some(310.0),
        // Fast fall 1.6 x the fall speed, every fighter's ratio; reached
        // within a few frames, as a fast fall is a commitment, not a ramp.
        fast_fall_speed: Some(500.0),
        fast_fall_accel: Some(6000.0),
        // Full hop 105 px (491 by the formula; the 60 Hz step lands 4% short
        // of it, so 501). An air jump from rest at the apex rises the same
        // (Mario's air jump equals his full hop).
        jump_speed: Some(501.0),
        double_jump_speed: Some(501.0),
        air_jumps: Some(1),
        // The squat decides: let go inside the 3-frame squat for a short hop
        // at 0.69 of the launch, about 48% of the height (the roster's
        // median ratio). A release in the air changes nothing.
        jump_law: Some(SquatDecided((short_hop_speed_frac: 0.69))),
        // A forward roll covers 96 px (32 u, Mario 32.2, median 31.8) in
        // 15 frames.
        dodge_roll_speed: Some(384.0),
        dodge_roll_time: Some(0.25),
    )),
    // Fighters are solid to each other (jostle). The engine owns the
    // constraint; the match only says its cast has it.
    fighter_contact: Some((resistance: 0.85)),
    // The camera (Melee's model, `cm/camera.c`, tuned toward Ultimate). Each
    // fighter asks for its body plus 40 px around it; fewer fighters pad
    // more (Melee's 1.5 / 1.32 / 1.16 / 1.0 per count, here relative to the
    // duel: 1.14 / 1.0 / 0.88 / 0.76). 15% of the view is kept below the
    // fight, so the ground stays in view and a wide view keeps more floor.
    // The view may close to 45% of the stage view. The centre pans at 6 Hz;
    // the view opens at 6 Hz (a launch leads it out; a body is never cut
    // off inside the camera box) and closes at 2.5 Hz (no pumping as an
    // exchange spreads and closes). The view stops 280 px past the sides,
    // 170 px above and 100 px below the room — about 70% of the way to the
    // side and rise blast lines (Ultimate's stages stop there too), so a
    // KO'd fighter leaves the frame before the line, and the void past the
    // stage is never framed.
    cast_framing: Some((
        min_view_scale: 0.45,
        margin: 40.0,
        margin_by_count: Some((1.14, 1.0, 0.88, 0.76)),
        floor_share: 0.15,
        pan_hz: Some(6.0),
        zoom_out_hz: Some(6.0),
        zoom_in_hz: Some(2.5),
        bounds: Some((side: 280.0, rise: 170.0, fall: 100.0)),
        // A fighter wholly past the frame (between the camera box and the
        // blast line) is shown in a bubble at the frame's edge, ringed in its
        // seat's HUD colour (partners by parity, as the HUD colours them).
        bubble: Some((
            diameter_px: 96.0,
            span: 100.0,
            // One per seat, four seats (a fixed four: a tuple in RON).
            rings: (
                (0.55, 0.85, 1.0, 1.0),
                (1.0, 0.6, 0.55, 1.0),
                (0.55, 0.85, 1.0, 1.0),
                (1.0, 0.6, 0.55, 1.0),
            ),
            backdrop: (0.04, 0.05, 0.1, 0.85),
        )),
        // Fighters are drawn between their last two ticks, not a tick ahead:
        // they stop, turn and freeze every few frames, and a tick ahead drew
        // each of those past where the body stopped, then snapped it back.
        // MEASURED (two CPUs, 20 s at 144 Hz, per-frame change of a body's
        // drawn step): ahead p99 7.65 px, max 26.7, 152 frames over 4 px;
        // between p99 1.51, max 7.9, 11 frames. The cost is one tick (16.7
        // ms) of drawn latency.
        interpolate_poses: true,
    )),
)
