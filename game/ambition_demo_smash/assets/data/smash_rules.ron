// Smash's own match flow and summon tuning (schema `smash_rules`, owned by
// this demo). The rules every fighting game shares are in `match_rules.ron`.
// An edit here is played at the next start, with no Rust build.
(
    // The results card stays this long before the select screen, in real
    // seconds. The banner asks for 3.0 s; this waits a little longer so the
    // players read it.
    return_to_select_seconds: 4.5,
    // The shark the pirate admiral's up-B summons.
    shark_ride: (
        // The shark takes its summoner on when it comes this near (px). A
        // shark that misses it is not refused: it waits out its deadline and
        // leaves, and the admiral loses the up-B.
        board_radius: 200.0,
        // How long the shark waits for its summoner, in seconds.
        board_deadline_seconds: 1.0,
        // The punishment the shark takes before it dies. Jon's rule: about
        // three hits. It must exceed the largest single hit in the cast:
        // George Booul's forward smash, `damage: 21` at `charge_mult = 1.7`,
        // is 36 exactly, so 40 clears it. The authored shark has 6, fair in
        // its own game; the summon writes over it.
        // `a_recovery_mount_cannot_be_deleted_by_one_hit` reads the whole
        // selectable cast, so a bigger smash trips it.
        health: 40,
        // How fast a dismissed shark leaves, in px per second.
        depart_speed: 1400.0,
        // How long it flies before it is removed. Generous: it only has to
        // outlast the time the body takes to leave view.
        depart_seconds: 2.0,
    ),
)
