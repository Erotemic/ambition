// Smash's own match flow and summon tuning (schema `smash_rules`, owned by
// this demo). The rules every fighting game shares are in `match_rules.ron`.
// An edit here is played at the next start, with no Rust build.
(
    // The fighter ids the select grid asks for, in grid order; the layout
    // follows the list's length. The grid shows the ids the composition has,
    // in this order, so a fighter of a pack that is not loaded is left out.
    // Cross-game fighters are shared by id: do not declare a copy of a
    // character here (the stand-ins below are the one exception).
    roster: [
        // The content catalog's robot v3; the demo does not declare its own
        // copy.
        "player_robot_v3",
        // This demo's own, on a sheet nobody else claims.
        "smash_george_booul",
        // Mary-O's tall form. Both Mary-O ids have identical kits; only the
        // sheet differs, so no test notices a swap.
        "mary_o_tall",
        "sanic",
        // Ambition's own cast.
        "npc_pirate_admiral",
        "npc_ninja_shadow_oni_leader",
        "npc_alice",
        "npc_bob",
        "npc_oiler",
        "perfect_cellular_automaton",
        "goblin",
        "npc_emmy_noether",
        // Both author their own repertoire (their catalog rows), like every
        // id on this roster: no seated fighter falls back to a generic
        // repertoire.
        "npc_carl_stargan",
        "special_patent_clerk",
        // The scholar of the GNU-ton boss fight, as a fighter: a light fencer
        // with a quill and a book (his own table, `movesets/gnu_ton.ron`).
        "npc_gnu_ton",
        // The mathematician of the hall, as a fighter: light, and his blows
        // are symbols written at arm's length from him (his own table,
        // `movesets/ramen_nujan.ron`). His grab is his scarf.
        "npc_ramen_nujan",
        // The deliberately simple SVG-rigged humanoid reference fighter: a
        // real character owned by Ambition content.
        "pointed_polygon",
        // The ranged one: a beast biped whose neutral special fires from a
        // head-mounted cannon. The grid's only body-authored projectile kit,
        // so it tests that a ranged kit survives the same seating, scoring
        // and rules.
        "projectile_polygon",
        "pugnacious_polygon",
        // The four easter eggs, after the archetypes they borrow and before
        // the stand-ins. Each is a polygon archetype wearing a different
        // person: same skeleton, clips and frame data under its own move
        // names. The two faceted ones come first; the two hand-drawn ones
        // follow their archetype (the Performer after the Director, the Medic
        // after the Officer). Neither hand-drawn one has gameplay rules for
        // her own specials yet.
        "director",
        "performer",
        "officer",
        "medic",
        // The stand-ins, last; see `stand_ins`.
        "smash_duelist_a",
        "smash_duelist_b",
    ],
    // The demo declares two rows on the robot lineage's sheets, copies of
    // characters Ambition's catalog already has. They keep the standalone app
    // from being a one-portrait grid, and each steps aside once the
    // character it stands in for is in the composition. `ambition_app`'s
    // guard ("did every buildable fighter reach the grid") reads this list to
    // tell a fighter dropped by a bug from one that stood down.
    stand_ins: [
        (copy: "smash_duelist_a", stands_in_for: "player_robot_v3"),
        (copy: "smash_duelist_b", stands_in_for: "player_robot_v2"),
    ],
    // The results card stays this long before the select screen, in real
    // seconds. The banner asks for 3.0 s; this waits a little longer so the
    // players read it.
    return_to_select_seconds: 4.5,
    // Seconds one press burns off a sleep (the Performer's song, the Shadow
    // Oni's seal: every sleep shares it). Against a mash of about ten presses
    // a second, a sleep decays at about 1.0 + 10 * 0.05 = 1.5 times the clock,
    // so a 1.4 s song holds a struggling fighter for about 0.93 s: the mash
    // buys back a third and cannot beat the clock.
    sleep_mash_seconds: 0.05,
    // The stock counts the stocks button offers, in the order it walks them.
    // A match starts on `stocks` in match_rules.ron (3: every ladder number
    // was measured there), so that count is one of these. One leaves no room
    // to learn the matchup; five makes an early mistake recoverable.
    stock_choices: [1, 3, 5],
    // The shark the pirate admiral's up-B summons.
    shark_ride: (
        // The shark takes its summoner on when it comes this near (px). A
        // shark that misses it is not refused: it waits out its deadline and
        // leaves, and the admiral loses the up-B.
        board_radius: 200.0,
        // How long the shark waits for its summoner, in seconds.
        board_deadline_seconds: 1.0,
        // The punishment the shark takes before it dies. Jon's rule: about
        // three hits. It must exceed the largest single hit in the cast:
        // George Booul's forward smash, `damage: 21` at `charge_mult = 1.7`,
        // is 36 exactly, so 40 clears it. The authored shark has 6, fair in
        // its own game; the summon writes over it.
        // `a_recovery_mount_cannot_be_deleted_by_one_hit` reads the whole
        // selectable cast, so a bigger smash trips it.
        health: 40,
        // How fast a dismissed shark leaves, in px per second.
        depart_speed: 1400.0,
        // How long it flies before it is removed. Generous: it only has to
        // outlast the time the body takes to leave view.
        depart_seconds: 2.0,
    ),
    // The Limit: the meter every seat holds, empty at the start and after a
    // respawn, and what fills it. Each source is independent; 0 turns one off.
    limit: (
        // The ceiling. A move that spends the Limit costs this much
        // (`bivalence`'s `costs`).
        cap: 60.0,
        // One point every 2 seconds, whatever anybody does.
        per_second: 0.5,
        // Each hit a fighter lands, and each point of its damage.
        on_damage_dealt: 1.0,
        per_damage_dealt: 0.1,
        // Each hit a fighter takes, and each point of its damage: twice what
        // landing it pays, so the fighter who is behind fills faster.
        on_damage_taken: 2.0,
        per_damage_taken: 0.2,
        // Each strike blocked: one landed hit's worth.
        on_block: 1.0,
        // No drain: a fighter keeps the meter it earned until it spends it.
        decay_per_second: 0.0,
    ),
)
