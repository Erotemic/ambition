// This demo's own content pack — the character package half of D166.
//
//  a SECOND pack in the workspace, and that is the point. Ambition's own
// pack (`game/ambition_content/assets/pack.ron`) was the only one, which made
// the content pipeline indistinguishable from that crate's private loader. A
// demo that authors its own fighter's values through the same
// `ambition_platformer2d::content` facade — with no dependency on the game crate
// and no plumbing of its own — is what shows it is a capability.
//
//  the manifest is the pack's EXPLICIT source list, not a directory glob,
// for the same reason it is next door: a glob makes the pack's contents depend
// on filesystem enumeration order. Adding a fighter is one line here: the
// game reads this list (`content_pack! { root: "assets" }`), and a build that
// embeds the pack embeds it from this list (`build.rs`).
//
// `smash_stages` and `smash_rules` are the demo's own schemas, which the
// generic content CLI does not link. Validate this tree, or a copy of it,
// with the demo's check binary (the content CLI with the demo's schemas):
//
//     cargo run -p ambition_demo_smash --features content_check \
//         --bin smash_content_check -- game/ambition_demo_smash/assets
(
    id: "ambition_demo_smash",
    version: "0.1.0",
    // Every identity this pack mints is `smash_demo:<schema>/<name>`, so the
    // demo's George cannot collide with the main game's cast.
    namespace: "smash_demo",
    // Nothing beyond the schema owners. `smash_fighter` brings the
    // platform-fighter capability with it.
    requires: [],
    //  THE PATH LEAVES THIS DIRECTORY ON PURPOSE — the demo SELECTS
    // George, it does not own his values (2026-08-19 GPT review: *"Smash
    // should select George; it should not own George's values."*). The facet
    // lives in the character-authoring submodule, whose README claims exactly
    // this material: "game/ruleset-specific character FACET VALUES".
    //
    //  a source path is `root.join(path)` + `canonicalize`, so escaping the
    // pack root is expressible and readable; what it costs is that the pack no
    // longer validates from a checkout with the submodule uninitialised, which
    // is the honest consequence of the values living where they belong.
    sources: [
        // The cast: every row is a character the demo registers.
        (path: "data/character_catalog.ron", schema: "character_catalog", version: 1),
        // The stand-ins' platform-fighter facets (their weights).
        (path: "data/fighters/smash_duelist_a.ron", schema: "smash_fighter", version: 1),
        (path: "data/fighters/smash_duelist_b.ron", schema: "smash_fighter", version: 1),
        (
            path: "../../../tools/ambition_sprite2d_renderer/ambition_sprite2d_renderer/data/characters/george_booul/smash_fighter.ron",
            schema: "smash_fighter",
            version: 1,
        ),
        // George's moves, beside his facet, for the same reason.
        (
            path: "../../../tools/ambition_sprite2d_renderer/ambition_sprite2d_renderer/data/characters/george_booul/smash_moveset.ron",
            schema: "moveset",
            version: 1,
        ),
        // The stand-in duelists' move table. The second duelist borrows the
        // first one's table, so the table is stated once.
        (path: "data/movesets/smash_duelist_a.ron", schema: "moveset", version: 1),
        (path: "data/movesets/smash_duelist_b.ron", schema: "moveset", version: 1),
        // What the session may play.
        (path: "audio/music_registry.ron", schema: "music_registry", version: 1),
        // The rules of Smash's rooms: the combat rules and the heavy-hit line.
        (path: "data/room_rules.ron", schema: "room_rules", version: 1),
        // The rules of its matches: stocks, clocks, the fighter body, the kit.
        (path: "data/match_rules.ron", schema: "match_rules", version: 1),
        // Its stages: the room they share and each stage's blocks.
        (path: "data/smash_stages.ron", schema: "smash_stages", version: 1),
        // Its own match flow and the admiral's shark.
        (path: "data/smash_rules.ron", schema: "smash_rules", version: 1),
    ],
)
