// The General's tower: the Iron Bastion of the Faction of Steel. A real
// military building inside, five floors high (480 wide x 1280 tall).
//
//   +--------------------+  y = 0
//   |  ceiling           |  y = 32
//   |  5 war room        |  the General, Major Brandt, the map table
//   |=============[##]===|  deck y 288, hatch x 352..416 (ladder 368..400)
//   |  4 signals         |  Corporal Ruiz at the radio desk
//   |===[##]=============|  deck y 528, hatch x 64..128 (ladder 80..112)
//   |  3 armory          |  Sergeant Granger at the issue counter
//   |=============[##]===|  deck y 768, hatch x 352..416
//   |  2 barracks        |  Corporal Bankole, Private Tanaka
//   |===[##]=============|  deck y 1008, hatch x 64..128
//   |  1 parade deck     |  Drill Sergeant Casey, Private Dorsey (sentry)
//   |   [annex] [hub]    |  doors x 300..348, 380..428
//   +--------------------+  y = 1248 (floor)
//
// Movement contract:
// - The player starts on the parade deck by the doors.
// - Each floor's ladder goes up through the hatch in the deck above. A hatch
//   is a grating (one-way): climb up through it, stand on it, drop down
//   through it. The ladders are on the left and the right in turn.
// - The General is in the war room at the top, stationary.
//
// The art: parallax theme and terrain skin `military_tower`; each floor's
// inside is one scenery prop (`targets/props/military_tower_props.py` in the
// sprite tools, drawn in this room's coordinates; its FLOORS and HATCHES are
// these numbers). The soldiers are made by the character generator
// (`data/townsfolk/tower_*.chargen.yaml`).
//
// Music: fighters_guild_oath_of_steel (the radio cue pipeline). The level's
// `music_track` drives `RoomMusicRequest` when the player enters.

(
    id: "military_tower",
    level_id: "military_tower",
    world_x: -1280,
    world_y: 2304,
    px_wid: 480,
    px_hei: 1280,
    fill_collision: "empty",
    biome: "tower",
    music_track: "fighters_guild_oath_of_steel",
    ambient_profile: "barracks",
    visual_theme: "red",
    parallax_theme: "military_tower",
    // The hub's door to this room (`military_tower_door`, x 616 in
    // `central_hub_main` since Jon's hub edit) belongs to the hub: this spec
    // does not place it (`connect_to` adds a door, and refuses one that is
    // there). This room's own door below names it.
    intgrid: (
        climbable: [
            ( kind: "Ladder", px: [80, 1008], size: [32, 240] ),
            ( kind: "Ladder", px: [368, 768], size: [32, 240] ),
            ( kind: "Ladder", px: [80, 528], size: [32, 240] ),
            ( kind: "Ladder", px: [368, 288], size: [32, 240] ),
        ],
    ),
    entities: [
        // Each floor's inside, furthest back first.
        ( type: "Prop", px: [16, 1024], size: [448, 224], fields: ( name: "tower_parade_deck_0", kind: "tower_parade_deck" ) ),
        ( type: "Prop", px: [16, 784], size: [448, 224], fields: ( name: "tower_barracks_0", kind: "tower_barracks" ) ),
        ( type: "Prop", px: [16, 544], size: [448, 224], fields: ( name: "tower_armory_0", kind: "tower_armory" ) ),
        ( type: "Prop", px: [16, 304], size: [448, 224], fields: ( name: "tower_signals_0", kind: "tower_signals" ) ),
        ( type: "Prop", px: [16, 32], size: [448, 256], fields: ( name: "tower_war_room_0", kind: "tower_war_room" ) ),
        // The shell.
        ( type: "Solid", px: [0, 1248], size: [480, 32], fields: ( name: "floor" ) ),
        ( type: "Solid", px: [0, 0], size: [480, 32], fields: ( name: "ceiling" ) ),
        ( type: "Solid", px: [0, 32], size: [16, 1216], fields: ( name: "left_wall" ) ),
        ( type: "Solid", px: [464, 32], size: [16, 1216], fields: ( name: "right_wall" ) ),
        // The decks: steel, with a grating over each hatch.
        ( type: "Solid", px: [16, 1008], size: [48, 16], fields: ( name: "deck_2_west" ) ),
        ( type: "OneWayPlatform", px: [64, 1008], size: [64, 16], fields: ( name: "deck_2_hatch" ) ),
        ( type: "Solid", px: [128, 1008], size: [336, 16], fields: ( name: "deck_2_east" ) ),
        ( type: "Solid", px: [16, 768], size: [336, 16], fields: ( name: "deck_3_west" ) ),
        ( type: "OneWayPlatform", px: [352, 768], size: [64, 16], fields: ( name: "deck_3_hatch" ) ),
        ( type: "Solid", px: [416, 768], size: [48, 16], fields: ( name: "deck_3_east" ) ),
        ( type: "Solid", px: [16, 528], size: [48, 16], fields: ( name: "deck_4_west" ) ),
        ( type: "OneWayPlatform", px: [64, 528], size: [64, 16], fields: ( name: "deck_4_hatch" ) ),
        ( type: "Solid", px: [128, 528], size: [336, 16], fields: ( name: "deck_4_east" ) ),
        ( type: "Solid", px: [16, 288], size: [336, 16], fields: ( name: "deck_5_west" ) ),
        ( type: "OneWayPlatform", px: [352, 288], size: [64, 16], fields: ( name: "deck_5_hatch" ) ),
        ( type: "Solid", px: [416, 288], size: [48, 16], fields: ( name: "deck_5_east" ) ),
        // The way in and out.
        ( type: "PlayerStart", px: [240, 1202], size: [28, 46], fields: ( name: "military_tower_spawn" ) ),
        ( type: "LoadingZone", px: [380, 1152], size: [48, 96], fields: ( id: "military_tower_entry", name: "to central hub", activation: "Door", target_room: "central_hub_complex", target_zone: "military_tower_door", bidirectional: true ) ),
        // The door to the gate annex (`specs/gate_network/make_gates.py` adds
        // it to the world and makes the annex).
        ( type: "LoadingZone", px: [300, 1152], size: [48, 96], fields: ( id: "military_tower_annex_door", name: "to the gate annex", activation: "Door", target_room: "military_gate_annex", target_zone: "military_gate_annex_door", bidirectional: true ) ),
        ( type: "DebugLabel", px: [270, 1124], size: [140, 24], fields: ( name: "military_tower_annex_sign", text: "GATE ANNEX", category: "Custom" ) ),
        // The garrison, floor by floor.
        ( type: "NpcSpawn", px: [192, 1184], size: [32, 64], fields: ( character_id: "npc_tower_voss", prompt: "Talk", dialogue_id: "military_tower_voss", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [432, 1184], size: [32, 64], fields: ( character_id: "npc_tower_dorsey", prompt: "Talk", dialogue_id: "military_tower_dorsey", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [180, 944], size: [32, 64], fields: ( character_id: "npc_tower_tanaka", prompt: "Talk", dialogue_id: "military_tower_tanaka", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [266, 944], size: [32, 64], fields: ( character_id: "npc_tower_bankole", prompt: "Talk", dialogue_id: "military_tower_bankole", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [298, 704], size: [32, 64], fields: ( character_id: "npc_tower_granger", prompt: "Talk", dialogue_id: "military_tower_granger", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [292, 464], size: [32, 64], fields: ( character_id: "npc_tower_ruiz", prompt: "Talk", dialogue_id: "military_tower_ruiz", brain_override: "stand_still" ) ),
        ( type: "NpcSpawn", px: [110, 218], size: [42, 70], fields: ( character_id: "npc_general", prompt: "Talk", dialogue_id: "military_general" ) ),
        ( type: "NpcSpawn", px: [310, 224], size: [32, 64], fields: ( character_id: "npc_tower_brandt", prompt: "Talk", dialogue_id: "military_tower_brandt", brain_override: "stand_still" ) ),
        ( type: "CameraZone", px: [0, 0], size: [480, 1280], fields: ( id: "military_tower_camera", name: "military_tower_camera", mode: "Default" ) ),
    ],
)
